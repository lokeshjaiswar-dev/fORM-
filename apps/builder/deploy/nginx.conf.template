# fORM- builder (Forms+) static server, nginx-unprivileged on :8080. Rendered by the image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only the two variables below are substituted; every other `$name` is nginx's own.
#   FP_WEB_ROOT      where the build lives (the SPA is under <root>/formplus/, built with VITE_BASE=/formplus/)
#   FP_HEADERS_DIR   plain.conf, embed-page.conf and upload.conf written at build time by security/render-nginx.ts
# nginx does not inherit add_header into a block that sets its own, so each location includes its header file itself.
# The ingress sends /formplus/ and /formbuilder/ (the retired OpenForm paths) here; /sharemaster belongs to DMS.

# The access log of the embed routes: no Cookie, no Authorization and no query string (SEC-DESIGN 3.3: the navigation request of the
# sandboxed iframe still carries the DMS cookies to this server). `$uri` is the path without the query; `$request`,
# `$request_uri`, `$args`, `$http_cookie` and `$http_authorization` must never appear in this format (security/deploy.test.ts).
# (Included inside `http {}`, where log_format is allowed.)
log_format fp_embed '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent "$http_user_agent"';

server {
  listen 8080;
  listen [::]:8080;
  server_name _;
  root ${FP_WEB_ROOT};
  server_tokens off;
  absolute_redirect off;
  port_in_redirect off;

  # Liveness and readiness probe: no files, no headers, no access log.
  location = /formplus/healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Trailing slash: /formplus is the app.
  location = /formplus {
    return 301 /formplus/$is_args$args;
  }

  # The only framable route: the classic live upload module frames it for upload step 2 (VITE_FP_EMBED_PARENTS, build time). It is
  # served from its OWN entry (embed-upload.html, no router, no storage, no network) with the `sandbox` CSP, so the document has an
  # opaque origin even when opened top-level (upload.conf; the M2 legacy build writes today's framable set there instead).
  location = /formplus/embed/dms-upload {
    include ${FP_HEADERS_DIR}/upload.conf;
    access_log /dev/stdout fp_embed;
    try_files /formplus/embed-upload.html =404;
  }

  # Hashed build output: immutable. The sandboxed upload page has an opaque origin and loads its module scripts, stylesheet and
  # fonts in CORS mode with `Origin: null`: public files, no credentials, so `*` (SEC-DESIGN 3.3 B2).
  location ^~ /formplus/assets/ {
    include ${FP_HEADERS_DIR}/plain.conf;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # The full-page launches, /formplus/embed/dms-master and /formplus/embed/dms-record (frame-ancestors 'none', no report-uri: no receiver on DMS hosts).
  location ^~ /formplus/embed/ {
    include ${FP_HEADERS_DIR}/embed-page.conf;
    access_log /dev/stdout fp_embed;
    add_header Cache-Control "no-cache" always;
    try_files $uri /formplus/index.html;
  }

  # The SPA (frame-ancestors 'none').
  location /formplus/ {
    include ${FP_HEADERS_DIR}/plain.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /formplus/index.html;
  }

  # OpenForm is retired (decisions.md item 6). The share page moved to DMS: keep the query (it carries the share token).
  # The query is the share token: this redirect is never logged.
  location = /formbuilder/sharemaster {
    access_log off;
    return 301 /sharemaster$is_args$args;
  }
  location = /formbuilder/sharemaster/ {
    access_log off;
    return 301 /sharemaster$is_args$args;
  }

  # Everything else under /formbuilder is gone: 410 with a static page that says where to go.
  location = /formbuilder {
    return 410;
  }
  location ^~ /formbuilder/ {
    return 410;
  }
  error_page 410 /moved/formbuilder.html;
  location = /moved/formbuilder.html {
    internal;
    include ${FP_HEADERS_DIR}/plain.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri =410;
  }

  location / {
    return 404;
  }
}
