      "reconnect": false,
      "retryable": false
    },
    {
      "code": "LAUNCH_STORE_UNAVAILABLE",
      "status": 503,
      "message": "Forms+ is temporarily unavailable. Try again in a moment.",
      "reconnect": false,
      "retryable": true
    },
    {
      "code": "FP_SESSION_INVALID",
      "status": 401,
      "message": "Your Forms+ session ended. Reconnect to DMS to continue.",
      "reconnect": true,
      "retryable": false
    },
    {
      "code": "FP_CONTEXT_MISMATCH",
      "status": 401,
      "message": "Your Forms+ session ended. Reconnect to DMS to continue.",
      "reconnect": true,
      "retryable": false
    },
    {
      "code": "FP_SCOPE_DENIED",
      "status": 403,
      "message": "This form cannot do that. Go back to DMS and open it again.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "FIELD_VISIBILITY_FORBIDDEN",
      "status": 403,
      "message": "Only the master creator, an owner or an administrator can change hidden or secret settings.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "PRIMARY_CANNOT_BE_HIDDEN",
      "status": 422,
      "message": "The primary field cannot be hidden or secret.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "FIELD_OMITTED",
      "status": 422,
