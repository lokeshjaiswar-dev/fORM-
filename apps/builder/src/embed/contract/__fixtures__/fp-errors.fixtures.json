      "reconnect": false,
      "retryable": false
    },
    {
      "code": "HIDDEN_FIELD_NOT_WRITABLE",
      "status": 422,
      "message": "This form contains a field that cannot be filled in.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "MASTER_ID_MISMATCH",
      "status": 422,
      "message": "This form does not belong to this link.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "LINK_EXPIRED",
      "status": 410,
      "message": "This link has expired. Ask the sender for a new one.",
      "reconnect": false,
      "retryable": false
