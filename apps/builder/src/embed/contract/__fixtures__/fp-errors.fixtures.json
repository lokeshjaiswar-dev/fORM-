      "reconnect": false,
      "retryable": false
    },
    {
      "code": "NOT_FOUND",
      "status": 404,
      "message": "This master or record is not available.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "MASTER_NOT_CONVERTED",
      "status": 422,
