    {
      "code": "RATE_LIMITED",
      "status": 429,
      "message": "Too many requests. Wait a moment and try again.",
      "reconnect": false,
      "retryable": true
    }
  ],
  "envelopes": [
    {
      "name": "scope-denied",
      "input": {
