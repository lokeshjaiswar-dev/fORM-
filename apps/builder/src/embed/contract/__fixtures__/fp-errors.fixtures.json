      "reconnect": false,
      "retryable": false
    },
    {
      "code": "MODE_NOT_TICKETED",
      "status": 422,
      "message": "Forms+ could not be opened. Try again, and give the reference to your administrator if it keeps failing.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "VALIDATION_FAILED",
      "status": 422,
      "message": "Forms+ could not be opened. Try again, and give the reference to your administrator if it keeps failing.",
      "reconnect": false,
      "retryable": false
    },
    {
      "code": "FP_TICKET_INVALID",
