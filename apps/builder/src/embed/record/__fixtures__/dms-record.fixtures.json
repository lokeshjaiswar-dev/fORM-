          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": true,
            "message": "Master Record updated",
            "data": {
              "id": "d3000000-0000-4000-8000-0000000000b1"
            }
          }
        },
        "then": {
          "stored": {
            "Tax Id": "29ABCDE1234F1Z5"
          },
          "audit": "old and new values are redacted to the mask in the activity row"
        }
      },
      {
        "name": "create-with-the-mask-as-value",
        "as": "editor",
        "request": {
