            "json_data": {
              "Vendor Name": "Beta",
              "Tax Id": "••••••"
            }
          }
        },
        "response": {
          "status": 422,
          "body": {
            "success": false,
            "code": "SECRET_MASK_NOT_ALLOWED"
          }
        },
        "then": {
          "no_record_created": true
        }
      },
      {
        "name": "create-with-a-hidden-key-as-non-revealer",
        "as": "editor",
        "request": {
          "method": "POST",
          "path": "/dms/master-records",
          "body": {
            "master_id": "a1000000-0000-4000-8000-0000000000b1",
            "json_data": {
