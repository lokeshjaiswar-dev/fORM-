            "master_record_id": "d3000000-0000-4000-8000-0000000000b1"
          }
        },
        "response": {
          "status": 422,
          "body": {
            "success": false,
            "code": "SECRET_MASK_NOT_ALLOWED"
          }
        },
        "then": {
          "stored_unchanged": [
            "Tax Id"
          ]
        },
        "note": "any key ending __masked is refused with the same code (plan default: SEC 5.2.7 names no second code)"
      },
      {
        "name": "update-with-a-hidden-key-as-non-revealer",
