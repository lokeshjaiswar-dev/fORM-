ield && (own.id === undefined || own.id === field.id) ? field : null\n  const out: ResolvedFieldAria = {}\n  const id = own.id ?? f?.id\n  if (id) out.id = id\n  const describedBy = joinIds(own['aria-describedby'], f?.describedBy)\n  if (describedBy) out['aria-describedby'] = describedBy\n  if (own['aria-invalid'] !== undefined ? isTrue(own['aria-invalid']) : f?.invalid) out['aria-invalid'] = true\n  if (own['aria-required'] !== undefined ? isTrue(own['aria-required']) : f?.required) out['aria-required'] = true\n  const labelledBy = own['aria-labelledby'] ?? (!labelable && !own['aria-label'] ? f?.labelId : undefined)\n  if (labelledBy) out['aria-labelledby'] = labelledBy\n  return out\n}\n\n/**\n * What a control inherits from its `Field` besides the aria attributes: `disabled` and the tone of the message (`error` / `warning` / `success`) as a `status`.\n * What the caller set wins (`disabled={false}` re-enables a control in a disabled field, `status=\"default\"` keeps a plain box under a warning).\n * Kept apart from `useFieldAria` because these are not attributes of the element: they style and disable it. This is the one place a field's `disabled` reaches a library control.\n */\nexport function useFieldInherit(own: { id?: string; disabled?: boolean; status?: FieldStatus }): { disabled: boolean | undefined; status: FieldStatus } {\n  const field = useFieldControl()\n  const f = field && (own.id === undefined || own.id === field.id) ? field : null\n  return { disabled: own.disabled ?? (f?.disabled || undefined), status: own.status ?? f?.status ?? 'default' }\n}\n\nconst FORM_TAGS = new Set(['input', 'select', 'textarea', 'button'])\n\n/** Adds a field's wiring (`aria-describedby`, `aria-invalid`, `aria-required`, and `disabled` when the field is disabled) to a single control element whose `id` is the field's, unless it set them itself. Anything else is returned as it is. `Field` does this for its child; `FormField` for the same child inside its own wrapper. */\nexp