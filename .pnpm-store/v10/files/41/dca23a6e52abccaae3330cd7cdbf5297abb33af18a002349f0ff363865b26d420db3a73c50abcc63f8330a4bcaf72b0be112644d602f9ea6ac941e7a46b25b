      else remove(value[value.length - 1])\n            }\n          }}\n          className={cn(fieldBoxVariants({ size }), 'cursor-pointer data-[disabled]:cursor-not-allowed data-[readonly]:cursor-default', className)}\n        >\n          <div className=\"flex min-w-0 flex-1 items-center gap-1 overflow-hidden\">\n            {picked.length === 0 && <span className=\"truncate text-text-muted\">{placeholder}</span>}\n            {picked.slice(0, maxVisible).map((o) => (\n              <ValueChip key={o.value} disabled={disabled} onRemove={locked ? undefined : () => remove(o.value)}>\n                {optionText(o)}\n              </ValueChip>\n            ))}\n            {hiddenCount > 0 && (\n              <span id={hiddenId} className=\"sr-only\">\n                Also selected: {picked.slice(maxVisible).map(optionText).join(', ')}\n              </span>\n            )}\n            {picked.length > maxVisible && (\n              <Tooltip>\n                <TooltipTrigger asChild>\n                  <span className=\"inline-flex shrink-0\">\n                    <ValueChip disabled={disabled} className={cn(!disabled && 'bg-primary-faded text-primary-text')}>\n                      +{picked.length - maxVisible}\n                    </ValueChip>\n                  </span>\n                </TooltipTrigger>\n                {/* the rest of the picks, so \"+3\" can be read without opening the menu */}\n                <TooltipContent className=\"max-w-64 text-left\">{picked.slice(maxVisible).map(optionText).join(', ')}</TooltipContent>\n              </Tooltip>\n            )}\n          </div>\n          {clearable && picked.length > 0 && !locked && (\n            <button\n              type=\"button\"\n              tabIndex={-1}\n              aria-hidden\n              aria-label=\"Clear all\"\n              title=\"Clear all (Ctrl/Cmd+Backspace)\"\n              onClick={(e) => {\n                e.stopPropagation()\n                setValue([])\n                // keep keyboard focus on the field (the button unmounts with the last pick)\n                e.currentTarget.closest<HTMLElement>('[data-slot=\"multi-select\"]')?.focus()\n              }}\n              className={cn('inline-flex size-4 shrink-0 cursor-pointer items-center justify-center rounded-xs text-icon-muted hover:text-foreground ds-focus focus-visible:outline-offset-0', hitArea)}\n            >\n              <XIcon aria-hidden className=\"size-3.5\" />\n            </button>\n          )}\n          {visual !== 'default' && <StatusIcon status={visual} size={size} />}\n          {!readOnly && <ChevronDownIcon aria-hidden className={cn('ds-field-icon transition-transform duration-(--dur-base)', fieldIconClass[size], open && 'rotate-180')} />}\n        </div>\n      </PopoverTrigger>\n      <PopoverContent\n        align={align}\n        className={cn('w-(--radix-popover-trigger-width) min-w-[220px] p-1', contentClassName)}\n        aria-label={aria['aria-label'] ?? placeholder}\n        aria-labelledby={aria['aria-label'] ? undefined : (aria['aria-labelledby'] ?? fieldLabelId)}\n      >\n        <OptionList\n          options={options}\n          checkbox\n          multiple\n          label={aria['aria-label'] ?? placeholder}\n          labelledBy={aria['aria-label'] ? undefined : (aria['aria-labelledby'] ?? fieldLabelId)}\n          isSelected={(o) => value.includes(o.value)}\n          onPick={toggle}\n          searchPlaceholder={searchPlaceholder}\n          emptyText={emptyText}\n          loading={loading}\n          footer={onLoadMore ? <LoadMoreRow onClick={onLoadMore} loading={loading} /> : undefined}\n        />\n      </PopoverContent>\n    </Popover>\n  )\n}\n\nexport { MultiSelect, ValueChip }\n","import * as React from 'react'\nimport { Slot } from 'radix-ui'\nimport { ChevronLeft, ChevronRight } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Figma: Pagination (1849:11167). 24x24 items, radius 4, Medium XS text. By default comfortable density makes them 28x28 (a roomier target) and compact keeps the 24x24 minimum;\n * `size=\"md\"` is a fixed 32x32 with small text (a table footer, a touch-first screen) and `size=\"sm\"` a fixed 24x24. Previous / next carry a faded 1px border; the current page is primary faded\n * with a primary border. States: default, hover, focus (keyboard), pressed (a neutral wash, so a mouse-down never looks like a second selected page), selected, disabled.\n */\ntype PaginationSize = 'sm' | 'md'\n\nconst PaginationContext = React.createContext<PaginationSize | undefined>(undefined)\n\nconst itemBase =\n  'inline-flex shrink-0 items-center justify-center rounded-sm border border-transparent px-1 font-medium text-text-subtle select-none transition-colors ' +\n  'hover:border-input hover:bg-state-hover hover:text-(--ds-text-strong) ' +\n  'focus-visible:bg-state-hover focus-visible:text-(--ds-text-strong) ds-focus ' +\n  'active:bg-state-pressed active:text-(--ds-text-strong) ' +\n  'aria-[current=page]:border-primary-highlighted aria-[current=page]:bg-primary-faded aria-[current=page]:text-primary-text ' +\n  'disabled:pointer-events-none disabled:text-text-disabled aria-disabled:pointer-events-none aria-disabled:text-text-disabled [&_svg]:size-4 [&_svg]:shrink-0'\n\nconst itemSize: Record<PaginationSize | 'auto', string> = {\n  auto: 'h-7 min-w-7 compact:h-6 compact:min-w-6 text-xs',\n  sm: 'h-6 min-w-6 text-xs',\n  md: 'h-8 min-w-8 min-[381px]:max-[430.98px]:min-w-7 max-[380.98px]:min-w-[26px] text-sm',\n}\nconst ellipsisSize: Record<PaginationSize | 'auto', string> = {\n  auto: 'size-7 compact:size-6 text-xs',\n  sm: 'size-6 text-xs',\n  md: 'size-8 min-[381px]:max-[430.98px]:size-7 max-[380.98px]:size-[26px] text-sm',\n}\n\nconst useItemClass = () => itemBase + ' ' + itemSize[React.useContext(PaginationContext) ?? 'auto']\n\n/** The landmark is named \"Pagination\"; give each one on a page its own `aria-label` (\"Invoices pagination\") so a screen reader can tell them apart. `size` is `sm` (24 px), `md` (32 px) or, left out, follows the density. */\nfunction Pagination({ className, size, 'aria-label': ariaLabel = 'Pagination', ...props }: React.ComponentProps<'nav'> & { size?: PaginationSize }) {\n  return (\n    <PaginationContext.Provider value={size}>\n      <nav data-slot=\"pagination\" aria-label={ariaLabel} className={cn('mx-auto flex w-full justify-center', className)} {...props} />\n    </PaginationContext.Provider>\n  )\n}\n\nfunction PaginationContent({ className, ...props }: React.ComponentProps<'ul'>) {\n  const size = React.useContext(PaginationContext)\n  // 32 px items need 392 px for the full window: they narrow to 28 px on a phone (328 px) and still wrap rather than overflow\n  return <ul data-slot=\"pagination-content\" className={cn('flex flex-row items-center justify-center gap-1', size === 'md' && 'flex-wrap max-[430.98px]:gap-0.5', className)} {...props} />\n}\n\nfunction PaginationItem(props: React.ComponentProps<'li'>) {\n  return <li data-slot=\"pagination-item\" {...props} />\n}\n\ntype PaginationLinkProps = {\n  isActive?: boolean\n  /** Render your router's link (or an `a`) as the control instead of a button: `<PaginationLink asChild><a href=\"?page=3\">3</a></PaginationLink>`. */\n  asChild?: boolean\n} & React.ComponentProps<'button'>\n\n/** A page number. `isActive` marks the current page (sets aria-current, which drives the selected style). `asChild` makes it your own link element. */\nfunction PaginationLink({ className, isActive, asChild = false, type, ...props }: PaginationLinkProps) {\n  const itemClass = useItemClass()\n  const Comp = asChild ? Slot.Root : 'button'\n  return <Comp data-slot=\"pagination-link\" type={asChild ? undefined : (type ?? 'button')} aria-current={isActive ? 'page' : undefined} data-active={isActive} className={cn(itemClass, className)} {...props} />\n}\n\ntype PaginationStepProps = { asChild?: boolean } & React.ComponentProps<'button'>\n\nfunction Pagination