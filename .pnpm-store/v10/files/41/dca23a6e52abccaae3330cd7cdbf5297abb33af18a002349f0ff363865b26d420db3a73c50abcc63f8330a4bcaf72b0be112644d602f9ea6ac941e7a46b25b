         ) : (\n            <PaginationItem key={it} className={cn(collapse && 'max-sm:hidden')}>\n              <PaginationEllipsis />\n            </PaginationItem>\n          ),\n        )}\n        <PaginationItem>\n          <PaginationNext disabled={cur >= pageCount} onClick={() => onPageChange(cur + 1)} />\n        </PaginationItem>\n      </PaginationContent>\n    </Pagination>\n  )\n}\n\nexport { Pagination, PaginationContent, PaginationItem, PaginationLink, PaginationPrevious, PaginationNext, PaginationEllipsis, PaginationBar, getPageItems }\nexport type { PaginationBarProps, PageItem, PaginationSize }\n","import * as React from 'react'\nimport { RadioGroup as RadioGroupPrimitive } from 'radix-ui'\n\nimport { cn } from '../lib/utils'\nimport { checkSizeClass, optionControlOffset, optionTextClass, type CheckSize } from './checkbox'\nimport { useFieldControl } from './field'\n\nconst joinIds = (...lists: (string | undefined | false)[]) => Array.from(new Set(lists.flatMap((l) => (l || '').split(/\\s+/)).filter(Boolean))).join(' ') || undefined\n\n/** What the group tells its items: they are invalid (red circle) and, for the labels, disabled. */\nconst RadioGroupContext = React.createContext<{ invalid?: boolean; disabled?: boolean }>({})\n\n/** Dot diameter inside the 16 / 20 / 24 circle (compact 14 / 16 / 20). */\nconst dotClass: Record<CheckSize, string> = { sm: 'size-1.5 compact:size-[5px]', md: 'size-2 compact:size-1.5', lg: 'size-2.5 compact:size-2' }\n/** The circle fills the button, like the checkbox box. */\nconst circleClass: Record<CheckSize, string> = { sm: 'size-full', md: 'size-full', lg: 'size-full' }\n\n/**\n * Inside a `Field` the group is named by the field's label, pointed at its message, and takes its `error` (every radio turns red) and `disabled`; set `aria-invalid` or `disabled` on the group yourself\n * to do the same without a Field.\n */\nfunction RadioGroup({ className, disabled, ...props }: React.ComponentProps<typeof RadioGroupPrimit