   onPick={(p) => set(((h24 ?? 0) % 12) + (p === 1 ? 12 : 0), minute ?? 0)}\n        />\n      )}\n    </div>\n  )\n}\n\nexport interface TimePickerProps {\n  /** 24-hour `HH:mm`; empty string when cleared */\n  value?: string\n  defaultValue?: string\n  onValueChange?: (value: string) => void\n  /** show AM / PM (default) or 24-hour columns; the value is always 24-hour */\n  hour12?: boolean\n  minuteStep?: number\n  /** earliest time, 24-hour `HH:mm`. Earlier options are disabled in the popover and a typed earlier time shows the error state. */\n  min?: string\n  /** latest time, 24-hour `HH:mm` (same day as `min`) */\n  max?: string\n  placeholder?: string\n  size?: FieldSize\n  status?: FieldStatus\n  disabled?: boolean\n  readOnly?: boolean\n  clearable?: boolean\n  /** id of the text input; the label's `htmlFor` points at it. Inside a `Field` it defaults to the field's id. */\n  id?: string\n  /** form field name. The form gets the 24-hour `HH:mm` value (empty when there is no time) through a hidden input, not the text that is shown. */\n  name?: string\n  className?: string\n  align?: 'start' | 'center' | 'end'\n  /** controls the popover: pass with `onOpenChange` */\n  open?: boolean\n  /** starts with the popover open */\n  defaultOpen?: boolean\n  onOpenChange?: (open: boolean) => void\n  /** ref of the text input */\n  ref?: React.Ref<HTMLInputElement>\n  /** called when the text input loses or gets focus (validate on blur here) */\n  onBlur?: React.FocusEventHandler<HTMLInputElement>\n  onFocus?: React.FocusEventHandler<HTMLInputElement>\n  autoFocus?: boolean\n  /** the text input is `required` (a native form checks it) */\n  required?: boolean\n  /** marks the field invalid and draws the error state (a typed time outside `min` / `max` or text that is not a time does too). Inside a `Field` it follows the field's `error`. */\n  'aria-invalid'?: boolean | 'true' | 'false'\n  /** accessible name when there is no visible label */\n  'aria-label'?: string\n  /** id of the element that names the input, when a `<label for>` does not */\n  'aria-labelledby'?: string\n  'aria-describedby'?: string\n  'aria-required'?: boolean | 'true' | 'false'\n}\n\n/**\n * Time field: typed entry (14:30, 2:30 pm ...) plus a three-column popover (Figma: Set Time / Time Picker). ArrowDown opens the popover and moves focus into\n * the hour column. Text that is not a time stays in the field with the error state (the value stays as it was) until it is corrected or cleared.\n */\nfunction TimePicker({\n  value: valueProp,\n  defaultValue,\n  onValueChange,\n  hour12 = true,\n  minuteStep = 1,\n  min,\n  max,\n  placeholder,\n  size = 'md',\n  status: statusProp,\n  disabled: disabledProp,\n  readOnly,\n  clearable = true,\n  id,\n  name,\n  className,\n  align = 'start',\n  open: openProp,\n  defaultOpen,\n  onOpenChange,\n  ref,\n  onBlur,\n  onFocus,\n  autoFocus,\n  required,\n  ...aria\n}: TimePickerProps) {\n  const wired = useFieldAria({ id, ...aria })\n  const { disabled, status } = useFieldInherit({ id, disabled: disabledProp, status: statusProp })\n  const [value, setValue] = useControllableState<string>(valueProp, defaultValue ?? '', onValueChange)\n  const [open, setOpen] = useControllableState<boolean>(openProp, defaultOpen ?? false, onOpenChange)\n  const [focusTick, setFocusTick] = React.useState(0)\n  const [text, setText] = React.useState<string | null>(null)\n  /** the text that was left in the field is not a time */\n  const [bad, setBad] = React.useState(false)\n  const hintId = React.useId()\n  const boxRef = React.useRef<HTMLDivElement>(null)\n  const inputRef = React.useRef<HTMLInputElement | null>(null)\n  const setInputRef = React.useCallback(\n    (node: HTMLInputElement | null) => {\n      inputRef.current = node\n      if (typeof ref === 'function') ref(node)\n      else if (ref) (ref as React.RefObject<HTMLInputElement | null>).current = node\n    },\n    [ref],\n  )\n  const contentRef = React.useRef<HTMLDivElement>(null)\n  const lastValue = React.useRef(value)\n  const shown = text ?? formatTimeDisplay(value, hour12)\n  const outOfRange = !!value && ((!!min && value < min) || (!!max && value > max))\n  const invalid = !!wired['aria-invalid'] || outOfRange || bad\n  const visual: FieldStatus = status !== 'default' ? status : invalid ? 'error' : 'default'\n  const locked = disabled || readOnly\n\n  useFocusInto(contentRef, focusTick, '[role=\"option\"][tabindex=\"0\"]')\n  React.useEffect(() => {\n    // the value was changed from outside while unparseable text was left in the field: show the value\n    if (lastValue.current !== value && bad) {\n      setBad(false)\n      setText(null)\n    }\n    lastValue.current = value\n  }, [value, bad])\n\n  const commit = (v: string) => {\n    if (v !== value) setValue(v)\n    setText(null)\n    setBad(false)\n  }\n  /** Enter and blur: a parseable time is committed, other text stays and turns the field red */\n  const settle = (raw: string) => {\n    const t = raw.trim()\n    if (!t) return commit('')\n    const parsed = parseTimeInput(t)\n    if (parsed) commit(parsed)\n    else setBad(true)\n  }\n  const openWith = (viaKeyboard: boolean) => {\n    if (locked) return\n    if (viaKeyboard) setFocusTick((t) => t + 1)\n    setOpen(true)\n  }\n\n  return (\n    <Popover open={open && !locked} onOpenChange={setOpen}>\n      <PopoverAnchor asChild>\n        <div\n          ref={boxRef}\n          data-slot=\"time-picker\"\n          data-status={visual !== 'default' ? visual : undefined}\n          data-disabled={disabled || undefined}\n          data-readonly={readOnly || undefined}\n          data-active={open || undefined}\n          className={cn(fieldBoxVariants({ size }), className)}\n        >\n          <input\n            ref={setInputRef}\n            type=\"text\"\n            autoComplete=\"off\"\n            spellCheck={false}\n            disabled={disabled}\n            readOnly={readOnly}\n            required={required}\n            autoFocus={autoFocus}\n            placeholder={placeholder ?? (hour12 ? 'HH:MM AM' : 'HH:MM')}\n            aria-label={aria['aria-label']}\n            {...wired}\n            aria-invalid={invalid || undefined}\n            aria-describedby={bad ? [wired['aria-describedby'], hintId].filter(Boolean).join(' ') : wired['aria-describedby']}\n            value={shown}\n            className=\"ds-field-input tnum\"\n            onFocus={onFocus}\n            onBlur={(e) => {\n              if (text !== null) settle(text)\n              onBlur?.(e)\n            }}\n            onClick={() => openWith(false)}\n            onChange={(e) => {\n              setText(e.target.value)\n              setBad(false)\n              if (e.target.value.trim() === '' && value) setValue('')\n            }}\n            onKeyDown={(e) => {\n              if (e.key === 'ArrowDown') {\n                e.preventDefault()\n                openWith(true)\n              } else if (e.key === 'Enter') {\n                if (!locked) settle(shown)\n                setOpen(false)\n              } else if (e.key === 'Escape' && open) {\n                e.stopPropagation()\n                setOpen(false)\n              }\n            }}\n          />\n          {name && <input type=\"hidden\" name={name} value={value} disabled={disabled} />}\n          {bad && (\n            <span id={hintId} className=\"sr-only\">\n              {`Not a valid time. Use ${hour12 ? 'HH:MM AM or PM' : 'HH:MM'}.`}\n            </span>\n          )}\n          {clearable && (!!value || !!text) && !locked && (\n            <button\n              type=\"button\"\n              aria-label=\"Clear time\"\n              onClick={() => commit('')}\n              className={cn('inline-flex size-4 shrink-0 cursor-pointer items-center justify-center rounded-xs text-icon-muted hover:text-foreground ds-focus focus-visible:outline-offset-0', hitArea)}\n            >\n              <XIcon aria-hidden className=\"size-3.5\" />\n            </button>\n          )}\n          {visual !== 'default' && <StatusIcon status={visual} size={size} />}\n          <PopoverTrigger asChild>\n            <button\n              type=\"button\"\n              disabled={disabled}\n              aria-label=\"Open time picker\"\n              onClick={(e) => {\n                if (e.detail === 0) setFocusTick((t) => t + 1)\n              }}\n              className={cn('ds-field-icon rounded-xs hover:text-foreground disabled:pointer-events-none ds-focus focus-visible:outline-offset-0', fieldIconClass[size], hitArea)}\n            >\n              <ClockIcon className=\"size-full\" />\n            </button>\n          </PopoverTrigger>\n        </div>\n      </PopoverAnchor>\n      <PopoverContent\n        ref={contentRef}\n        align={align}\n        aria-label=\"Choose time\"\n        className=\"w-auto p-0\"\n        onOpenAutoFocus={(e) => e.preventDefault()}\n        onCloseAutoFocus={(e) => e.preventDefault()}\n        onEscapeKeyDown={() => inputRef.current?.focus()}\n        onInteractOutside={(e) => {\n          if (boxRef.current?.contains(e.target as Node)) e.preventDefault()\n        }}\n      >\n        <TimeList\n          value={value}\n          hour12={hour12}\n          minuteStep={minuteStep}\n          min={min}\n          max={max}\n          onValueChange={(v) => {\n            setValue(v)\n            setText(null)\n            setBad(false)\n          }}\n        />\n      </PopoverContent>\n    </Popover>\n  )\n}\n\nexport { TimePicker, TimeList }\n","import * as React from 'react'\nimport { SearchIcon, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { fieldBoxVariants, fieldIconClass, hitArea, StatusIcon, useFieldAria, useFieldInherit, type FieldSize, type FieldStatus } from './field'\nimport { DatePicker } from './date-picker'\nimport { TimePicker } from './time-picker'\n\nexport interface InputProps extends Omit<React.ComponentProps<'input'>, 'size'> {\n  /** Field size, the same heights as Button: sm 28, md 32 (default), lg 40, xl 48 (compact density 24 / 28 / 32 / 36). A height class such as `h-11` still overrides it. */\n  size?: FieldSize\n  /** visual state; `aria-invalid` is treated as `error`, also when it comes from the surrounding `Field`, and a `Field` with a `warning` or `success` message passes that tone on when `status` is left out. `loading` shows a spinner. */\n  status?: FieldStatus\n  /** icon before the text */\n  startIcon?: React.ReactNode\n  /** icon / action after the text (the status glyph comes first). A bare `<button>` here gets a pointer, a hover colour, a focus ring and a 24px hit area. */\n  endIcon?: React.ReactNode\n  /** short text before the value, such as a currency symbol (`₹`). It is part of the box and a press on it focuses the input. */\n  prefixText?: React.ReactNode\n  /** short text after the value, such as a unit (`kg`, `%`, `days`) */\n  suffixText?: React.ReactNode\n  /** class of the inner <input>; `className` styles the field box around it */\n  inputClassName?: string\n}\n\n/** A change event for callers that read `e.target.value`, produced by the pickers that replace native date / time inputs. */\nfunction valueEvent(value: string, name?: string) {\n  const target = { value, name: name ?? '' }\n  return { target, currentTarget: target, type: 'change' } as unknown as React.ChangeEvent<HTMLInputElement>\n}\n\n/**\n * Text input (Figma: TextField). It renders the field box with a borderless <input> inside, in every state, so the <input> stays the same\n * element when a status or an error appears or goes: focus, caret and selection survive validation while the user types. `className` styles\n * the box and `inputClassName` the input; `startIcon`, `prefixText`, `suffixText`, `endIcon` and the status glyph sit inside the box. Inside a `Field` it takes its `id`,\n * `aria-describedby`, `aria-invalid`, `aria-required` and `disabled` from the field, and the box takes the warning / success tone of the field's message.\n * `status=\"error\"` also sets `aria-invalid`. `type=\"date\"` and `type=\"time\"` render the dMACQ pickers\n * (popover calendar, typed entry) and still call `onChange` with an event whose `target.value` is `YYYY-MM-DD` / `HH:mm`, so existing screens keep working;\n * `onBlur`, `onFocus`, `autoFocus`, `required` and `ref` reach their text input.\n */\nfunction Input({ className, type, size = 'md', status: statusProp, startIcon, endIcon, prefixText, suffixText, inputClassName, ...props }: InputProps) {\n  const aria = useFieldAria(props)\n  const inherit = useFieldInherit({ id: props.id, disabled: props.disabled, status: statusProp })\n\n  if (type === 'date' || type === 'time') {\n    const { value, defaultValue, onChange, onBlur, onFocus, autoFocus, required, ref, min, max, readOnly, placeholder, name } = props\n    const common = {\n      id: aria.id,\n      name,\n      size,\n      status: statusProp,\n      disabled: props.disabled,\n      readOnly,\n      placeholder,\n      className,\n      ref,\n      onBlur,\n      onFocus,\n      autoFocus,\n      required,\n      value: value === undefined ? undefined : String(value),\n      defaultValue: defaultValue === undefined ? undefined : String(defaultValue),\n      onValueChange: (v: string) => onChange?.(valueEvent(v, name)),\n      'aria-invalid': aria['aria-invalid'] === true,\n      'aria-required': aria['aria-required'],\n      'aria-label': props['aria-label'],\n      'aria-labelledby': props['aria-labelledby'],\n      'aria-describedby': aria['aria-describedby'],\n    }\n    return type === 'date' ? <DatePicker {...common} min={min === undefined ? undefined : String(min)} max={max === undefined ? undefined : String(max)} /> : <TimePicker {...common} />\n  }\n\n  if (type === 'hidden') return <input type=\"hidden\" data-slot=\"input\" {...props} />\n\n  const numeric = type === 'number'\n  const { disabled, status } = inherit\n  const shown: FieldStatus = status !== 'default' ? status : aria['aria-invalid'] ? 'error' : 'default'\n  const { readOnly } = props\n\n  return (\n    <div\n      data-slot=\"input-group\"\n      data-status={shown !== 'default' ? shown : undefined}\n      data-disabled={disabled || undefined}\n      data-readonly={readOnly || undefined}\n      // forced states for the design-system gallery: the box carries the field styling\n      data-force={(props as { 'data-force'?: string })['data-force']}\n      data-active={(props as { 'data-active'?: string })['data-active']}\n      // the padding and the icons of the box are part of the field: a press on them focuses the input\n      onMouseDown={(e) => {\n        const hit = (e.target as Element).closest('input, button, a, [tabindex]')\n        if (disabled || (hit && e.currentTarget.contains(hit))) return\n        e.preventDefault()\n        e.currentTarget.querySelector('input')?.focus()\n      }}\n      className={cn(fieldBoxVariants({ size }), 'cursor-text data-[disabled]:cursor-not-allowed', className)}\n    >\n      {startIcon && <span className={cn('ds-field-icon', fieldIconClass[size], '[&>svg]:size-full')}>{startIcon}</span>}\n      {prefixText && (\n        <span data-slot=\"input-prefix\" className=\"shrink-0 select-none text-text-subtle [[data-disabled]_&]:text-disabled-foreground\">\n          {prefixText}\n        </span>\n      )}\n      <input\n        type={type}\n        data-slot=\"input\"\n        {...props}\n        {...aria}\n        // status=\"error\" on its own (no Field, no aria-invalid) still has to reach assistive technology\n        {...(aria['aria-invalid'] === undefined && shown === 'error' ? { 'aria-invalid': true } : null)}\n        disabled={disabled}\n        className={cn(\n          'ds-field-input cursor-[inherit] [text-align:inherit] selection:bg-primary selection:text-primary-foreground file:inline-flex file:border-0 file:bg-transparent file:text-sm file:font-medium',\n          numeric && 'tnum',\n         