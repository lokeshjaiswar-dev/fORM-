enter' : 'justify-start'\n  const name = typeof children === 'string' ? children : undefined\n  const infoGlyph = <Info aria-hidden className=\"size-4 shrink-0 text-information\" />\n  const extras = (\n    <>\n      {onSort && <SortIcon direction={sorted} />}\n      {info && (onSort ? infoGlyph : null)}\n      {badge !== undefined && badge !== '' && (\n        <span className=\"grid h-3.5 min-w-3.5 shrink-0 place-items-center rounded-full bg-information-faded px-1 text-xxs font-medium text-information\">{badge}</span>\n      )}\n      {pinned && <Pin role=\"img\" aria-label=\"Pinned\" className=\"size-4 shrink-0 text-text-muted\" />}\n    </>\n  )\n  // a sortable header cannot hold a second button: its tooltip opens from the sort button itself and the text is also read after the label\n  const sortButton = (\n    <button\n      type=\"button\"\n      onClick={onSort}\n      disabled={disabled}\n      className={cn(\n        'flex h-(--table-head-h) w-full cursor-pointer items-center gap-1 px-(--table-px) transition-colors disabled:pointer-events-none',\n        'hover:bg-state-hover hover:text-foreground',\n        'active:bg-surface-primary-subtle active:text-primary-text',\n        'focus-visible:bg-surface-primary-subtle focus-visible:text-primary-text ds-focus-inset',\n        justify,\n      )}\n    >\n      <span className=\"min-w-6 truncate\">{children}</span>\n      {extras}\n      {info && <span className=\"sr-only\">{`. ${info}`}</span>}\n    </button>\n  )\n  return (\n    <th\n      data-slot=\"table-head\"\n      aria-sort={onSort ? (sorted === 'asc' ? 'ascending' : sorted === 'desc' ? 'descending' : 'none') : undefined}\n      style={stickyStyle(stickyStart, style)}\n      className={cn(\n        'h-(--table-head-h) bg-surface-subtle px-(--table-px) align-middle text-(length:--table-head-fs) leading-(--table-lh) font-semibold whitespace-nowrap text-text-subtle [&:has([role=checkbox])]:px-(--table-px-check)',\n        disabled && 'text-disabled-foreground',\n        align === 'left' && 'text-left',\n        align === 'right' && 'text-right',\n        align === 'center' && 'text-center',\n        stickyStart !== undefined && stickyHead,\n        onSort && 'p-0',\n        className,\n      )}\n      {...props}\n    >\n      {onSort ? (\n        info ? (\n          <Tooltip>\n            <TooltipTrigger asChild>{sortButton}</TooltipTrigger>\n            <TooltipContent>{info}</TooltipContent>\n          </Tooltip>\n        ) : (\n          sortButton\n        )\n      ) : adorned ? (\n        <div className={cn('flex items-center gap-1', justify)}>\n          <span className=\"min-w-6 truncate\">{children}</span>\n          {info && (\n            <Tooltip>\n              <TooltipTrigger asChild>\n                <button type=\"button\" aria-label={`${name ? name + ': ' : ''}${info}`} className={cn('inline-flex shrink-0 rounded-xs ds-focus focus-visible:outline-offset-0', hitArea)}>\n                  {infoGlyph}\n                </button>\n              </TooltipTrigger>\n              <TooltipContent>{info}</TooltipContent>\n            </Tooltip>\n          )}\n          {extras}\n        </div>\n      ) : (\n        children\n      )}\n    </th>\n  )\n}\n\n/** A spanning group header above a set of columns (Figma: Header Group Cell). */\nfunction TableHeadGroup({ className, ...props }: React.ComponentProps<'th'>) {\n  return (\n    <th\n      data-slot=\"table-head-group\"\n      className={cn('h-8 border-b border-border-subtle bg-surface-subtle px-3 text-center align-middle text-sm font-semibold whitespace-nowrap text-foreground', className)}\n      {...props}\n    />\n  )\n}\n\nfunction TableCell({ className, stickyStart, style, ...props }: React.ComponentProps<'td'> & { /** see `TableHead` */ stickyStart?: number | string }) {\n  return (\n    <td\n      data-slot=\"table-cell\"\n      style={stickyStyle(stickyStart, style)}\n      className={cn(\n        'h-(--table-row-h) px-(--table-px) py-(--table-cell-py) align-middle text-(length:--table-fs) leading-(--table-lh) font-medium text-foreground [&:has([role=checkbox])]:px-(--table-px-check)',\n        stickyStart !== undefined && stickyCell,\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nfunction TableCaption({ className, ...props }: React.ComponentProps<'caption'>) {\n  return <caption data-slot=\"table-caption\" className={cn('mt-3 text-sm text-text-muted', className)} {...props} />\n}\n\ntype TableStateTone = 'neutral' | 'negative'\n\n/**\n * Empty, no-results and error panels for the table body (Figma: Table Empty / No Results / Error State, 200px, title Link M, text Regular S).\n * `tone=\"negative\"` is the error look: a red glyph (the alert circle unless `icon` says otherwise) and an alert role so it is announced when it replaces the rows.\n * `icon` adds a glyph above the title (any tone).\n */\nfunction TableState({\n  title, description, action, icon, tone = 'neutral', className, ...props\n}: Omit<React.ComponentProps<'div'>, 'title'> & { title: React.ReactNode; description?: React.ReactNode; action?: React.ReactNode; icon?: React.ReactNode; tone?: TableStateTone }) {\n  const glyph = icon ?? (tone === 'negative' ? <AlertCircle /> : null)\n  return (\n    <div\n      data-slot=\"table-state\"\n      data-tone={tone}\n      role={tone === 'negative' ? 'alert' : undefined}\n      className={cn('flex min-h-(--table-state-min-h) flex-col items-center justify-start gap-2 px-4 py-(--table-state-py) text-center', className)}\n      {...props}\n    >\n      {glyph && (\n        <span\n          aria-hidden\n          className={cn('mb-1 grid size-10 place-items-center rounded-full [&_svg]:size-5', tone === 'negative' ? 'bg-negative-faded text-negative' : 'bg-surface-subtle text-icon-muted')}\n        >\n          {glyph}\n        </span>\n      )}\n      <div className=\"text-base font-semibold text-foreground\">{title}</div>\n      {description && <div className=\"max-w-md text-sm text-text-subtle\">{description}</div>}\n      {action && <div className=\"pt-1\">{action}</div>}\n    </div>\n  )\n}\n\nexport { Table, TableHeader, TableBody, TableFooter, TableHead, TableHeadGroup, TableRow, TableCell, TableCaption, TableState, SortIcon }\nexport type { TableHeadProps, TableProps, TableStateTone }\n","import * as React from 'react'\n\nimport { cn } from '../lib/utils'\nimport { useFieldAria, useFieldInherit, type FieldSize, type FieldStatus } from './field'\n\nconst sizeClass: Record<FieldSize, string> = {\n  sm: 'rounded-md px-(--field-px-sm) text-(length:--field-fs-sm)',\n  md: 'rounded-lg px-(--field-px) text-(length:--field-fs)',\n  lg: 'rounded-lg px-(--field-px) text-(length:--field-fs)',\n  xl: 'rounded-lg px-(--field-px) text-(length:--field-fs-xl)',\n}\n\n/**\n * Multi-line field: the TextField box (8 radius, 1px border, same states), growing with its content up to about 24rem (`max-h-none` lifts the cap, `resize-y`\n * lets the user drag it taller). `rows` sets the height it starts at; `size` sets the type size and padding like `Input` (the height follows the content). Inside a `Field` it takes its `id`, `aria-describedby`, `aria-invalid`, `aria-required` and `disabled` from the field,\n * and the box takes the warning / success tone of the field's message. `status` draws the state with a border and a glyph in the corner; `status=\"error\"` also sets `aria-invalid`.\n */\nfunction Textarea({ className, size = 'md', status: statusProp, rows, style, ...props }: Omit<React.ComponentProps<'textarea'>, 'size'> & { size?: FieldSize; status?: FieldStatus }) {\n  const aria = useFieldAria(props)\n  const { disabled, status: inherited } = useFieldInherit({ id: props.id, disabled: props.disabled, status: statusProp })\n  const status: FieldStatus = inherited !== 'default' ? inherited : aria['aria-invalid'] ? 'error' : 'default'\n  return (\n    <textarea\n      data-slot=\"textarea\"\n      data-status={status !== 'default' ? status : undefined}\n      // `fie