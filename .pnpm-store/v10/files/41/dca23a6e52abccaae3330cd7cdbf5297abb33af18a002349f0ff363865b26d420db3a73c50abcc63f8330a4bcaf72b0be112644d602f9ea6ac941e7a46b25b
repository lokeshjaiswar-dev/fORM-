up/avatar relative flex shrink-0 overflow-hidden rounded-full', {\n  variants: {\n    size: {\n      xsmall: 'size-[18px]',\n      small: 'size-5',\n      medium: 'size-6',\n      large: 'size-8',\n      xlarge: 'size-10',\n      '2xlarge': 'size-12',\n    },\n  },\n  defaultVariants: { size: 'large' },\n})\n\n// initials text per size, measured from Figma: 18 and 20 use Medium XXS (10/14), 24 and 32 Medium XS (12/16), 40 Medium XL (18/26), 48 steps up to 24\nconst FALLBACK_TEXT =\n  'group-data-[size=xsmall]/avatar:text-xxs group-data-[size=small]/avatar:text-xxs group-data-[size=medium]/avatar:text-xs group-data-[size=large]/avatar:text-xs group-data-[size=xlarge]/avatar:text-xl group-data-[size=2xlarge]/avatar:text-2xl'\n\nconst TONE: Record<AvatarTone, string> = {\n  orange: 'bg-(--ds-av-orange-bg) text-(--ds-av-orange-fg)',\n  blue: 'bg-(--ds-av-blue-bg) text-(--ds-av-blue-fg)',\n  green: 'bg-(--ds-av-green-bg) text-(--ds-av-green-fg)',\n  red: 'bg-(--ds-av-red-bg) text-(--ds-av-red-fg)',\n  info: 'bg-(--ds-av-info-bg) text-(--ds-av-info-fg)',\n  neutral: 'bg-(--ds-av-neutral-bg) text-(--ds-av-neutral-fg)',\n}\nconst TONES = Object.keys(TONE) as AvatarTone[]\n\n/** Stable colour for a name, so the same person always gets the same initials colour. */\nfunction avatarToneFor(name: string): AvatarTone {\n  let h = 0\n  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0\n  return TONES[h % TONES.length]\n}\n\n/** Up to two initials from a display name. */\nfunction initialsOf(name: string) {\n  const parts = name.trim().split(/\\s+/).filter(Boolean)\n  if (parts.length === 0) return ''\n  return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase()\n}\n\n// clickable avatars: the shared focus ring (an outline: the box-shadow ring is taken by AvatarGroup's separator), a hover / press scrim over the picture\n// (a black overlay, so the tone keeps its identity in both themes, unlike a brightness filter that bleaches the disc to white in dark mode), the same\n// solid ring while a card is open, and they come to the front of a group while hovered, focused or open. Disabled uses the disabled tokens on the initials\n// disc and mutes a photo.\nconst INTERACTIVE =\n  'ds-focus cursor-pointer select-none outline-offset-2 hover:z-10 focus-visible:z-10 data-[state=open]:z-10 data-[state=open]:outline-2 data-[state=open]:outline-(--focus-ring) ' +\n  \"after:pointer-events-none after:absolute after:inset-0 after:rounded-full after:bg-black/0 after:transition-colors after:duration-(--dur-base) hover:after:bg-black/10 active:after:bg-black/20 \" +\n  // the neutral disc is dark in dark mode, where a black scrim vanishes: lighten it instead\n  'dark:has-[[data-tone=neutral]]:hover:after:bg-white/12 dark:has-[[data-tone=neutral]]:active:after:bg-white/20 ' +\n  'disabled:pointer-events-none disabled:after:hidden disabled:[&_[data-slot=avatar-fallback]]:bg-(--disabled-bg) disabled:[&_[data-slot=avatar-fallback]]:text-(--disabled-fg) disabled:[&_[data-slot=avatar-image]]:opacity-40 disabled:[&_[data-slot=avatar-image]]:grayscale'\n\nexport type AvatarProps = Omit<React.ComponentProps<typeof AvatarPrimitive.Root>, 'onClick'> & {\n  /** diameter from `xsmall` (18 px) to `2xlarge` (48 px), or the short names `xs` ... `2xl`. Inside an `AvatarGroup` it follows the group; otherwise `large` (32 px). */\n  size?: AvatarSize | AvatarSizeShort\n  /** render a `button` with hover, press and focus states. On by default when `onClick` is set. */\n  interactive?: boolean\n  onClick?: React.MouseEventHandler<HTMLElement>\n  /** interactive avatars only */\n  disabled?: boolean\n}\n\nfunction Avatar({ className, size, interactive, disabled, children, ...props }: AvatarProps) {\n  const inherited = React.useContext(SizeContext)\n  const s = avatarSizeName(size ?? inherited ?? 'large')\n  const clickable = !props.asChild && (interactive ?? props.onClick !== undefined)\n  const classes = cn(avatarVariants({ size: s }), clickable && INTERACTIVE, className)\n  if (!clickable) {\n    return (\n      <AvatarPrimitive.Root data-slot=\"avatar\" data-size={s} className={classes} {...props}>\n        {children}\n      </AvatarPrimitive.Root>\n    )\n  }\n  return (\n    <AvatarPrimitive.Root asChild data-slot=\"avatar\" data-size={s} data-interactive=\"\" className={classes} {...props}>\n      <button type=\"button\" disabled={disabled}>\n        {children}\n      </button>\n    </AvatarPrimitive.Root>\n  )\n}\n\nfunction AvatarImage({ className, ...props }: React.ComponentProps<typeof AvatarPrimitive.Image>) {\n  return <AvatarPrimitive.Image data-slot=\"avatar-image\" className={cn('aspect-square size-full object-cover', className)} {...props} />\n}\n\nfunction AvatarFallback({ className, tone = 'orange', ...props }: React.ComponentProps<typeof AvatarPrimitive.Fallback> & {\n  /** background and text colour of the initials. `avatarToneFor(name)` picks one per person. */\n  tone?: AvatarTone\n}) {\n  return (\n    <AvatarPrimitive.Fallback\n      data-slot=\"avatar-fallback\"\n      data-tone={tone}\n      className={cn('flex size-full items-center justify-center rounded-full leading-none font-medium uppercase', FALLBACK_TEXT, TONE[tone], className)}\n      {...props}\n    />\n  )\n}\n\n/** Icon avatar (Figma type=Icon): a person glyph on a neutral disc, or pass any icon as children. */\nfunction AvatarIcon({ className, children, ...props }: React.ComponentProps<typeof AvatarPrimitive.Fallback>) {\n  return (\n    <AvatarPrimitive.Fallback\n      delayMs={0}\n      data-slot=\"avatar-icon\"\n      data-tone=\"neutral\"\n      className={cn(\n        'flex size-full items-center justify-center rounded-full bg-(--ds-av-neutral-bg) text-(--ds-av-neutral-fg) [&_svg]:size-[58%]',\n        className,\n      )}\n      {...props}\n    >\n      {children ?? <User aria-hidden />}\n    </AvatarPrimitive.Fallback>\n  )\n}\n\n// overlap between neighbours in px, measured from the Figma avatar_group frames (4 visible members + the +N disc)\nconst OVERLAP: Record<AvatarSize, number> = { xsmall: 2, small: 4, medium: 5, large: 7, xlarge: 8, '2xlarge': 10 }\n// ring width between neighbours, from the Figma group frames: border_width small 1 (18), medium 1.5 (32), large 2 (40).\n// Every avatar but the last has its right edge covered by the next one (overlap + ring), so its initials are centred in the part that stays visible\n// (right padding equal to the covered width) instead of being shaved by the neighbour. Full class names, so Tailwind can see them.\nconst RING: Record<AvatarSize, string> = {\n  xsmall: '[&>*]:ring-1 [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+1px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+1px)]',\n  small: '[&>*]:ring-1 [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+1px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+1px)]',\n  medium: '[&>*]:ring-[1.5px] [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+1.5px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+1.5px)]',\n  large: '[&>*]:ring-[1.5px] [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+1.5px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+1.5px)]',\n  xlarge: '[&>*]:ring-2 [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+2px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+2px)]',\n  '2xlarge': '[&>*]:ring-2 [&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)+2px)] pointer-coarse:[&>*:not(:last-child)_[data-slot=avatar-fallback]]:pr-[calc(var(--av-overlap)/2+2px)]',\n}\n\nfunction AvatarGroup({\n  size: sizeProp = 'medium',\n  max,\n  tone = 'neutral',\n  moreLabel = (n) => `${n} more`,\n  className,\n  children,\n  ...props\n}: Omit<React.ComponentProps<'div'>, 'children'> & {\n  /** size given to every avatar in the group */\n  size?: AvatarSize | AvatarSizeShort\n  /** how many avatars to show; the rest collapse into a `+N` avatar */\n  max?: number\n  /** colour of the `+N` avatar (default `neutral`, so it does not read as another person) */\n  tone?: AvatarTone\n  /** accessible name of the `+N` avatar, given the number of hidden avatars. Default `\"3 more\"`; use it to translate. */\n  moreLabel?: (hidden: number) => string\n  /** the avatars */\n  children: React.ReactNode\n}) {\n  const size = avatarSizeName(sizeProp)\n  const items = React.Children.toArray(children)\n  const visible = max !== undefined && items.length > max ? items.slice(0, max) : items\n  const hidden = items.length - visible.length\n  return (\n    <SizeContext.Provider value={size}>\n      <div\n        data-slot=\"avatar-group\"\n        role=\"group\"\n        className={cn('inline-flex items-center [&>*]:ring-(--av-ring,var(--background)) [&>*+*]:-ml-[var(--av-overlap)] pointer-coarse:[&>*+*]:-ml-[calc(var(--av-overlap)/2)]', RING[size], className)}\n        style={{ '--av-overlap': `${OVERLAP[size]}px` } as React.CSSProperties}\n        {...props}\n      >\n        {visible}\n        {hidden > 0 && (\n          <Avatar size={size} role=\"img\" aria-label={moreLabel(hidden)}>\n            <AvatarFallback tone={tone} className=\"tnum normal-case\">\n              +{hidden}\n            </AvatarFallback>\n          </Avatar>\n        )}\n      </div>\n    </SizeContext.Provider>\n  )\n}\n\n/** A person as the interactive avatars take it. Only `name` is required; initials and colour come from it. */\nexport interface AvatarPerson {\n  /** React key in lists; the name is used when it is missing */\n  id?: string | number\n  name: string\n  /** picture URL; the initials show while it loads or if it fails */\n  src?: string\n  /** initials