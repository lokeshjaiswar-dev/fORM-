{"version":3,"file":"tone-DVxkvAdu.js","sources":["../../src/lib/utils.ts","../../src/components/alert.tsx","../../src/lib/nowrap-ids.tsx","../../src/hooks/use-scrollable.ts","../../src/components/loader.tsx","../../src/components/button.tsx","../../src/components/alert-dialog.tsx","../../src/components/popover.tsx","../../src/components/avatar.tsx","../../src/components/badge.tsx","../../src/lib/in-toaster.ts","../../src/components/breadcrumb.tsx","../../src/components/calendar.tsx","../../src/components/label.tsx","../../src/components/tooltip.tsx","../../src/components/field.tsx","../../src/components/checkbox.tsx","../../src/components/dialog.tsx","../../src/components/command.tsx","../../src/components/combobox.tsx","../../src/hooks/use-narrow-screen.ts","../../src/hooks/use-focus-into.ts","../../src/components/date-picker.tsx","../../src/components/dropdown-menu.tsx","../../src/components/skeleton.tsx","../../src/components/separator.tsx","../../src/components/progress.tsx","../../src/components/time-picker.tsx","../../src/components/input.tsx","../../src/lib/format.ts","../../src/components/multi-select.tsx","../../src/components/pagination.tsx","../../src/components/radio-group.tsx","../../src/components/select.tsx","../../src/components/sheet.tsx","../../src/hooks/use-mobile.ts","../../src/components/sidebar.tsx","../../src/components/switch.tsx","../../src/components/table.tsx","../../src/components/textarea.tsx","../../src/components/timeline.tsx","../../src/components/toggle.tsx","../../src/components/toggle-group.tsx","../../src/lib/tone.ts"],"sourcesContent":["import { clsx, type ClassValue } from 'clsx'\nimport { extendTailwindMerge } from 'tailwind-merge'\n\n// `text-xxs` (Figma Body XXS, now 11/14: 10px text failed legibility) is a font size we added to the theme. Without telling tailwind-merge, it reads `text-xxs` as a text colour and\n// drops the real colour class next to it (a count bubble lost its white text).\nconst twMerge = extendTailwindMerge({ extend: { classGroups: { 'font-size': [{ text: ['xxs'] }] } } })\n\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs))\n}\n","import * as React from 'react'\nimport { cva, type VariantProps } from 'class-variance-authority'\nimport { CircleAlert, CircleCheck, Info, TriangleAlert, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/** Figma Alert 2166:3834: colour = Primary | Success | Negative | Ideal | Neutral, variant = Intense (solid) | Subtle (tint). */\nexport type AlertTone = 'primary' | 'positive' | 'negative' | 'notice' | 'neutral'\nexport type AlertVariant = 'default' | 'destructive' | 'warning' | 'success' | 'info' | AlertTone\n\n/** The original shadcn variant names keep working and map onto the Figma tones. */\nconst TONE_OF: Record<AlertVariant, AlertTone> = {\n  default: 'neutral',\n  destructive: 'negative',\n  warning: 'notice',\n  success: 'positive',\n  info: 'primary',\n  primary: 'primary',\n  positive: 'positive',\n  negative: 'negative',\n  notice: 'notice',\n  neutral: 'neutral',\n}\n\nconst alertVariants = cva(\n  // --alert-line is the height of the first text line (title, or description when there is no title); the 16px icon is centred on it\n  'group/alert relative grid w-full grid-cols-[0_1fr] items-start gap-y-(--alert-gap) rounded-lg px-3 py-(--alert-py) text-sm [--alert-gap:0.25rem] [--alert-py:0.75rem] compact:[--alert-gap:0.125rem] compact:[--alert-py:0.5rem] [--alert-line:1.25rem] has-[[data-slot=alert-title]]:[--alert-line:1.5rem] compact:[--alert-line:1.125rem] compact:has-[[data-slot=alert-title]]:[--alert-line:1.25rem] has-[>svg]:grid-cols-[16px_1fr] has-[>svg]:gap-x-2 data-[closable=true]:pr-11 [&>svg]:mt-[calc((var(--alert-line)-1rem)/2)] [&>svg]:size-4 [&>svg]:shrink-0',\n  {\n    variants: {\n      tone: { primary: '', positive: '', negative: '', notice: '', neutral: '' },\n      emphasis: { subtle: '', intense: 'text-white [--focus-ring:var(--focus-ring-inverse)] [&>svg]:text-white' },\n    },\n    compoundVariants: [\n      { emphasis: 'intense', tone: 'primary', className: 'bg-ov-primary' },\n      { emphasis: 'intense', tone: 'positive', className: 'bg-ov-positive' },\n      { emphasis: 'intense', tone: 'negative', className: 'bg-ov-negative' },\n      { emphasis: 'intense', tone: 'notice', className: 'bg-ov-notice' },\n      { emphasis: 'intense', tone: 'neutral', className: 'bg-ov-neutral' },\n      { emphasis: 'subtle', tone: 'primary', className: 'ring-1 ring-inset ring-primary/25 bg-primary-faded text-foreground [&>svg]:text-primary-text' },\n      { emphasis: 'subtle', tone: 'positive', className: 'ring-1 ring-inset ring-positive/25 bg-positive-faded text-foreground [&>svg]:text-positive' },\n      { emphasis: 'subtle', tone: 'negative', className: 'ring-1 ring-inset ring-negative/25 bg-negative-faded text-foreground [&>svg]:text-negative' },\n      { emphasis: 'subtle', tone: 'notice', className: 'ring-1 ring-inset ring-notice/30 bg-notice-faded text-foreground [&>svg]:text-notice-text' },\n      { emphasis: 'subtle', tone: 'neutral', className: 'ring-1 ring-inset ring-border-control/40 bg-neutral-faded text-foreground [&>svg]:text-foreground' },\n    ],\n    defaultVariants: { tone: 'neutral', emphasis: 'subtle' },\n  },\n)\n\nconst TONE_ICON: Record<AlertTone, React.ReactNode> = {\n  primary: <Info aria-hidden />,\n  positive: <CircleCheck aria-hidden />,\n  negative: <CircleAlert aria-hidden />,\n  notice: <TriangleAlert aria-hidden />,\n  neutral: <Info aria-hidden />,\n}\n\ntype AlertProps = Omit<React.ComponentProps<'div'>, 'color'> &\n  Pick<VariantProps<typeof alertVariants>, 'emphasis'> & {\n    /** Tone. `default | destructive | warning | success | info` are the original names; the Figma names are `primary | positive | negative | notice | neutral`. */\n    variant?: AlertVariant\n    /** alias of `variant`, the name `Badge`, `Chip` and `ToastCard` use; wins over `variant` when both are set */\n    tone?: AlertVariant\n    /** The leading icon: `true` for the one that goes with the tone (info, tick, alert circle, triangle), or your own 16px svg. Without it you put the icon in `children` yourself. */\n    icon?: React.ReactNode\n    /** Shows the close X (top right) and calls this when it is pressed. */\n    onClose?: () => void\n    closeLabel?: string\n  }\n\n/**\n * Alert. Put an icon first (a 16px svg), then `AlertTitle`, `AlertDescription` and optionally `AlertActions`.\n * `emphasis=\"intense\"` is the solid Figma style; the default `subtle` is the tinted one used across the screens.\n */\nfunction Alert({ className, variant = 'default', tone: toneProp, icon, emphasis = 'subtle', onClose, closeLabel = 'Dismiss', children, ...props }: AlertProps) {\n  const tone = TONE_OF[toneProp ?? variant] ?? 'neutral'\n  // errors and warnings are announced at once; info, success and neutral messages are polite (a page full of static alerts must not interrupt a screen reader)\n  const role = tone === 'negative' || tone === 'notice' ? 'alert' : 'status'\n  return (\n    <div\n      data-slot=\"alert\"\n      role={role}\n      data-tone={tone}\n      data-emphasis={emphasis ?? 'subtle'}\n      data-closable={onClose ? 'true' : undefined}\n      className={cn(alertVariants({ tone, emphasis }), className)}\n      {...props}\n    >\n      {icon === true ? TONE_ICON[tone] : icon}\n      {children}\n      {onClose && (\n        <button\n          type=\"button\"\n          data-slot=\"alert-close\"\n          aria-label={closeLabel}\n          onClick={onClose}\n          className=\"absolute top-3 right-3 compact:top-1.5 grid size-6 place-items-center rounded-sm text-current opacity-80 transition-colors hover:bg-current/10 hover:opacity-100 group-data-[emphasis=subtle]/alert:text-text-subtle [&_svg]:size-4 ds-focus\"\n        >\n          <XIcon />\n        </button>\n      )}\n    </div>\n  )\n}\n\nfunction AlertTitle({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"alert-title\" className={cn('col-start-2 min-h-(--alert-line) text-base leading-(--alert-line) font-semibold compact:text-sm', className)} {...props} />\n}\n\nfunction AlertDescription({ className, ...props }: React.ComponentProps<'div'>) {\n  return (\n    <div\n      data-slot=\"alert-description\"\n      className={cn('col-start-2 grid justify-items-start gap-1 text-sm leading-5 compact:text-[0.8125rem] compact:leading-[1.125rem] group-data-[emphasis=subtle]/alert:text-text-subtle [&_a]:rounded-xs [&_a]:underline [&_a]:underline-offset-2 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-(--focus-ring) [&_a:focus-visible]:outline-solid', className)}\n      {...props}\n    />\n  )\n}\n\n/** Row of buttons under the description (Figma: outlined \"Button\" and a plain \"Button\"). */\nfunction AlertActions({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"alert-actions\" className={cn('col-start-2 mt-2 flex flex-wrap items-center gap-2', className)} {...props} />\n}\n\n/** Button sized and coloured for the alert tone: `outline` has a 1px border, `text` has none. */\nfunction AlertButton({ className, variant = 'outline', type = 'button', ...props }: React.ComponentProps<'button'> & { variant?: 'outline' | 'text' }) {\n  return (\n    <button\n      type={type}\n      data-slot=\"alert-button\"\n      className={cn(\n        // same height, radius and type as Button md (it follows density); disabled uses the shared disabled tokens, not opacity\n        'inline-flex h-(--ctl-h-md) items-center justify-center rounded-lg px-(--btn-px-md) text-(length:--btn-fs-md) font-medium whitespace-nowrap transition-colors duration-(--dur-base) disabled:pointer-events-none ds-focus',\n        'group-data-[emphasis=intense]/alert:text-white group-data-[emphasis=intense]/alert:hover:bg-white/12 group-data-[emphasis=intense]/alert:disabled:text-white/60',\n        'group-data-[emphasis=subtle]/alert:text-foreground group-data-[emphasis=subtle]/alert:hover:bg-black/5 dark:group-data-[emphasis=subtle]/alert:hover:bg-white/10 group-data-[emphasis=subtle]/alert:disabled:text-disabled-foreground',\n        variant === 'outline' &&\n          'border group-data-[emphasis=intense]/alert:border-white/50 group-data-[emphasis=intense]/alert:disabled:border-white/25 group-data-[emphasis=subtle]/alert:border-border-control group-data-[emphasis=subtle]/alert:disabled:border-disabled-border',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nexport { Alert, AlertTitle, AlertDescription, AlertActions, AlertButton, alertVariants }\n","import * as React from 'react'\n\n// a document or record id such as REQ-2026-0148 or INV-0042: capitals, then hyphenated groups\nconst ID = /\\b[A-Z]{2,}(?:-[A-Za-z0-9]+)+\\b/g\n\n/** Keeps ids like `REQ-2026-0148` in one piece when a plain-text title wraps (a line must not break at the hyphen). Anything but a string is returned as is. */\nexport function nowrapIds(children: React.ReactNode): React.ReactNode {\n  if (typeof children !== 'string') return children\n  const parts: React.ReactNode[] = []\n  let last = 0\n  for (const m of children.matchAll(ID)) {\n    if (m.index > last) parts.push(children.slice(last, m.index))\n    parts.push(\n      <span key={m.index} className=\"whitespace-nowrap\">\n        {m[0]}\n      </span>,\n    )\n    last = m.index + m[0].length\n  }\n  if (!parts.length) return children\n  if (last < children.length) parts.push(children.slice(last))\n  return parts\n}\n","import * as React from 'react'\n\n/**\n * Tells whether an element has more content than fits, so a scroll container can become a tab stop only when it really scrolls (WCAG 2.1.1: a pane that only\n * a mouse can scroll fails keyboard users, but an extra tab stop on every container that happens to fit is noise). Returns a ref callback (merged with\n * `external`, if you have one) and the flag. It re-measures when the element or its first child changes size.\n * With `{ unlessFocusable: true }` the flag stays false while the box holds something focusable (a form in a dialog body): that already lets the keyboard scroll it,\n * and an extra tab stop in front of the first field would also take the dialog's initial focus.\n */\nconst FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]):not([type=\"hidden\"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"]), [contenteditable=\"true\"]'\n\nexport function useScrollable<T extends HTMLElement>(external?: React.Ref<T>, { unlessFocusable = false }: { unlessFocusable?: boolean } = {}) {\n  const [scrollable, setScrollable] = React.useState(false)\n  const cleanup = React.useRef<(() => void) | null>(null)\n\n  const ref = React.useCallback(\n    (node: T | null) => {\n      cleanup.current?.()\n      cleanup.current = null\n      if (typeof external === 'function') external(node)\n      else if (external) (external as React.RefObject<T | null>).current = node\n      if (!node) return\n      const measure = () => setScrollable((node.scrollHeight > node.clientHeight + 1 || node.scrollWidth > node.clientWidth + 1) && !(unlessFocusable && node.querySelector(FOCUSABLE)))\n      measure()\n      if (typeof ResizeObserver === 'undefined') return\n      const ro = new ResizeObserver(measure)\n      ro.observe(node)\n      Array.from(node.children).forEach((c) => ro.observe(c))\n      cleanup.current = () => ro.disconnect()\n    },\n    [external, unlessFocusable],\n  )\n\n  return [ref, scrollable] as const\n}\n","import * as React from 'react'\nimport { cva, type VariantProps } from 'class-variance-authority'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Loader (Figma 2118:14843). `dots` is the four-dot Figma Loader (colours primary, neutral, error / negative, on primary = inverse) used inside a loading\n * Button, `spinner` is the ring, `pie` is the progress pie (`value` 0 to 100, Figma Loader 3) and `bar` is the indeterminate strip.\n */\nconst loaderVariants = cva('inline-flex shrink-0 items-center justify-center', {\n  variants: {\n    tone: {\n      primary: 'text-(--ds-indicator-primary)',\n      neutral: 'text-text-muted',\n      negative: 'text-negative',\n      inverse: 'text-white',\n      current: 'text-current',\n    },\n  },\n  defaultVariants: { tone: 'primary' },\n})\n\ntype LoaderSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl'\n\nconst SPINNER_PX: Record<LoaderSize, number> = { xs: 12, sm: 16, md: 24, lg: 32, xl: 48 }\nconst DOT_PX: Record<LoaderSize, number> = { xs: 3, sm: 4, md: 5, lg: 6, xl: 8 }\n\nexport interface LoaderProps extends Omit<React.ComponentProps<'span'>, 'children'>, VariantProps<typeof loaderVariants> {\n  variant?: 'spinner' | 'dots' | 'bar' | 'pie'\n  /** progress of the `pie` variant, 0 to 100 */\n  value?: number\n  size?: LoaderSize\n  /** what is loading, for screen readers: rendered as hidden text inside the `role=\"status\"` element (default \"Loading\"; for `pie` the name of the progress bar, default \"Progress\") */\n  label?: string\n}\n\nfunction Loader({ variant = 'spinner', size = 'md', tone, value = 0, label, className, style, ...props }: LoaderProps) {\n  const common = { role: 'status', 'data-slot': 'loader', 'data-variant': variant, 'data-size': size } as const\n  // a live region announces its text, not its aria-label, so the name is hidden text inside it\n  const text = <span className=\"sr-only\">{label ?? 'Loading'}</span>\n\n  if (variant === 'dots') {\n    const d = DOT_PX[size]\n    return (\n      <span {...common} className={cn(loaderVariants({ tone }), className)} style={{ gap: d, ...style }} {...props}>\n        {text}\n        {[0, 1, 2, 3].map((i) => (\n          <span key={i} aria-hidden className=\"ds-loader-dot\" style={{ width: d, height: d }} />\n        ))}\n      </span>\n    )\n  }\n\n  if (variant === 'pie') {\n    const px = SPINNER_PX[size]\n    const pct = Math.min(100, Math.max(0, value))\n    return (\n      <span\n        {...common}\n        role=\"progressbar\"\n        aria-label={label ?? 'Progress'}\n        aria-valuemin={0}\n        aria-valuemax={100}\n        aria-valuenow={Math.round(pct)}\n        aria-valuetext={`${Math.round(pct)}%`}\n        className={cn(loaderVariants({ tone }), 'rounded-full', className)}\n        style={{\n          width: px,\n          height: px,\n          background: `conic-gradient(currentColor ${pct * 3.6}deg, transparent 0)`,\n          boxShadow: 'inset 0 0 0 1.5px color-mix(in srgb, currentColor 26%, transparent)',\n          ...style,\n        }}\n        {...props}\n      />\n    )\n  }\n\n  if (variant === 'bar') {\n    return (\n      <span\n        {...common}\n        className={cn(loaderVariants({ tone }), 'relative block h-1 w-full overflow-hidden rounded-full bg-current/20', size === 'lg' || size === 'xl' ? 'h-1.5' : '', className)}\n        style={style}\n        {...props}\n      >\n        {text}\n        <span aria-hidden className=\"ds-loader-bar absolute inset-y-0 left-0 w-1/3 rounded-full bg-current\" />\n      </span>\n    )\n  }\n\n  const px = SPINNER_PX[size]\n  const stroke = size === 'xs' || size === 'sm' ? 3 : 2.5\n  return (\n    <span {...common} className={cn(loaderVariants({ tone }), className)} style={style} {...props}>\n      {text}\n      <svg aria-hidden viewBox=\"0 0 24 24\" width={px} height={px} fill=\"none\" className=\"ds-loader-spin\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" strokeOpacity={0.2} strokeWidth={stroke} />\n        <path d=\"M21 12a9 9 0 0 0-9-9\" stroke=\"currentColor\" strokeWidth={stroke} strokeLinecap=\"round\" />\n      </svg>\n    </span>\n  )\n}\n\n/** Centered loader with an optional caption, for page and panel loading states. */\nfunction PageLoader({ label, caption, size = 'lg', className }: { label?: string; caption?: React.ReactNode; size?: LoaderSize; className?: string }) {\n  return (\n    <div className={cn('flex min-h-40 flex-col items-center justify-center gap-3', className)}>\n      <Loader size={size} label={label} />\n      {caption && <p className=\"text-sm text-text-subtle\">{caption}</p>}\n    </div>\n  )\n}\n\nexport { Loader, PageLoader, loaderVariants }\n","import * as React from 'react'\nimport { Slot } from 'radix-ui'\nimport { cva } from 'class-variance-authority'\nimport { ChevronDown } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Loader } from './loader'\n\n/**\n * Button (Figma 564:1367, Button & Icon).\n * Figma axes: color (primary | neutral | negative | whiteOnPrimary) x variant (Primary | Secondary | Ghost) x size (xlarge 48, large 40,\n * medium 32, small 28, xsmall 24; compact density 36 / 32 / 28 / 24 / 24, see ds-density.css) x state (normal, hover, active, focus, disabled, loading) x iconOnly. The colour matrix lives in\n * src/styles/ds-atoms.css (classes ds-btn-<kind> ds-btn-<color>); this file owns structure, size and the old API mapping.\n *\n * Old variants map to: default -> Primary/primary, destructive -> Primary/negative, outline -> Secondary/neutral, secondary -> Secondary/primary,\n * ghost -> Ghost/neutral, link -> link/primary, success -> Primary/positive. Old sizes: default = medium, sm = small, xs = xsmall, lg = large,\n * icon = medium icon-only, icon-sm = small icon-only. New: xl, icon-xs, icon-lg, icon-xl and the Figma names (xlarge ... xsmall).\n */\nexport type ButtonVariant = 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' | 'link' | 'success'\nexport type ButtonColor = 'primary' | 'neutral' | 'negative' | 'positive' | 'whiteOnPrimary'\n/**\n * `default` `sm` `xs` `lg` `xl` are the size names to use; `icon`, `icon-sm` ... are the same steps with `iconOnly`.\n * `xlarge` `large` `medium` `small` `xsmall` are the Figma names, kept for old code.\n */\nexport type ButtonSize =\n  | 'default' | 'sm' | 'xs' | 'lg' | 'xl' | 'icon' | 'icon-sm' | 'icon-xs' | 'icon-lg' | 'icon-xl'\n  /** @deprecated Figma name: use `xl` */ | 'xlarge'\n  /** @deprecated Figma name: use `lg` */ | 'large'\n  /** @deprecated Figma name: use `default` */ | 'medium'\n  /** @deprecated Figma name: use `sm` */ | 'small'\n  /** @deprecated Figma name: use `xs` */ | 'xsmall'\n\ntype Kind = 'solid' | 'outline' | 'ghost' | 'link'\ntype Step = 'xl' | 'lg' | 'md' | 'sm' | 'xs'\n\nconst VARIANT_MAP: Record<ButtonVariant, { kind: Kind; color: ButtonColor }> = {\n  default: { kind: 'solid', color: 'primary' },\n  destructive: { kind: 'solid', color: 'negative' },\n  outline: { kind: 'outline', color: 'neutral' },\n  secondary: { kind: 'outline', color: 'primary' },\n  ghost: { kind: 'ghost', color: 'neutral' },\n  link: { kind: 'link', color: 'primary' },\n  success: { kind: 'solid', color: 'positive' },\n}\n\nconst SIZE_MAP: Record<ButtonSize, { step: Step; iconOnly: boolean }> = {\n  default: { step: 'md', iconOnly: false }, medium: { step: 'md', iconOnly: false },\n  sm: { step: 'sm', iconOnly: false }, small: { step: 'sm', iconOnly: false },\n  xs: { step: 'xs', iconOnly: false }, xsmall: { step: 'xs', iconOnly: false },\n  lg: { step: 'lg', iconOnly: false }, large: { step: 'lg', iconOnly: false },\n  xl: { step: 'xl', iconOnly: false }, xlarge: { step: 'xl', iconOnly: false },\n  icon: { step: 'md', iconOnly: true }, 'icon-sm': { step: 'sm', iconOnly: true }, 'icon-xs': { step: 'xs', iconOnly: true },\n  'icon-lg': { step: 'lg', iconOnly: true }, 'icon-xl': { step: 'xl', iconOnly: true },\n}\n\nconst buttonBase = cva(\n  'ds-btn relative inline-flex shrink-0 items-center justify-center border font-medium whitespace-nowrap select-none transition-[background-color,color,border-color,box-shadow] duration-(--dur-base) disabled:pointer-events-none aria-disabled:pointer-events-none data-[loading=true]:pointer-events-none [&_svg]:pointer-events-none [&_svg]:shrink-0',\n  {\n    variants: {\n      // heights, label size and padding come from the density variables (ds-density.css), so compact is a change of variables, not of classes\n      step: {\n        xl: \"h-(--ctl-h-xl) gap-1.5 rounded-lg px-4 text-lg [&_svg:not([class*='size-'])]:size-5\",\n        lg: \"h-(--ctl-h-lg) gap-1.5 rounded-lg px-4 text-base [&_svg:not([class*='size-'])]:size-4\",\n        md: \"h-(--ctl-h-md) gap-1.5 rounded-lg px-(--btn-px-md) text-(length:--btn-fs-md) leading-[18px] [&_svg:not([class*='size-'])]:size-4\",\n        sm: \"h-(--ctl-h-sm) gap-1.5 rounded-md px-(--btn-px-sm) text-(length:--btn-fs-sm) leading-4 [&_svg:not([class*='size-'])]:size-4\",\n        xs: \"h-(--ctl-h-xs) gap-1 rounded-sm px-(--btn-px-xs) text-(length:--btn-fs-xs) leading-4 [&_svg:not([class*='size-'])]:size-3.5\",\n      },\n      iconOnly: { true: 'px-0', false: '' },\n    },\n    compoundVariants: [\n      { step: 'xl', iconOnly: true, class: \"w-(--ctl-h-xl) [&_svg:not([class*='size-'])]:size-6\" },\n      { step: 'lg', iconOnly: true, class: \"w-(--ctl-h-lg) [&_svg:not([class*='size-'])]:size-5\" },\n      { step: 'md', iconOnly: true, class: \"w-(--ctl-h-md) [&_svg:not([class*='size-'])]:size-4\" },\n      { step: 'sm', iconOnly: true, class: \"w-(--ctl-h-sm) [&_svg:not([class*='size-'])]:size-4\" },\n      { step: 'xs', iconOnly: true, class: \"w-(--ctl-h-xs) [&_svg:not([class*='size-'])]:size-3.5\" },\n    ],\n    defaultVariants: { step: 'md', iconOnly: false },\n  },\n)\n\nexport interface ButtonStyleOptions {\n  variant?: ButtonVariant | null\n  size?: ButtonSize | null\n  /** Figma colour; overrides the colour implied by `variant` */\n  color?: ButtonColor | null\n  /** alias of `color`, the name `Badge` and `Chip` use; wins over `color` when both are set */\n  tone?: ButtonColor | null\n  /** square icon-only button; implied by the icon sizes */\n  iconOnly?: boolean | null\n  /** static outer ring (Figma outlineBox) */\n  ringed?: boolean | null\n  className?: string\n}\n\nfunction resolve({ variant, size, color: colorProp, tone, iconOnly }: ButtonStyleOptions) {\n  const color = tone ?? colorProp\n  cons