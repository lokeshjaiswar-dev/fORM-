bel}` : ''}`\n  const touch = React.useSyncExternalStore(subscribeHoverless, isHoverless, () => false)\n  if (touch) {\n    return (\n      <Popover>\n        <PopoverTrigger asChild>\n          <button type=\"button\" aria-label={name} className={infoButtonClass}>\n            <CircleHelp className=\"size-3.5\" />\n          </button>\n        </PopoverTrigger>\n        <PopoverContent align=\"end\" className=\"w-64 p-3 text-sm font-normal text-popover-foreground\">\n          {children}\n        </PopoverContent>\n      </Popover>\n    )\n  }\n  return (\n    <Tooltip>\n      <TooltipTrigger asChild>\n        <button type=\"button\" aria-label={name} className={infoButtonClass}>\n          <CircleHelp className=\"size-3.5\" />\n        </button>\n      </TooltipTrigger>\n      <TooltipContent>{children}</TooltipContent>\n    </Tooltip>\n  )\n}\n\nexport interface FieldProps {\n  label?: React.ReactNode\n  required?: boolean\n  /** shows \"Optional\" in the label row */\n  optional?: boolean\n  /** text of the (i) tooltip in the label row */\n  info?: React.ReactNode\n  /** action in the label row (link text, button) */\n  action?: React.ReactNode\n  hint?: React.ReactNode\n  /** keep the hint visible under an error / warning / success message (for format rules such as \"8 to 15 characters\"); by default the message replaces it */\n  persistHint?: boolean\n  error?: React.ReactNode\n  warning?: React.ReactNode\n  success?: React.ReactNode\n  /** counter at the right of the helper row. `unit` is what is counted, read out by screen readers (\"3 of 5 tags\"); defaults to \"characters\" */\n  counter?: { value: number; max?: number; unit?: string }\n  /** the control, or a function that receives its wiring (`id`, `describedBy`, `invalid`, `required`) */\n  children: React.ReactNode | ((control: FieldControlProps) => React.ReactNode)\n  className?: string\n  /** id of the control the label points at; made with `useId` when left out */\n  htmlFor?: string\n  /** greys the label and hint and disables the control inside: the library's `Input`, `Textarea`, `SelectTrigger`, `Combobox`, `MultiSelect`, `TagInput`, `DatePicker`, `DateRangePicker`, `TimePicker` and `Slider` read it from the field (a `disabled` they set themselves wins). A function child gets `control.disabled` (`controlAria` includes it); a plain element of your own is disabled only when its `id` is the field's */\n  disabled?: boolean\n  /** announce an error message to screen readers when it appears (`role=\"alert\"`, default true). Turn it off when something else already announces the errors, such as a `FormErrorSummary`. */\n  announceError?: boolean\n}\n\n/** Counter text tone: neutral, notice from 90 % of `max`, negative above it. */\nfunction counterTone(value: number, max: number | undefined, disabled?: boolean) {\n  if (disabled) return 'text-text-disabled'\n  if (max == null) return 'text-text-muted'\n  if (value > max) return 'text-negative'\n  if (value >= max * 0.9) return 'text-notice-text'\n  return 'text-text-muted'\n}\n\n/**\n * Label + control + helper row: Figma TextField anatomy (label row 18, 6 gap, control, 6 gap, helper row 16).\n * `error` / `warning` / `success` messages replace the hint and tint it (`persistHint` keeps the hint under them).\n * The wiring is plain React, no DOM patching. The message has an id and is tied to the control with `aria-describedby`, an error is announced when it\n * appears, `aria-invalid` / `aria-required` follow `error` / `required`, and the label has an id for controls that name themselves with `aria-labelledby`.\n * Where the control gets it from: the library's own controls (`Input`, `Textarea`, `TagInput`, `Select`, `Combobox`, `MultiSelect`, `DatePicker`, `DateRangePicker`, `TimePicker`, `Slider`) read the\n * field around them, wherever they sit inside it (including `disabled`, and for the text-like ones the warning / success tone); a single child whose `id` is the field's gets the props added; any other control 