turn\n        e.preventDefault()\n        inputRef.current?.focus()\n      }}\n      className={cn(fieldBoxVariants({ size }), 'cursor-text text-text-subtle', className)}\n    >\n      <SearchIcon aria-hidden className={cn('shrink-0 text-icon-muted [[data-disabled]_&]:text-icon-disabled', fieldIconClass[size])} />\n      <input\n        ref={setRef}\n        type=\"search\"\n        role=\"searchbox\"\n        value={text}\n        placeholder={placeholder}\n        onChange={(e) => {\n          onChange?.(e)\n          onValueChange?.(e.target.value)\n        }}\n        className=\"ds-field-input cursor-[inherit] text-foreground [&::-webkit-search-cancel-button]:hidden\"\n        {...props}\n      />\n      {text && onValueChange && !props.disabled && !props.readOnly && (\n        <button\n          type=\"button\"\n          aria-label=\"Clear search\"\n          onClick={() => {\n            onValueChange('')\n            inputRef.current?.focus()\n          }}\n          className={cn('inline-flex size-4 shrink-0 cursor-pointer items-center justify-center rounded-xs text-icon-muted hover:text-foreground ds-focus focus-visible:outline-offset-0', hitArea)}\n        >\n          <XIcon aria-hidden className=\"size-3.5\" />\n        </button>\n      )}\n    </div>\n  )\n}\n\nexport { Input, SearchInput }\n","// Display formatting used by the components: Indian digit grouping (lakh/crore), DD-MMM-YYYY dates, initials.\n\n/** ₹1,23,45,678 (no paise) */\nexport function inr(n: number | undefined | null): string {\n  const r = Math.round(Number(n ?? 0))\n  return (r < 0 ? '-' : '') + '₹' + Math.abs(r).toLocaleString('en-IN')\n}\n\n/** ₹1,23,45,678.50 (always 2 decimals) */\nexport function inr2(n: number | undefined | null): string {\n  const v = Number(n ?? 0)\n  return (v <= -0.005 ? '-' : '') + '₹' + Math.abs(v).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })\n}\n\n/** Compact: ₹4.79 Cr, ₹38.06 L, ₹12,500 */\nexport function inrShort(n: number | undefined | null): string {\n  const v = Number(n ?? 0)\n  const a = Math.abs(v)\n  const s = v < 0 ? '-' : ''\n  if (a >= 1e7) return `${s}₹${(a / 1e7).toFixed(2)} Cr`\n  if (a >= 1e5) return `${s}₹${(a / 1e5).toFixed(2)} L`\n  return `${s}₹${Math.round(a).toLocaleString('en-IN')}`\n}\n\nexport const num = (n: number | undefined | null) => Number(n ?? 0).toLocaleString('en-IN')\nexport const pct = (n: number | undefined | null, d = 1) => `${Number(n ?? 0).toFixed(d)}%`\n\nconst MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n\n/** '2026-10-24' -> '24-Oct-2026' */\nexport function fmtDate(d?: string | null): string {\n  if (!d) return '—'\n  const [y, m, day] = d.slice(0, 10).split('-').map(Number)\n  if (!y || !m || !day) return d\n  return `${String(day).padStart(2, '0')}-${MON[m - 1]}-${y}`\n}\n\n/** '2026-10-24T09:47' -> '24-Oct-2026 09:47' (the clock part is read as written) */\nexport function fmtDateTime(iso?: string | null): string {\n  if (!iso) return '—'\n  const t = iso.length > 10 ? iso.slice(11, 16) : ''\n  return fmtDate(iso) + (t ? ' ' + t : '')\n}\n\n/** 'Sneha Kulkarni' -> 'SK' */\nexport const initials = (name: string) =>\n  name\n    .split(/\\s+/)\n    .filter(Boolean)\n    .slice(0, 2)\n    .map((s) => s[0]?.toUpperCase())\n    .join('')\n","import * as React from 'react'\nimport { ChevronDownIcon, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { OptionList, LoadMoreRow, optionText, type ComboboxOption } from './combobox'\nimport { Popover, PopoverContent, PopoverTrigger } from './popover'\nimport { Tooltip, TooltipContent, TooltipTrigger } from './tooltip'\nimport { fieldBoxVariants, fieldIconClass, hitArea, StatusIcon, useControllableState, useFieldAria, useFieldControl, useFieldInherit, type FieldSize, type FieldStatus } from './field'\n\n/**\n * Value chip inside a field (Figma: Select Trigger, Chip Row). `disabled` greys it with the disabled recipe and drops the remove button.\n * The remove button is for pointer users and is hidden from assistive technology (a button inside a `role=\"combobox\"` is not valid ARIA): keyboard and screen reader users\n * untick the option in the list, or press Backspace on the field to remove the last chip (Ctrl/Cmd+Backspace clears all when `clearable`).\n */\nfunction ValueChip({ children, onRemove, disabled, className }: { children: React.ReactNode; onRemove?: () => void; disabled?: boolean; className?: string }) {\n  return (\n    <span\n      data-slot=\"value-chip\"\n      data-disabled={disabled || undefined}\n      className={cn(\n        'inline-flex h-[var(--field-chip-h,1.5rem)] min-w-0 max-w-full shrink items-center gap-1 rounded-full border border-border bg-surface-subtle pr-1 pl-2 text-xs font-medium text-foreground data-[disabled]:border-disabled-border data-[disabled]:bg-disabled data-[disabled]:text-disabled-foreground',\n        (!onRemove || disabled) && 'pr-2',\n        className,\n      )}\n    >\n      <span className=\"truncate\">{children}</span>\n      {onRemove && !disabled && (\n        <button\n          type=\"button\"\n          tabIndex={-1}\n          aria-hidden\n          aria-label={`Remove ${typeof children === 'string' ? children : 'item'}`}\n          onClick={(e) => {\n            e.stopPropagation()\n            onRemove()\n          }}\n          className={cn('inline-flex size-4 shrink-0 cursor-pointer items-center justify-center rounded-xs text-icon-muted hover:bg-[var(--option-hover)] hover:text-foreground ds-focus focus-visible:outline-offset-0', hitArea)}\n        >\n          <XIcon aria-hidden className=\"size-3.5\" />\n        </button>\n      )}\n    </span>\n  )\n}\n\nexport interface MultiSelectProps {\n  options: ComboboxOption[]\n  value?: string[]\n  defaultValue?: string[]\n  onValueChange?: (value: string[]) => void\n  placeholder?: string\n  searchPlaceholder?: string\n  emptyText?: string\n  loading?: boolean\n  /** chips shown before the \"+N\" overflow chip; the field never grows (default 2) */\n  maxVisible?: number\n  size?: FieldSize\n  status?: FieldStatus\n  disabled?: boolean\n  readOnly?: boolean\n  /** x button that clears every picked value (default false) */\n  clearable?: boolean\n  /** shows a \"load more\" row at the end of the menu */\n  onLoadMore?: () => void\n  /** id of the field element. Inside a `Field` it defaults to the field's id. */\n  id?: string\n  className?: string\n  contentClassName?: string\n  align?: 'start' | 'center' | 'end'\n  /** marks the field invalid and draws the error state. Inside a `Field` it follows the field's `error`. */\n  'aria-invalid'?: boolean | 'true' | 'false'\n  /** accessible name when there is no visible label */\n  'aria-label'?: string\n  /** id of the element that names the field. The field is a `div` with `role=\"combobox\"`, which a `<label for>` cannot name, so inside a `Field` it defaults to the field's label. */\n  'aria-labelledby'?: string\n  /** id of the hint or error text. Inside a `Field` it is set to the field's message. */\n  'aria-describedby'?: string\n  /** tells assistive technology an answer is required. Inside a `Field` it follows `required`. */\n  'aria-required'?: boolean | 'true' | 'false'\n}\n\n/** Multi-select with chips (Figma: Select Trigger, Chip Row + Dropdown Menu with checkbox rows). Value is an array of option values. */\nfunction MultiSelect({\n  options,\n  value: valueProp,\n  defaultValue,\n  onValueChange,\n  placeholder = 'Select...',\n  searchPlaceholder = 'Search...',\n  emptyText = 'No options found',\n  loading,\n  maxVisible = 2,\n  size = 'md',\n  status: statusProp,\n  disabled: disabledProp,\n  readOnly,\n  clearable,\n  onLoadMore,\n  id,\n  className,\n  contentClassName,\n  align = 'start',\n  ...aria\n}: MultiSelectProps) {\n  const wired = useFieldAria({ id, ...aria }, { labelable: false })\n  const { disabled, status } = useFieldInherit({ id, disabled: disabledProp, status: statusP