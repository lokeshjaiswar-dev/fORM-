crollable } from '../hooks/use-scrollable'\nimport { footerButtonClass } from './button'\n\n/**\n * Modal. Figma Modal page 3334:1173: a card with a 56px header (title + close X, divider), a scrollable body and a 56px footer\n * (divider, a text \"Secondary\" button and a filled \"Primary\" button, both the default Button size (see footerButtonClass); `Back` can sit at the start with `className=\"mr-auto\"`).\n * Sizes: `default` (512px, the original), `sm` (Figma Small, 400), `md` (Figma Medium, 780) and `lg` (Figma Large, 780 wide and taller).\n *\n * Usage is unchanged: `<DialogContent><DialogHeader>...</DialogHeader> body ... <DialogFooter>...</DialogFooter></DialogContent>`.\n * When a `DialogHeader` or `DialogFooter` is a direct child, the header and footer stay pinned and everything else scrolls in the body.\n */\ntype DialogSize = 'default' | 'sm' | 'md' | 'lg'\n\nconst SIZE_FIXED: Record<DialogSize, string> = {\n  default: 'sm:max-w-lg',\n  sm: 'sm:max-w-[400px]',\n  md: 'sm:max-w-[780px]',\n  lg: 'sm:max-w-[780px] sm:min-h-[min(602px,calc(100dvh-2rem))]',\n}\n\nconst SIZE_STATIC: Record<DialogSize, string> = {\n  default: 'max-w-lg',\n  sm: 'max-w-[400px]',\n  md: 'max-w-[780px]',\n  lg: 'max-w-[780px] min-h-[min(602px,calc(100dvh-2rem))]',\n}\n\nconst surface = 'flex flex-col overflow-hidden rounded-lg border border-modal-border bg-card p-0 text-card-foreground shadow-lg'\nconst closeButton =\n  'absolute top-3.5 right-3 grid size-7 place-items-center rounded-sm text-text-subtle opacity-90 transition-colors hover:bg-accent hover:text-foreground hover:opacity-100 disabled:pointer-events-none disabled:text-(--disabled-fg) disabled:opacity-100 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=size-])]:size-4 ds-focus'\n\nconst titleClass = 'text-lg leading-6 font-bold text-foreground'\n\nfunction Dialog(props: React.ComponentProps<typeof DialogPrimitive.Root>) {\n  return <DialogPrimitive.Root data-slot=\"dialog\" {...props} />\n}\n\nfunction DialogTrigger(props: React.ComponentProps<typeof DialogPrimitive.Trigger>) {\n  return <DialogPrimitive.Trigger data-slot=\"dialog-trigger\" {...props} />\n}\n\nfunction DialogPortal(props: React.ComponentProps<typeof DialogPrimitive.Portal>) {\n  return <DialogPrimitive.Portal data-slot=\"dialog-portal\" {...props} />\n}\n\nfunction DialogClose(props: React.ComponentProps<typeof DialogPrimitive.Close>) {\n  return <DialogPrimitive.Close data-slot=\"dialog-close\" {...props} />\n}\n\nfunction DialogOverlay({ className, ...props }: React.ComponentProps<typeof DialogPrimitive.Overlay>) {\n  return (\n    <DialogPrimitive.Overlay\n      data-slot=\"dialog-overlay\"\n      className={cn(\n        'fixed inset-0 z-(--z-overlay) bg-scrim data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nfunction DialogContent({\n  className,\n  children,\n  showCloseButton = true,\n  size = 'default',\n  dismissible = true,\n  onOpenAutoFocus,\n  onCloseAutoFocus,\n  onEscapeKeyDown,\n  onPointerDownOutside,\n  onInteractOutside,\n  ...props\n}: React.ComponentProps<typeof DialogPrimitive.Content> & {\n  showCloseButton?: boolean\n  size?: DialogSize\n  /** `false` while a request is running: Escape and a click outside are ignored and the close X is disabled, so nothing looks like it should work and does not. */\n  dismissible?: boolean\n}) {\n  // A dialog opened from state rather than from a `DialogTrigger` has no trigger to hand focus back to, so remember whatever had focus when it opened.\n  const opener = React.useRef<HTMLElement | null>(null)\n  const nodes = React.Children.toArray(children)\n  const isType = (node: React.ReactNode, type: unknown) => React.isValidElement(node) && node.type === type\n  const headers = nodes.filter((n) => isType(n, DialogHeader))\n  const footers = nodes.filter((n) => isType(n, DialogFooter))\n  const body = nodes.filter((n) => !isType(n, DialogHeader) && !isType(n, DialogFooter))\n  // With a header or footer as a direct child the body scrolls between them; without, children render as they are (command palette, custom layouts).\n  const structured = headers.length > 0 || footers.length > 0\n  return (\n    <DialogPortal>\n      <DialogOverlay />\n      <DialogPrimitive.Content\n        data-slot=\"dialog-content\"\n        data-size={size}\n        className={cn(\n          surface,\n          'fixed top-[50%] left-[50%] z-(--z-overlay) max-h-[calc(100dvh-2rem)] w-full max-w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] duration-(--dur-moderate) outline-none data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95',\n          SIZE_FIXED[size],\n          className,\n        )}\n        {...props}\n        onEscapeKeyDown={(event) => {\n          onEscapeKeyDown?.(event)\n          if (!dismissible) event.preventDefault()\n        }}\n        onPointerDownOutside={(event) => {\n          onPointerDownOutside?.(event)\n          if (!dismissible || inToaster(event.target)) event.preventDefault()\n        }}\n        onInteractOutside={(event) => {\n          onInteractOutside?.(event)\n          if (!dismissible || inToaster(event.target)) event.preventDefault()\n        }}\n        onOpenAutoFocus={(event) => {\n          opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n          onOpenAutoFocus?.(event)\n        }}\n        onCloseAutoFocus={(event) => {\n          onCloseAutoFocus?.(event)\n          const target = opener.current\n          if (event.defaultPrevented || !target || target === document.body || !target.isConnected) return\n          event.preventDefault()\n          target.focus()\n        }}\n      >\n        {structured ? (\n          <>\n            {headers}\n            {body.length > 0 && (body.length === 1 && isType(body[0], DialogBody) ? body[0] : <DialogBody>{body}</DialogBody>)}\n            {footers}\n          </>\n        ) : (\n          children\n        )}\n        {showCloseButton && (\n          <DialogPrimitive.Close data-slot=\"dialog-close\" className={closeButton} disabled={!dismissible}>\n            <XIcon />\n            <span className=\"sr-only\">Close</span>\n          </DialogPrimitive.Close>\n        )}\n      </DialogPrimitive.Content>\n    </DialogPortal>\n  )\n}\n\nfunction DialogHeader({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"dialog-header\" className={cn('flex min-h-14 shrink-0 flex-col justify-center gap-0.5 border-b px-4 py-4 pr-14 text-left', className)} {...props} />\n}\n\n/** Scrollable middle of the modal. Added for you around loose children; use it directly to control the padding. */\nfunction DialogBody({ className, ref, ...props }: React.ComponentProps<'div'>) {\n  // a body that scrolls is a tab stop, so the arrow keys scroll it for someone without a mouse\n  const [scrollRef, scrollable] = useScrollable<HTMLDivElement>(ref, { unlessFocusable: true })\n  return <div ref={scrollRef} data-slot=\"dialog-body\" tabIndex={scrollable ? 0 : undefined} className={cn('grid min-h-0 flex-1 content-start gap-4 overflow-y-auto p-4 ds-focus-inset', className)} {...props} />\n}\n\n/**\n * Under 640px the footer stacks. `stack=\"reverse\"` (default) puts the first child last, which is right for a Cancel / Primary pair (the primary action ends up on top);\n * `stack=\"normal\"` keeps source order for footers that hold status text, a counter or a Back button.\n */\nfunction DialogFooter({ className, stack = 'reverse', ...props }: React.ComponentProps<'div'> & { stack?: 'reverse' | 'normal' }) {\n  return (\n    <div\n      data-slot=\"dialog-footer\"\n      className={cn(footerButtonClass, 'flex min-h-14 shrink-0 gap-2 border-t px-4 py-3 sm:flex-row sm:items-center sm:justify-end', stack === 'normal' ? 'flex-col' : 'flex-col-reverse', className)}\n      {...props}\n    />\n  )\n}\n\nfunction DialogTitle({ className, children, ...props }: React.ComponentProps<typeof DialogPrimitive.Title>) {\n  return (\n    <DialogPrimitive.Title data-slot=\"dialog-title\" className={cn(titleClass, 'text-balance', className)} {...props}>\n      {nowrapIds(children)}\n    </DialogPrimitive.Title>\n  )\n}\n\nfunction DialogDescription({ className, ...props }: React.ComponentProps<typeof DialogPrimitive.Description>) {\n  return <DialogPrimitive.Description data-slot=\"dialog-description\" className={cn('text-sm text-muted-foreground', className)} {...props} />\n}\n\n/**\n * Non-interactive copy of the modal, in the page flow, for the design-system gallery and for previews.\n * (A real dialog needs Radix state and a portal; use `Dialog` for that.)\n */\nfunction ModalPanel({\n  size = 'default',\n  title,\n  onClose,\n  footer,\n  children,\n  className,\n}: {\n  size?: DialogSize\n  title: React.ReactNode\n  /** Shows the close X when given. */\n  onClose?: () => void\n  footer?: React.ReactNode\n  children?: React.ReactNode\n  className?: string\n}) {\n  return (\n    <div data-slot=\"modal-panel\" data-size={size} className={cn(surface, 'relative w-full', SIZE_STATIC[size], className)}>\n      <DialogHeader>\n        <h2 className={titleClass}>{title}</h2>\n      </DialogHeader>\n      {onClose && (\n        <button type=\"button\" aria-label=\"Close\" onClick={onClose} className={closeButton}>\n          <XIcon />\n        </button>\n      )}\n      <DialogBody>{children}</DialogBody>\n      {footer && <DialogFooter>{footer}</DialogFooter>}\n    </div>\n  )\n}\n\nexport { Dialog, DialogBody, DialogClose, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogOverlay, DialogPortal, DialogTitle, DialogTrigger, ModalPanel }\nexport type { DialogSize }\n","import * as React from 'react'\nimport { Command as CommandPrimitive, useCommandState } from 'cmdk'\nimport { RefreshCw, SearchIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Dialog, DialogContent, DialogDescription, DialogTitle } from './dialog'\n\nfunction Command({ className, ...props }: React.ComponentProps<typeof CommandPrimitive>) {\n  return (\n    <CommandPrimitive\n      data-slot=\"command\"\n      className={cn('flex h-full w-full flex-col overflow-hidden rounded-lg bg-popover text-popover-foreground', className)}\n      {...props}\n    />\n  )\n}\n\n/**\n * Command palette in a modal. The input is pinned near the top of the window (15% down) and the list grows and shrinks below it, so the field does\n * not move while the results change. The title and description are read by screen readers only.\n */\nfunction CommandDialog({\n  title = 'Command Palette',\n  description = 'Search for a command to run...',\n  children,\n  ...props\n}: React.ComponentProps<typeof Dialog> & { title?: string; description?: string }) {\n  return (\n    <Dialog {...props}>\n      <DialogContent\n        showCloseButton={false}\n        className=\"top-[max(1rem,15dvh)] max-h-[calc(100dvh-max(1rem,15dvh)-1rem)] translate-y-0 overflow-hidden p-0 sm:max-w-xl [&_[cmdk-list]]:min-h-[min(12rem,40dvh)]\"\n      >\n        <DialogTitle className=\"sr-only\">{title}</DialogTitle>\n        <DialogDescription className=\"sr-only\">{description}</DialogDescription>\n        <Command className=\"rounded-none\">{children}</Command>\n      </DialogContent>\n    </Dialog>\n  )\n}\n\n/**\n * Search row. `variant=\"menu\"` is the Figma \"Menu Search Row\" at the top of a dropdown (28 high, divider below);\n * the default is the roomier row of the command palette.\n */\nfunction CommandInput({ className, variant = 'palette', ...props }: React.ComponentProps<typeof CommandPrimitive.Input> & { variant?: 'palette' | 'menu' }) {\n  const menu = variant === 'menu'\n  return (\n    <div data-slot=\"command-input-wrapper\" className={cn(menu ? 'ds-menu-search' : 'flex h-11 items-center gap-2 border-b px-3', 'has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-(--focus-ring)')}>\n      <SearchIcon className={cn('shrink-0 text-icon-muted', menu ? 'size-4' : 'size-4')} />\n      <CommandPrimitive.Input\n        data-slot=\"command-input\"\n        className={cn(\n          'flex w-full bg-transparent text-(length:--field-fs) font-medium outline-hidden placeholder:text-text-muted disabled:cursor-not-allowed disabled:opacity-50',\n          menu ? 'h-(--menu-search-h,1.75rem)' : 'h-10 py-3',\n          className,\n        )}\n        {...props}\n      />\n    </div>\n  )\n}\n\n/** The rows, with the 4px inset of a menu (none when the list already sits inside a `ds-menu` panel, as in `Combobox`). */\nfunction CommandList({ className, ...props }: React.ComponentProps<typeof CommandPrimitive.List>) {\n  return <CommandPrimitive.List data-slot=\"command-list\" className={cn('ds-scroll max-h-[320px] scroll-py-1 overflow-x-hidden overflow-y-auto p-1 [.ds-menu_&]:p-0 [&_[cmdk-group]:not([hidden])~[cmdk-group]]:mt-1', className)} {...props} />\n}\n\n/** \"No options found\" row. */\nfunction CommandEmpty({ className, ...props }: React.ComponentProps<typeof CommandPrimitive.Empty>) {\n  return <CommandPrimitive.Empty data-slot=\"command-empty\" className={cn('px-3 py-6 text-center text-xs text-[color:var(--field-meta)]', className)} {...props} />\n}\n\n/** \"Loading options...\" row (Figma: Dropdown Menu loading). */\nfunction CommandLoading({ className, children = 'Loading options...', ...props }: React.ComponentProps<typeof CommandPrimitive.Loading>) {\n  return (\n    <CommandPrimitive.Loading data-slot=\"command-loading\" {...props}>\n      <div className={cn('flex items-center justify-center gap-2 px-3 py-6 text-xs text-[color:var(--field-meta)]', className)}>\n        <RefreshCw aria-hidden className=\"size-4 animate-spin text-icon-muted\" />\n        {children}\n      </div>\n    </CommandPrimitive.Loading>\n  )\n}\n\nfunction CommandGroup({ className, ...props }: React.ComponentProps<typeof CommandPrimitive.Group>) {\n  return (\n    <CommandPrimitive.Group\n      data-slot=\"command-group\"\n      className={cn(\n        'overflow-hidden text-foreground [&_[cmdk-group-heading]]:flex [&_[cmdk-group-heading]]:h-(--option-group-h,1.75rem) [&_[cmdk-group-heading]]:items-center [&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:text-xs [&_[cmdk-group-heading]]:font-normal [&_[cmdk-group-heading]]:tracking-wide [&_[cmdk-group-heading]]:text-[color:var(--field-meta)] [&_[cmdk-group-heading]]:uppercase',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\n/**\n * Divider between groups. Shown while the search box is empty (cmdk hides its own separator while filtering, so do we) or always with `alwaysRender`.\n * cmdk's own `Separator` is not used: it forces `role=\"separator\"`, which is not allowed inside the listbox, so this is a hidden, presentational line.\n */\nfunction CommandSeparator({ className, alwaysRender, ...props }: React.ComponentProps<'div'> & { alwaysRender?: boolean }) {\n  const searching = useCommandState((state) => !!state.search)\n  if (searching && !alwaysRender) return null\n  return <div aria-hidden data-slot=\"command-separator\" className={cn('ds-menu-divider', className)} {...props} />\n}\n\nfunction CommandItem({ className, ...props }: React.ComponentProps<typeof CommandPrimitive.Item>) {\n  return (\n    <CommandPrimitive.Item\n      data-slot=\"command-item\"\n      className={cn('ds-option [&_svg:not([class*=\"size-\"])]:size-4 [&_svg:not([class*=\"text-\"])]:text-icon-muted', className)}\n      {...props}\n    />\n  )\n}\n\nfunction CommandShortcut({ className, ...props }: React.ComponentProps<'span'>) {\n  return <span data-slot=\"command-shortcut\" className={cn('ds-menu-shortcut', className)} {...props} />\n}\n\nexport { Command, CommandDialog, CommandInput, CommandList, CommandEmpty, CommandLoading, CommandGroup, CommandItem, CommandShortcut, CommandSeparator }\n","import * as React from 'react'\nimport { CheckIcon, ChevronDownIcon, RefreshCw, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Command, CommandEmpty, CommandGroup, CommandInput, CommandItem, CommandList, CommandLoading } from './command'\nimport { Popover, PopoverAnchor, PopoverContent, PopoverTrigger } from './popover'\nimport { fieldBoxVariants, fieldIconClass, hitArea, StatusIcon, useControllableState, useFieldAria, useFieldControl, useFieldInherit, type FieldSize, type FieldStatus } from './field'\n\nexport interface ComboboxOption {\n  value: string\n  label: React.ReactNode\n  /** plain text used for searching and for chips when `label` is not a string */\n  text?: string\n  /** supporting line under the label */\n  description?: React.ReactNode\n  icon?: React.ReactNode\n  /** initials shown in a small avatar before the label */\n  avatar?: string\n  /** text at the right of the row */\n  trailing?: React.ReactNode\n  disabled?: boolean\n  /** options with the same group are listed under a group label */\n  group?: string\n}\n\nexport const optionText = (o: ComboboxOption) => o.text ?? (typeof o.label === 'string' ? o.label : o.value)\n\n/** Round avatar with initials (Figma: Avatar, light peach). */\nexport function OptionAvatar({ initials, className }: { initials: string; className?: string }) {\n  return (\n    <span aria-hidden data-slot=\"option-avatar\" className={cn('inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[#ffdcb9] text-xxs font-medium text-black', className)}>\n      {initials}\n    </span>\n  )\n}\n\n/** Row content shared by Combobox and MultiSelect: avatar / icon, label with optional description, trailing text, tick or checkbox. */\nfunction OptionContent({ option, selected, checkbox }: { option: ComboboxOption; selected: boolean; checkbox?: boolean }) {\n  return (\n    <>\n      {checkbox && (\n        <span aria-hidden data-state={selected ? 'checked' : 'unchecked'} className=\"ds-check pointer-events-none inline-flex size-4 shrink-0 items-center justify-center\">\n          <span className=\"ds-check-box\">{selected && <CheckIcon className=\"text-current\" strokeWidth={3.5} />}</span>\n        </span>\n      )}\n      {option.avatar && <OptionAvatar initials={option.avatar} />}\n      {option.icon && <span className=\"inline-flex shrink-0 text-icon-muted [&>svg]:size-4\">{option.icon}</span>}\n      <span className=\"flex min-w-0 flex-1 flex-col\">\n        <span className=\"truncate\">{option.label}</span>\n        {option.description && <span className=\"truncate text-xs font-normal text-text-subtle\">{option.description}</span>}\n      </span>\n      {option.trailing && <span className=\"shrink-0 text-xs font-normal text-text-subtle\">{option.trailing}</span>}\n      {!checkbox && (\n        <span className=\"ds-option-check\">{selected && <CheckIcon className=\"size-4 text-primary-text\" />}</span>\n      )}\n    </>\n  )\n}\n\n/** \"Load more\" row at the end of a long menu (Figma: Menu Load More Row, 32 high). */\nexport function LoadMoreRow({ onClick, loading }: { onClick: () => void; /** fetching: the row shows a spinner, is disabled (no double fire) and the list above it stays in place */ loading?: boolean }) {\n  return (\n    <button\n      type=\"button\"\n      onClick={() => {\n        // aria-disabled (not native disabled) so a keyboard user's focus stays on the row while it loads\n        if (!loading) onClick()\n      }}\n      onKeyDown={(e) => {\n        // the footer sits inside <Command>, whose root handler turns Enter into \"pick the highlighted option\" and cancels this click\n        if (e.key === 'Enter') e.stopPropagation()\n      }}\n      aria-disabled={loading || undefined}\n      aria-busy={loading || undefined}\n      className=\"mt-1 flex h-8 w-full items-center justify-center gap-2 rounded-sm border-t border-border text-xs font-semibold text-primary-text hover:bg-primary-faded aria-disabled:cursor-progress aria-disabled:text-text-subtle aria-disabled:hover:bg-transparent ds-focus-inset\"\n    >\n      {loading ? (\n        <>\n          <RefreshCw aria-hidden className=\"size-3.5 animate-spin\" />\n          Loading...\n        </>\n      ) : (\n        'Load more'\n      )}\n    </button>\n  )\n}\n\n/** Substring match on the text and description, so \"kum\" finds \"Meera Kumar\" and ids never match by accident. */\nconst filterOptions = (_value: string, search: string, keywords?: string[]) => ((keywords ?? []).join(' ').toLowerCase().includes(search.trim().toLowerCase()) ? 1 : 0)\n\nfunction OptionList({\n  options,\n  isSelected,\n  onPick,\n  checkbox,\n  searchPlaceholder,\n  emptyText,\n  loading,\n  footer,\n  label,\n  labelledBy,\n  multiple,\n}: {\n  options: ComboboxOption[]\n  isSelected: (o: ComboboxOption) => boolean\n  onPick: (o: ComboboxOption) => void\n  checkbox?: boolean\n  searchPlaceholder: string\n  emptyText: string\n  loading?: boolean\n  footer?: React.ReactNode\n  /** accessible name of the listbox */\n  label?: string\n  labelledBy?: string\n  /** the listbox allows several selected options */\n  multiple?: boolean\n}) {\n  const groups = React.useMemo(() => {\n    const out: { label?: string; items: ComboboxOption[] }[] = []\n    for (const o of options) {\n      const last = out[out.length - 1]\n      if (last && last.label === o.group) last.items.push(o)\n      else out.push({ label: o.group, items: [o] })\n    }\n    return out\n  }, [options])\n  const row = (o: ComboboxOption) => {\n    const selected = isSelected(o)\n    return (\n      <CommandItem\n        key={o.value}\n        value={o.value}\n        keywords={[optionText(o), typeof o.description === 'string' ? o.description : '']}\n        disabled={o.disabled}\n        data-checked={!checkbox && selected ? 'true' : undefined}\n        aria-checked={selected}\n        onSelect={() => onPick(o)}\n        className={cn(o.description && 'min-h-[44px]')}\n      >\n        <OptionContent option={o} selected={selected} checkbox={checkbox} />\n      </CommandItem>\n    )\n  }\n  return (\n    <Command filter={filterOptions} className=\"bg-transparent\">\n      <CommandInput variant=\"menu\" placeholder={searchPlaceholder} />\n      {/* the list is focusable (it scrolls): a mouse press must not take focus from the search row, or typing after a pick stops filtering */}\n      <CommandList label={label} aria-labelledby={labelledBy} aria-multiselectable={multiple || undefined} className=\"max-h-[280px]\" onMouseDown={(e) => e.preventDefault()}>\n        {loading && options.length === 0 ? (\n          <CommandLoading />\n        ) : (\n          <>\n            <CommandEmpty>{emptyText}</CommandEmpty>\n            {/* cmdk reorders items while filtering: they must stay direct children of the list or of a group, so no wrapper elements */}\n            {groups.map((g, i) =>\n              g.label ? (\n                <CommandGroup key={`${g.label}-${i}`} heading={g.label}>\n                  {g.items.map(row)}\n                </CommandGroup>\n              ) : (\n                <React.Fragment key={`plain-${i}`}>{g.items.map(row)}</React.Fragment>\n              ),\n            )}\n            {/* more options are loading but there is no \"Load more\" row to show it: keep the list and put the spinner under it */}\n            {loading && !footer && <CommandLoading className=\"py-3\">Loading...</CommandLoading>}\n          </>\n        )}\n      </CommandList>\n      {footer}\n    </Command>\n  )\n}\n\nexport interface ComboboxProps {\n  options: ComboboxOption[]\n  value?: string\n  defaultValue?: string\n  onValueChange?: (value: string, option?: ComboboxOption) => void\n  placeholder?: string\n  searchPlaceholder?: string\n  emptyText?: string\n  loading?: boolean\n  size?: FieldSize\n  status?: FieldStatus\n  disabled?: boolean\n  readOnly?: boolean\n  /** x button that clears the selection (default false) */\n  clearable?: boolean\n  startIcon?: React.ReactNode\n  /** shows a \"load more\" row at the end of the menu */\n  onLoadMore?: () => void\n  /** id of the trigger button; the label's `htmlFor` points at it. Inside a `Field` it defaults to the field's id. */\n  id?: string\n  className?: string\n  contentClassName?: string\n  align?: 'start' | 'center' | 'end'\n  /** marks the field invalid and draws the error state. Inside a `Field` it follows the field's `error`. */\n  'aria-invalid'?: boolean | 'true' | 'false'\n  /** accessible name when there is no visible label */\n  'aria-label'?: string\n  /** id of the element that names the trigger, when a `<label for>` does not */\n  'aria-labelledby'?: string\n  /** id of the hint or error text. Inside a `Field` it is set to the field's message. */\n  'aria-describedby'?: string\n  /** tells assistive technology an answer is required. Inside a `Field` it follows `required`. */\n  'aria-required'?: boolean | 'true' | 'false'\n}\n\n/** Searchable select (Figma: Select Trigger openSearch + Dropdown Menu with search row). Value is the option's `value` string. */\nfunction Combobox({\n  options,\n  value: valueProp,\n  defaultValue,\n  onValueChange,\n  placeholder = 'Select...',\n  searchPlaceholder = 'Search...',\n  emptyText = 'No options found',\n  loading,\n  size = 'md',\n  status: statusProp,\n  disabled: disabledProp,\n  readOnly,\n  clearable,\n  startIcon,\n  onLoadMore,\n  id,\n  className,\n  contentClassName,\n  align = 'start',\n  ...aria\n}: ComboboxProps) {\n  const wired = useFieldAria({ id, ...aria })\n  const { disabled, status } = useFieldInherit({ id, disabled: disabledProp, status: statusProp })\n  const fieldLabelId = useFieldControl()?.labelId\n  const [value, setValue] = useControllableState<string>(valueProp, defaultValue ?? '', (v) => onValueChange?.(v, options.find((o) => o.value === v)))\n  const [open, setOpen] = React.useState(false)\n  const fieldRef = React.useRef<HTMLDivEle