ventListener('change', notify)\n    },\n    () => window.matchMedia('(max-width: 479px)').matches,\n    () => false,\n  )\n}\n","import * as React from 'react'\n\n/**\n * Moves focus into a portalled panel (a picker popover) after it was opened from the keyboard. Bump `tick` to ask for it: the panel mounts a\n * frame or two after `open` flips, so the first match of `selector` inside `ref` is retried for up to 30 frames. Internal.\n */\nexport function useFocusInto(ref: React.RefObject<HTMLElement | null>, tick: number, selector: string) {\n  React.useEffect(() => {\n    if (!tick) return\n    let raf = 0\n    let tries = 0\n    const run = () => {\n      const target = ref.current?.querySelector<HTMLElement>(selector)\n      if (target) target.focus()\n      else if (tries++ < 30) raf = requestAnimationFrame(run)\n    }\n    raf = requestAnimationFrame(run)\n    return () => cancelAnimationFrame(raf)\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [tick])\n}\n\n/** True when the viewport is at least `px` wide (false on the server). Internal. */\nexport function useMinWidth(px: number) {\n  return React.useSyncExternalStore(\n    (notify) => {\n      const list = window.matchMedia(`(min-width: ${px}px)`)\n      list.addEventListener('change', notify)\n      return () => list.removeEventListener('change', notify)\n    },\n    () => window.matchMedia(`(min-width: ${px}px)`).matches,\n    () => true,\n  )\n}\n","import * as React from 'react'\nimport { CalendarIcon, XIcon } from 'lucide-react'\nimport type { DateRange, Matcher } from 'react-day-picker'\n\nimport { cn } from '../lib/utils'\nimport { useFocusInto, useMinWidth } from '../hooks/use-focus-into'\nimport { Calendar } from './calendar'\nimport { Popover, PopoverAnchor, PopoverContent, PopoverTrigger } from './popover'\nimport { fieldBoxVariants, fieldIconClass, hitArea, StatusIcon, useControllableState, useFieldAria, useFieldInherit, type FieldSize, type FieldStatus } from './field'\n\ntype CalendarProps = React.ComponentProps<typeof Calendar>\n\nconst pad = (n: number) => String(n).padStart(2, '0')\nconst MONTH_NAMES = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']\n\n/** Local Date -> 'YYYY-MM-DD' (no timezone shift). */\nexport const toISO = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`\n\n/** 'YYYY-MM-DD' -> local Date at midnight; undefined when empty or not a real date. */\nexport function fromISO(s?: string | null): Date | undefined {\n  const m = s ? /^(\\d{4})-(\\d{2})-(\\d{2})/.exec(s) : null\n  if (!m) return undefined\n  const [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])]\n  const date = new Date(y, mo - 1, d)\n  return date.getFullYear() === y && date.getMonth() === mo - 1 && date.getDate() === d ? date : undefined\n}\n\n/** 'YYYY-MM-DD' -> 'DD/MM/YYYY' (the format the design system shows in fields and tables). */\nexport function formatDateDisplay(iso?: string | null): string {\n  const d = fromISO(iso)\n  return d ? `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}` : ''\n}\n\nfunction validISO(y: number, m: number, d: number): string | undefined {\n  const date = new Date(y, m - 1, d)\n  return date.getFullYear() === y && date.getMonth() === m - 1 && date.getDate() === d ? toISO(date) : undefined\n}\n\n/** Typed entry: 24/10/2026, 24-10-26, 24.10.2026, 24 Oct 2026, 24-Oct-2026, 24102026, 2026-10-24. */\nexport function parseDateInput(text: string): string | undefined {\n  const t = text.trim()\n  let m = /^(\\d{4})-(\\d{1,2})-(\\d{1,2})$/.exec(t)\n  if (m) return validISO(Number(m[1]), Number(m[2]), Number(m[3]))\n  m = /^(\\d{1,2})[/\\-. ](\\d{1,2})[/\\-. ](\\d{2}|\\d{4})$/.exec(t)\n  if (m) return validISO(m[3].length === 2 ? 2000 + Number(m[3]) : Number(m[3]), Number(m[2]), Number(m[1]))\n  m = /^(\\d{1,2})[/\\-. ]([A-Za-z]{3,9})[/\\-. ](\\d{2}|\\d{4})$/.exec(t)\n  if (m) {\n    const mi = MONTH_NAMES.indexOf(m[2].slice(0, 3).toLowerCase()