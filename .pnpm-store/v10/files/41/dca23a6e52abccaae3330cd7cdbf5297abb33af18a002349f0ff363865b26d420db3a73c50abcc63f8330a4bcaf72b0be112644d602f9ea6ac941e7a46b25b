tays `DD/MM/YYYY`. */\n  locale?: CalendarProps['locale']\n  /** ref of the text input */\n  ref?: React.Ref<HTMLInputElement>\n  /** called when the text input loses or gets focus (validate on blur here) */\n  onBlur?: React.FocusEventHandler<HTMLInputElement>\n  onFocus?: React.FocusEventHandler<HTMLInputElement>\n  autoFocus?: boolean\n  /** the text input is `required` (a native form checks it) */\n  required?: boolean\n  /** marks the field invalid and draws the error state (a typed date outside `min` / `max` or text that is not a date does too). Inside a `Field` it follows the field's `error`. */\n  'aria-invalid'?: boolean | 'true' | 'false'\n  /** accessible name when there is no visible label */\n  'aria-label'?: string\n  /** id of the element that names the input, when a `<label for>` does not */\n  'aria-labelledby'?: string\n  /** id of the hint or error text. Inside a `Field` it is set to the field's message. */\n  'aria-describedby'?: string\n  /** tells assistive technology a date is required. Inside a `Field` it follows `required`. */\n  'aria-required'?: boolean | 'true' | 'false'\n}\n\n/**\n * Date field: typed entry (DD/MM/YYYY and common variants) plus a calendar popover (Figma: Calendar, Date / Month / Year).\n * Works inside dialogs and sheets (the popover sits above them), with the keyboard (ArrowDown opens and moves into the grid,\n * Escape closes) and honours `min` / `max`. A typed date outside the range shows the error state, and so does text that is not a date:\n * it stays in the field (and the value stays as it was) until it is corrected or cleared.\n */\nfunction DatePicker({\n  value: valueProp,\n  defaultValue,\n  onValueChange,\n  min,\n  max,\n  disabledDates,\n  placeholder = 'DD/MM/YYYY',\n  size = 'md',\n  status: statusProp,\n  disabled: disabledProp,\n  readOnly,\n  clearable = true,\n  id,\n  name,\n  className,\n  align = 'start',\n  locale,\n  open: openProp,\n  defaultOpen,\n  onOpenChange,\n  ref,\n  onBlur,\n  onFocus,\