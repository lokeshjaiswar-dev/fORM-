15px]',\n    },\n  },\n  defaultVariants: { size: 'sm' },\n})\n\n/** Inside a `Field` it takes the field's `disabled` and is pointed at the field's message, like the other controls. */\nfunction Switch({ className, size, ...props }: React.ComponentProps<typeof SwitchPrimitive.Root> & VariantProps<typeof switchVariants>) {\n  const field = useFieldControl()\n  const describedBy = joinIds(props['aria-describedby'], field?.describedBy)\n  return (\n    <SwitchPrimitive.Root data-slot=\"switch\" data-size={size ?? 'sm'} className={cn(switchVariants({ size }), className)} {...props} aria-describedby={describedBy} disabled={props.disabled ?? (field?.disabled || undefined)}>\n      <SwitchPrimitive.Thumb data-slot=\"switch-thumb\" className={thumbVariants({ size })} />\n    </SwitchPrimitive.Root>\n  )\n}\n\n/**\n * Switch with its label and optional supporting text, the same row as `CheckboxField` and `RadioField` (13 / 14 / 16 px label for sm / md / lg, switch first). The label is tied to the\n * switch and the description is announced with it. For the settings-row layout (label left, switch right) pass `className=\"flex-row-reverse justify-between\"`.\n */\nfunction SwitchField({\n  label,\n  description,\n  size = 'sm',\n  id,\n  className,\n  labelClassName,\n  ...props\n}: Omit<React.ComponentProps<typeof SwitchPrimitive.Root>, 'size'> & { label: React.ReactNode; description?: React.ReactNode; size?: CheckSize; labelClassName?: string }) {\n  const autoId = React.useId()\n  const sid = id ?? autoId\n  const t = optionTextClass[size]\n  const field = useFieldControl()\n  const disabled = props.disabled ?? field?.disabled\n  /* the switch is 16 / 20 / 24 high: the label's first line sits at the switch's centre */\n  return (\n    <div data-slot=\"switch-field\" data-disabled={disabled || undefined} className={cn('flex items-start gap-2', optionControlOffset[size], className)}>\n      <Switch id={sid} size={size} {...props} aria-describedby={joinIds(props['aria-describedby'], description ? `${sid}-description` : undefined)} />\n      <label htmlFor={sid} className={cn('flex min-w-0 flex-col gap-0.5', disabled ? 'cursor-not-allowed' : 'cursor-pointer', labelClassName)}>\n        <span className={cn(t.label, 'font-normal', disabled ? 'text-[color:var(--label-disabled)]' : 'text-foreground')}>{label}</span>\n        {description && (\n          <span id={`${sid}-description`} className={cn(t.description, 'font-normal', disabled ? 'text-[color:var(--label-disabled)]' : 'text-text-muted')}>\n            {description}\n          </span>\n        )}\n      </label>\n    </div>\n  )\n}\n\nexport { Switch, SwitchField, switchVariants }\n","import * as React from 'react'\nimport { AlertCircle, Info, Pin } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { useScrollable } from '../hooks/use-scrollable'\nimport { hitArea } from './field'\nimport { Tooltip, TooltipContent, TooltipTrigger } from './tooltip'\n\ninterface TableProps extends React.ComponentProps<'table'> {\n  /** Classes for the scroll container around the table, e.g. `max-h-96` to scroll the body too (pair it with a sticky `TableHeader`). */\n  containerClassName?: string\n  containerRef?: React.Ref<HTMLDivElement>\n}\n\n/**\n * Figma: Table (3028:1565). Header cell 40px / Link S, cell 48px / Medium S, faded 1px row rules, quiet pill scrollbars. The sizes follow the density variables\n * (--table-head-h, --table-row-h, --table-px, ...), so a `className` such as `h-14` on a cell wins in both densities.\n * A table wider than its box scrolls sideways and shows a soft shadow on each edge that has more content behind it.\n */\nfunction Table({ className, containerClassName, containerRef, ...props }: TableProps) {\n  // a table wider (or, with a max height, taller) than its container scrolls: make that reachable with the keyboard\n  const node = React.useRef<HTMLDivElement | null>(null)\n  const frame = React.useRef<HTMLDivElement>(null)\n  const setNode = React.useCallback(\n    (el: HTMLDivElement | null) => {\n      node.current = el\n      if (typeof containerRef === 'function') containerRef(el)\n      else if (containerRef) (containerRef as React.RefObject<HTMLDivElement | null>).current = el\n    },\n    [containerRef],\n  )\n  const [ref, scrollable] = useScrollable<HTMLDivElement>(setNode)\n  // which edges have content behind them: `data-start` / `data-end` on the frame show the edge shadows, written straight to the DOM so scrolling never re-renders\n  React.useEffect(() => {\n    const el = node.current\n    const box = frame.current\n    if (!el || !box) return\n    const read = () => {\n      const x = Math.abs(el.scrollLeft)\n      box.toggleAttribute('data-start', x > 1)\n      box.toggleAttribute('data-end', x + el.clientWidth < el.scrollWidth - 1)\n    }\n    read()\n    el.addEventListener('scroll', read, { passive: true })\n    if (typeof ResizeObserver === 'undefined') return () => el.removeEventListener('scroll', read)\n    const ro = new ResizeObserver(read)\n    ro.observe(el)\n    Array.from(el.children).forEach((c) => ro.observe(c))\n    return () => {\n      el.removeEventListener('scroll', read)\n      ro.disconnect()\n    }\n  }, [])\n  return (\n    <div ref={frame} data-slot=\"table-frame\" className=\"group/table relative w-full\">\n      <div ref={ref} tabIndex={scrollable ? 0 : undefined} data-slot=\"table-container\" className={cn('ds-scroll ds-focus-inset relative w-full overflow-x-auto', containerClassName)}>\n        <table data-slot=\"table\" className={cn('w-full caption-bottom text-sm', className)} {...props} />\n      </div>\n      <span aria-hidden className=\"pointer-events-none absolute inset-y-0 left-0 w-5 bg-linear-to-r from-(--state-pressed) to-transparent opacity-0 transition-opacity duration-(--dur-base) group-data-[start]/table:opacity-100\" />\n      <span aria-hidden className=\"pointer-events-none absolute inset-y-0 right-0 w-5 bg-linear-to-l from-(--state-pressed) to-transparent opacity-0 transition-opacity duration-(--dur-base) group-data-[end]/table:opacity-100\" />\n    </div>\n  )\n}\n\nfunction TableHeader({ className, ...props }: React.ComponentProps<'thead'>) {\n  return <thead data-slot=\"table-header\" className={cn('bg-surface-subtle [&_tr]:border-b [&_tr]:border-border-subtle', className)} {...props} />\n}\n\nfunction TableBody({ className, ...props }: React.ComponentProps<'tbody'>) {\n  return <tbody data-slot=\"table-body\" className={cn('[&_tr:last-child]:border-0', className)} {...props} />\n}\n\nfunction TableFooter({ className, ...props }: React.ComponentProps<'tfoot'>) {\n  return <tfoot data-slot=\"table-footer\" className={cn('border-t border-border-subtle bg-surface-subtle font-medium [&>tr]:last:border-b-0', className)} {...props} />\n}\n\nfunction TableRow({ className, ...props }: React.ComponentProps<'tr'>) {\n  return (\n    <tr\n      data-slot=\"table-row\"\n      className={cn('group/row border-b border-border transition-colors hover:bg-state-hover data-[state=selected]:bg-primary-faded', className)}\n      {...props}\n    />\n  )\n}\n\n/** The two-caret sort glyph (Figma: Sorting, State=None / Ascending / Descending): the active direction is dark, the other one muted. */\nfunction SortIcon({ direction, className }: { direction: 'asc' | 'desc' | false; className?: string }) {\n  return (\n    <svg data-slot=\"sort-icon\" data-direction={direction || 'none'} viewBox=\"0 0 16 16\" aria-hidden className={cn('size-4 shrink-0', className)}>\n      <path d=\"M8 3.5 11.25 7.25H4.75Z\" className={direction === 'asc' ? 'fill-foreground' : 'fill-text-muted'} />\n      <path d=\"M8 12.5 4.75 8.75H11.25Z\" className={direction === 'desc' ? 'fill-foreground' : 'fill-text-muted'} />\n    </svg>\n  )\n}\n\ninterface TableHeadProps extends Omit<React.ComponentProps<'th'>, 'align'> {\n  /** Makes the header a sort button. Hover, pressed and keyboard-focus styles exist only on sortable columns (Figma dev notes). */\n  onSort?: (