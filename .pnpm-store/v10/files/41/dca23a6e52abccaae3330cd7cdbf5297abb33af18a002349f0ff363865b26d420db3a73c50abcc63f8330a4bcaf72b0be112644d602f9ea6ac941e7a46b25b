     )}\n      {meta && <div className=\"text-xs text-text-subtle\">{meta}</div>}\n      {children}\n      {actions && <div className=\"flex flex-wrap items-center gap-2 border-t pt-3\">{actions}</div>}\n    </div>\n  )\n}\n\nexport type PersonAvatarProps = AvatarPerson &\n  Omit<AvatarProps, 'id' | 'children' | 'content'> & {\n    /** `click` (default) opens the card on press, `hover` also on pointer hover, `none` makes a plain avatar (clickable when `onClick` is set) */\n    card?: LazyPopoverTrigger | 'none'\n    /** buttons at the bottom of the default card */\n    actions?: React.ReactNode\n    /** replaces the default PersonCard */\n    content?: React.ReactNode\n    side?: React.ComponentProps<typeof PopoverContent>['side']\n    align?: React.ComponentProps<typeof PopoverContent>['align']\n    open?: boolean\n    onOpenChange?: (open: boolean) => void\n  }\n\n/**\n * An avatar for a person that is clickable out of the box: pressing it opens a PersonCard. The card machinery mounts on first open\n * (LazyPopover), so long lists and tables of avatars stay cheap. `onClick` still runs; call `event.preventDefault()` in it to keep the card shut.\n */\nfunction PersonAvatar({ id, name, src, tone, subtext, email, meta, actions, content, card = 'click', side, align, open, onOpenChange, size, ...props }: PersonAvatarProps) {\n  const avatar = (\n    <Avatar size={size} interactive={card !== 'none' || props.onClick !== undefined} aria-label={name} title={card === 'none' ? name : undefined} {...props}>\n      <PersonPicture name={name} src={src} tone={tone} />\n    </Avatar>\n  )\n  if (card === 'none') return avatar\n  return (\n    <LazyPopover\n      trigger={card}\n      side={side}\n      align={align}\n      open={open}\n      onOpenChange={onOpenChange}\n      aria-label={name}\n      content={content ?? <PersonCard name={name} src={src} tone={tone} subtext={subtext} email={email} meta={meta} actions={actions} />}\n    >\n      {avatar}\n    </LazyPopover>\n  )\n}\n\nexport interface PeopleListProps extends Omit<React.ComponentProps<'div'>, 'onClick'> {\n  people: AvatarPerson[]\n  /** heading above the rows, e.g. \"4 more\" or \"Approvers\" */\n  heading?: React.ReactNode\n  /** makes each row a button */\n  onPersonClick?: (person: AvatarPerson) => void\n}\n\n/** A scrolling list of people (avatar, name, subtext). The +N popover of PersonAvatarGroup uses it; rows skip layout and paint while off-screen. */\nfunction PeopleList({ people, heading, onPersonClick, className, ...props }: PeopleListProps) {\n  const row = 'flex w-full min-w-0 items-center gap-2.5 rounded-sm px-2 py-1.5 text-left [contain-intrinsic-size:auto_44px] [content-visibility:auto]'\n  return (\n    <div data-slot=\"people-list\" className={cn('flex max-h-80 flex-col overflow-y-auto p-1', className)} {...props}>\n      {heading && <p className=\"px-2 pt-1.5 pb-1 text-xs font-semibold text-text-subtle\">{heading}</p>}\n      <ul className=\"flex flex-col\">\n        {people.map((p, i) => {\n          const body = (\n            <>\n              <Avatar size=\"large\">\n                <PersonPicture name={p.name} src={p.src} tone={p.tone} />\n              </Avatar>\n              <span className=\"min-w-0\">\n                <span className=\"block truncate text-sm font-medium text-foreground\">{p.name}</span>\n                {p.subtext && <span className=\"block truncate text-xs text-text-subtle\">{p.subtext}</span>}\n              </span>\n            </>\n          )\n          return (\n            <li key={p.id ?? `${p.name}-${i}`}>\n              {onPersonClick ? (\n                <button\n                  type=\"button\"\n                  onClick={() => onPersonClick(p)}\n                  className={cn(row, 'hover:bg-state-hover focus-visible:bg-state-hover ds-focus-inset')}\n                >\n                  {body}\n                </button>\n              ) : (\n                <div className={row}>{body}</div>\n              )}\n            </li>\n          )\n        })}\n      </ul>\n    </div>\n  )\n}\n\nexport interface PersonAvatarGroupProps extends Omit<React.ComponentProps<'div'>, 'children'> {\n  people: AvatarPerson[]\n  /** avatars shown before the rest collapse into +N (default 4) */\n  max?: number\n  size?: AvatarSize | AvatarSizeShort\n  /** colour of the +N avatar (default `neutral`) */\n  tone?: AvatarTone\n  /** accessible name of the +N button and the heading of its list, given the number of hidden people. Default `\"55 more\"`; the names are in the list, not in the label. */\n  moreLabel?: (hidden: number) => string\n  /** how each avatar opens its card; `none` turns the cards off (the +N list still opens) */\n  card?: PersonAvatarProps['card']\n  /** buttons for each person's card */\n  actions?: (person: AvatarPerson) => React.ReactNode\n  /** runs when a row of the +N list is pressed */\n  onPersonClick?: (person: AvatarPerson) => void\n}\n\n/** AvatarGroup from data: every avatar opens its PersonCard and the +N avatar opens a scrolling list of the people it hides. */\nfunction PersonAvatarGroup({ people, max = 4, size = 'medium', tone = 'neutral', moreLabel = (n) => `${n} more`, card = 'click', actions, onPersonClick, ...props }: PersonAvatarGroupProps) {\n  const visible = people.length > max ? people.slice(0, max) : people\n  const hidden = people.slice(visible.length)\n  return (\n    <AvatarGroup size={size} {...props}>\n      {visible.map((p, i) => (\n        <PersonAvatar key={p.id ?? `${p.name}-${i}`} {...p} card={card} actions={actions?.(p)} />\n      ))}\n      {hidden.length > 0 && (\n        <LazyPopover\n          aria-label={moreLabel(hidden.length)}\n          className=\"w-64\"\n          content={<PeopleList people={hidden} heading={moreLabel(hidden.length)} onPersonClick={onPersonClick} />}\n        >\n          <Avatar interactive aria-label={moreLabel(hidden.length)}>\n            <AvatarFallback tone={tone} className=\"tnum normal-case\">\n              +{hidden.length}\n            </AvatarFallback>\n          </Avatar>\n        </LazyPopover>\n      )}\n    </AvatarGroup>\n  )\n}\n\nexport {\n  Avatar,\n  AvatarImage,\n  AvatarFallback,\n  AvatarIcon,\n  AvatarGroup,\n  PersonAvatar,\n  PersonAvatarGroup,\n  PersonCard,\n  PeopleList,\n  avatarToneFor,\n  initialsOf,\n}\n","import * as React from 'react'\nimport { Slot } from 'radix-ui'\nimport { cva } from 'class-variance-authority'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Badge (Figma 2532:21380). Figma axes: size (large 24, medium 20, small 16) x color (positive, negative, warning, info, neutral) x type\n * (subtle, intense, outline) x border (circular, squared). Mapped here to `size`, `tone`, `appearance` and `shape`.\n * Old variants keep working: default (primary intense), secondary (neutral subtle), destructive (negative intense), outline (neutral outline),\n * success / warning / danger / info (subtle), brand (primary subtle), orange (brand orange subtle).\n * Use `warning` for status. `orange` is the brand accent, a hue 15 degrees from `warning`, so a page should not use both to mean different things.\n * A bare <Badge> is a solid primary block: for a quiet label use `variant=\"secondary\"`.\n */\nexport type BadgeVariant = 'default' | 'secondary' | 'destructive' | 'outline' | 'success' | 'warning' | 'danger' | 'info' | 'brand' | 'orange'\nexport type BadgeTone = 'positive' | 'negative' | 'warning' | 'info' | 'neutral' | 'primary' | 'orange'\nexport type BadgeAppearance = 'subtle' | 'intense' | 'outline'\n/** `lg` `md` `sm` are short names for large, medium and small (the vocabulary of Button). */\nexport type BadgeSize = 'large' | 'medium' | 'small' | 'lg' | 'md' | 'sm'\nexport type BadgeShape = 'squared' | 'circular'\n\nconst VARIANT_MAP: Record<BadgeVariant, { tone: BadgeTone; appearance: BadgeAppearance }> = {\n  default: { tone: 'primary', appearance: 'intense' },\n  secondary: { tone: 'neutral', appearance: 'subtle' },\n  destructive: { tone: 'negative', appearance: 'intense' },\n  outline: { tone: 'neutral', appearance: 'outline' },\n  success: { tone: 'positive', appearance: 'subtle' },\n  warning: { tone: 'warning', appearance: 'subtle' },\n  danger: { tone: 'negative', appearance: 'subtle' },\n  info: { tone: 'info', appearance: 'subtle' },\n  brand: { tone: 'primary', appearance: 'subtle' },\n  orange: { tone: 'orange', appearance: 'subtle' },\n}\n\n// subtle = faded fill + subtle border + tone text; intense = solid fill + white text; outline = tone border + tone text (Figma tokens).\nconst TONE: Record<BadgeTone, Record<BadgeAppearance, string>> = {\n  positive: {\n    subtle: 'border-positive-subtle bg-positive-faded text-positive',\n    intense: 'border-(--ds-positive-solid) bg-(--ds-positive-solid) text-white',\n    outline: 'border-positive bg-transparent text-positive',\n  },\n  negative: {\n    subtle: 'border-negative-subtle bg-negative-faded text-negative',\n    intense: 'border-(--ds-negative-solid) bg-(--ds-negative-solid) text-white',\n    outline: 'border-negative bg-transparent text-negative',\n  },\n  warning: {\n    subtle: 'border-notice-subtle bg-notice-faded text-notice-text',\n    intense: 'border-(--ds-notice-solid) bg-(--ds-notice-solid) text-white',\n    outline: 'border-notice bg-transparent text-notice-text',\n  },\n  info: {\n    subtle: 'border-information-subtle bg-information-faded text-information',\n    intense: 'border-(--ds-info-solid) bg-(--ds-info-solid) text-white',\n    outline: 'border-information bg-transparent text-information',\n  },\n  neutral: {\n    subtle: 'border-border bg-neutral-subtle text-neutral-intense',\n    intense: 'border-(--ds-neutral-default) bg-(--ds-neutral-default) text-white',\n    outline: 'border-neutral-intense bg-transparent text-neutral-intense',\n  },\n  primary: {\n    subtle: 'border-primary-highlighted bg-primary-faded text-primary-text',\n    intense: 'border-primary bg-primary text-primary-foreground',\n    outline: 'border-primary bg-transparent text-primary-text',\n  },\n  orange: {\n    subtle: 'border-brand-orange/25 bg-brand-orange/10 text-brand-orange-text',\n    intense: 'border-brand-orange-solid bg-brand-orange-solid text-white',\n    outline: 'border-brand-orange bg-transparent text-brand-orange-text',\n  },\n}\n\nconst SIZE_ALIAS = { lg: 'large', md: 'medium', sm: 'small' } as const\n\nconst badgeBase = cva(\n  'inline-flex w-fit shrink-0 items-center justify-center overflow-hidden border font-medium whitespace-nowrap transition-[color,box-shadow] [&>svg]:pointer-events-none ds-focus',\n  {\n    variants: {\n      size: {\n        large: 'h-6 gap-1 px-2 text-sm leading-4 [&>svg]:size-3.5',\n        medium: 'h-5 gap-1 px-2 text-xs leading-4 [&>svg]:size-3',\n        small: 'h-4 gap-0.5 px-1 text-xxs leading-[14px] [&>svg]:size-2.5',\n      },\n      shape: {\n        squared: 'rounded-sm',\n        circular: 'rounded-full',\n      },\n    },\n    defaultVariants: { size: 'medium', shape: 'squared' },\n  },\n)\n\nexport interface BadgeStyleOptions {\n  variant?: BadgeVariant | null\n  tone?: BadgeTone | null\n  appearance?: BadgeAppearance | null\n  size?: BadgeSize | null\n  shape?: BadgeShape | null\n  className?: string\n}\n\n/** Class string for anything that must look like a Badge. */\nfunction badgeVariants({ variant, tone, appearance, size, shape, className }: BadgeStyleOptions = {}) {\n  const v = variant ? VARIANT_MAP[variant] : undefined\n  // no props = the old default (primary, solid); a bare `tone` reads as the Figma default type (subtle)\n  const t = tone ?? v?.tone ?? 'primary'\n  const a = appearance ?? v?.appearance ?? (tone ? 'subtle' : 'intense')\n  const sizeName = size && size in SIZE_ALIAS ? SIZE_ALIAS[size as keyof typeof SIZE_ALIAS] : (size as 'large' | 'medium' | 'small' | null | undefined)\n  return cn(badgeBase({ size: sizeName, shape }), TONE[t][a], className)\n}\n\nexport interface BadgeProps extends React.ComponentProps<'span'>, Omit<BadgeStyleOptions, 'className'> {\n  asChild?: boolean\n  /** leading status dot in the badge colour. The dot is decoration: colour alone must not carry the meaning, so always give the badge text */\n  dot?: boolean\n}\n\nfunction Badge({ className, variant, tone, appearance, size, shape, dot, asChild = false, children, ...props }: BadgeProps) {\n  const Comp = asChild ? Slot.Root : 'span'\n  return (\n    <Comp data-slot=\"badge\" data-variant={variant} className={badgeVariants({ variant, tone, appearance, size, shape, className })} {...props}>\n      {asChild ? (\n        children\n      ) : (\n        <>\n          {dot && <span aria-hidden className=\"size-1.5 shrink-0 rounded-full bg-current\" />}\n          {children}\n        </>\n      )}\n    </Comp>\n  )\n}\n\n/** Numeric count pill (Figma \"Count / Quantity\"): notifications, tab counters, list totals. Values above `max` read as `max+`. */\nfunction CountBadge({\n  count,\n  max = 99,\n  tone = 'negative',\n  appearance = 'intense',\n  size = 'medium',\n  className,\n  label,\n  ...props\n}: Omit<BadgeProps, 'children' | 'asChild' | 'dot' | 'shape'> & {\n  count: number\n  max?: number\n  /** what is being counted (\"unread\", \"alerts\"): read by screen readers after the number, hidden on screen */\n  label?: string\n}) {\n  return (\n    <Badge\n      tone={tone}\n      appearance={appearance}\n      size={size}\n      shape=\"circular\"\n      className={cn('min-w-5 justify-center px-1.5 tnum', (size === 'small' || size === 'sm') && 'min-w-4 px-1', (size === 'large' || size === 'lg') && 'min-w-6', className)}\n      {...props}\n    >\n      {count > max ? `${max}+` : count}\n      {label && <span className=\"sr-only\"> {label}</span>}\n    </Badge>\n  )\n}\n\nexport { Badge, CountBadge, badgeVariants }\n","/**\n * True when an event target sits inside a Sonner toast. A toast raised from inside a modal (Dialog, Sheet, BottomSheet) is portalled outside the\n * modal's content, so pressing its Undo or close button counts as an interaction outside and would dismiss the modal. The modals call this in\n * their `onInteractOutside` and cancel the dismissal.\n */\nexport const inToaster = (target: EventTarget | null) => target instanceof Element && !!target.closest('[data-sonner-toaster]')\n","import * as React from 'react'\nimport { Slot } from 'radix-ui'\nimport { ChevronRight, MoreHorizontal } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/* Figma Breadcrumb 226:86. Sizes xsmall 10/14, small 12/16, medium 14/20, large 20/28 (Body/Link, SemiBold); gap 4; chevron 12 (20 on large).\n   Colour neutral: ancestors muted #58728d, current page normal; primary: ancestors in primary text. Type collapsed: \"Item > ... > Item > Item\".\n   A trail that wraps must not leave a chevron at the end of a line: put the separator inside the item that follows it (`<BreadcrumbItem separator>`), so the pair wraps together. The sibling BreadcrumbSeparator still works. */\ntype BreadcrumbSize = 'xs' | 'sm' | 'md' | 'lg'\ntype BreadcrumbColor = 'neutral' | 'primary'\n\nconst BreadcrumbContext = React.createContext<{ size: BreadcrumbSize; color: BreadcrumbColor }>({ size: 'md', color: 'neutral' })\n\nconst listSize: Record<BreadcrumbSize, string> = { xs: 'text-xxs', sm: 'text-xs', md: 'text-base', lg: 'text-2xl' }\nconst chevronSize: Record<BreadcrumbSize, string> = { xs: 'size-3', sm: 'size-3', md: 'size-3', lg: 'size-5' }\n\nfunction Breadcrumb({ size = 'md', color = 'neutral', ...props }: React.ComponentProps<'nav'> & { size?: BreadcrumbSize; color?: BreadcrumbColor }) {\n  const value = React.useMemo(() => ({ size, color }), [size, color])\n  return (\n    <BreadcrumbContext.Provider value={value}>\n      <nav aria-label=\"Breadcrumb\" data-slot=\"breadcrumb\" data-size={size} data-color={color} {...props} />\n    </BreadcrumbContext.Provider>\n  )\n}\n\nfunction BreadcrumbList({ className, ...props }: React.ComponentProps<'ol'>) {\n  const { size } = React.useContext(BreadcrumbContext)\n  return (\n    <ol\n      data-slot=\"breadcrumb-list\"\n      className={cn('flex flex-wrap items-center gap-1 font-semibold break-words text-text-muted', listSize[size], className)}\n      {...props}\n    />\n  )\n}\n\n/**\n * One level of the trail. `separator` draws the chevron (or your own node, such as \"/\") before the level, inside the same list item, so a trail\n * that wraps never strands a separator at the end of a line. Leave it off on the first level.\n */\nfunction BreadcrumbItem({ className, separator, children, ...props }: React.ComponentProps<'li'> & { separator?: boolean | React.ReactNode }) {\n  const { size } = React.useContext(BreadcrumbContext)\n  return (\n    <li data-slot=\"breadcrumb-item\" className={cn('inline-flex min-w-0 items-center gap-1', className)} {...props}>\n      {separator !== undefined && separator !== false && separator !== null && (\n        <span data-slot=\"breadcrumb-separator\" aria-hidden=\"true\" className=\"inline-flex shrink-0 items-center text-text-muted\">\n          {separator === true ? <ChevronRight className={chevronSize[size]} /> : separator}\n        </span>\n      )}\n      {children}\n    </li>\n  )\n}\n\nfunction BreadcrumbLink({ asChild, className, ...props }: React.ComponentProps<'a'> & { asChild?: boolean }) {\n  const { color } = React.useContext(BreadcrumbContext)\n  const Comp = asChild ? Slot.Root : 'a'\n  return (\n    <Comp\n      data-slot=\"breadcrumb-link\"\n      className={cn(\n        'rounded-xs transition-colors ds-focus',\n        color === 'primary' ? 'text-primary-text hover:underline' : 'hover:text-foreground hover:underline',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nfunction BreadcrumbPage({ className, ...props }: React.ComponentProps<'span'>) {\n  return <span data-slot=\"breadcrumb-page\" aria-current=\"page\" className={cn('font-semibold text-foreground', className)} {...props} />\n}\n\nfunction BreadcrumbSeparator({ children, className, ...props }: React.ComponentProps<'li'>) {\n  const { size } = React.useContext(BreadcrumbContext)\n  return (\n    <li\n      data-slot=\"breadcrumb-separator\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      className={cn('inline-flex items-center text-text-muted', className)}\n      {...props}\n    >\n      {children ?? <ChevronRight className={chevronSize[size]} />}\n    </li>\n  )\n}\n\n/** The collapsed middle of a long trail: an ellipsis icon (Figma type=collapsed) in a 24 px button. Always a real, focusable button: give it `onClick` to expand the trail, or wrap it in a menu trigger (`asChild`) to list the hidden levels. */\nfunction BreadcrumbEllipsis({ className, ...props }: React.ComponentProps<'button'>) {\n  return (\n    <button\n      type=\"button\"\n      data-slot=\"breadcrumb-ellipsis\"\n      aria-label=\"Show hidden levels\"\n      className={cn(\n        'inline-flex h-6 min-w-6 cursor-pointer items-center justify-center rounded-sm font-semibold text-text-muted transition-colors hover:bg-state-hover hover:text-foreground active:bg-state-pressed ds-focus',\n        className,\n      )}\n      {...props}\n    >\n      <MoreHorizontal className=\"size-4\" aria-hidden=\"true\" />\n    </button>\n  )\n}\n\nexport { Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator, BreadcrumbEllipsis }\nexport type { BreadcrumbSize, BreadcrumbColor }\n","import * as React from 'react'\nimport { ChevronDown, ChevronLeft, ChevronRight } from 'lucide-react'\nimport { DayPicker, useDayPicker, type MonthCaptionProps } from 'react-day-picker'\n\nimport { cn } from '../lib/utils'\n\ntype View = 'day' | 'month' | 'year'\n\n/** Month name (`long`: January, `short`: Jan) and weekday initial in the calendar's locale (`locale.code` of a react-day-picker locale), English by default. */\nconst monthName = (code: string | undefined, index: number, style: 'long' | 'short' = 'long') => new Intl.DateTimeFormat(code ?? 'en', { month: style }).format(new Date(2000, index, 1))\nconst weekdayInitial = (code: string | undefined, d: Date) => new Intl.DateTimeFormat(code ?? 'en', { weekday: 'narrow' }).format(d)\n\n/** Sizes follow the density variables (--cal-cell, --cal-pad, --cal-nav, --cal-fs in ds-density.css): 40 / 16 / 28 / 16 px comfortable, 32 / 12 / 24 / 13 px compact. */\nconst panelWidth = 'w-[calc(7*var(--cal-cell)+2*var(--cal-pad))]'\n/** The month and year panels are as tall as a day grid with six weeks, so the popover does not change size when the view switches. */\nconst panelMinHeight = 'min-h-[calc(2*var(--cal-pad)+2*var(--cal-nav)+0.75rem+6*(var(--cal-cell)+0.25rem))]'\n\nconst ViewContext = React.createContext<{ setView: (v: View) => void; locale?: string }>({ setView: () => {} })\n\n/** Header cell button (month / year switcher). */\nconst headerButton =\n  'inline-flex h-(--cal-nav) items-center gap-1 rounded-sm px-1.5 text-(length:--cal-fs) font-medium text-foreground transition-colors hover:bg-state-hover ds-focus'\n/** prev / next button with the faded 1px border. */\nconst navButton =\n  'inline-flex size-(--cal-nav) shrink-0 items-center justify-center rounded-md border border-border bg-surface text-icon-normal transition-colors hover:bg-state-hover focus-visible:border-primary disabled:pointer-events-none disabled:text-icon-disabled ds-focus'\n/** grid cell used by the month and year panels (and the day buttons). */\nconst cell =\n  'inline-flex h-(--cal-cell) items-center justify-center rounded-sm text-(length:--cal-fs) font-normal text-foreground transition-colors hover:bg-primary-faded hover:text-primary-text disabled:pointer-events-none disabled:text-text-disabled ds-focus-inset'\nconst cellSelected = 'bg-primary! text-primary-foreground! hover:bg-primary!'\n\nfunction NavButton({ dir, ...props }: { dir: 'prev' | 'next' } & React.ComponentProps<'button'>) {\n  return (\n    <button type=\"button\" aria-label={dir === 'prev' ? 'Previous' : 'Next'} className={navButton} {...props}>\n      {dir === 'prev' ? <ChevronLeft className=\"size-4\" /> : <ChevronRight className=\"size-4\" />}\n    </button>\n  )\n}\n\n/** Day view header: prev, \"April v  2026 v\", next. Month and year open the month / year panels. */\nfunction CalendarCaption({ calendarMonth, displayIndex }: MonthCaptionProps) {\n  const { previousMonth, nextMonth, goToMonth, months } = useDayPicker()\n  const { setView, locale } = React.useContext(ViewContext)\n  const first = displayIndex === 0\n  const last = displayIndex === months.length - 1\n  const date = calendarMonth.date\n  return (\n    <div data-slot=\"calendar-caption\" className=\"flex h-(--cal-nav) items-center justify-between\">\n      {first ? <NavButton dir=\"prev\" disabled={!previousMonth} onClick={() => previousMonth && goToMonth(previousMonth)} /> : <span className=\"size-(--cal-nav)\" />}\n      <div className=\"flex items-center gap-2\">\n        <button type=\"button\" className={headerButton} onClick={() => setView('month')} aria-label=\"Choose month\">\n          {monthName(locale, date.getMonth())}\n          <ChevronDown className=\"size-4 text-icon-muted\" />\n        </button>\n        <button type=\"button\" className={headerButton} onClick={() => setView('year')} aria-label=\"Choose year\">\n          {date.getFullYear()}\n          <ChevronDown className=\"size-4 text-icon-muted\" />\n        </button>\n      </div>\n      {last ? <NavButton dir=\"next\" disabled={!nextMonth} onClick={() => nextMonth && goToMonth(nextMonth)} /> : <span className=\"size-(--cal-nav)\" />}\n    </div>\n  )\n}\n\n/** Moves focus to the selected cell (or the first enabled one) when a panel opens, so the keyboard and Escape keep working inside the popover. */\nfunction useFocusCell(ref: React.RefObject<HTMLElement | null>) {\n  React.useEffect(() => {\n    const root = ref.current\n    const target = root?.querySelector<HTMLElement>('button[aria-pressed=\"true\"]:not(:disabled)') ?? root?.querySelector<HTMLElement>('button[data-cell]:not(:disabled)')\n    target?.focus({ preventScroll: true })\n  }, [ref])\n}\n\ninterface PanelLimits {\n  /** first month that can be picked (react-day-picker `startMonth`) */\n  startMonth?: Date\n  /** last month that can be picked (`endMonth`) */\n  endMonth?: Date\n}\n\nconst monthIndex = (d: Date) => d.getFullYear() * 12 + d.getMonth()\n\n/** The month grid. `onBack` returns to the days; `onYear` (optional) opens the year grid. Months outside `startMonth` / `endMonth` are disabled. */\nfunction MonthPanel({ month, onPick, onBack, onYear, startMonth, endMonth, locale }: { month: Date; onPick: (monthIndex: number) => void; onBack: () => void; onYear?: () => void; locale?: string } & PanelLimits) {\n  const ref = React.useRef<HTMLDivElement>(null)\n  useFocusCell(ref)\n  const year = month.getFullYear()\n  return (\n    <div ref={ref} data-slot=\"calendar-months\" className={cn('flex flex-col p-(--cal-pad)', panelWidth, panelMinHeight)}>\n      <div className=\"flex h-(--cal-nav) items-center justify-center gap-2\">\n        <button type=\"button\" className={headerButton} onClick={onBack} aria-label=\"Back to days\">\n          {monthName(locale, month.getMonth())}\n          <ChevronDown className=\"size-4 rotate-180 text-icon-muted\" />\n        </button>\n        {onYear ? (\n          <button type=\"button\" className={headerButton} onClick={onYear} aria-label=\"Choose year\">\n            {year}\n            <ChevronDown className=\"size-4 text-icon-muted\" />\n          </button>\n        ) : (\n          <span className=\"px-1.5 text-(length:--cal-fs) font-medium text-foreground tnum\">{year}</span>\n        )}\n      </div>\n      <div className=\"mt-3 grid flex-1 auto-rows-fr grid-cols-3 gap-2\">\n        {Array.from({ length: 12 }, (_, i) => i).map((i) => {\n          const idx = year * 12 + i\n          const out = (!!startMonth && idx < monthIndex(startMonth)) || (!!endMonth && idx > monthIndex(endMonth))\n          return (\n            <button key={i} type=\"button\" data-cell disabled={out} aria-pressed={i === month.getMonth()} onClick={() => onPick(i)} className={cn(cell, 'h-auto min-h-(--cal-cell)', i === month.getMonth() && !out && cellSelected)}>\n              {monthName(locale, i, 'short')}\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\n/** The year grid (15 years per page). `onBack` (optional) turns the range label into a button that returns to the days. Years outside `startMonth` / `endMonth` are disabled and the arrows stop there. */\nfunction YearPanel({ month, onPick, onBack, startMonth, endMonth }: { month: Date; onPick: (year: number) => void; onBack?: () => void } & PanelLimits) {\n  const ref = React.useRef<HTMLDivElement>(null)\n  useFocusCell(ref)\n  const year = month.getFullYear()\n  const [start, setStart] = React.useState(year - 6)\n  const lo = startMonth?.getFullYear()\n  const hi = endMonth?.getFullYear()\n  const label = (\n    <>\n      {start} - {start + 14}\n    </>\n  )\n  return (\n    <div ref={ref} data-slot=\"calendar-years\" className={cn('flex flex-col p-(--cal-pad)', panelWidth, panelMinHeight)}>\n      <div className=\"flex h-(--cal-nav) items-center justify-between\">\n        <NavButton dir=\"prev\" disabled={lo !== undefined && start <= lo} onClick={() => setStart((s) => s - 15)} />\n        {onBack ? (\n          <button type=\"button\" className={cn(headerButton, 'tnum')} onClick={onBack} aria-label=\"Back to days\">\n            {label}\n            <ChevronDown className=\"size-4 rotate-180 text-icon-muted\" />\n          </button>\n        ) : (\n          <span className=\"text-(length:--cal-fs) font-medium text-foreground tnum\">{label}</span>\n        )}\n        <NavButton dir=\"next\" disabled={hi !== undefined && start + 14 >= hi} onClick={() => setStart((s) => s + 15)} />\n      </div>\n      <div className=\"mt-3 grid flex-1 auto-rows-fr grid-cols-3 gap-2\">\n        {Array.from({ length: 15 }, (_, i) => start + i).map((y) => {\n          const out = (lo !== undefined && y < lo) || (hi !== undefined && y > hi)\n          return (\n            <button key={y} type=\"button\" data-cell disabled={out} aria-pressed={y === year} onClick={() => onPick(y)} className={cn(cell, 'h-auto min-h-(--cal-cell) tnum', y === year && !out && cellSelected)}>\n              {y}\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\nfunction firstSelected(selected: unknown): Date | undefined {\n  if (selected instanceof Date) return selected\n  if (Array.isArray(selected)) return selected[0] instanceof Date ? selected[0] : undefined\n  if (selected && typeof selected === 'object' && 'from' in selected) {\n    const from = (selected as { from?: Date }).from\n    return from instanceof Date ? from : undefined\n  }\n  return undefined\n}\n\n/** A selected day that is also disabled (a typed date outside min / max): no solid fill, an error outline instead. */\nconst selectedButEnabled = '[&>button]:bg-primary! [&>button]:text-primary-foreground! [&>button]:hover:bg-primary!'\nconst selectedButDisabled = '[&[data-disabled]>button]:bg-transparent! [&[data-disabled]>button]:text-negative! [&[data-disabled]>button]:shadow-[inset_0_0_0_1px_var(--negative)]'\n\n/**\n * Calendar (Figma: Calendar, Varient=Date / Month / Year). 40px cells, 16px padding (32 and 12 in compact density), 312 wide; the header switches to a month\n * grid and a year grid, which Escape (or the header button) leaves again. Accepts every react-day-picker prop (single, multiple and range selection, disabled\n * matchers ...); `startMonth` / `endMonth` also limit the month and year grids. Month names and weekday initials follow `locale`.\n */\nfunction Calendar({\n  className,\n  classNames,\n  showOutsideDays = true,\n  fixedWeeks,\n  month: monthProp,\n  defaultMonth,\n  onMonthChange,\n  components,\n  formatters,\n  ...props\n}: React.ComponentProps<typeof DayPicker>) {\n  const [view, setView] =