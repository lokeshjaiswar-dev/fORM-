/* scrollbars: one quiet, overlay-feeling scrollbar for every scroll container (page, tables, menus, code, panels).
   A transparent 10px track with a pill thumb that is 4px thick at rest, deepens when the container is hovered and grows to 6px under the pointer,
   all on a short ease. Chromium and Safari are drawn with ::-webkit-scrollbar; Firefox (and anything else without it) gets the standard
   scrollbar-width / scrollbar-color pair, which cannot animate but uses the same colours.
   Everything is driven by the variables below, so a dark panel (the sidebar) only has to redeclare the colours.
   Rules live in the base layer: a utility such as `[scrollbar-width:none]` or a component rule always wins. */

:root {
  --scroll-size: 10px;           /* width of a vertical / height of a horizontal bar */
  --scroll-inset: 3px;           /* transparent ring around the thumb: thickness at rest = size - 2 x inset */
  --scroll-inset-active: 2px;    /* ring while the pointer is on the thumb: the thumb grows by 2px */
  --scroll-thumb: #6c849d4d;
  --scroll-thumb-near: #6c849d80;    /* the container is hovered or focused */
  --scroll-thumb-hover: #58728db3;   /* pointer on the thumb */
  --scroll-thumb-active: #40566de6;  /* dragging */
  --scroll-ease: 160ms cubic-bezier(0.2, 0, 0, 1);
}
.dark {
  --scroll-thumb: #90a5bb40;
  --scroll-thumb-near: #90a5bb73;
  --scroll-thumb-hover: #90a5bbb3;
  --scroll-thumb-active: #b1c1d2e6;
}

@layer base {
  :root { color-scheme: light; }
  .dark { color-scheme: dark; }

  /* Chromium, Safari, Edge */
  *::-webkit-scrollbar {
    width: var(--scroll-size);
    height: var(--scroll-size);
    background: transparent;
  }
  *::-webkit-scrollbar-track,
  *::-webkit-scrollbar-corner {
    background: transparent;
  }
  *::-webkit-scrollbar-button {
    display: none;
    width: 0;
    height: 0;
  }
  *::-webkit-scrollbar-thumb {
    background-color: var(--scroll-thumb);
    background-clip: padding-box;
    border: var(--scroll-inset) solid transparent;
    border-radius: 999px;
    min-height: 32px;
    min-width: 32px;
    transition: background-color var(--scroll-ease), border-width var(--scroll-ease);
  }
  *:hover::-webkit-scrollbar-thumb,
  *:focus-within::-webkit-scrollbar-thumb {
    background-color: var(--scroll-thumb-near);
  }
  *::-webkit-scrollbar-thumb:hover {
    background-color: var(--scroll-thumb-hover);
    border-width: var(--scroll-inset-active);
  }
  *::-webkit-scrollbar-thumb:active {
    background-color: var(--scroll-thumb-active);
    border-width: var(--scroll-inset-active);
  }

  /* Firefox */
  @supports not selector(::-webkit-scrollbar) {
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--scroll-thumb-near) transparent;
    }
  }
}

/* A panel that scrolls on its own (menus, lists, table bodies): stop the scroll from leaking into the page behind it.
   `.ds-scroll-thin` is the 6px bar for narrow columns such as the time picker. */
.ds-scroll {
  overscroll-behavior: contain;
}
.ds-scroll-thin {
  --scroll-size: 6px;
  --scroll-inset: 1px;
  --scroll-inset-active: 0px;
}
