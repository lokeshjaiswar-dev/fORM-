/* =====================================================================================================================
   Density. `data-density` on <html> (or on any container) switches the scale: "comfortable" is the Figma size, "compact" is about
   20% tighter so a screen shows more and reads less like a form. Without the attribute a page is comfortable; src/lib/density.ts
   (applyDensity) makes compact the app default.

   How it works
   - Sizes that several components share are CSS variables, declared once here and read by the components with utilities such as
     h-(--ctl-h-md). The variables live outside any @layer and only the component's own default reads them, so a className such as
     h-11 on a Button or an Input always wins, in both densities. Nothing here keys on a utility class like .h-8.
   - One-off tightening of a single component uses the `compact:` variant (index.css) in the component itself.
   - A few slot-keyed rules at the bottom (card, alert) are plain CSS: they only change size, padding and type size, never colour.
   - Touch: on a coarse pointer (a phone, a tablet) compact is not applied, because 28 px targets are too small for a finger.
     `@media not (pointer: coarse)` wraps every compact value, including the `compact:` variant.
   - Small viewports and touch screens set the field font to 16 px, below which iOS Safari zooms the page when a field gets focus.
   - Under 640 px (a phone, a narrow window, even with a mouse) the control heights are the comfortable ones too (see the 639px block near the end of
     the variables): a 28 px field with 16 px text next to 40 px footer buttons looks broken. Other compact sizes (menu rows, tables, tabs) are unchanged.

   Control heights (Button and every field-like control share one scale, so a default Button and a default field are the same height)
                   comfortable   compact
     xs  (Button)       24          24     (24 px is the WCAG 2.5.8 minimum target, so xs does not shrink)
     sm                 28          24
     md  (default)      32          28
     lg                 40          32
     xl                 48          36
   ===================================================================================================================== */

:root,
[data-density='comfortable'] {
  --ctl-h-xs: 1.5rem;
  --ctl-h-sm: 1.75rem;
  --ctl-h-md: 2rem;
  --ctl-h-lg: 2.5rem;
  --ctl-h-xl: 3rem;

  /* Button label size and side padding per step (lg and xl keep the utility classes of the component) */
  --btn-fs-md: 0.8125rem;
  --btn-fs-sm: 0.75rem;
  --btn-fs-xs: 0.75rem;
  --btn-px-md: 0.75rem;
  --btn-px-sm: 0.75rem;
  --btn-px-xs: 0.5rem;

  /* fields: text size, side padding, gap between icon and text, textarea */
  --field-fs-sm: 0.8125rem;
  --field-fs: 0.875rem;
  --field-fs-xl: 1rem;
  --field-px: 0.75rem;
  --field-px-sm: 0.625rem;
  --field-gap: 0.5rem;
  --field-py: 0.625rem;
  --field-textarea-min: 5rem;
  /* the chip inside a field (multi-select value, tag): set on the field box by its size, read by ValueChip */
  --chip-h-sm: 1.25rem;
  --chip-h-md: 1.5rem;
  --chip-h-lg: 1.75rem;
  --chip-h-xl: 2rem;

  /* menus: option rows, group labels, the search row of a menu */
  --option-h: 2.25rem;
  --option-px: 0.75rem;
  --option-py: 0.5rem;
  --option-fs: 0.875rem;
  --option-lh: 1.25rem;
  --option-gap: 0.25rem;
  --option-group-h: 1.75rem;
  --menu-search-h: 1.75rem;

  /* calendar: day cell edge, padding around the grid, header row, day number size (time lists use --option-h and --option-fs) */
  --cal-cell: 2.5rem;
  --cal-pad: 1rem;
  --cal-nav: 1.75rem;
  --cal-fs: 1rem;

  /* tables: header and row height, side padding, type, empty/error panel */
  --table-head-h: 2.5rem;
  --table-row-h: 3rem;
  --table-px: 0.75rem;
  --table-px-check: 1rem;
  --table-cell-py: 0.5rem;
  --table-head-fs: 0.875rem;
  --table-fs: 0.875rem;
  --table-lh: 1.25rem;
  --table-state-min-h: 12rem;
  --table-state-py: 2rem;

  /* shell */
  --shell-bar-h: 3.75rem;
  --ds-sidebar-w: 15rem;
}

@media not (pointer: coarse) {
  [data-density='compact'] {
    --ctl-h-xs: 1.5rem;
    --ctl-h-sm: 1.5rem;
    --ctl-h-md: 1.75rem;
    --ctl-h-lg: 2rem;
    --ctl-h-xl: 2.25rem;

    --btn-fs-md: 0.75rem;
    --btn-fs-sm: 0.75rem;
    --btn-fs-xs: 0.75rem;
    --btn-px-md: 0.625rem;
    --btn-px-sm: 0.5rem;
    --btn-px-xs: 0.375rem;

    --field-fs-sm: 0.75rem;
    --field-fs: 0.8125rem;
    --field-fs-xl: 0.875rem;
    --field-px: 0.625rem;
    --field-px-sm: 0.5rem;
    --field-gap: 0.375rem;
    --field-py: 0.5rem;
    --field-textarea-min: 4rem;
    --chip-h-sm: 1.125rem;
    --chip-h-md: 1.25rem;
    --chip-h-lg: 1.5rem;
    --chip-h-xl: 1.75rem;

    --option-h: 1.75rem;
    --option-px: 0.625rem;
    --option-py: 0.25rem;
    --option-fs: 0.8125rem;
    --option-lh: 1.125rem;
    --option-gap: 0.125rem;
    --option-group-h: 1.5rem;
    --menu-search-h: 1.5rem;

    --cal-cell: 2rem;
    --cal-pad: 0.75rem;
    --cal-nav: 1.5rem;
    --cal-fs: 0.8125rem;

    --table-head-h: 2rem;
    --table-row-h: 2.25rem;
    --table-px: 0.625rem;
    --table-px-check: 0.625rem;
    --table-cell-py: 0.25rem;
    --table-head-fs: 0.75rem;
    --table-fs: 0.8125rem;
    --table-lh: 1.125rem;
    --table-state-min-h: 8rem;
    --table-state-py: 1.5rem;

    --shell-bar-h: 3rem;
    --ds-sidebar-w: 14rem;
  }
}

/* iOS Safari zooms the page when a focused field has a font below 16 px: phones and narrow windows use 16 px in every density. It sits
   last so it wins over the compact block above (same specificity). */
@media (max-width: 639px), (pointer: coarse) {
  :root,
  [data-density] {
    --field-fs-sm: 1rem;
    --field-fs: 1rem;
    --field-fs-xl: 1rem;
  }
}

/* A narrow window is used like a phone: control heights are the comfortable ones there (a 28 px field with 16 px text next to 40 px footer buttons looks
   broken). Last in the file's variable blocks so it wins over the compact values above (same specificity). */
@media (max-width: 639px) {
  :root,
  [data-density] {
    --ctl-h-sm: 1.75rem;
    --ctl-h-md: 2rem;
    --ctl-h-lg: 2.5rem;
    --ctl-h-xl: 3rem;
  }
}

/* ---- alerts: padding, row gap and line height follow the compact: variant in alert.tsx (variables there), so a className can override them */

/* ---- cards: spacing, radius and type size are variables read by card.tsx, so a className on Card, CardTitle... overrides them in both densities */
:root,
[data-density='comfortable'] {
  --card-gap: 1rem;
  --card-py: 1.25rem;
  --card-px: 1.25rem;
  --card-radius: var(--radius-xl);
  --card-title-fs: 1rem;
  --card-description-fs: 0.875rem;
}
@media not (pointer: coarse) {
  [data-density='compact'] {
    --card-gap: 0.625rem;
    --card-py: 0.75rem;
    --card-px: 0.875rem;
    --card-radius: 10px;
    --card-title-fs: 0.875rem;
    --card-description-fs: 0.75rem;
  }
}
