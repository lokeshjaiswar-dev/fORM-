/* Type scale (Figma Body styles), in px. Declared in @theme so Tailwind's text-* utilities use it: text-sm is Body S 13/18. */
@theme {
  --text-xxs: 11px; --text-xxs--line-height: 14px;
  --text-xs: 12px; --text-xs--line-height: 16px;
  --text-sm: 13px; --text-sm--line-height: 18px;
  --text-base: 14px; --text-base--line-height: 20px;
  --text-lg: 16px; --text-lg--line-height: 24px;
  --text-xl: 18px; --text-xl--line-height: 26px;
  --text-2xl: 20px; --text-2xl--line-height: 28px;
  --text-3xl: 24px; --text-3xl--line-height: 32px;
  --text-4xl: 32px; --text-4xl--line-height: 40px;
}

@layer base {
  * {
    @apply border-border outline-ring;
  }
  html {
    font-size: 16px;
  }
  /* A grid with no column class (the phone layout of `lg:grid-cols-3` and friends) gets one column that may shrink, so a wide table inside it
     scrolls in its own box instead of stretching the page. A grid that asks for its own column shape opts out (grid-flow-*, grid-auto-cols-*,
     grid-template-areas / -columns, so `grid grid-flow-col` behaves as in plain Tailwind). A grid-cols-* utility always wins (utilities are a
     later layer), and so does any unlayered consumer CSS. */
  .grid:where(:not([class*='grid-flow'], [class*='grid-auto-cols'], [class*='grid-template-areas'], [class*='grid-template-columns'])) {
    grid-template-columns: minmax(0, 1fr);
  }
  body {
    @apply bg-background text-foreground font-sans text-sm antialiased;
  }
  .tnum {
    font-variant-numeric: tabular-nums;
  }
}

/* ---- reduced motion: users who ask for less movement get no zoom / slide / fade choreography. Overlay enter and exit (tw-animate-css, on any element
   Radix marks with data-state / data-side, and Sonner toasts) and hover transitions collapse to a near-instant change; the end state is unchanged, so
   Radix Presence still sees animationend. Loaders and the skeleton shimmer are status indicators, not choreography: they have their own slower
   reduced-motion rules (ds-atoms.css, ds-overlays.css). Radix marks the indeterminate Progress indicator with data-state, so indeterminate / loading
   states and ds-loader-* are excluded here; without that exclusion the infinite bar would strobe at 0.01ms. */
@media (prefers-reduced-motion: reduce) {
  :is([data-state], [data-side], [data-sonner-toast], [data-sonner-toaster]):not([data-state='indeterminate'], [data-state='loading'], [class*='ds-loader']),
  :is([data-state], [data-side], [data-sonner-toast]):not([data-state='indeterminate'], [data-state='loading'], [class*='ds-loader'])::before,
  :is([data-state], [data-side], [data-sonner-toast]):not([data-state='indeterminate'], [data-state='loading'], [class*='ds-loader'])::after {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
    transition-duration: 0.01ms !important;
    transition-delay: 0ms !important;
  }
  * { scroll-behavior: auto !important; }
}
