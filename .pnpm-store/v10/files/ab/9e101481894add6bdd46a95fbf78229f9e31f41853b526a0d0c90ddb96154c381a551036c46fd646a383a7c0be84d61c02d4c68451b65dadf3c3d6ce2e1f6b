{
  "name": "@dmacq/ui",
  "version": "0.1.0",
  "private": true,
  "description": "dMACQ design system as React components: shadcn/ui style, Radix primitives, Tailwind 4 tokens.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev -w @dmacq/docs",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "docs:build": "npm run build -w @dmacq/docs",
    "docs:preview": "npm run preview -w @dmacq/docs",
    "typecheck": "tsc --noEmit && npm run typecheck -w @dmacq/docs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/noto-sans": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.540.0",
    "radix-ui": "^1.4.0",
    "react-day-picker": "^9.8.0",
    "react-resizable-panels": "^4.15.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
