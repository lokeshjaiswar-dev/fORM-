nse' : 'outline')\n  const common = { 'data-slot': 'chip', 'data-kind': kind, 'data-color': color, 'data-appearance': look } as const\n  const classes = cn(BASE, SIZE[size], className)\n\n  if (kind === 'status') {\n    return (\n      <span {...(props as React.ComponentProps<'span'>)} {...common} aria-disabled={disabled || undefined} className={cn(classes, 'pointer-events-none')}>\n        {dot && <span aria-hidden className=\"size-1.5 shrink-0 rounded-full bg-current\" />}\n        {children}\n      </span>\n    )\n  }\n\n  if (kind === 'input') {\n    const { onClick, ...rest } = props\n    const text = typeof children === 'string' || typeof children === 'number' ? String(children) : undefined\n    return (\n      <span role=\"group\" aria-label={text} {...(rest as React.ComponentProps<'span'>)} {...common} aria-disabled={disabled || undefined} className={cn(classes, 'pr-1 has-[button:focus-visible]:outline-2 has-[button:focus-visible]:outline-offset-2 has-[button:focus-visible]:outline-(--focus-ring)')}>\n        {icon}\n        <button type=\"button\" disabled={disabled} onClick={onClick} className=\"rounded-full outline-none focus-visible:underline focus-visible:underline-offset-2\">\n          {children}\n        </button>\n        <button\n          type=\"button\"\n          disabled={disabled}\n          aria-label={removeLabel ?? (text ? `Remove ${text}` : 'Remove')}\n          onClick={onRemove}\n          className=\"relative inline-flex size-4 items-center justify-center rounded-full transition-colors after:absolute after:-inset-1 after:content-[''] hover:bg-black/10 dark:hover:bg-white/15 [&_svg]:size-3 outline-none focus-visible:bg-black/20 dark:focus-visible:bg-white/25\"\n        >\n          <X aria-hidden />\n        </button>\n      </span>\n    )\n  }\n\n  return (\n    <button\n      type=\"button\"\n      {...props}\n      {...common}\n      aria-pressed={kind === 'filter' ? selected : undefined}\n      data-selected={kind === 'filter' ? selected : undefined}\n      disabled={disabled}\n      className={classes}\n    >\n      {kind === 'filter' && selected ? <Check aria-hidden /> : icon}\n      {children}\n    </button>\n  )\n}\n\nexport { Chip }\n","import * as React from 'react'\nimport { Collapsible as CollapsiblePrimitive } from 'radix-ui'\nimport { ChevronDownIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\nfunction Collapsible(props: React.ComponentProps<typeof CollapsiblePrimitive.Root>) {\n  return <CollapsiblePrimitive.Root data-slot=\"collapsible\" {...props} />\n}\n\nfunction CollapsibleTrigger({ className, ...props }: React.ComponentProps<typeof CollapsiblePrimitive.CollapsibleTrigger>) {\n  return <CollapsiblePrimitive.CollapsibleTrigger data-slot=\"collapsible-trigger\" className={cn('group/collapsible-trigger', className)} {...props} />\n}\n\n/** Eases open and closed like Accordion (height, 200ms, no motion for reduced-motion users). Clipping is only on while it animates, so focus rings of the content are never cut. */\nfunction CollapsibleContent({ className, ...props }: React.ComponentProps<typeof CollapsiblePrimitive.CollapsibleContent>) {\n  return <CollapsiblePrimitive.CollapsibleContent data-slot=\"collapsible-content\" className={cn('ds-collapsible-content', className)} {...props} />\n}\n\n/**\n * A chevron that turns upside down while its `CollapsibleTrigger` is open, so every \"show more\" does not rewrite the rotation.\n * Put it inside the trigger (or inside a Button that is the trigger with `asChild`).\n */\nfunction CollapsibleChevron({ className, ...props }: React.ComponentProps<typeof ChevronDownIcon>) {\n  return (\n    <ChevronDownIcon\n      aria-hidden\n      data-slot=\"collapsible-chevron\"\n      className={cn('transition-transform duration-(--dur-moderate) ease-(--ease-standard) group-data-[state=open]/collapsible-trigger:rotate-180', className)}\n      {...props}\n    />\n  )\n}\n\nexport { Collapsible, CollapsibleTrigger, CollapsibleContent, CollapsibleChevron }\n","import * as React from 'react'\nimport { ContextMenu as ContextMenuPrimitive } from 'radix-ui'\nimport { CheckIcon, ChevronRightIcon, MinusIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { useNarrowScreen } from '../hooks/use-narrow-screen'\n\nconst iconRules = \"[&_svg:not([class*='size-'])]:size-4 [&_svg:not([class*='text-'])]:text-icon-muted\"\n\n/** Right-click menu (Figma: Dropdown Menu, opened from the pointer). Same panel, rows, icons and motion as `DropdownMenu`. */\nfunction ContextMenu(props: React.ComponentProps<typeof ContextMenuPrimitive.Root>) {\n  return <ContextMenuPrimitive.Root data-slot=\"context-menu\" {...props} />\n}\n\n/** The area that opens the menu: right-click, long-press on touch, or Shift+F10 / the ContextMenu key while it has focus. */\nfunction ContextMenuTrigger(props: React.ComponentProps<typeof ContextMenuPrimitive.Trigger>) {\n  return <ContextMenuPrimitive.Trigger data-slot=\"context-menu-trigger\" {...props} />\n}\n\nfunction ContextMenuPortal(props: React.ComponentProps<typeof ContextMenuPrimitive.Portal>) {\n  return <ContextMenuPrimitive.Portal data-slot=\"context-menu-portal\" {...props} />\n}\n\nfunction ContextMenuGroup(props: React.ComponentProps<typeof ContextMenuPrimitive.Group>) {\n  return <ContextMenuPrimitive.Group data-slot=\"context-menu-group\" {...props} />\n}\n\nfunction ContextMenuSub(props: React.ComponentProps<typeof ContextMenuPrimitive.Sub>) {\n  return <ContextMenuPrimitive.Sub data-slot=\"context-menu-sub\" {...props} />\n}\n\nfunction ContextMenuRadioGroup(props: React.ComponentProps<typeof ContextMenuPrimitive.RadioGroup>) {\n  return <ContextMenuPrimitive.RadioGroup data-slot=\"context-menu-radio-group\" {...props} />\n}\n\n/** Menu panel: 8 radius, 4 padding, 1px highlighted border, mid elevation. Opens at the pointer. */\nfunction ContextMenuContent({ className, ...props }: React.ComponentProps<typeof ContextMenuPrimitive.Content>) {\n  return (\n    <ContextMenuPrimitive.Portal>\n      <ContextMenuPrimitive.Content\n        data-slot=\"context-menu-content\"\n        collisionPadding={8}\n        className={cn(\n          'ds-menu ds-scroll z-(--z-popover) max-h-(--radix-context-menu-content-available-height) min-w-[10rem] max-w-(--radix-context-menu-content-available-width) origin-(--radix-context-menu-content-transform-origin) overflow-x-hidden overflow-y-auto data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2',\n          className,\n        )}\n        {...props}\n      />\n    </ContextMenuPrimitive.Portal>\n  )\n}\n\n/** Option row: 36 high, 12 / 8 padding, medium 14/20, hover fill, disabled grey. `variant=\"destructive\"` turns it red. */\nfunction ContextMenuItem({\n  className,\n  inset,\n  variant = 'default',\n  ...props\n}: React.ComponentProps<typeof ContextMenuPrimitive.Item> & {\n  /** Indents the label to line up with rows that have a check or an icon. */\n  inset?: boolean\n  /** `destructive` is for actions that delete or discard. */\n  variant?: 'default' | 'destructive'\n}) {\n  return (\n    <ContextMenuPrimitive.Item\n      data-slot=\"context-menu-item\"\n      data-inset={inset}\n      data-variant={variant}\n      className={cn(\n        'ds-option data-[inset]:pl-8 data-[variant=destructive]:text-negative data-[variant=destructive]:data-[highlighted]:bg-negative-faded data-[variant=destructive]:data-[highlighted]:text-negative data-[variant=destructive]:[&_svg:not([class*=text-])]:text-negative',\n        iconRules,\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\n/** Multi-select row: a checkbox before the label. */\nfunction ContextMenuCheckboxItem({ className, children, checked, ...props 