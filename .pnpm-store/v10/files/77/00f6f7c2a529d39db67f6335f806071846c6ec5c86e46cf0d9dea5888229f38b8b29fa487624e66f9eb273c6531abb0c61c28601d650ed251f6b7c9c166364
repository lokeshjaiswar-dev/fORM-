nimport { Toaster as Sonner, type ToasterProps } from 'sonner'\nimport { CircleAlert, CircleCheck, Info, TriangleAlert, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Loader } from './loader'\n\n/**\n * Toast. Figma Alert / Toast page 2166:3834, frame \"Toast\" 2169:16965: 360x36, 4px radius, 16px icon, one line of text, close X.\n * `appearance` picks the Figma variant: \"intense\" (solid fill, white text, default) or \"subtle\" (tint, dark text).\n * Sonner type -> Figma colour: success = Success (positive), error = Negative, warning = Ideal (notice), info = Primary, default/loading = Neutral.\n * `theme` follows the `dark` class on <html> unless you pass it. The colours, sizes and the inline close button are set in src/styles/ds-overlays.css (`.ds-toaster`), because sonner draws its own DOM.\n */\ntype ToasterAppearance = 'intense' | 'subtle'\n\n/** The design system's dark mode is the `dark` class on <html>, not prefers-color-scheme: follow it (and its changes) unless `theme` is passed. */\nfunction useDocumentTheme(): 'light' | 'dark' {\n  const read = () => (typeof document !== 'undefined' && document.documentElement.classList.contains('dark') ? 'dark' : 'light')\n  const [theme, setTheme] = React.useState<'light' | 'dark'>(read)\n  React.useEffect(() => {\n    setTheme(read())\n    const observer = new MutationObserver(() => setTheme(read()))\n    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })\n    return () => observer.disconnect()\n  }, [])\n  return theme\n}\n\nfunction Toaster({\n  appearance = 'intense',\n  className,\n  position = 'bottom-left',\n  richColors = true,\n  closeButton = true,\n  expand = true,\n  gap = 12,\n  toastOptions,\n  icons,\n  theme,\n  ...props\n}: ToasterProps & { appearance?: ToasterAppearance }) {\n  const documentTheme = useDocumentTheme()\n  return (\n    <Sonner\n      theme={theme ?? documentTheme}\n      className={cn('toaster group ds-toaster', appearance === 'subtle' && 'ds-toaster-subtle', className)}\n      position={position}\n      richColors={richColors}\n      closeButton={closeButton}\n      expand={expand}\n      gap={gap}\n      icons={{\n        success: <CircleCheck className=\"size-4\" />,\n        info: <Info className=\"size-4\" />,\n        warning: <TriangleAlert className=\"size-4\" />,\n        error: <CircleAlert className=\"size-4\" />,\n        loading: <Loader size=\"sm\" tone=\"current\" aria-hidden />,\n        close: <XIcon className=\"size-4\" />,\n        ...icons,\n      }}\n      toastOptions={{\n        ...toastOptions,\n        classNames: {\n          toast: 'ds-toast',\n          icon: 'ds-toast-icon',\n          closeButton: 'ds-toast-close',\n          actionButton: 'ds-toast-action',\n          cancelButton: 'ds-toast-cancel',\n          ...toastOptions?.classNames,\n        },\n      }}\n      {...props}\n    />\n  )\n}\n\nexport type ToastTone = 'primary' | 'positive' | 'negative' | 'notice' | 'neutral'\n\nconst TOAST_FILL: Record<ToastTone, Record<ToasterAppearance, string>> = {\n  primary: { intense: 'bg-ov-primary text-white shadow-md', subtle: 'border border-border bg-primary-faded text-foreground [&>svg:first-child]:text-primary-text' },\n  positive: { intense: 'bg-ov-positive text-white shadow-md', subtle: 'border border-border bg-positive-faded text-foreground [&>svg:first-child]:text-positive' },\n  negative: { intense: 'bg-ov-negative text-white shadow-md', subtle: 'border border-border bg-negative-faded text-foreground [&>svg:first-child]:text-negative' },\n  notice: { intense: 'bg-ov-notice text-white shadow-md', subtle: 'border border-border bg-notice-faded text-foreground [&>svg:first-child]:text-notice-text' },\n  neutral: { intense: 'bg-ov-neutral text-white shadow-md', subtle: 'border border-border bg-neutral-faded text-foreground' },\n}\n\nconst TONE_ICON: Record<ToastTone, React.ReactNode> = {\n  primary: <Info className=\"size-4 shrink-0\" />,\n  positive: <CircleCheck className=\"size-4 shrink-0\" />,\n  negative: <CircleAlert className=\"size-4 shrink-0\" />,\n  notice: <TriangleAlert className=\"size-4 shrink-0\" />,\n  neutral: <Info className=\"size-4 shrink-0\" />,\n}\n\n/**\n * Static toast, the same look as a sonner toast, for places that need a toast-shaped message in the page\n * (design-system gallery, inline confirmations). Real notifications go through `toast.success(...)` and the `Toaster`.\n */\nfunction ToastCard({\n  tone = 'neutral',\n  appearance = 'intense',\n  icon,\n  action,\n  onClose,\n  closeLabel = 'Dismiss',\n  className,\n  children,\n  ...props\n}: Omit<React.ComponentProps<'div'>, 'children'> & {\n  tone?: ToastTone\n  appearance?: ToasterAppearance\n  icon?: React.ReactNode\n  /** Optional action, rendered before the close X (for example a small outlined button). */\n  action?: React.ReactNode\n  onClose?: () => void\n  /** accessible name of the close button (default \"Dismiss\") */\n  closeLabel?: string\n  children: React.ReactNode\n}) {\n  return (\n    <div\n      data-slot=\"toast-card\"\n      role=\"status\"\n      data-tone={tone}\n      data-appearance={appearance}\n      className={cn('group/toast flex min-h-9 w-full max-w-[360px] items-center gap-2 rounded-lg px-3 py-2 text-xs data-[appearance=intense]:[--focus-ring:var(--focus-ring-inverse)]', TOAST_FILL[tone][appearance], className)}\n      {...props}\n    >\n      {icon ?? TONE_ICON[tone]}\n      <div className=\"min-w-0 flex-1\">{children}</div>\n      {action}\n      {onClose && (\n        <button\n          type=\"button\"\n          aria-label={closeLabel}\n          onClick={onClose}\n          className=\"-my-0.5 -mr-1 grid size-6 shrink-0 place-items-center rounded-sm opacity-85 transition-colors hover:bg-current/15 hover:opacity-100 ds-focus\"\n        >\n          <XIcon className=\"size-4\" />\n        </button>\n      )}\n    </div>\n  )\n}\n\nexport { Toaster, ToastCard }\n","import * as React from 'react'\nimport { Popover as PopoverPrimitive } from 'radix-ui'\nimport { ChevronLeft, ChevronRight, XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { buttonVariants } from './button'\n\n/**\n * Spotlight popover. Figma Spotlight Popover page 3649:3739: a 360px card with a 6px tip that points at the element it explains, used for\n * guided tours and \"what is this\" hints. Header (headline, optional leading icon, close X), body text or any slot, footer with a step counter\n * (\"1 of 5\") and either Secondary / Primary buttons or two arrow buttons (Figma Button Type Default | Action).\n *\n * <SpotlightPopover open={open} onOpenChange={setOpen} side=\"right\" tip=\"start\" title=\"Create a document\" step={{ current: 1, total: 5 }}\n *   anchor={<Button>New document</Button>} secondaryLabel=\"Skip\" primaryLabel=\"Next\" onPrimary={next}>\n *   Documents hold the files, reviewers and due dates.\n * </SpotlightPopover>\n *\n * `dim` darkens the page behind the popover and lifts the anchor above the dimming (the anchor must not sit inside a stacking context of its own).\n * `SpotlightCard` is the same card without Radix, with a drawn tip, for previews.\n */\ntype SpotlightSide = 'top' | 'right' | 'bottom' | 'left'\ntype SpotlightTip = 'start' | 'center' | 'end'\n\ninterface SpotlightContentProps {\n  title: React.ReactNode\n  /** Leading icon in the header (Figma \"With Leading Icon\"). */\n  icon?: React.ReactNode\n  /** false is the Figma \"Only Headline\" header: no close X. */\n  showClose?: boolean\n  onClose?: () => void\n  /** Body text or any slot. */\n  children?: React.ReactNode\n  step?: { current: number; total: number }\n  /** `buttons` (Secondary and Primary, default) or `arrows` (previous and next icon buttons). */\n  actions?: 'buttons' | 'arrows'\n  secondaryLabel?: string\n  primaryLabel?: string\n  onSecondary?: () => void\n  onPrimary?: () => void\n  onPrev?: () => void\n  onNext?: () => void\n  /** Disables the previous / next arrow at the ends of a tour. */\n  prevDisabled?: boolean\n  nextDisabled?: boolean\n}\n\n// the card floats over the page with no scrim, so its edge is the menu edge (visible in light and dark) and its depth the mid elevation, like a popover\nconst surface = 'w-[360px] max-w-[calc(100vw-2rem)] rounded-lg border border-(--menu-border) bg-card p-4 text-card-foreground shadow-(--elevation-mid)'\n\n/** Text (\"Secondary\", ghost) or filled (\"Primary\") button. Both are `Button`s at the small size, so hover, disabled and density follow the rest of the library. */\nfunction SpotlightButton({ className, variant = 'text', type = 'button', ...props }: React.ComponentProps<'button'> & { variant?: 'text' | 'filled' }) {\n  return (\n    <button\n      type={type}\n      data-slot=\"spotlight-button\"\n      data-autofocus={variant === 'filled' ? '' : undefined}\n      className={buttonVariants({ variant: variant === 'text' ? 'ghost' : 'default', color: variant === 'text' ? 'primary' : undefined, size: 'sm', className })}\n      {...props}\n    />\n  )\n}\n\n/** Previous / next icon button (outlined, small), disabled at the ends of a tour. */\nfunction SpotlightArrowButton({ className, ...props }: React.ComponentProps<'button'>) {\n  return <button type=\"button\" data-slot=\"spotlight-arrow\" className={buttonVariants({ variant: 'secondary', size: 'icon-sm', className })} {...props} />\n}\n\n/** Header, body and footer of the card, shared by the live popover and the static card. `Close` is the Radix close in a live popover. */\nfunction SpotlightLayout({\n  title,\n  icon,\n  showClose = true,\n  onClose,\n  children,\n  step,\n  actions = 'buttons',\n  secondaryLabel = 'Secondary',\n  primaryLabel = 'Primary',\n  onSecondary,\n  onPrimary,\n  onPrev,\n  onNext,\n  prevDisabled,\n  nextDisabled,\n  Close,\n  titleId,\n}: SpotlightContentProps & { Close?: typeof PopoverPrimitive.Close; titleId?: string }) {\n  const closeClass =\n    '-mt-0.5 -mr-1 grid size-7 shrink-0 place-items-center rounded-md text-icon-normal opacity-80 transition-colors hover:bg-accent hover:opacity-100 [&_svg]:size-4 ds-focus'\n  return (\n    <>\n      <div data-slot=\"spotlight-header\" className=\"flex items-start gap-2\">\n        {icon && <span className=\"mt-0.5 grid size-5 shrink-0 place-items-center text-icon-normal [&_svg]:size-5\">{icon}</span>}\n        <h3 id={titleId} className=\"min-w-0 flex-1 text-lg leading-6 font-semibold text-foreground\">{title}</h3>\n        {showClose &&\n          (Close ? (\n            <Close aria-label=\"Close\" className={closeClass}>\n              <XIcon />\n            </Close>\n          ) : (\n            <button type=\"button\" aria-label=\"Close\" onClick={onClose} className={closeClass}>\n              <XIcon />\n            </button>\n          ))}\n      </div>\n      {children != null && <div data-slot=\"spotlight-body\" className=\"mt-2 text-base text-text-subtle\">{children}</div>}\n      <div data-slot=\"spotlight-footer\" className=\"mt-4 flex min-h-7 items-center gap-2\">\n        {step && (\n          <span className=\"text-sm font-medium text-foreground\" aria-label={`Step ${step.current} of ${step.total}`}>\n            {step.current} of {step.total}\n          </span>\n        )}\n        <div className=\"ml-auto flex items-center gap-2\">\n          {actions === 'arrows' ? (\n            <>\n              <SpotlightArrowButton aria-label=\"Previous step\" onClick={onPrev} disabled={prevDisabled}>\n                <ChevronLeft />\n              </SpotlightArrowButton>\n              <SpotlightArrowButton aria-label=\"Next step\" data-autofocus onClick={onNext} disabled={nextDisabled}>\n                <ChevronRight />\n              </SpotlightArrowButton>\n            </>\n          ) : (\n            <>\n              <SpotlightButton onClick={onSecondary}>{secondaryLabel}</SpotlightButton>\n              <SpotlightButton variant=\"filled\" onClick={onPrimary}>\n                {primaryLabel}\n              </SpotlightButton>\n            </>\n          )}\n        </div>\n      </div>\n    </>\n  )\n}\n\nconst CARD_WIDTH = 360\nconst GUTTER = 16\n\n/**\n * The side a card can use. `left` and `right` need the whole card to fit between the anchor and the window edge (Radix only flips to the opposite side\n * and shifts along the other axis, so a card that fits on neither side would be cut off). When neither side fits, the card sits below the anchor.\n */\nfunction fitSide(side: SpotlightSide, anchor: DOMRect, offset: number): SpotlightSide {\n  if (side !== 'left' && side !== 'right') return side\n  const width = Math.min(CARD_WIDTH, window.innerWidth - 2 * GUTTER) + offset\n  const fitsRight = anchor.right + width + GUTTER <= window.innerWidth\n  const fitsLeft = anchor.left - width - GUTTER >= 0\n  return fitsRight || fitsLeft ? side : 'bottom'\n}\n\n/** Interactive popover anchored to `anchor`. Controlled with `open` and `onOpenChange`. A `left` or `right` card that fits on neither side of its anchor (a phone, a narrow window) sits below it (`bottom`) instead. */\nfunction SpotlightPopover({\n  open,\n  onOpenChange,\n  anchor,\n  side = 'right',\n  tip = 'start',\n  sideOffset = 12,\n  dim = false,\n  className,\n  ...content\n}: SpotlightContentProps & {\n  open: boolean\n  onOpenChange: (open: boolean) => void\n  anchor: React.ReactNode\n  side?: SpotlightSide\n  /** Where the tip sits along the edge of the card: it follows this alignment. */\n  tip?: SpotlightTip\n  sideOffset?: number\n  dim?: boolean\n  className?: string\n}) {\n  const titleId = React.useId()\n  const anchorRef = React.useRef<HTMLSpanElement>(null)\n  const [placedSide, setPlacedSide] = React.useState<SpotlightSide>(side)\n  // decide the side from where the anchor is, before the card paints, and again when the window is resized\n  React.useLayoutEffect(() => {\n    if (!open) return\n    const place = () => {\n      const rect = anchorRef.current?.getBoundingClientRect()\n      setPlacedSide(rect ? fitSide(side, rect, sideOffset) : side)\n    }\n    place()\n    window.addEventListener('resize', place)\n    return () => window.removeEventListener('resize', place)\n  }, [open, side, sideOffset])\n  const contentRef = React.useRef<HTMLDivElement>(null)\n  const opener = React.useRef<HTMLElement | null>(null)\n  return (\n    <PopoverPrimitive.Root open={open} onOpenChange={onOpenChange}>\n      <PopoverPrimitive.Anchor asChild>\n        <span ref={anchorRef} className={cn('inline-flex rounded-md', dim && open && 'relative z-[45]')}>{anchor}</span>\n      </PopoverPrimitive.Anchor>\n      {dim && (\n        <PopoverPrimitive.Portal>\n          <div aria-hidden className=\"ov-spotlight-scrim fixed inset-0 z-40 bg-scrim\" />\n        </PopoverPrimitive.Portal>\n      )}\n      <PopoverPrimitive.Portal>\n        <PopoverPrimitive.Content\n          ref={contentRef}\n          data-slot=\"spotlight-popover\"\n          aria-labelledby={titleId}\n          // a tour moves forward with Enter: the primary / next button takes focus when the card opens, falling back to the first control\n          onOpenAutoFocus={(event) => {\n            opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n            const primary = contentRef.current?.querySelector<HTMLElement>('[data-autofocus]:not(:disabled)')\n            if (!primary) return\n            event.preventDefault()\n            primary.focus()\n          }}\n          // the anchor is not a Trigger, so Radix has nothing to return focus to: give it back to whatever had it when the card opened (the \"Show hint\" button),\n          // or, for a card opened from a timer or from a previous step, to the control inside the anchor\n          onCloseAutoFocus={(event) => {\n            event.preventDefault()\n            const before = opener.current && opener.current !== document.body && opener.current.isConnected ? opener.current : null\n            const target = before ?? anchorRef.current?.querySelector<HTMLElement>('button, a[href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])')\n            target?.focus()\n          }}\n          side={placedSide}\n          align={tip}\n          sideOffset={sideOffset}\n          arrowPadding={8}\n          collisionPadding={16}\n          className={cn(\n            surface,\n            'z-(--z-popover) origin-(--radix-popover-content-transform-origin) outline-none data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0',\n            className,\n          )}\n        >\n          <SpotlightLayout {...content} titleId={titleId} onClose={() => onOpenChange(false)} Close={PopoverPrimitive.Close} />\n          <PopoverPrimitive.Arrow width={16} height={6} className={cn('fill-card', TIP_EDGE)} />\n        </PopoverPrimitive.Content>\n      </PopoverPrimitive.Portal>\n    </PopoverPrimitive.Root>\n  )\n}\n\n/** A hairline in the card's edge colour around the tip, so the edge does not break where the tip starts. */\nconst TIP_EDGE = '[filter:drop-shadow(0_0_0.5px_var(--menu-border))_drop-shadow(0_0_0.5px_var(--menu-border))]'\n\n// `side` is the side of the anchor the card sits on, so the tip points back to the opposite edge of the card\nconst TIP_BOX: Record<SpotlightSide, string> = {\n  right: 'left-[-6px] h-4 w-[6px]',\n  left: 'right-[-6px] h-4 w-[6px]',\n  bottom: 'top-[-6px] h-[6px] w-4',\n  top: 'bottom-[-6px] h-[6px] w-4',\n}\n\nconst TIP_CLIP: Record<SpotlightSide, string> = {\n  right: '[clip-path:polygon(100%_0,0_50%,100%_100%)]',\n  left: '[clip-path:polygon(0_0,100%_50%,0_100%)]',\n  bottom: '[clip-path:polygon(0_100%,50%_0,100%_100%)]',\n  top: '[clip-path:polygon(0_0,50%_100%,100%_0)]',\n}\n\nconst TIP_ALIGN: Record<'x' | 'y', Record<SpotlightTip, string>> = {\n  y: { start: 'top-2', center: 'top-1/2 -translate-y-1/2', end: 'bottom-2' },\n  x: { start: 'left-2', center: 'left-1/2 -translate-x-1/2', end: 'right-2' },\n}\n\n/** Non-interactive copy of the card with a drawn tip. `side` is where the card sits relative to what it explains (as on the popover). */\nfunction SpotlightCard({\n  side = 'right',\n  tip = 'start',\n  hideTip = false,\n  className,\n  ...content\n}: SpotlightContentProps & { side?: SpotlightSide; tip?: SpotlightTip; hideTip?: boolean; className?: string }) {\n  const axis = side === 'left' || side === 'right' ? 'y' : 'x'\n  return (\n    <div data-slot=\"spotlight-card\" data-side={side} data-tip={tip} className={cn(surface, 'relative', className)}>\n      {!hideTip && (\n        <span aria-hidden className={cn('absolute', TIP_EDGE, TIP_ALIGN[axis][tip], TIP_BOX[side])}>\n          <span className={cn('block size-full bg-card', TIP_CLIP[side])} />\n        </span>\n      )}\n      <SpotlightLayout {...content} />\n    </div>\n  )\n}\n\nexport { SpotlightArrowButton, SpotlightButton, SpotlightCard, SpotlightPopover }\nexport type { SpotlightSide, SpotlightTip }\n","import * as React from 'react'\n\n/**\n * Tells which edges of a horizontally scrolling element still have content past them, so the list can fade those edges (class `ds-scroll-fade-x`)\n * and the reader sees that more is there. Returns a ref callback (merged with `external`) and `{ start, end }`; spread `data-scroll-start` and\n * `data-scroll-end` from them onto the element. It re-measures on scroll and when the element or its children change size.\n */\nexport function useScrollEdges<T extends HTMLElement>(external?: React.Ref<T>) {\n  const [edges, setEdges] = React.useState({ start: false, end: false })\n  const cleanup = React.useRef<(() => void) | null>(null)\n\n  const ref = React.useCallback(\n    (node: T | null) => {\n      cleanup.current?.()\n      cleanup.current = null\n      if (typeof external === 'function') external(node)\n      else if (external) (external as React.RefObject<T | null>).current = node\n      if (!node) return\n      const measure = () => {\n        const max = node.scrollWidth - node.clientWidth\n        const left = Math.abs(node.scrollLeft)\n        const next = { start: left > 1, end: max - left > 1 }\n        setEdges((prev) => (prev.start === next.start && prev.end === next.end ? prev : next))\n      }\n      measure()\n      node.addEventListener('scroll', measure, { passive: true })\n      const ro = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure)\n      ro?.observe(node)\n      Array.from(node.children).forEach((c) => ro?.observe(c))\n      cleanup.current = () => {\n        node.removeEventListener('scroll', measure)\n        ro?.disconnect()\n      }\n    },\n    [external],\n  )\n\n  return [ref, edges] as const\n}\n","import * as React from 'react'\nimport { cva, type VariantProps } from 'class-variance-authority'\nimport { Check, Minus } from 'lucide-react'\n\nimport { useScrollEdges } from '../hooks/use-scroll-edges'\nimport { useScrollable } from '../hooks/use-scrollable'\n\nimport { cn } from '../lib/utils'\n\n/* Figma Step Wizard 3386:477.\n   Step item: 16 / 20 / 24 circle (Small / Medium / Large) with the step number in Body/Bold (10 / 12 / 14) or, once completed, a solid positive circle with a check.\n   Active: a solid primary circle with a soft halo, so the current step is the one thing you find at a glance (the Figma subtle fill read as a pending step). Pending (In-active): a visible control border, muted text.\n   Error: solid negative circle with \"!\". Skipped: dashed border and a dash. Label Body/Bold 12 / 14 / 16, description Body/Medium_S.\n   Dash: 32px connector, 1.5px; pending neutral, completed positive. Stepper orientation horizontal or vertical; items put the circle beside or above the label. */\ntype StepStatus = 'completed' | 'active' | 'pending' | 'error' | 'skipped'\n\nconst circleVariants = cva('relative grid shrink-0 place-items-center rounded-full font-bold tabular-nums select-none', {\n  variants: {\n    size: { sm: 'size-4 text-xxs', md: 'size-5 text-xs', lg: 'size-6 text-base' },\n    status: {\n      completed: 'bg-(--positive-solid) text-white',\n      active: 'bg-primary text-primary-foreground shadow-[0_0_0_3px_var(--primary-faded)]',\n      pending: 'border border-border-control text-text-muted',\n      error: 'bg-(--negative-solid) text-white',\n      skipped: 'border border-dashed border-border-control text-text-muted',\n    },\n  },\n  defaultVariants: { size: 'lg', status: 'pending' },\n})\n\nconst labelSize = { sm: 'text-xs', md: 'text-base', lg: 'text-lg' } as const\nconst descriptionSize = { sm: 'text-xxs', md: 'text-xs', lg: 'text-sm' } as const\nconst checkSize = { sm: 'size-2.5', md: 'size-3', lg: 'size-3.5' } as const\nconst circlePx = { sm: 16, md: 20, lg: 24 } as const\n\ninterface StepItemProps extends Omit<React.ComponentProps<'div'>, 'children'>, VariantProps<typeof circleVariants> {\n  index: number\n  status: StepStatus\n  label: React.ReactNode\n  description?: React.ReactNode\n  /** circle beside the label (default) or above it, centred */\n  orientation?: 'horizontal' | 'vertical'\n  icon?: React.ReactNode\n}\n\n/** One step: numbered circle (check when completed) with a label and an optional description. */\nfunction StepItem({ index, status, label, description, orientation = 'horizontal', size = 'lg', icon, className, ...props }: StepItemProps) {\n  const s = size ?? 'lg'\n  const vertical = orientation === 'vertical'\n  return (\n    <div\n      data-slot=\"step-item\"\n      data-status={status}\n      className={cn('flex gap-2', vertical ? 'flex-col items-center gap-1 text-center' : 'flex-row items-center', className)}\n      {...props}\n    >\n      <span data-slot=\"step-circle\" className={circleVariants({ size: s, status })}>\n        {status === 'completed' ? (\n          <Check className={checkSize[s]} strokeWidth={3} aria-hidden />\n        ) : status === 'error' ? (\n          '!'\n        ) : status === 'skipped' && !icon ? (\n          <Minus className={checkSize[s]} strokeWidth={3} aria-hidden />\n        ) : (\n          (icon ?? index + 1)\n        )}\n      </span>\n      <span className={cn('flex min-w-0 flex-col', vertical ? 'items-center gap-0' : 'items-start')}>\n        <span className={cn('font-bold', labelSize[s], status === 'pending' || status === 'skipped' ? 'text-text-muted' : status === 'error' ? 'text-negative' : 'text-foreground')}>{label}</span>\n        {description && (\n          <span className={cn('font-medium', descriptionSize[s], status === 'pending' || status === 'skipped' ? 'text-text-muted' : 'text-text-subtle')}>{description}</span>\n        )}\n      </span>\n    </div>\n  )\n}\n\n/** Connector between two steps (Figma Dash): 32px long, completed in positive, otherwise neutral. */\nfunction StepDash({ done = false, orientation = 'horizontal', className, ...props }: { done?: boolean; orientation?: 'horizontal' | 'vertical' } & React.ComponentProps<'span'>) {\n  return (\n    <span\n      data-slot=\"step-dash\"\n      data-done={done}\n      aria-hidden=\"true\"\n      className={cn(\n        'shrink-0',\n        orientation === 'horizontal' ? 'h-[1.5px] w-8' : 'h-8 w-[1.5px]',\n        done ? 'bg-(--step-dash-done)' : 'bg-(--step-dash-pending)',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\ninterface StepperStep {\n  id?: string\n  label: React.ReactNode\n  description?: React.ReactNode\n  /** override the status derived from `current` */\n  status?: StepStatus\n  icon?: React.ReactNode\n}\n\ninterface StepperProps extends Omit<React.ComponentProps<'ol'>, 'children'> {\n  steps: StepperStep[]\n  /** 0-based index of the current step: earlier steps are completed, later ones pending. A value of steps.length or more completes them all. */\n  current?: number\n  orientation?: 'horizontal' | 'vertical'\n  /** where each circle sits relative to its label */\n  itemOrientation?: 'horizontal' | 'vertical'\n  size?: 'sm' | 'md' | 'lg'\n  /** makes completed, error and skipped steps buttons (jump back to a step). The current step and pending steps are never buttons. */\n  onStepClick?: (index: number) => void\n}\n\nconst statusHint: Record<StepStatus, string> = {\n  completed: ' (completed)',\n  active: ' (current step)',\n  pending: ' (not started)',\n  error: ' (needs attention)',\n  skipped: ' (skipped)',\n}\n\n/**\n * A horizontal stepper that is wider than its container scrolls sideways (the edge that still has steps fades) and keeps the current step in view; give it a width, or put it in a flex or grid cell, and it needs no wrapper.\n * With `onStepClick`, completed, error and skipped steps are buttons; the current step and pending steps are not.\n */\nfunction Stepper({ steps, current = 0, orientation = 'horizontal', itemOrientation = 'horizontal', size = 'lg', onStepClick, className, ref, ...props }: StepperProps) {\n  const status = (i: number): StepStatus => steps[i].status ?? (i < current ? 'completed' : i === current ? 'active' : 'pending')\n  const horizontal = orientation === 'horizontal'\n  const [scrollRef, scrollable] = useScrollable<HTMLOListElement>(ref)\n  const [edgesRef, edges] = useScrollEdges<HTMLOListElement>(scrollRef)\n  /* keep the current step visible when the list scrolls: centre it when it is clipped (sets scrollLeft, so the page itself never scrolls) */\n  const listRef = React.useRef<HTMLOListElement | null>(null)\n  const setRef = React.useCallback(\n    (node: HTMLOListElement | null) => {\n      listRef.current = node\n      edgesRef(node)\n    },\n    [edgesRef],\n  )\n  React.useEffect(() => {\n    const list = listRef.current\n    const li = list?.querySelector<HTMLElement>('[aria-current=\"step\"]')\n    if (!list || !li || !horizontal || list.scrollWidth <= list.clientWidth) return\n    const outside = li.offsetLeft < list.scrollLeft || li.offsetLeft + li.offsetWidth > list.scrollLeft + list.clientWidth\n    if (outside) list.scrollLeft = li.offsetLeft - (list.clientWidth - li.offsetWidth) / 2\n  }, [current, horizontal, steps.length])\n  const itemsTop = horizontal && itemOrientation === 'vertical'\n  return (\n    <ol\n      ref={horizontal ? setRef : ref}\n      data-slot=\"stepper\"\n      data-orientation={orientation}\n      data-scroll-start={horizontal && edges.start ? '' : undefined}\n      data-scroll-end={horizontal && edges.end ? '' : undefined}\n      // a list that scrolls is a tab stop, so the keyboard can scroll it too\n      tabIndex={horizontal && scrollable ? 0 : undefined}\n      aria-label=\"Progress\"\n      className={cn(\n        'relative flex',\n        horizontal ? 'ds-scroll-fade-x -m-2 flex-row overflow-x-auto rounded-md p-2 ds-focus-inset [scrollbar-width:none] [&::-webkit-scrollbar]:hidden' : 'flex-col items-start',\n        horizontal && (itemsTop ? 'items-start' : 'items-center'),\n        className,\n      )}\n      {...props}\n    >\n      {steps.map((step, i) => {\n        const st = status(i)\n        const clickable = !!onStepClick && st !== 'pending' && st !== 'active'\n        const item = (\n          <StepItem\n            index={i}\n            status={st}\n            label={step.label}\n            description={step.description}\n            orientation={itemOrientation}\n            size={size}\n            icon={step.icon}\n            className={cn(itemOrientation === 'vertical' && 'text-balance', itemOrientation === 'vertical' && size === 'lg' && step.description && 'min-w-18')}\n          />\n        )\n        return (\n          <li\n            key={step.id ?? i}\n            data-status={st}\n            aria-current={st === 'active' ? 'step' : undefined}\n            className={cn('relative flex', horizontal ? 'shrink-0 flex-row' : 'flex-col items-start', horizontal && (itemsTop ? 'items-start' : 'items-center'))}\n          >\n            {i > 0 && (\n              <StepDash\n                done={status(i - 1) === 'completed'}\n                orientation={orientation}\n                className={horizontal ? 'mx-2' : 'my-2'}\n                /* circle-above-label items: the dash runs through the circles' centre line, not the centre of the label block */\n                style={horizontal ? (itemsTop ? { marginTop: circlePx[size] / 2 - 0.75 } : undefined) : { marginLeft: circlePx[size] / 2 - 0.75 }}\n              />\n            )}\n            {clickable ? (\n              <button\n                type=\"button\"\n                onClick={() => onStepClick?.(i)}\n                className=\"-m-1 rounded-md p-1 text-left transition-colors hover:bg-state-hover active:bg-state-pressed motion-reduce:transition-none ds-focus\"\n              >\n                {item}\n              </button>\n            ) : (\n              item\n            )}\n            <span className=\"sr-only\">{statusHint[st]}</span>\n          </li>\n        )\n      })}\n    </ol>\n  )\n}\n\nexport { Stepper, StepItem, StepDash, circleVariants as stepCircleVariants }\nexport type { StepperProps, StepperStep, StepStatus }\n","import * as React from 'react'\nimport { Tabs as TabsPrimitive } from 'radix-ui'\n\nimport { useScrollEdges } from '../hooks/use-scroll-edges'\nimport { cn } from '../lib/utils'\n\n/* Figma Tabs 1785:11908. Tab item: Small 32 / Medium 40 / Large 48 high, label Body/Link (SemiBold) 12 / 13 / 16, padding 10 / 12 / 16.\n   Variants \"Bottom Bordered\" (horizontal), \"Left Bordered\" and \"Right Bordered\" (vertical): a hairline track plus a 2px primary bar on the selected tab.\n   States: default muted, hover subtle text + faded bar, selected primary text + primary bar, focus faded primary wash, disabled.\n   `variant=\"pill\"` keeps the segmented control used for compact switches. */\ntype TabsVariant = 'underline' | 'pill'\ntype TabsSize = 'sm' | 'md' | 'lg'\ntype TabsIndicator = 'bottom' | 'left' | 'right'\n\ninterface TabsContextValue {\n  variant: TabsVariant\n  size: TabsSize\n  indicator: TabsIndicator\n  orientation: 'horizontal' | 'vertical'\n  fullWidth: boolean\n}\n\nconst TabsContext = React.createContext<TabsContextValue>({ variant: 'underline', size: 'md', indicator: 'bottom', orientation: 'horizontal', fullWidth: false })\n\nfunction Tabs({\n  className,\n  variant = 'underline',\n  size = 'md',\n  orientation = 'horizontal',\n  indicator,\n  fullWidth = false,\n  ...props\n}: React.ComponentProps<typeof TabsPrimitive.Root> & {\n  variant?: TabsVariant\n  size?: TabsSize\n  /** which edge carries the selected bar; vertical tabs default to the left edge */\n  indicator?: TabsIndicator\n  /** tabs share the width of the list equally (Figma isFullWidth) */\n  fullWidth?: boolean\n}) {\n  const bar: TabsIndicator = indicator ?? (orientation === 'vertical' ? 'left' : 'bottom')\n  const value = React.useMemo(() => ({ variant, size, indicator: bar, orientation, fullWidth }), [variant, size, bar, orientation, fullWidth])\n  return (\n    <TabsContext.Provider value={value}>\n      <TabsPrimitive.Root\n        data-slot=\"tabs\"\n        orientation={orientation}\n        className={cn('flex gap-3', orientation === 'vertical' ? (bar === 'right' ? 'flex-row-reverse' : 'flex-row') : 'flex-col', className)}\n        {...props}\n      />\n    </TabsContext.Provider>\n  )\n}\n\n/* the hairline track is an inset shadow so the 2px selected bar sits on top of it without overflowing the list box */\nconst listTrack: Record<TabsIndicator, string> = {\n  bottom: 'ds-scroll-fade-x w-full scroll-px-6 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden shadow-[inset_0_-1px_0_0_var(--tab-track)]',\n  left: 'flex-col shadow-[inset_1px_0_0_0_var(--tab-track)]',\n  right: 'flex-col shadow-[inset_-1px_0_0_0_var(--tab-track)]',\n}\n\nfunction TabsList({ className, ref, onFocus, ...props }: React.ComponentProps<typeof TabsPrimitive.List>) {\n  const { variant, size, indicator } = React.useContext(TabsContext)\n  /* an overflowing underline list fades the edge that still has tabs past it, and brings a tab that gets keyboard focu