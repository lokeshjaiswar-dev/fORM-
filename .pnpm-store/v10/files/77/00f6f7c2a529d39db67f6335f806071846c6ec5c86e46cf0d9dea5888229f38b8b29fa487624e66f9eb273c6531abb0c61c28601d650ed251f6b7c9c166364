available('rotate')) {\n    groups.push(\n      <div key=\"rotate\" className=\"flex shrink-0 items-center gap-0.5\">\n        <ToolButton label=\"Rotate left\" disabled={!ready} onClick={() => rotate(-90)}>\n          <RotateCcw />\n        </ToolButton>\n        <ToolButton label=\"Rotate right\" disabled={!ready} onClick={() => rotate(90)}>\n          <RotateCw />\n        </ToolButton>\n      </div>,\n    )\n  }\n  const trailing: React.ReactNode[] = []\n  if (available('download')) {\n    trailing.push(\n      <ToolLink key=\"download\" label=\"Download\" href={src} download={name} onClick={onDownload}>\n        <Download />\n      </ToolLink>,\n    )\n  }\n  if (available('open')) {\n    trailing.push(\n      <ToolLink key=\"open\" label=\"Open in new tab\" href={src} target=\"_blank\" rel=\"noopener noreferrer\">\n        <ExternalLink />\n      </ToolLink>,\n    )\n  }\n  if (available('fullscreen')) {\n    trailing.push(\n      <ToolButton key=\"fullscreen\" label={fullscreen ? 'Exit full screen' : 'Full screen'} pressed={fullscreen} onClick={toggleFullscreen}>\n        {fullscreen ? <Minimize /> : <Maximize />}\n      </ToolButton>,\n    )\n  }\n  const withSeparators = (nodes: React.ReactNode[], prefix: string) =>\n    nodes.flatMap((node, i) => (i === 0 ? [node] : [<Separator key={`${prefix}-${i}`} orientation=\"vertical\" className=\"mx-1 shrink-0 data-[orientation=vertical]:h-5\" />, node]))\n  const hasToolbar = groups.length + trailing.length > 0\n\n  /* ---- header ---- */\n  // the same glyph the file cards draw; the viewer's own detection decides the kind, the name only supplies the extension to print\n  const glyphKind: FileKind = kind === 'unsupported' ? resolveFileKind(name) : kind\n  const defaultMeta =\n    kind === 'pdf' ? 'PDF document' : kind === 'text' ? 'Plain text' : kind === 'image' ? (natural && !failed ? `Image, ${natural.w} × ${natural.h} px` : 'Image') : (extensionOf(name).toUpperCase() || 'File')\n  const status =\n    kind === 'image'\n      ? `Zoom ${percent(scale)}${turned ? `, rotated ${turned} degrees` : ''}`\n      : kind === 'pdf'\n        ? `Page ${page}${pageCount ? ` of ${pageCount}` : ''}, zoom ${zoomLabel}`\n        : kind === 'text'\n          ? `Zoom ${percent(scale)}`\n          : ''\n\n  return (\n    <div\n      ref={rootRef}\n      role=\"region\"\n      aria-labelledby={nameId}\n      data-slot=\"document-viewer\"\n      data-kind={kind}\n      data-fullscreen={fullscreen || undefined}\n      onKeyDown={handleKeyDown}\n      style={fullscreen ? style : { height, ...style }}\n      className={cn(\n        'flex min-w-0 flex-col overflow-hidden rounded-lg border bg-card text-card-foreground',\n        fallbackFullscreen && 'fixed inset-0 z-(--z-overlay) h-auto rounded-none border-0',\n        nativeFullscreen && 'rounded-none border-0',\n        className,\n      )}\n      {...props}\n    >\n      <div data-slot=\"document-viewer-header\" className=\"flex min-h-12 shrink-0 flex-wrap items-center gap-x-3 gap-y-2 border-b px-3 py-2 compact:min-h-11 compact:py-1.5\">\n        <FileTypeIcon kind={glyphKind} type={name} size=\"md\" />\n        <div className=\"min-w-32 flex-1\">\n          <div id={nameId} title={name} className=\"truncate text-sm leading-5 font-semibold text-foreground\">\n            {name}\n          </div>\n          <div className=\"truncate text-xs leading-4 text-text-subtle\">{meta ?? defaultMeta}</div>\n        </div>\n        {actions && <div data-slot=\"document-viewer-actions\" className=\"ml-auto flex shrink-0 items-center gap-2\">{actions}</div>}\n      </div>\n\n      {hasToolbar && (\n        <ToolbarPrimitive.Root\n          data-slot=\"document-viewer-toolbar\"\n          aria-label=\"Document tools\"\n          // wide screens wrap the groups; a phone gets one scrollable row instead of two rows of tiny buttons\n          className=\"ds-scroll flex shrink-0 items-center gap-y-1 border-b bg-surface-moderate px-2 py-1 compact:py-0.5 max-sm:overflow-x-auto sm:flex-wrap\"\n        >\n          {withSeparators(groups, 'g')}\n          {trailing.length > 0 && <div className=\"ml-auto flex shrink-0 items-center gap-0.5 pl-2\">{trailing}</div>}\n        </ToolbarPrimitive.Root>\n      )}\n\n      <div data-slot=\"document-viewer-body\" className=\"relative min-h-40 flex-1 overflow-hidden bg-surface-subtle\">\n        {loading ? (\n          <ViewerSkeleton />\n        ) : failed ? (\n          <ViewerMessage\n            tone=\"error\"\n            icon={<CircleAlert />}\n            title=\"Couldn't load this document\"\n            body={typeof error === 'boolean' || error === undefined || error === null ? `${name} could not be opened. Check your connection and try again.` : error}\n          >\n            <Button variant=\"outline\" size=\"sm\" onClick={retry}>\n              Retry\n            </Button>\n            {!available('download') && <DownloadButton src={src} name={name} onDownload={onDownload} variant=\"ghost\" />}\n          </ViewerMessage>\n        ) : kind === 'unsupported' ? (\n          <ViewerMessage\n            icon={<FileQuestionMark />}\n            title=\"No preview for this file type\"\n            body={`${extensionOf(name) ? `.${extensionOf(name)} files` : 'This file'} can't be shown in the browser. Download it to open it in another app.`}\n          >\n            <DownloadButton src={src} name={name} onDownload={onDownload} />\n          </ViewerMessage>\n        ) : kind === 'image' ? (\n          <div\n            ref={viewportRef}\n            tabIndex={0}\n            role=\"group\"\n            aria-label={`${name}, image preview`}\n            aria-keyshortcuts=\"+ - 0 1\"\n            data-pannable={pannable || undefined}\n            onPointerDown={onPointerDown}\n            onPointerMove={onPointerMove}\n            onPointerUp={endDrag}\n            onPointerCancel={endDrag}\n            onDoubleClick={() => imageReady && toggleActual()}\n            className={cn(\n              'absolute inset-0 touch-none overflow-hidden select-none ds-focus-inset',\n              pannable && (dragging ? 'cursor-grabbing' : 'cursor-grab'),\n            )}\n          >\n            <img\n              key={attempt}\n              src={src}\n              alt={name}\n              draggable={false}\n              onLoad={(e) => setNatural({ w: e.currentTarget.naturalWidth || e.currentTarget.width || 800, h: e.currentTarget.naturalHeight || e.currentTarget.height || 600 })}\n              onError={() => setImageFailed(true)}\n              style={{\n                width: natural?.w,\n                height: natural?.h,\n                visibility: imageReady ? 'visible' : 'hidden',\n                transform: `translate(-50%, -50%) translate(${shownPan.x}px, ${shownPan.y}px) rotate(${rotation}deg) scale(${scale})`,\n              }}\n              className={cn(\n                'absolute top-1/2 left-1/2 max-w-none origin-center',\n                !dragging && 'transition-transform duration-(--dur-base) ease-out motion-reduce:transition-none',\n              )}\n            />\n            {!imageReady && <ViewerSkeleton />}\n          </div>\n        ) : kind === 'pdf' ? (\n          <>\n            <iframe\n              key={attempt}\n              src={pdfSrc}\n              title={`${name} (PDF)`}\n              onLoad={() => setPdfLoaded(true)}\n              className=\"absolute inset-0 size-full border-0 bg-card\"\n            />\n            {!pdfLoaded && <ViewerSkeleton />}\n          </>\n        ) : text.status === 'loading' ? (\n          <ViewerSkeleton />\n        ) : (\n          <div\n            tabIndex={0}\n            role=\"region\"\n            aria-label={`${name}, text preview`}\n            aria-keyshortcuts=\"+ - 0 1\"\n            className=\"absolute inset-0 overflow-auto p-4 ds-focus-inset\"\n          >\n            <pre\n              style={{ fontSize: 13 * scale }}\n              className=\"mx-auto w-fit max-w-full min-w-0 rounded-md border bg-card p-4 font-mono leading-relaxed break-words whitespace-pre-wrap text-foreground\"\n            >\n              {text.value || 'This file is empty.'}\n            </pre>\n          </div>\n        )}\n      </div>\n      <span role=\"status\" aria-live=\"polite\" className=\"sr-only\">\n        {ready ? status : ''}\n      </span>\n    </div>\n  )\n}\n\nfunction ViewerSkeleton() {\n  return (\n    <div role=\"status\" data-slot=\"document-viewer-loading\" className=\"absolute inset-0 flex items-center justify-center overflow-hidden bg-surface-subtle p-6\">\n      <span className=\"sr-only\">Loading document</span>\n      <div aria-hidden className=\"max-h-full w-full max-w-sm space-y-4 overflow-hidden rounded-md border bg-card p-5 shadow-xs\">\n        <Skeleton shape=\"text\" className=\"h-4 w-1/2\" />\n        <SkeletonText lines={4} />\n        <Skeleton className=\"h-20 w-full\" />\n        <SkeletonText lines={3} />\n      </div>\n    </div>\n  )\n}\n\nfunction ViewerMessage({\n  icon,\n  title,\n  body,\n  tone,\n  children,\n}: {\n  icon: React.ReactNode\n  title: string\n  body: React.ReactNode\n  tone?: 'error'\n  children?: React.ReactNode\n}) {\n  return (\n    <div data-slot=\"document-viewer-message\" role={tone === 'error' ? 'alert' : undefined} className=\"absolute inset-0 grid place-items-center overflow-auto p-6\">\n      <div className=\"flex max-w-sm flex-col items-center gap-4 text-center\">\n        <span\n          aria-hidden\n          className={cn('grid size-12 place-items-center rounded-full [&_svg]:size-6', tone === 'error' ? 'bg-negative-faded text-negative' : 'bg-card text-icon-muted shadow-xs')}\n        >\n          {icon}\n        </span>\n        <div className=\"space-y-1\">\n          <p className=\"text-sm font-semibold text-foreground\">{title}</p>\n          <p className=\"text-sm text-text-subtle\">{body}</p>\n        </div>\n        <div className=\"flex flex-wrap items-center justify-center gap-2\">{children}</div>\n      </div>\n    </div>\n  )\n}\n\nfunction DownloadButton({\n  src,\n  name,\n  onDownload,\n  variant = 'default',\n}: Pick<DocumentViewerProps, 'src' | 'name' | 'onDownload'> & { variant?: ButtonProps['variant'] }) {\n  return (\n    <Button asChild variant={variant} size=\"sm\">\n      <a href={src} download={name} onClick={onDownload}>\n        <Download />\n        Download\n      </a>\n    </Button>\n  )\n}\n\n/** Icon button for the toolbar: a roving-focus item with a tooltip and an accessible name. */\nfunction ToolButton({ label, shortcut, children, ...props }: ButtonProps & { label: string; shortcut?: string }) {\n  return (\n    <Tooltip>\n      <TooltipTrigger asChild>\n        <ToolbarPrimitive.Button asChild>\n          <Button variant=\"ghost\" size=\"icon-sm\" aria-label={label} {...props} className={cn('max-sm:size-9', props.className)}>\n            {children}\n          </Button>\n        </ToolbarPrimitive.Button>\n      </TooltipTrigger>\n      <TooltipContent shortcut={shortcut}>{label}</TooltipContent>\n    </Tooltip>\n  )\n}\n\nfunction ToolLink({ label, children, ...props }: React.ComponentProps<'a'> & { label: string }) {\n  return (\n    <Tooltip>\n      <TooltipTrigger asChild>\n        <ToolbarPrimitive.Link asChild>\n          <Button asChild variant=\"ghost\" size=\"icon-sm\" className=\"max-sm:size-9\">\n            <a aria-label={label} {...props}>\n              {children}\n            </a>\n          </Button>\n        </ToolbarPrimitive.Link>\n      </TooltipTrigger>\n      <TooltipContent>{label}</TooltipContent>\n    </Tooltip>\n  )\n}\n\nfunction PageControl({ page, pageCount, disabled, onChange }: { page: number; pageCount?: number; disabled: boolean; onChange: (page: number) => void }) {\n  const [draft, setDraft] = React.useState(String(page))\n  React.useEffect(() => setDraft(String(page)), [page])\n  // typing past the last page shows the error edge right away; the commit still clamps, so nothing is lost\n  const invalid = pageCount !== undefined && Number(draft) > pageCount\n  function commit() {\n    const n = Math.round(Number(draft))\n    if (Number.isFinite(n) && n >= 1) {\n      const next = pageCount === undefined ? n : Math.min(n, pageCount)\n      setDraft(String(next))\n      onChange(next)\n    } else setDraft(String(page))\n  }\n  return (\n    <div className=\"flex shrink-0 items-center gap-0.5\">\n      <ToolButton label=\"Previous page\" disabled={disabled || page <= 1} onClick={() => onChange(page - 1)}>\n        <ChevronLeft />\n      </ToolButton>\n      <input\n        aria-label=\"Page number\"\n        aria-invalid={invalid || undefined}\n        inputMode=\"numeric\"\n        value={draft}\n        disabled={disabled}\n        onChange={(e) => setDraft(e.target.value.replace(/\\D/g, ''))}\n        onFocus={(e) => e.currentTarget.select()}\n        onBlur={commit}\n        onKeyDown={(e) => {\n          if (e.key === 'Enter') commit()\n        }}\n        // the library field surface (boundary, hover, focus ring, error edge) at the toolbar's own height: as tall as the buttons beside it\n        className=\"ds-field h-(--ctl-h-sm) w-10 rounded-md px-1 text-center text-xs font-medium tnum max-sm:h-9\"\n      />\n      {pageCount !== undefined && <span className=\"px-1 text-xs whitespace-nowrap text-text-subtle tnum\">of {pageCount}</span>}\n      <ToolButton label=\"Next page\" disabled={disabled || (pageCount !== undefined && page >= pageCount)} onClick={() => onChange(page + 1)}>\n        <ChevronRight />\n      </ToolButton>\n    </div>\n  )\n}\n\n/**\n * Zoom level button that opens the presets. The menu portals into the viewer (not the page) so it still shows while the viewer is fullscreen,\n * which hides everything outside the fullscreen element.\n */\nfunction ZoomMenu({\n  container,\n  label,\n  value,\n  fitItems,\n  presets,\n  disabled,\n  onChange,\n}: {\n  container: HTMLElement | null\n  label: string\n  value: string\n  fitItems: [string, string][]\n  presets: number[]\n  disabled: boolean\n  onChange: (value: string) => void\n}) {\n  return (\n    <DropdownMenuPrimitive.Root>\n      <DropdownMenuPrimitive.Trigger asChild>\n        <ToolbarPrimitive.Button asChild>\n          <Button variant=\"ghost\" size=\"sm\" caret disabled={disabled} aria-label={`Zoom level, ${label}. Choose a preset`} className=\"min-w-[4.5rem] px-1.5 tnum max-sm:h-9\">\n            {label}\n          </Button>\n        </ToolbarPrimitive.Button>\n      </DropdownMenuPrimitive.Trigger>\n      <DropdownMenuPrimitive.Portal container={container}>\n        <DropdownMenuPrimitive.Content\n          align=\"start\"\n          sideOffset={4}\n          aria-label=\"Zoom presets\"\n          className=\"ds-menu ds-scroll z-(--z-popover) max-h-(--radix-dropdown-menu-content-available-height) min-w-40 origin-(--radix-dropdown-menu-content-transform-origin) overflow-y-auto data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95\"\n        >\n          <DropdownMenuPrimitive.RadioGroup value={value} onValueChange={onChange}>\n            {[...fitItems, ...presets.map((p): [string, string] => [String(p), percent(p)])].map(([v, text]) => (\n              <DropdownMenuPrimitive.RadioItem key={v} value={v} className=\"ds-option\">\n                {text}\n                <span className=\"ds-option-check\">\n                  <DropdownMenuPrimitive.ItemIndicator>\n                    <svg viewBox=\"0 0 16 16\" aria-hidden className=\"size-4\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                      <path d=\"m3.5 8.5 3 3 6-7\" />\n                    </svg>\n                  </DropdownMenuPrimitive.ItemIndicator>\n                </span>\n              </DropdownMenuPrimitive.RadioItem>\n            ))}\n          </DropdownMenuPrimitive.RadioGroup>\n        </DropdownMenuPrimitive.Content>\n      </DropdownMenuPrimitive.Portal>\n    </DropdownMenuPrimitive.Root>\n  )\n}\n\nexport interface DocumentViewerDialogProps extends Omit<DocumentViewerProps, 'title' | 'height'> {\n  /** whether the dialog is open; pass with `onOpenChange` to control it */\n  open?: boolean\n  /** called when the dialog opens or closes */\n  onOpenChange?: (open: boolean) => void\n  /** accessible title of the dialog; defaults to the file name */\n  title?: string\n  /** accessible description read out when the dialog opens */\n  description?: string\n  /** element that opens the dialog when pressed (rendered with `asChild`) */\n  trigger?: React.ReactNode\n}\n\n/** The viewer in a large Dialog. The close button sits in the viewer header after `actions`. */\nfunction DocumentViewerDialog({ open, onOpenChange, title, description, trigger, actions, className, ...viewer }: DocumentViewerDialogProps) {\n  // without a trigger Radix has nothing to hand focus back to, so remember what had focus when the dialog opened\n  const opener = React.useRef<HTMLElement | null>(null)\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      {trigger && <DialogTrigger asChild>{trigger}</DialogTrigger>}\n      <DialogContent\n        showCloseButton={false}\n        className=\"h-[min(90dvh,880px)] max-sm:top-0 max-sm:left-0 max-sm:h-dvh max-sm:max-h-dvh max-sm:max-w-none max-sm:translate-x-0 max-sm:translate-y-0 max-sm:rounded-none max-sm:border-0 sm:max-w-5xl\"\n        onOpenAutoFocus={() => {\n          opener.current = document.activeElement instanceof HTMLElement ? document.activeElement : null\n        }}\n        onCloseAutoFocus={(e) => {\n          if (trigger || !opener.current?.isConnected) return\n          e.preventDefault()\n          opener.current.focus()\n        }}\n      >\n        <DialogTitle className=\"sr-only\">{title ?? viewer.name}</DialogTitle>\n        <DialogDescription className=\"sr-only\">{description ?? 'Document preview. Press Escape to close.'}</DialogDescription>\n        <DocumentViewer\n          {...viewer}\n          height=\"100%\"\n          className={cn('min-h-0 flex-1 rounded-none border-0', className)}\n          actions={\n            <>\n              {actions}\n              <DialogClose asChild>\n                <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Close preview\">\n                  <XIcon />\n                </Button>\n              </DialogClose>\n            </>\n          }\n        />\n      </DialogContent>\n    </Dialog>\n  )\n}\n\nexport { DocumentViewer, DocumentViewerDialog }\n","import * as React from 'react'\nimport { Check, CloudUpload, RotateCw, X } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Button, buttonVariants } from './button'\nimport { FileTypeIcon, resolveFileKind } from './file-card'\nimport { FileName } from './file-name'\nimport { StatusIcon, hitArea, resolveStatus, useFieldAria, useFieldInherit, type FieldStatus } from './field'\nimport { Progress } from './progress'\n\n/* File upload: a drop zone that is also a button, and a list of the files that were picked.\n   The zone only validates and hands over `File` objects (`onFilesAdded`); sending them anywhere is up to the app. The list rows show whatever\n   state the app reports (idle, uploading with progress, done, error with retry). */\n\nexport type FileRejectReason = 'type' | 'size' | 'count'\n\nexport interface FileRejection {\n  file: File\n  /** every rule the file broke; a file can fail on type and size at once */\n  reasons: FileRejectReason[]\n}\n\nexport interface FileValidationRules {\n  /** accepted types: mime types (`application/pdf`), wildcards (`image/*`) and extensions (`.docx`), as an array or the native comma separated string */\n  accept?: string[] | string\n  /** largest allowed file, in bytes */\n  maxSize?: number\n  /** most files allowed in total (see `currentCount`) */\n  maxFiles?: number\n  /** files that are already attached, so `maxFiles` counts them too */\n  currentCount?: number\n}\n\nconst UNITS = ['B', 'KB', 'MB', 'GB', 'TB']\n\n/** 1536 -> \"1.5 KB\", 2_400_000 -> \"2.3 MB\". Binary units (1 KB = 1024 B), one decimal below 10, none above. */\nexport function formatBytes(bytes: number): string {\n  if (!Number.isFinite(bytes) || bytes <= 0) return '0 B'\n  let i = Math.min(UNITS.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)))\n  let v = bytes / 1024 ** i\n  if (i < UNITS.length - 1 && Math.round(v) >= 1024) {\n    i += 1\n    v = bytes / 1024 ** i\n  }\n  const text = i === 0 || v >= 10 ? String(Math.round(v)) : v.toFixed(1).replace(/\\.0$/, '')\n  return `${text} ${UNITS[i]}`\n}\n\nfunction acceptTokens(accept?: string[] | string): string[] {\n  const list = Array.isArray(accept) ? accept : (accept ?? '').split(',')\n  return list.map((t) => t.trim().toLowerCase()).filter(Boolean)\n}\n\nfunction matchesAccept(file: File, tokens: string[]): boolean {\n  if (tokens.length === 0) return true\n  const name = file.name.toLowerCase()\n  const type = file.type.toLowerCase()\n  return tokens.some((t) => {\n    if (t.startsWith('.')) return name.endsWith(t)\n    if (t.endsWith('/*')) return type.startsWith(t.slice(0, -1))\n    return type === t\n  })\n}\n\n/** Split `files` into the ones that pass `rules` and the ones that do not, with the reasons. Order is kept; files that fail on type or size do not use up the count. */\nexport function validateFiles(files: File[], rules: FileValidationRules = {}): { accepted: File[]; rejected: FileRejection[] } {\n  const tokens = acceptTokens(rules.accept)\n  let room = rules.maxFiles == null ? Infinity : Math.max(0, rules.maxFiles - (rules.currentCount ?? 0))\n  const accepted: File[] = []\n  const rejected: FileRejection[] = []\n  for (const file of files) {\n    const reasons: FileRejectReason[] = []\n    if (!matchesAccept(file, tokens)) reasons.push('type')\n    if (rules.maxSize != null && file.size > rules.maxSize) reasons.push('size')\n    if (reasons.length === 0) {\n      if (room > 0) {\n        room -= 1\n        accepted.push(file)\n        continue\n      }\n      reasons.push('count')\n    }\n    rejected.push({ file, reasons })\n  }\n  return { accepted, rejected }\n}\n\nconst MIME_LABEL: Record<string, string> = {\n  'application/pdf': 'PDF',\n  'application/msword': 'DOC',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document': 'DOCX',\n  'application/vnd.ms-excel': 'XLS',\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'XLSX',\n  'application/vnd.ms-powerpoint': 'PPT',\n  'application/vnd.openxmlformats-officedocument.presentationml.presentation': 'PPTX',\n  'application/zip': 'ZIP',\n  'text/csv': 'CSV',\n  'text/plain': 'TXT',\n  'image/png': 'PNG',\n  'image/jpeg': 'JPG',\n}\nconst FAMILY_LABEL: Record<string, string> = { image: 'Images', video: 'Videos', audio: 'Audio', text: 'Text files' }\n\n/** `['.pdf', 'image/*', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']` -> \"PDF, Images, DOCX\" */\nexport function formatAccept(accept?: string[] | string): string {\n  const labels = acceptTokens(accept).map((t) => {\n    if (t.startsWith('.')) return t.slice(1).toUpperCase()\n    if (t.endsWith('/*')) return FAMILY_LABEL[t.slice(0, -2)] ?? t\n    return MIME_LABEL[t] ?? t.split('/').pop()?.toUpperCase() ?? t\n  })\n  return Array.from(new Set(labels)).join(', ')\n}\n\n/** One line for a screen reader or an error list: \"big-scan.pdf: larger than 5 MB\". */\nexport function describeRejection({ file, reasons }: FileRejection, rules: FileValidationRules = {}): string {\n  const parts = reasons.map((r) => {\n    if (r === 'type') {\n      const allowed = formatAccept(rules.accept)\n      return allowed ? `only ${allowed} allowed` : 'file type not allowed'\n    }\n    if (r === 'size') return `larger than ${formatBytes(rules.maxSize ?? 0)}`\n    return rules.maxFiles === 1 ? 'only one file allowed' : `limit of ${rules.maxFiles} files reached`\n  })\n  return `${file.name}: ${parts.join(', ')}`\n}\n\nfunction rulesHint({ accept, maxSize, maxFiles }: FileValidationRules, multiple: boolean): string {\n  const parts: string[] = []\n  const types = formatAccept(accept)\n  // a single type reads as a rule (\"PDF files only\"), not as a bare label\n  if (types) parts.push(!types.includes(',') ? (Object.values(FAMILY_LABEL).includes(types) ? `${types} only` : `${types} files only`) : types)\n  if (maxSize != null) parts.push(`up to ${formatBytes(maxSize)}${multiple ? ' each' : ''}`)\n  if (multiple && maxFiles != null) parts.push(`max ${maxFiles} files`)\n  return parts.join(' · ')\n}\n\nfunction hasFiles(e: React.DragEvent) {\n  return Array.from(e.dataTransfer?.types ?? []).includes('Files')\n}\n\nexport interface FileDropzoneProps extends Omit<React.ComponentProps<'div'>, 'title' | 'children' | 'onDrop' | 'onDragEnter' | 'onDragOver' | 'onDragLeave' | 'onPaste' | 'onChange' | 'className'>, FileValidationRules {\n  /** allow several files at once (default true); when false the zone takes the first file and rejects the rest with reason `count` */\n  multiple?: boolean\n  /** called with the files that passed and the ones that did not, after a drop, a paste or the picker; skipped when both are empty */\n  onFilesAdded?: (accepted: File[], rejected: FileRejection[]) => void\n  /** blocks the picker and drops, dims the zone and removes it from the tab order */\n  disabled?: boolean\n  /** `compact` is a single row for tight forms */\n  size?: 'default' | 'compact'\n  /** visual state of the zone, same vocabulary as the fields; `loading` shows a spinner and ignores new files */\n  status?: FieldStatus\n  /** error text under the zone; implies `status=\"error\"` */\n  error?: React.ReactNode\n  /** main line; defaults to \"Drag and drop files, or browse\" (\"Drop files here\" when compact), \"Tap to choose files\" on touch screens and \"Drop to upload\" while a file is dragged over it */\n  title?: React.ReactNode\n  /** second line; defaults to the rules (types, size, count). `null` hides it */\n  description?: React.ReactNode\n  /** glyph in the round tile (default a cloud with an up arrow) */\n  icon?: React.ReactNode\n  /** also take files pasted from the clipboard while the zone has focus */\n  pasteable?: boolean\n  /** class names for the outer wrapper (width, margin); the zone fills it */\n  className?: string\n}\n\n/**\n * File drop zone. Drag files onto it or press Enter / Space to open the picker. It validates type, size and count, reports the result through\n * `onFilesAdded` and announces rejections in a polite live region. The zone is named by its title unless you pass `aria-label`. The hidden `<input type=\"file\">` is reset after every pick, so the same file\n * can be chosen again.\n */\nfunction FileDropzone({\n  accept,\n  maxSize,\n  maxFiles,\n  currentCount,\n  multiple = true,\n  onFilesAdded,\n  size = 'default',\n  status: statusProp,\n  error,\n  title,\n  description,\n  icon,\n  pasteable,\n  disabled: disabledProp,\n  className,\n  ref,\n  'aria-describedby': describedByProp,\n  'aria-invalid': ariaInvalid,\n  'aria-label': ariaLabel,\n  'aria-labelledby': labelledByProp,\n  onClick,\n  onKeyDown,\n  ...props\n}: FileDropzoneProps) {\n  const uid = React.useId()\n  const inputRef = React.useRef<HTMLInputElement>(null)\n  const depth = React.useRef(0)\n  const [dragging, setDragging] = React.useState(false)\n  const [announcement, setAnnouncement] = React.useState('')\n  // inside a Field the zone takes its error / warning / success tone and disabled state, is described by its message and named by its label (the zone is a\n  // div with role=\"button\", which `<label for>` cannot name, so the name is the label plus the zone's own title)\n  const wired = useFieldAria({ id: props.id, 'aria-describedby': describedByProp, 'aria-invalid': ariaInvalid, 'aria-label': ariaLabel, 'aria-labelledby': labelledByProp }, { labelable: false })\n  const inherited = useFieldInherit({ id: props.id, disabled: disabledProp, status: statusProp })\n  const disabled = inherited.disabled\n  const status = resolveStatus({ error, status: inherited.status !== 'default' ? inherited.status : wired['aria-invalid'] ? 'error' : undefined })\n  const loading = status === 'loading'\n  const inert = !!disabled || loading\n  const compact = size === 'compact'\n\n  const rules: FileValidationRules = multiple ? { accept, maxSize, maxFiles, currentCount } : { accept, maxSize, maxFiles: 1 }\n  const acceptAttr = Array.isArray(accept) ? accept.join(',') : accept\n\n  const announce = (text: string) => setAnnouncement((prev) => (prev === text ? `${text} ` : text))\n\n  function handleFiles(list: FileList | File[] | null | undefined) {\n    const files = Array.from(list ?? [])\n    if (files.length === 0 || inert) return\n    const { accepted, rejected } = validateFiles(files, rules)\n    const spoken: string[] = []\n    if (accepted.length) spoken.push(accepted.length === 1 ? `${accepted[0].name} added.` : `${accepted.length} files added.`)\n    if (rejected.length) {\n      spoken.push(`${rejected.length === 1 ? '1 file' : `${rejected.length} files`} not added. ${rejected.map((r) => describeRejection(r, rules)).join('. ')}.`)\n    }\n    announce(spoken.join(' '))\n    onFilesAdded?.(accepted, rejected)\n  }\n\n  function openPicker() {\n    if (!inert) inputRef.current?.click()\n  }\n\n  const resetDrag = () => {\n    depth.current = 0\n    setDragging(false)\n  }\n\n  const descriptionText = description === undefined ? rulesHint(rules, multiple) : description\n  // a compact zone without a second line is one control row that lines up with the fields next to it\n  const bare = compact && !descriptionText\n  const titleId = `${uid}-title`\n  const descriptionId = `${uid}-description`\n  const errorId = `${uid}-error`\n  const describedBy = [descriptionText ? descriptionId : null, error ? errorId : null, wired['aria-describedby']].filter(Boolean).join(' ') || undefined\n\n  // Drag and drop is not possible on a phone: there the zone says what a tap does. Both variants are in the DOM, the hidden one is display:none\n  const noun = multiple ? 'files' : 'a file'\n  const heading =\n    title ??\n    (dragging ? (\n      'Drop to upload'\n    ) : (\n      <>\n        <span className=\"[@media(hover:none)]:hidden\">\n          {compact ? (multiple ? 'Drop files here' : 'Drop a file here') : `Drag and drop ${noun}, or `}\n          {!compact && <span className=\"text-primary-text underline-offset-2 group-hover/zone:underline\">browse</span>}\n        </span>\n        <span className=\"hidden [@media(hover:none)]:inline\">{compact ? (multiple ? 'Add files' : 'Add a file') : <span className=\"text-primary-text\">Tap to choose {noun}</span>}</span>\n      </>\n    ))\n  const statusGlyph = status === 'error' || status === 'warning' || status === 'success'\n\n  const tile = (\n    <span\n      aria-hidden\n      className={cn(\n        'inline-flex shrink-0 items-center justify-center rounded-full transition-colors motion-reduce:transition-none [&_svg]:size-full',\n        compact ? (bare ? 'size-6 p-1' : 'size-8 p-1.5') : 'size-10 p-2.5',\n        dragging ? 'bg-primary-faded-highlighted text-primary-text' : 'bg-surface-subtle text-icon-muted',\n        disabled && 'text-icon-disabled',\n      )}\n    >\n      {loading ? (\n        <StatusIcon status=\"loading\" className=\"size-full\" />\n      ) : statusGlyph && !icon && !dragging ? (\n        // the state is not only a hue: success, warning and error each draw their own glyph\n        <StatusIcon status={status} className=\"size-full\" />\n      ) : (\n        (icon ?? <CloudUpload strokeWidth={1.75} />)\n      )}\n    </span>\n  )\n\n  return (\n    <div data-slot=\"file-dropzone-root\" className={cn('relative flex flex-col gap-1', className)}>\n      <div\n        ref={ref}\n        data-slot=\"file-dropzone\"\n        data-size={size}\n        data-status={status}\n        data-dragging={dragging || undefined}\n        data-disabled={disabled || undefined}\n        id={wired.id}\n        role=\"button\"\n        tabIndex={inert ? -1 : 0}\n        aria-disabled={inert || undefined}\n        aria-busy={loading || undefined}\n        aria-label={ariaLabel}\n        aria-labelledby={ariaLabel ? undefined : labelledByProp ? labelledByProp : [wired['aria-labelledby'], titleId].filter(Boolean).join(' ')}\n        aria-describedby={describedBy}\n        className={cn(\n          'group/zone flex flex-1 cursor-pointer rounded-lg border border-dashed bg-surface-moderate transition-colors select-none motion-reduce:transition-none',\n          compact\n            ? cn('flex-row items-center gap-3 px-3 text-left', bare ? 'min-h-(--ctl-h-lg) py-1' : 'min-h-12 py-2')\n            : 'min-h-36 flex-col items-center justify-center gap-3 px-4 py-6 text-center compact:min-h-28 compact:py-4',\n          // a drop target is a bounded area: the idle dashed edge meets the 3:1 control boundary, and a disabled zone keeps its outline\n          'border-border-control hover:bg-state-hover',\n          'focus-visible:border-primary ds-focus',\n          status === 'error' && 'border-negative focus-visible:border-negative',\n          status === 'warning' && 'border-notice focus-visible:border-notice',\n          status === 'success' && 'border-positive focus-visible:border-positive',\n          dragging && 'border-primary bg-primary-faded hover:bg-primary-faded',\n          loading && 'cursor-progress',\n          disabled && 'cursor-not-allowed border-border-default bg-transparent text-text-disabled hover:bg-transparent',\n        )}\n        onClick={(e) => {\n          onClick?.(e)\n          if (!e.defaultPrevented) openPicker()\n        }}\n        onKeyDown={(e) => {\n          onKeyDown?.(e)\n          if (e.defaultPrevented || e.target !== e.currentTarget) return\n          if (e.key === 'Enter' || e.key === ' ') {\n            e.preventDefault()\n            openPicker()\n          }\n        }}\n        onDragEnter={(e) => {\n          if (!hasFiles(e)) return\n          e.preventDefault()\n          depth.current += 1\n          if (!inert) setDragging(true)\n        }}\n        onDragOver={(e) => {\n          if (!hasFiles(e)) return\n          e.preventDefault()\n          e.dataTransfer.dropEffect = inert ? 'none' : 'copy'\n        }}\n        onDragLeave={(e) => {\n          if (!hasFiles(e)) return\n          depth.current = Math.max(0, depth.current - 1)\n          if (depth.current === 0) setDragging(false)\n        }}\n        onDrop={(e) => {\n          if (!hasFiles(e)) return\n          e.preventDefault()\n          resetDrag()\n          handleFiles(e.dataTransfer.files)\n        }}\n        onPaste={\n          pasteable\n            ? (e) => {\n                if (e.clipboardData.files.length === 0) return\n                e.preventDefault()\n                handleFiles(e.clipboardData.files)\n              }\n            : undefined\n        }\n        {...props}\n      >\n        {tile}\n        <span className={cn('pointer-events-none flex min-w-0 flex-col gap-0.5', compact && 'flex-1')}>\n          <span id={titleId} className={cn('text-sm font-semibold', disabled ? 'text-text-disabled' : 'text-foreground')}>{heading}</span>\n          {descriptionText && (\n            <span id={descriptionId} className={cn('text-xs', disabled ? 'text-text-disabled' : 'text-text-muted')}>\n              {descriptionText}\n            </span>\n          )}\n        </span>\n        {compact && (\n          <span aria-hidden className={buttonVariants({ variant: 'outline', size: bare ? 'xs' : 'sm', className: cn('pointer-events-none', disabled && 'opacity-50') })}>\n            Browse\n          </span>\n        )}\n      </div>\n      {error && (\n        <p id={errorId} role=\"alert\" className=\"text-xs text-negative\">\n          {error}\n        </p>\n      )}\n      <input\n        ref={inputRef}\n        type=\"file\"\n        hidden\n        tabIndex={-1}\n        aria-hidden\n        accept={acceptAttr}\n        multiple={multiple}\n        disabled={inert}\n        onChange={(e) => {\n          handleFiles(e.target.files)\n          e.target.value = ''\n        }}\n      />\n      <div role=\"status\" aria-live=\"polite\" aria-atomic className=\"sr-only\">\n        {announcement}\n      </div>\n    </div>\n  )\n}\n\nexport type FileUploadStatus = 'idle' | 'uploading' | 'done' | 'error'\n\n/** The glyph is the same `FileTypeIcon` the file cards use, so one PDF looks the same in a card, a row and the viewer. The name decides the kind, the MIME type is the fallback. */\nfunction UploadTypeIcon({ name, type, failed }: { name: string; type?: string; failed?: boolean }) {\n  const fromName = resolveFileKind(name)\n  return <FileTypeIcon type={fromName !== 'generic' ? name : (type || name)} size=\"md\" className={cn(failed && 'text-negative')} />\n}\n\n/** The list that holds the rows. A plain `<ul>`; give it an `aria-label` such as \"Attached documents\". */\nfunction FileUploadList({ className, ...props }: React.ComponentProps<'ul'>) {\n  return <ul data-slot=\"file-upload-list\" role=\"list\" className={cn('flex flex-col gap-2', className)} {...props} />\n}\n\n/** The Remove button unmounts with its row, which would drop keyboard focus onto the page: hand it to a neighbouring row, or the list's drop zone, unless the app already moved it. */\nfunction removeKeepingFocus(event: React.MouseEvent<HTMLElement>, remove: () => void) {\n  const row = event.currentTarget.closest('li')\n  const neighbour = row?.nextElementSibling ?? row?.previousElementSibling\n  const zone = row?.parentElement?.parentElement?.querySelector<HTMLElement>('[data-slot=\"file-dropzone\"]')\n  remove()\n  requestAnimationFrame(() => {\n    if (document.activeElement && document.activeElement !== document.body) return\n    const target = [neighbour?.querySelector<HTMLElement>('button'), zone].find((el) => el?.isConnected)\n    target?.focus()\n  })\n}\n\nexport interface FileUploadItemProps extends Omit<React.ComponentProps<'li'>, 'children'> {\n  /** shortcut that fills `name`, `size` and `type` from a `File` */\n  file?: File\n  /** file name, shown on one line and in full as a tooltip */\n  name?: string\n  /** size in bytes */\n  size?: number\n  /** mime type, used with the extension to pick the icon */\n  type?: string\n  /** `idle` (waiting), `uploading` (shows the progress bar), `done` or `error` */\n  status?: FileUploadStatus\n  /** 0 to 100 while uploading; without it the bar is indeterminate */\n  progress?: number\n  /** message shown in the `error` state (default \"Upload failed\") */\n  error?: React.ReactNode\n  /** shows the Remove button; while uploading it is labelled \"Cancel upload\" */\n  onRemove?: () => void\n  /** shows the Retry button in the `error` state */\n  onRetry?: () => void\n}\n\n/** One file: type icon, name, size, status line, optional progress bar and the Retry / Remove buttons. Use inside `FileUploadList`. */\nfunction FileUploadItem({ file, name: nameProp, size, type: typeProp, status = 'idle', progress, error, onRemove, onRetry, className, ...props }: FileUploadItemProps) {\n  const name = nameProp ?? file?.name ?? 'Untitled file'\n  const bytes = size ?? file?.size\n  const type = typeProp ?? file?.type\n  const uploading = status === 'uploading'\n  const failed = status === 'error'\n  const pct = progress == null ? undefined : Math.min(100, Math.max(0, Math.round(progress)))\n\n  const sep = <span aria-hidden>{' · '}</span>\n\n  return (\n    <li\n      data-slot=\"file-upload-item\"\n      data-status={status}\n      className={cn('flex flex-col gap-2 rounded-lg border bg-card px-3 py-2 transition-colors compact:py-1.5', failed ? 'border-negative/60' : 'border-border', className)}\n      {...props}\n    >\n      <div className=\"flex items-center gap-3\">\n        <UploadTypeIcon name={name} type={type} failed={failed} />\n        <div className=\"flex min-w-0 flex-1 flex-col\">\n          <span title={name} className=\"text-sm font-medium text-foreground\">\n            <FileName name={name} />\n          </span>\n          {/* one inline run of text: a long message wraps like a sentence and the separator never starts a line */}\n          <span className=\"text-xs text-text-subtle\">\n            {bytes != null && <span className=\"tnum\">{formatBytes(bytes)}</span>}\n            {uploading && (\n              <>\n                {bytes != null && sep}\n                <span className=\"tnum\">{pct == null ? 'Uploading' : `Uploading ${pct}%`}</span>\n              </>\n            )}\n            {status === 'done' && (\n              <>\n                {bytes != null && sep}\n                <span className=\"inline-flex items-center gap-1 align-bottom text-positive\">\n                  <Check aria-hidden className=\"size-3\" strokeWidth={2.5} />\n                  Uploaded\n                </span>\n              </>\n            )}\n            {failed && (\n              <>\n                {bytes != null && sep}\n                <span role=\"alert\" className=\"text-negative\">\n                  {error ?? 'Upload failed'}\n                </span>\n              </>\n            )}\n          </span>\n        </div>\n        <div className=\"flex shrink-0 items-center gap-2\">\n          {failed && onRetry && (\n            <Button type=\"button\" variant=\"ghost\" size=\"icon-sm\" className={hitArea} aria-label={`Retry upload of ${name}`} onClick={onRetry}>\n              <RotateCw />\n            </Button>\n          )}\n          {onRemove && (\n            <Button type=\"button\" variant=\"ghost\" size=\"icon-sm\" className={hitArea} aria-label={uploading ? `Cancel upload of ${name}` : `Remove ${name}`} onClick={(e) => removeKeepingFocus(e, onRemove)}>\n              <X />\n            </Button>\n          )}\n        </div>\n      </div>\n      {uploading && <Progress value={pct ?? null} size=\"md\" aria-label={`Uploading ${name}`} indicatorClassName=\"motion-reduce:transition-none\" />}\n    </li>\n  )\n}\n\nexport { FileDropzone, FileUploadList, FileUploadItem }\n","import * as React from 'react'\nimport { ChevronRight } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { Checkbox } from './checkbox'\nimport { hitArea } from './field'\n\n/* Figma Folder Tree Structure 3769:986 (Folder State 3727:4400): 32px rows, 24px indent per level with a hairline guide at the middle of each gutter,\n   [checkbox 20] [expand chevron 16] [folder icon 16] [label Body/Medium_S]. Folder icons are amber (open / closed).\n   Rows are a flat list with aria-level / aria-posinset / aria-setsize (valid per the ARIA tree pattern). Give the tree an aria-label. */\n\n/** Filled folder glyph from the Figma Folder Icon component (State=Open / Close). */\nfunction FolderIcon({ open = false, className, ...props }: { open?: boolean } & React.ComponentProps<'svg'>) {\n  return (\n    <svg data-slot=\"folder-icon\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\" className={cn('size-4 shrink-0', className)} {...props}>\n      <path\n        d=\"M1.5 3.75A1.25 1.25 0 0 1 2.75 2.5h3.1c.33 0 .64.13.88.35l.9.9c.12.12.28.18.45.18h5.17A1.25 1.25 0 0 1 14.5 5v7.25a1.25 1.25 0 0 1-1.25 1.25H2.75A1.25 1.25 0 0 1 1.5 12.25V3.75Z\"\n        fill=\"var(--folder-back)\"\n      />\n      {open ? (\n        <path d=\"M2.4 7.4A1.25 1.25 0 0 1 3.6 6.5h10.8a.9.9 0 0 1 .87 1.14l-1.3 4.7a1.25 1.25 0 0 1-1.2.9H2.5a.9.9 0 0 1-.87-1.14L2.4 7.4Z\" fill=\"var(--folder-front)\" />\n      ) : (\n        <path d=\"M1.5 6.25A1.25 1.25 0 0 1 2.75 5h10.5a1.25 1.25 0 0 1 1.25 1.25v6a1.25 1.25 0 0 1-1.25 1.25H2.75A1.25 1.25 0 0 1 1.5 12.25v-6Z\" fill=\"var(--folder-front)\" />\n      )}\n    </svg>\n  )\n}\n\ninterface FolderNode {\n  id: string\n  label: React.ReactNode\n  children?: FolderNode[]\n  /** replaces the folder glyph (for example a file icon on a leaf) */\n  icon?: React.ReactNode\n  disabled?: boolean\n}\n\ntype CheckState = boolean | 'indeterminate'\n\nfunction useControllable<T>(value: T | undefined, defaultValue: T, onChange?: (v: T) => void): [T, (v: T) => void] {\n  const [inner, setInner] = React.useState<T>(defaultValue)\n  const controlled = value !== undefined\n  const current = controlled ? (value as T) : inner\n  const set = React.useCallback(\n    (v: T) => {\n      if (!controlled) setInner(v)\n      onChange?.(v)\n    },\n    [controlled, onChange],\n  )\n  return [current, set]\n}\n\ninterface FlatRow {\n  node: FolderNode\n  depth: number\n  parent?: string\n  hasChildren: boolean\n  /** 1-based position among its siblings, and how many siblings there are (aria-posinset / aria-setsize) */\n  pos: number\n  size: number\n}\n\nfunction flatten(nodes: FolderNode[], expanded: Set<string>, depth = 0, parent?: string, out: FlatRow[] = []) {\n  nodes.forEach((node, i) => {\n    const hasChildren = !!node.children && node.children.length > 0\n    out.push({ node, depth, parent, hasChildren, pos: i + 1, size: nodes.length })\n    if (hasChildren && expanded.has(node.id)) flatten(node.children!, expanded, depth + 1, node.id, out)\n  })\n  return out\n}\n\nfunction descendantIds(node: FolderNode, out: string[] = []) {\n  for (const c of node.children ?? []) {\n    out.push(c.id)\n    descendantIds(c, out)\n  }\n  return out\n}\n\ninterface FolderTreeProps extends Omit<React.ComponentProps<'div'>, 'onSelect' | 'children' | 'defaultChecked'> {\n  nodes: FolderNode[]\n  /** expanded folder ids (controlled) / initial ids (uncontrolled) */\n  expanded?: string[]\n  defaultExpanded?: string[]\n  onExpandedChange?: (ids: string[]) => void\n  /** show the checkbox column (Figma default) */\n  checkable?: boolean\n  checked?: string[]\n  defaultChecked?: string[]\n  onCheckedChange?: (ids: string[]) => void\n  /** ticking a folder ticks everything inside it, and a folder with some ticked children shows the mixed state */\n  cascade?: boolean\n  /** the highlighted row (single selection, e.g. the folder whose contents are listed beside the tree) */\n  selected?: string\n  defaultSelected?: string\n  onSelect?: (id: string) => void\n  /**\n   * Whether a click on the row (not just on the chevron) opens and closes a folder. Defaults to true (a click selects the row and opens or closes\n   * the folder). Set it to false in a master-detail tree so clicking an open folder selects it without folding it away.\n   * The chevron, the Left/Right keys and a double click always toggle.\n   */\n  toggleOnRowClick?: boolean\n}\n\nfunction FolderTree({\n  nodes,\n  expanded: expandedProp,\n  defaultExpanded = [],\n  onExpandedChange,\n  checkable = true,\n  checked: checkedProp,\n  defaultChecked = [],\n  onCheckedChange,\n  cascade = false,\n  selected: selectedProp,\n  defaultSelected,\n  onSelect,\n  toggleOnRowClick,\n  className,\n  ...props\n}: FolderTreeProps) {\n  const selectionDriven = selectedProp !== undefined || defaultSelected !== undefined || !!onSelect\n  const rowToggles = toggleOnRowClick ?? true\n  const [expandedIds, setExpandedIds] = useControllable(expandedProp, defaultExpanded, onExpandedChange)\n  const [checkedIds, setCheckedIds] = useControllable(checkedProp, defaultChecked, onCheckedChange)\n  const [selectedId, setSelectedId] = useControllable<string | undefined>(selectedProp, defaultSelected, (v) => v && onSelect?.(v))\n  const expanded = React.useMemo(() => new Set(expandedIds), [expandedIds])\n  const checked = React.useMemo(() => new Set(checkedIds), [checkedIds])\n  const rows = React.useMemo(() => flatten(nodes, expanded), [nodes, expanded])\n  const [focusId, setFocusId] = React.useState<string | undefined>(undefined)\n  const refs = React.useRef(new Map<string, HTMLDivElement>())\n  const activeId = focusId && rows.some((r) => r.node.id === focusId) ? focusId : rows[0]?.node.id\n\n  const toggleExpanded = (id: string) => setExpandedIds(expanded.has(id) ? expandedIds.filter((x) => x !== id) : [...expandedIds, id])\n\n  const stateOf = (node: FolderNode): CheckState => {\n    if (checked.has(node.id)) return true\n    if (cascade && node.children?.length) {\n      const ids = descendantIds(node)\n      const n = ids.filter((i) => checked.has(i)).length\n      if (n > 0) return n === ids.length ? true : 'indeterminate'\n    }\n    return false\n  }\n\n  const setChecked = (node: FolderNode, next: boolean) => {\n    const set = new Set(checkedIds)\n    const ids = cascade ? [node.id, ...descendantIds(node)] : [node.id]\n    ids.forEach((i) => (next ? set.add(i) : set.delete(i)))\n    setCheckedIds([...set])\n  }\n\n  const focusRow = (id: string | undefined) => {\n    if (!id) return\n    setFocusId(id)\n    refs.current.get(id)?.focus()\n  }\n\n  const onKeyDown = (e: React.KeyboardEvent) => {\n    const i = rows.findIndex((r) => r.node.id === activeId)\n    if (i < 0) return\n    const row = rows[i]\n    if (e.key === 'ArrowDown') { e.preventDefault(); focusRow(rows[Math.min(i + 1, rows.length - 1)].node.id) }\n    else if (e.key === 'ArrowUp') { e.preventDefault(); focusRow(rows[Math.max(i - 1, 0)].node.id) }\n    else if (e.key === 'Home') { e.preventDefault(); focusRow(rows[0].node.id) }\n    else if (e.key === 'End') { e.preventDefault(); focusRow(rows[rows.length - 1].node.id) }\n    else if (e.key === 'ArrowRight') {\n      e.preventDefault()\n      if (row.hasChildren && !expanded.has(row.node.id)) toggleExpanded(row.node.id)\n      else if (row.hasChildren) focusRow(rows[i + 1]?.node.id)\n    } else if (e.key === 'ArrowLeft') {\n      e.preventDefault()\n      if (row.hasChildren && expanded.has(row.node.id)) toggleExpanded(row.node.id)\n      else focusRow(row.parent)\n    } else if (e.key === ' ' && checkable && !row.node.disabled) {\n      e.preventDefault()\n      setChecked(row.node, stateOf(row.node) !== true)\n    } else if (e.key === 'Enter' && !row.node.disabled) {\n      e.preventDefault()\n      setSelectedId(row.node.id)\n      if (row.hasChildren && rowToggles) toggleExpanded(row.node.id)\n    }\n  }\n\n  return (\n    <div data-slot=\"folder-tree\" role=\"tree\" aria-multiselectable={checkable || undefined} className={cn('flex flex-col', className)} onKeyDown={onKeyDown} {...props}>\n      {rows.map(({ node, depth, hasChildren, pos, size }) => {\n        const open = expanded.has(node.id)\n        const state = checkable ? stateOf(node) : false\n        const isSelected = selectedId === node.id\n        return (\n          <div\n            key={node.id}\n            ref={(el) => {\n              if (el) refs.current.set(node.id, el)\n              else refs.current.delete(node.id)\n            }}\n            role=\"treeitem\"\n            aria-level={depth + 1}\n            aria-posinset={pos}\n            aria-setsize={size}\n            aria-expanded={hasChildren ? open : undefined}\n            aria-selected={selectionDriven ? isSelected : undefined}\n            aria-checked={checkable ? (state === 'indeterminate' ? 'mixed' : state) : undefined}\n            aria-disabled={node.disabled || undefined}\n            tabIndex={activeId === node.id ? 0 : -1}\n            data-state={open ? 'open' : 'closed'}\n            data-selected={isSelected || undefined}\n            onFocus={() => setFocusId(node.id)}\n            onClick={() => {\n              if (node.disabled) return\n              setSelectedId(node.id)\n              if (hasChildren && rowToggles) toggleExpanded(node.id)\n            }}\n            onDoubleClick={() => {\n              if (node.disabled || !hasChildren || rowToggles) return\n              toggleExpanded(node.id)\n            }}\n            className={cn(\n              'group/row flex h-8 compact:h-7 cursor-pointer items-center rounded-sm pr-2 text-sm font-medium text-foreground transition-colors',\n              'hover:bg-state-hover data-[selected]:bg-primary-faded ds-focus-inset',\n              node.disabled && 'pointer-events-none text-text-disabled [&_svg]:opacity-50',\n            )}\n          >\n            {Array.from({ length: depth }).map((_, d) => (\n              <span key={d} aria-hidden=\"true\" className=\"relative h-8 compact:h-7 w-6 shrink-0 after:absolute after:inset-y-0 after:left-1/2 after:w-px after:bg-border-default\" />\n            ))}\n            {checkable && (\n              <span\n                aria-hidden=\"true\"\n                // 28px target around the 16px box with the footprint of the old 20px slot; a click beside the box still ticks it, never selects or folds the row\n                className=\"-mr-1 ml-[-2px] grid size-7 shrink-0 place-items-center\"\n                onClick={(e) => {\n                  e.stopPropagation()\n                  if (e.target === e.currentTarget && !node.disabled) setChecked(node, state !== true)\n                }}\n              >\n                <Checkbox\n                  tabIndex={-1}\n                  aria-label={typeof node.label === 'string' ? node.label : node.id}\n                  checked={state}\n                  disabled={node.disabled}\n                  onCheckedChange={(v) => setChecked(node, v === true)}\n                />\n              </span>\n            )}\n            <span\n              aria-hidden=\"true\"\n              className={cn('ml-0.5 grid size-4 shrink-0 place-items-center rounded-xs text-icon-muted hover:text-foreground', hitArea, !hasChildren && 'invisible')}\n              onClick={(e) => {\n                if (node.disabled || !hasChildren) return\n                e.stopPropagation()\n                toggleExpanded(node.id)\n              }}\n            >\n              <ChevronRight className={cn('size-4 transition-transform duration-(--dur-base)', open && 'rotate-90')} />\n            </span>\n            <span className=\"ml-1 flex min-w-0 items-center gap-2\">\n              {node.icon ?? <FolderIcon open={open && hasChildren} />}\n              <span className=\"truncate\">{node.label}</span>\n            </span>\n          </div>\n        )\n      })}\n    </div>\n  )\n}\n\nexport { FolderTree, FolderIcon }\nexport type { FolderNode, FolderTreeProps }\n","import * as React from 'react'\nimport { HoverCard as HoverCardPrimitive } from 'radix-ui'\n\nimport { cn } from '../lib/utils'\n\nfunction HoverCard(props: React.ComponentProps<typeof HoverCardPrimitive.Root>) {\n  return <HoverCardPrimitive.Root data-slot=\"hover-card\" {...props} />\n}\n\nfunction HoverCardTrigger(props: React.ComponentProps<typeof HoverCardPrimitive.Trigger>) {\n  return <HoverCardPrimitive.Trigger data-slot=\"hover-card-trigger\" {...props} />\n}\n\n/** Same surface as `PopoverContent` and the menus (`ds-menu`: 8 radius, visible edge, mid elevation, popover layer). */\nfunction HoverCardContent({ className, align = 'center', sideOffset = 4, ...props }: React.ComponentProps<typeof HoverCardPrimitive.Content>) {\n  return (\n    <HoverCardPrimitive.Portal data-slot=\"hover-card-portal\">\n      <HoverCardPrimitive.Content\n        data-slot=\"hover-card-content\"\n        align={align}\n        sideOffset={sideOffset}\n        collisionPadding={8}\n        className={cn(\n          'ds-menu ds-scroll z-(--z-popover) max-h-(--radix-hover-card-content-available-height) w-64 max-w-(--radix-hover-card-content-available-width) overflow-y-auto origin-(--radix-hover-card-content-transform-origin) p-4 text-sm outline-hidden data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95',\n          className,\n        )}\n        {...props}\n      />\n    </HoverCardPrimitive.Portal>\n  )\n}\n\nexport { HoverCard, HoverCardTrigger, HoverCardContent }\n","import * as React from 'react'\nimport { Slot } from 'radix-ui'\nimport { cva } from 'class-variance-authority'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Text link (Figma Button & Icon, Link frame 3222:3088): medium-weight text that is underlined at rest (see below), firms the underline up on hover and takes the solid focus ring, in five\n * sizes and four colours (primary, neutral, negative, whiteOnPrimary), with an optional leading or trailing icon. It flows inside a paragraph\n * (and wraps across lines) like a plain <a>; it becomes an inline-flex box only when it carries an icon. Every colour is underlined at rest (solid for neutral, a thin soft line for the others),\n * because colour alone does not set it apart from the text around it. Use `asChild` to wrap a router\n * <Link>. Named TextLink so it never clashes with react-router's Link.\n * The colour and state rules are in src/styles/ds-atoms.css (.ds-link).\n */\nexport type TextLinkColor = 'primary' | 'neutral' | 'negative' | 'whiteOnPrimary'\nexport type TextLinkSize = 'xlarge' | 'large' | 'medium' | 'small' | 'xsmall'\n\nconst linkVariants = cva('ds-link rounded-xs font-medium transition-colors [&_svg]:shrink-0', {\n  variants: {\n    size: {\n      xlarge: 'text-lg [&_svg]:size-5',\n      large: 'text-base [&_svg]:size-4',\n      medium: 'text-sm [&_svg]:size-4',\n      small: 'text-xs [&_svg]:size-3.5',\n      xsmall: 'text-xxs leading-[14px] [&_svg]:size-3',\n    },\n  },\n  defaultVariants: { size: 'medium' },\n})\n\nconst COLOR_CLASS: Record<TextLinkColor, string> = {\n  primary: 'ds-link-primary',\n  neutral: 'ds-link-neutral',\n  negative: 'ds-link-negative',\n  whiteOnPrimary: 'ds-link-white',\n}\n\nexport interface TextLinkProps extends Omit<React.ComponentProps<'a'>, 'color'> {\n  color?: TextLinkColor\n  size?: TextLinkSize\n  /** underline all the time. Default: a solid underline for the `neutral` colour and a thin soft one at rest (firming up on hover) for the other colours, so a link in running text is not told apart by hue alone; links with an icon default to hover-only. `true` forces the solid underline