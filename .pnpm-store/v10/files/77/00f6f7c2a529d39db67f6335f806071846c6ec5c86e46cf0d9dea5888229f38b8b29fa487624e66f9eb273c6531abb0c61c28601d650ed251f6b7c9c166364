context-menu-content-available-height) min-w-[8rem] max-w-(--radix-context-menu-content-available-width) origin-(--radix-context-menu-content-transform-origin) overflow-x-hidden overflow-y-auto data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nexport {\n  ContextMenu,\n  ContextMenuTrigger,\n  ContextMenuPortal,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuLabel,\n  ContextMenuItem,\n  ContextMenuCheckboxItem,\n  ContextMenuRadioGroup,\n  ContextMenuRadioItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuSub,\n  ContextMenuSubTrigger,\n  ContextMenuSubContent,\n}\n","import { cn } from '../lib/utils'\n\n/* Internal: a file name that truncates in the middle. The stem gives way, the last few characters of it and the extension stay visible, so\n   \"Master Services Agreement - Tata Motors v7.docx\" shortens to \"Master Services Agree…ors v7.docx\" and two siblings that differ at the end\n   (INV-1182 / INV-1183, v6 / v7, .pdf / .docx) can still be told apart. Not exported from the package. */\n\nconst TAIL = 8\nconst EXT = /^(.+)(\\.[A-Za-z0-9]{1,5})$/\n\nfunction splitName(name: string) {\n  const m = EXT.exec(name)\n  const stem = m ? m[1] : name\n  const ext = m ? m[2] : ''\n  if (stem.length <= TAIL * 2) return { head: stem, tail: ext }\n  // the tail starts on a letter: a space at the cut would show as a gap after the ellipsis\n  let cut = stem.length - TAIL\n  while (cut < stem.length - 1 && stem[cut] === ' ') cut += 1\n  return { head: stem.slice(0, cut), tail: stem.slice(cut) + ext }\n}\n\nexport function FileName({ name, className }: { name: string; className?: string }) {\n  const { head, tail } = splitName(name)\n  if (!tail) return <span className={cn('block truncate', className)}>{name}</span>\n  return (\n    <span className={cn