{"version":3,"file":"index.js","sources":["../src/components/accordion.tsx","../src/components/banner.tsx","../src/components/bottom-sheet.tsx","../src/components/card.tsx","../src/components/carousel.tsx","../src/components/chip.tsx","../src/components/collapsible.tsx","../src/components/context-menu.tsx","../src/components/file-name.tsx","../src/components/file-card.tsx","../src/components/document-viewer.tsx","../src/components/file-upload.tsx","../src/components/folder-tree.tsx","../src/components/hover-card.tsx","../src/components/link.tsx","../src/components/list.tsx","../src/components/resizable.tsx","../src/components/scroll-area.tsx","../src/components/slider.tsx","../src/components/sonner.tsx","../src/components/spotlight-popover.tsx","../src/hooks/use-scroll-edges.ts","../src/components/stepper.tsx","../src/components/tabs.tsx","../src/components/tag-input.tsx","../src/components/toolbar.tsx","../src/lib/density.ts"],"sourcesContent":["import * as React from 'react'\nimport { Accordion as AccordionPrimitive } from 'radix-ui'\nimport { ChevronDownIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/* Figma Accordion 1785:11907 (item 2471:259..264): header 52 high, padding 16, title Body/Link_M (SemiBold 14), 20px trailing chevron (muted),\n   body Body/Regular_M, 1px hairline under every item, hover wash on surface/subtle, focus = wash + 3px faded primary ring.\n   Leading slot: a 20px icon or a number (\"1.\"); the panel text then lines up with the title, not with the icon.\n   The root is unstyled. To draw a card, give it `overflow-hidden rounded-lg border` so the hover wash is clipped to the corners. */\nfunction Accordion(props: React.ComponentProps<typeof AccordionPrimitive.Root>) {\n  return <AccordionPrimitive.Root data-slot=\"accordion\" {...props} />\n}\n\nfunction AccordionItem({ className, ...props }: React.ComponentProps<typeof AccordionPrimitive.Item>) {\n  return <AccordionPrimitive.Item data-slot=\"accordion-item\" className={cn('group/accordion-item border-b border-border last:border-b-0', className)} {...props} />\n}\n\nfunction AccordionTrigger({\n  className,\n  children,\n  icon,\n  index,\n  ...props\n}: React.ComponentProps<typeof AccordionPrimitive.Trigger> & {\n  /** leading 20px icon (Figma leading=Icon) */\n  icon?: React.ReactNode\n  /** leading number (Figma leading=Number), rendered as \"1.\" */\n  index?: number | string\n}) {\n  return (\n    <AccordionPrimitive.Header className=\"flex\">\n      <AccordionPrimitive.Trigger\n        data-slot=\"accordion-trigger\"\n        data-leading={icon ? 'icon' : index !== undefined ? 'index' : undefined}\n        className={cn(\n          'group/accordion relative flex min-h-13 flex-1 items-center justify-between gap-3 px-4 py-4 compact:min-h-10 compact:px-3 compact:py-2 compact:text-sm text-left text-base font-semibold text-foreground transition-colors hover:bg-state-hover focus-visible:z-10 focus-visible:bg-state-hover disabled:pointer-events-none disabled:text-text-disabled [&[data-state=open]>svg:last-child]:rotate-180 ds-focus-inset',\n          className,\n        )}\n        {...props}\n      >\n        <span className=\"flex min-w-0 flex-1 items-center gap-2\">\n          {icon && <span className=\"grid size-5 shrink-0 place-items-center text-icon-muted [&>svg]:size-5\">{icon}</span>}\n          {/* The panel inset assumes an index of one digit (a 20px column); \"10.\" and wider push the title but not the panel text. */}\n          {index !== undefined && <span className=\"min-w-5 shrink-0 tabular-nums\">{index}.</span>}\n          <span className=\"min-w-0\">{children}</span>\n        </span>\n        <ChevronDownIcon className=\"pointer-events-none size-5 shrink-0 text-icon-muted transition-transform duration-(--dur-moderate) group-disabled/accordion:text-icon-disabled\" />\n      </AccordionPrimitive.Trigger>\n    </AccordionPrimitive.Header>\n  )\n}\n\nfunction AccordionContent({ className, children, ...props }: React.ComponentProps<typeof AccordionPrimitive.Content>) {\n  return (\n    <AccordionPrimitive.Content\n      data-slot=\"accordion-content\"\n      className=\"overflow-hidden text-base compact:text-sm data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down\"\n      {...props}\n    >\n      <div\n        className={cn(\n          'px-4 pt-0 pb-4 compact:px-3 compact:pb-3 group-has-[[data-leading]]/accordion-item:ps-11 compact:group-has-[[data-leading]]/accordion-item:ps-10',\n          className,\n        )}\n      >{children}</div>\n    </AccordionPrimitive.Content>\n  )\n}\n\nexport { Accordion, AccordionItem, AccordionTrigger, AccordionContent }\n","import * as React from 'react'\nimport { cva, type VariantProps } from 'class-variance-authority'\nimport { AlertCircle, Check, ChevronDown, Pause, X } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Banner. Figma Banner page 4003:1027: a 360px card (12px radius, mid shadow) with a 48px header (title + chevron), an optional 32px status strip\n * (Neutral, Alert, Positive, Negative, Primary), a body (text, optional 40px loader or status icon, optional action buttons)\n * and, when collapsed, a thin progress bar along the bottom edge.\n *\n * A banner is a static card by default. Pass `live` when its text changes while people are on the page (progress, completion), so a screen reader announces it politely.\n *\n * <Banner title=\"Import\" collapsible progress={64}>\n *   <BannerStrip tone=\"primary\" label=\"Step 2 of 3\" actionLabel=\"Details\" onAction={...} />\n *   <BannerBody indicator={<BannerLoader kind=\"progress\" value={64} showValue />}>Checking your file.</BannerBody>\n * </Banner>\n */\ntype BannerProgressTone = 'primary' | 'positive' | 'negative' | 'notice'\nconst BAR_TONE: Record<BannerProgressTone, string> = { primary: 'bg-primary', positive: 'bg-positive', negative: 'bg-negative', notice: 'bg-notice' }\n\nfunction Banner({\n  title,\n  collapsible = false,\n  open,\n  defaultOpen = true,\n  onOpenChange,\n  progress,\n  progressTone,\n  summary,\n  live = false,\n  className,\n  children,\n  ...props\n}: Omit<React.ComponentProps<'section'>, 'title'> & {\n  title: React.ReactNode\n  /** Adds the chevron and lets the header fold the strip and body away. */\n  collapsible?: boolean\n  open?: boolean\n  defaultOpen?: boolean\n  onOpenChange?: (open: boolean) => void\n  /** 0 to 100. Drawn as a bar along the bottom edge while the banner is collapsed. */\n  progress?: number\n  /** Colour of the collapsed progress bar. Default `primary`, and `positive` once `progress` reaches 100. Use `negative` or `notice` when the job failed or needs attention. */\n  progressTone?: BannerProgressTone\n  /** Short status shown in the header while the banner is collapsed (for example \"Failed\" or \"2 rows need attention\"), so folding the banner does not hide its state. */\n  summary?: React.ReactNode\n  /** Announce changes to the banner's text politely (`role=\"status\"`). Off by default, because most banners are static. */\n  live?: boolean\n}) {\n  const [innerOpen, setInnerOpen] = React.useState(defaultOpen)\n  const isOpen = !collapsible || (open ?? innerOpen)\n  const bodyId = React.useId()\n  const toggle = () => {\n    const next = !isOpen\n    setInnerOpen(next)\n    onOpenChange?.(next)\n  }\n  const showBar = collapsible && !isOpen && typeof progress === 'number'\n  const barTone: BannerProgressTone = progressTone ?? (typeof progress === 'number' && progress >= 100 ? 'positive' : 'primary')\n  return (\n    <section\n      data-slot=\"banner\"\n      data-state={isOpen ? 'open' : 'closed'}\n      {...(live ? { role: 'status', 'aria-live': 'polite' as const } : null)}\n      className={cn('relative w-full max-w-[360px] overflow-hidden rounded-xl border border-modal-border bg-card text-card-foreground shadow-md', className)}\n      {...props}\n    >\n      {collapsible ? (\n        <button\n          type=\"button\"\n          data-slot=\"banner-header\"\n          aria-expanded={isOpen}\n          aria-controls={bodyId}\n          onClick={toggle}\n          className=\"group/header flex h-12 w-full items-center justify-between gap-2 px-4 text-left text-base font-semibold text-foreground transition-colors duration-(--dur-base) hover:bg-state-hover active:bg-state-pressed ds-focus-inset\"\n        >\n          <span className=\"min-w-0 flex-1 truncate\">{title}</span>\n          {!isOpen && summary != null && <span className=\"min-w-0 max-w-[50%] shrink-0 truncate text-xs font-medium text-text-subtle\">{summary}</span>}\n          <ChevronDown className=\"size-4 shrink-0 text-icon-muted transition-transform duration-(--dur-moderate) ease-(--ease-standard) group-aria-expanded/header:rotate-180 motion-reduce:transition-none\" />\n        </button>\n      ) : (\n        <div data-slot=\"banner-header\" className=\"flex h-12 w-full items-center justify-between gap-2 px-4 text-base font-semibold text-foreground\">\n          <span className=\"min-w-0 truncate\">{title}</span>\n        </div>\n      )}\n      <div\n        id={bodyId}\n        data-slot=\"banner-content\"\n        inert={!isOpen}\n        className={cn('grid transition-[grid-template-rows] duration-(--dur-moderate) ease-out motion-reduce:transition-none', isOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]')}\n      >\n        <div className=\"min-h-0 overflow-hidden\">{children}</div>\n      </div>\n      {showBar && (\n        <div\n          role=\"progressbar\"\n          aria-valuemin={0}\n          aria-valuemax={100}\n          aria-valuenow={Math.round(progress)}\n          aria-label={typeof title === 'string' ? title : 'Progress'}\n          data-slot=\"banner-progress\"\n          data-tone={barTone}\n          className=\"h-[5px] w-full border-t border-border-faded bg-neutral-faded\"\n        >\n          <div className={cn('h-full transition-[width] duration-(--dur-slow)', BAR_TONE[barTone])} style={{ width: `${Math.min(100, Math.max(0, progress))}%` }} />\n        </div>\n      )}\n    </section>\n  )\n}\n\nconst stripVariants = cva('flex h-8 items-center justify-between gap-2 border-t border-border-faded px-4 text-xs font-medium', {\n  variants: {\n    tone: {\n      neutral: 'bg-neutral-faded text-text-subtle',\n      notice: 'bg-notice-faded text-notice-text',\n      positive: 'bg-positive-faded text-positive',\n      negative: 'bg-negative-faded text-negative',\n      primary: 'bg-primary-faded text-primary-text',\n    },\n  },\n  defaultVariants: { tone: 'neutral' },\n})\n\n/** Figma Status-Strip: a 32px line under the header with a tone-coloured label and a text action at the end. */\nfunction BannerStrip({\n  tone,\n  label,\n  actionLabel,\n  onAction,\n  className,\n  ...props\n}: Omit<React.ComponentProps<'div'>, 'children'> &\n  VariantProps<typeof stripVariants> & {\n    label: React.ReactNode\n    actionLabel?: string\n    onAction?: () => void\n  }) {\n  return (\n    <div data-slot=\"banner-strip\" data-tone={tone ?? 'neutral'} className={cn(stripVariants({ tone }), className)} {...props}>\n      <span className=\"min-w-0 truncate\">{label}</span>\n      {actionLabel && (\n        <button\n          type=\"button\"\n          onClick={onAction}\n          // 24px hit area (the strip is 32px high) that hugs the right edge so the label stays aligned with the title\n          className=\"-mr-2 inline-flex h-6 shrink-0 items-center rounded-md px-2 text-primary-text transition-colors duration-(--dur-base) hover:bg-primary-faded hover:underline ds-focus focus-visible:outline-offset-0\"\n        >\n          {actionLabel}\n        </button>\n      )}\n    </div>\n  )\n}\n\n/** Figma Banner body: 12px text, with a loader or status icon at the end (56px high) or action buttons under the text (76px high). */\n/** The id of the text next to a `BannerLoader`, so the loader is named by what it is loading instead of a bare \"Progress\". */\nconst BannerTextContext = React.createContext<string | undefined>(undefined)\n\nfunction BannerBody({\n  indicator,\n  actions,\n  className,\n  children,\n  ...props\n}: React.ComponentProps<'div'> & {\n  indicator?: React.ReactNode\n  actions?: React.ReactNode\n}) {\n  const textId = React.useId()\n  return (\n    <div\n      data-slot=\"banner-body\"\n      className={cn('border-t border-neutral-faded px-4 text-xs text-foreground', actions ? 'py-3' : 'py-2', className)}\n      {...props}\n    >\n      <div className=\"flex min-h-10 items-center gap-3\">\n        <div id={textId} className=\"min-w-0 flex-1 text-xs leading-4\">{children}</div>\n        <BannerTextContext.Provider value={textId}>{indicator}</BannerTextContext.Provider>\n      </div>\n      {actions && <div className=\"mt-2 flex items-center justify-end gap-3\">{actions}</div>}\n    </div>\n  )\n}\n\n/** Button for the banner body: `text` is the plain primary-coloured \"Secondary\", `filled` is the 28px \"Primary\". */\nfunction BannerButton({ className, variant = 'text', type = 'button', ...props }: React.ComponentProps<'button'> & { variant?: 'text' | 'filled' }) {\n  return (\n    <button\n      type={type}\n      data-slot=\"banner-button\"\n      className={cn(\n        // the Button \"sm\" step (height, radius, padding and type follow density); disabled uses the shared tokens, not opacity\n        'inline-flex h-(--ctl-h-sm) items-center justify-center rounded-md text-(length:--btn-fs-sm) leading-4 font-medium whitespace-nowrap transition-colors duration-(--dur-base) disabled:pointer-events-none ds-focus',\n        variant === 'text'\n          ? 'px-2 text-primary-text hover:bg-primary-faded hover:underline disabled:text-disabled-foreground disabled:hover:bg-transparent disabled:hover:no-underline'\n          : 'bg-primary px-(--btn-px-sm) text-primary-foreground hover:bg-primary/90 disabled:bg-disabled disabled:text-disabled-foreground',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\ntype BannerStatus = 'completed' | 'alert' | 'error' | 'pause'\n\nconst STATUS_STYLE: Record<BannerStatus, { box: string; icon: React.ReactNode; label: string }> = {\n  completed: { box: 'bg-positive-faded text-positive', icon: <Check className=\"size-5\" />, label: 'Completed' },\n  alert: { box: 'bg-notice-faded text-notice-text', icon: <AlertCircle className=\"size-5\" />, label: 'Needs attention' },\n  error: { box: 'bg-negative-faded text-negative', icon: <X className=\"size-5\" />, label: 'Failed' },\n  pause: { box: 'bg-neutral-faded text-text-subtle', icon: <Pause className=\"size-5\" />, label: 'Paused' },\n}\n\n/**\n * Figma Loader Icon, 40x40. `spinner` turns, `progress` is a ring filled to `value` (0 to 100, with the number in the middle when `showValue`),\n * `status` is a round icon: completed, alert, error or pause.\n */\nfunction BannerLoader({\n  kind = 'spinner',\n  value = 0,\n  showValue = false,\n  status = 'completed',\n  label,\n  className,\n}: {\n  kind?: 'spinner' | 'progress' | 'status'\n  value?: number\n  showValue?: boolean\n  status?: BannerStatus\n  label?: string\n  className?: string\n}) {\n  if (kind === 'status') {\n    const s = STATUS_STYLE[status]\n    return (\n      <span role=\"img\" aria-label={label ?? s.label} data-slot=\"banner-loader\" data-kind=\"status\" className={cn('grid size-10 shrink-0 place-items-center rounded-full', s.box, className)}>\n        {s.icon}\n      </span>\n    )\n  }\n  const textId = React.useContext(BannerTextContext)\n  const r = 17\n  const c = 2 * Math.PI * r\n  const pct = Math.min(100, Math.max(0, value))\n  const dash = kind === 'progress' ? (c * pct) / 100 : c * 0.28\n  return (\n    <span\n      role={kind === 'progress' ? 'progressbar' : 'status'}\n      aria-label={label ?? (textId ? undefined : kind === 'progress' ? 'Progress' : 'Loading')}\n      aria-labelledby={label ? undefined : textId}\n      aria-valuemin={kind === 'progress' ? 0 : undefined}\n      aria-valuemax={kind === 'progress' ? 100 : undefined}\n      aria-valuenow={kind === 'progress' ? Math.round(pct) : undefined}\n      data-slot=\"banner-loader\"\n      data-kind={kind}\n      className={cn('relative grid size-10 shrink-0 place-items-center', className)}\n    >\n      <svg viewBox=\"0 0 40 40\" className=\"absolute inset-0 size-10 -rotate-90\" aria-hidden>\n        <circle cx=\"20\" cy=\"20\" r={r} fill=\"none\" strokeWidth=\"4\" className=\"stroke-border-default\" />\n        <circle\n          cx=\"20\"\n          cy=\"20\"\n          r={r}\n          fill=\"none\"\n          strokeWidth=\"4\"\n          strokeLinecap=\"round\"\n          strokeDasharray={`${dash} ${c}`}\n          className={cn('stroke-primary', kind === 'spinner' && 'ov-loader-arc')}\n        />\n      </svg>\n      {kind === 'progress' && showValue && <span className=\"relative text-[10px] leading-none font-semibold text-foreground tabular-nums\">{Math.round(pct)}%</span>}\n    </span>\n  )\n}\n\nexport { Banner, BannerBody, BannerButton, BannerLoader, BannerStrip }\nexport type { BannerStatus, BannerProgressTone }\n","import * as React from 'react'\nimport { Dialog as SheetPrimitive } from 'radix-ui'\nimport { XIcon } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\nimport { inToaster } from '../lib/in-toaster'\nimport { useScrollable } from '../hooks/use-scrollable'\n\n/**\n * Bottom sheet. Figma Bottom Sheet page 3792:4426: a full-width sheet that rises from the bottom and stops 74px below the top of the window\n * (the dimmed page stays visible above it). Layout follows the width of the sheet itself (container queries), so the static panel can show the\n * phone layout inside a wide page. A 56px header holds the title (Heading S), an optional badge, actions (search, Secondary, Primary)\n * and a close X; the body is made of slots: the main content, a 372px aside and a 40px rail.\n *\n * <BottomSheet open={open} onOpenChange={setOpen}>\n *   <BottomSheetContent>\n *     <BottomSheetHeader title=\"INV12345\" badge={<Badge>In progress</Badge>} actions={<Button>Accept</Button>} />\n *     <BottomSheetBody>\n *       <BottomSheetMain>...</BottomSheetMain>\n *       <BottomSheetAside>...</BottomSheetAside>\n *     </BottomSheetBody>\n *   </BottomSheetContent>\n * </BottomSheet>\n *\n * `BottomSheetPanel` is the same sheet without Radix, in the page flow, for previews (gallery, mobile frames).\n */\nconst LiveContext = React.createContext(false)\n\nfunction BottomSheet(props: React.ComponentProps<typeof SheetPrimitive.Root>) {\n  return <SheetPrimitive.Root data-slot=\"bottom-sheet\" {...props} />\n}\n\nfunction BottomSheetTrigger(props: React.ComponentProps<typeof SheetPrimitive.Trigger>) {\n  return <SheetPrimitive.Trigger data-slot=\"bottom-sheet-trigger\" {...props} />\n}\n\nfunction BottomSheetClose(props: React.ComponentProps<typeof SheetPrimitive.Close>) {\n  return <SheetPrimitive.Close data-slot=\"bottom-sheet-close\" {...props} />\n}\n\nfunction BottomSheetOverlay({ className, ...props }: React.ComponentProps<typeof SheetPrimitive.Overlay>) {\n  return (\n    <SheetPrimitive.Overlay\n      data-slot=\"bottom-sheet-overlay\"\n      className={cn(\n        'fixed inset-0 z-(--z-overlay) bg-scrim data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nconst surface = '@container flex flex-col rounded-t-xl border-t bg-card text-card-foreground shadow-lg'\n\n/** `height=\"full\"` (default) is the Figma sheet, 74px short of the window height; `auto` sizes to the content up to that limit. */\nfunction BottomSheetContent({\n  className,\n  children,\n  height = 'full',\n  onInteractOutside,\n  ...props\n}: React.ComponentProps<typeof SheetPrimitive.Content> & { height?: 'full' | 'auto' }) {\n  return (\n    <SheetPrimitive.Portal data-slot=\"bottom-sheet-portal\">\n      <BottomSheetOverlay />\n      <SheetPrimitive.Content\n        data-slot=\"bottom-sheet-content\"\n        // the aside and main slots are the description, so Radix's missing-description warning has nothing to ask for; pass your own `aria-describedby` to override\n        aria-describedby={undefined}\n        className={cn(\n          surface,\n          'fixed inset-x-0 bottom-0 z-(--z-overlay) overflow-hidden pb-[env(safe-area-inset-bottom)] outline-none data-[state=closed]:animate-out data-[state=closed]:duration-(--dur-moderate) data-[state=closed]:slide-out-to-bottom data-[state=open]:animate-in data-[state=open]:duration-(--dur-slow) data-[state=open]:slide-in-from-bottom',\n          height === 'full' ? 'h-[calc(100dvh-74px)]' : 'max-h-[calc(100dvh-74px)]',\n          className,\n        )}\n        {...props}\n        onInteractOutside={(event) => {\n          onInteractOutside?.(event)\n          // a toast raised from inside the sheet sits outside its content: pressing its Undo or close button must not dismiss the sheet\n          if (inToaster(event.target)) event.preventDefault()\n        }}\n      >\n        <LiveContext.Provider value>{children}</LiveContext.Provider>\n      </SheetPrimitive.Content>\n    </SheetPrimitive.Portal>\n  )\n}\n\n/** Same surface as `BottomSheetContent`, in the page flow and without Radix. */\nfunction BottomSheetPanel({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"bottom-sheet-panel\" className={cn(surface, 'relative w-full overflow-hidden border-x border-b', className)} {...props} />\n}\n\nfunction BottomSheetHeader({\n  title,\n  badge,\n  actions,\n  onClose,\n  showClose = true,\n  className,\n  ...props\n}: Omit<React.ComponentProps<'div'>, 'title'> & {\n  title: React.ReactNode\n  badge?: React.ReactNode\n  /** Search field and buttons shown before the close X. On narrow screens they wrap onto a second line. */\n  actions?: React.ReactNode\n  /** Used by the static panel; a live sheet closes through Radix. */\n  onClose?: () => void\n  showClose?: boolean\n}) {\n  const live = React.useContext(LiveContext)\n  const Title = live ? SheetPrimitive.Title : 'h2'\n  return (\n    <div\n      data-slot=\"bottom-sheet-header\"\n      className={cn('flex min-h-14 shrink-0 flex-wrap items-center gap-x-3 gap-y-2 border-b px-4 py-2', className)}\n      {...props}\n    >\n      <div className=\"flex min-w-0 flex-1 items-center gap-3 @2xl:flex-none\">\n        <Title className=\"truncate text-2xl leading-7 font-extrabold text-foreground\">{title}</Title>\n        {badge}\n      </div>\n      {actions && <div className=\"order-last flex w-full items-center gap-2 @2xl:order-none @2xl:ml-auto @2xl:w-auto @2xl:flex-1 @2xl:justify-end\">{actions}</div>}\n      {showClose &&\n        (live ? (\n          <SheetPrimitive.Close\n            aria-label=\"Close\"\n            className=\"ml-auto grid size-10 shrink-0 place-items-center rounded-md text-foreground hover:bg-accent @2xl:ml-0 ds-focus\"\n          >\n            <XIcon className=\"size-5\" />\n          </SheetPrimitive.Close>\n        ) : (\n          <button\n            type=\"button\"\n            aria-label=\"Close\"\n            onClick={onClose}\n            className=\"ml-auto grid size-10 shrink-0 place-items-center rounded-md text-foreground hover:bg-accent @2xl:ml-0 ds-focus\"\n          >\n            <XIcon className=\"size-5\" />\n          </button>\n        ))}\n    </div>\n  )\n}\n\n/** Row of slots under the header (stacks on narrow screens). */\nfunction BottomSheetBody({ className, ref, ...props }: React.ComponentProps<'div'>) {\n  // when the slots stack, the body scrolls: a tab stop then, so the arrow keys work without a mouse\n  const [scrollRef, scrollable] = useScrollable<HTMLDivElement>(ref, { unlessFocusable: true })\n  return <div ref={scrollRef} data-slot=\"bottom-sheet-body\" tabIndex={scrollable ? 0 : undefined} className={cn('flex min-h-0 flex-1 @max-3xl:flex-col @max-3xl:overflow-y-auto ds-focus-inset', className)} {...props} />\n}\n\n/** Main slot: takes the free width and scrolls. */\nfunction BottomSheetMain({ className, ref, ...props }: React.ComponentProps<'div'>) {\n  const [scrollRef, scrollable] = useScrollable<HTMLDivElement>(ref, { unlessFocusable: true })\n  return <div ref={scrollRef} data-slot=\"bottom-sheet-main\" tabIndex={scrollable ? 0 : undefined} className={cn('min-w-0 flex-1 @3xl:overflow-y-auto ds-focus-inset', className)} {...props} />\n}\n\n/** Side slot (Figma Slot 2, 372px). A plain `div`: an `aside` inside a dialog is not a valid top-level landmark. Give it `role=\"region\"` and an `aria-label` if it deserves a landmark. */\nfunction BottomSheetAside({ className, ref, ...props }: React.ComponentProps<'div'>) {\n  const [scrollRef, scrollable] = useScrollable<HTMLDivElement>(ref, { unlessFocusable: true })\n  return (\n    <div\n      ref={scrollRef}\n      data-slot=\"bottom-sheet-aside\"\n      tabIndex={scrollable ? 0 : undefined}\n      className={cn('shrink-0 border-t bg-surface-moderate @max-3xl:w-full @3xl:w-[372px] @3xl:overflow-y-auto @3xl:border-t-0 @3xl:border-l ds-focus-inset', className)}\n      {...props}\n    />\n  )\n}\n\n/** Narrow rail (Figma Mini Sidebar, 40px) for icon buttons. Hidden on narrow screens. */\nfunction BottomSheetRail({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"bottom-sheet-rail\" className={cn('flex w-10 shrink-0 flex-col items-center gap-1 border-l bg-card py-2 @max-3xl:hidden', className)} {...props} />\n}\n\nexport {\n  BottomSheet,\n  BottomSheetAside,\n  BottomSheetBody,\n  BottomSheetClose,\n  BottomSheetContent,\n  BottomSheetHeader,\n  BottomSheetMain,\n  BottomSheetOverlay,\n  BottomSheetPanel,\n  BottomSheetRail,\n  BottomSheetTrigger,\n}\n","import * as React from 'react'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Card. Spacing, radius and the title / description sizes are variables (--card-gap, --card-py, --card-px, --card-radius, --card-title-fs,\n * --card-description-fs, set per density in ds-density.css), so a className such as `py-0`, `rounded-lg` or `text-2xl` on a part always wins,\n * in comfortable and compact density alike.\n */\nfunction Card({ className, interactive, ...props }: React.ComponentProps<'div'> & {\n  /** hover feedback (border and shadow) for a card that acts as one link or button, such as a document tile. The card does not become clickable by itself: put the link or button inside it. Its own focus ring stays, and the card edge turns to the focus colour as well. */\n  interactive?: boolean\n}) {\n  return (\n    <div\n      data-slot=\"card\"\n      data-interactive={interactive || undefined}\n      className={cn(\n        'flex flex-col gap-(--card-gap) rounded-(--card-radius) border bg-card py-(--card-py) text-card-foreground shadow-xs',\n        interactive && 'relative transition-[border-color,box-shadow] duration-(--dur-base) hover:border-border-control hover:shadow-md has-focus-visible:border-(--focus-ring) has-focus-visible:shadow-md',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\nfunction CardHeader({ className, ...props }: React.ComponentProps<'div'>) {\n  return (\n    <div\n      data-slot=\"card-header\"\n      className={cn(\n        '@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-(--card-px) has-data-[slot=card-action]:grid-cols-[1fr_auto]',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\ntype CardTitleProps = React.ComponentProps<'div'> & {\n  /** element to render. Default `div`; pass `h2` / `h3` ... to make the title a heading, at the level that fits the page outline. */\n  as?: 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'\n}\n\nfunction CardTitle({ className, as: Tag = 'div', ...props }: CardTitleProps) {\n  return <Tag data-slot=\"card-title\" className={cn('text-(length:--card-title-fs) leading-snug font-semibold', className)} {...(props as React.ComponentProps<'div'>)} />\n}\n\nfunction CardDescription({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"card-description\" className={cn('text-(length:--card-description-fs) text-muted-foreground', className)} {...props} />\n}\n\nfunction CardAction({ className, ...props }: React.ComponentProps<'div'>) {\n  return (\n    <div\n      data-slot=\"card-action\"\n      className={cn('col-start-2 row-span-2 row-start-1 self-start justify-self-end', className)}\n      {...props}\n    />\n  )\n}\n\nfunction CardContent({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"card-content\" className={cn('px-(--card-px)', className)} {...props} />\n}\n\nfunction CardFooter({ className, ...props }: React.ComponentProps<'div'>) {\n  return <div data-slot=\"card-footer\" className={cn('flex items-center px-(--card-px)', className)} {...props} />\n}\n\nexport { Card, CardHeader, CardFooter, CardTitle, CardAction, CardDescription, CardContent }\nexport type { CardTitleProps }\n","import * as React from 'react'\nimport { ChevronLeft, ChevronRight } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Carousel. Figma Carousel page 3709:322: a row of items that scrolls one item at a time, with previous / next buttons (32px, 8px radius)\n * and page dots (6px dots, the active one is an 18px pill; each dot is a 24px-wide button, so the marks sit about 13px apart). `navigation=\"bottom\"` puts buttons and dots in a row under the items,\n * `navigation=\"side\"` puts the buttons beside the items and the dots under them. `visibleItems` is 1, 2, 3 or `auto` (items keep their own width).\n * `tone` is the Figma state of the controls: `primary`, `neutral`, or `onPrimary` for use on a blue surface.\n * `minItemWidth` (px) makes `visibleItems` a maximum: the count drops so items never get narrower than that, so a 3-up carousel is 2-up or 1-up on a phone.\n * `labels` replaces the English button and dot labels.\n *\n * <Carousel visibleItems={3} navigation=\"bottom\" aria-label=\"Featured templates\">\n *   <TemplateCard /> <TemplateCard /> <TemplateCard /> <TemplateCard />\n * </Carousel>\n */\ntype CarouselTone = 'primary' | 'neutral' | 'onPrimary'\ntype CarouselVisible = 1 | 2 | 3 | 'auto'\n\n/** The words the controls speak. Every key is optional; the defaults are English. */\ntype CarouselLabels = {\n  previous: string\n  next: string\n  /** The name of the group of page dots. */\n  dots: string\n  /** The name of one dot, 1-based. */\n  goTo: (page: number) => string\n  /** The name of one item. */\n  slide: (index: number, count: number) => string\n}\n\n/** Where a slide starts inside the scrolled track, from bounding rects: `offsetLeft` is rounded to a whole pixel, which can leave the last card clipped by 1px. */\nconst slideLeft = (track: HTMLElement, slide: HTMLElement) => slide.getBoundingClientRect().left - track.getBoundingClientRect().left - track.clientLeft + track.scrollLeft\n\nconst DEFAULT_LABELS: CarouselLabels = {\n  previous: 'Previous',\n  next: 'Next',\n  dots: 'Choose slide',\n  goTo: (page) => `Go to slide ${page}`,\n  slide: (index, count) => `${index} of ${count}`,\n}\n\n/* Disabled recipe: the shared --disabled tokens on the neutral surfaces; a translucent white on the blue surface, where those tokens are not designed to sit. */\nconst BUTTON_TONE: Record<CarouselTone, string> = {\n  primary: 'bg-primary text-primary-foreground hover:bg-primary/90 disabled:bg-disabled disabled:text-disabled-foreground',\n  neutral: 'bg-ov-neutral text-white hover:bg-ov-neutral/90 disabled:bg-disabled disabled:text-disabled-foreground',\n  onPrimary: 'bg-white text-black hover:bg-white/90 disabled:bg-white/20 disabled:text-white/60 [--focus-ring:var(--focus-ring-inverse)]',\n}\n\n/* Idle dots are --border-control (3:1 on the page) so the row of pages is visible, not just the active one. */\nconst DOT_TONE: Record<CarouselTone, { active: string; idle: string; ring: string }> = {\n  primary: { active: 'bg-primary-text', idle: 'bg-border-control group-hover/dot:bg-text-muted', ring: '' },\n  neutral: { active: 'bg-text-muted', idle: 'bg-border-control group-hover/dot:bg-text-muted', ring: '' },\n  onPrimary: { active: 'bg-white', idle: 'bg-white/50 group-hover/dot:bg-white/80', ring: '[--focus-ring:var(--focus-ring-inverse)]' },\n}\n\nfunction CarouselButton({ tone = 'primary', direction, className, ...props }: React.ComponentProps<'button'> & { tone?: CarouselTone; direction: 'prev' | 'next' }) {\n  return (\n    <button\n      type=\"button\"\n      data-slot=\"carousel-button\"\n      aria-label={direction === 'prev' ? DEFAULT_LABELS.previous : DEFAULT_LABELS.next}\n      className={cn(\n        'inline-grid size-8 compact:size-7 shrink-0 place-items-center rounded-lg transition-colors duration-(--dur-fast) disabled:pointer-events-none [&_svg]:size-4 ds-focus',\n        BUTTON_TONE[tone],\n        className,\n      )}\n      {...props}\n    >\n      {direction === 'prev' ? <ChevronLeft /> : <ChevronRight />}\n    </button>\n  )\n}\n\n/**\n * The page dots on their own (Figma Carousel Indicators). Plain buttons in a labelled group (so every dot is in the tab order, not a tablist that would\n * promise arrow-key navigation); the current one has `aria-current`. Each dot is a 24px button around the 6px mark (WCAG 2.5.8).\n */\nfunction CarouselDots({\n  count,\n  index,\n  tone = 'primary',\n  onSelect,\n  labels,\n  className,\n}: {\n  count: number\n  index: number\n  tone?: CarouselTone\n  onSelect?: (index: number) => void\n  labels?: Partial<Pick<CarouselLabels, 'dots' | 'goTo'>>\n  className?: string\n}) {\n  const t = { ...DEFAULT_LABELS, ...labels }\n  return (\n    <div data-slot=\"carousel-dots\" role=\"group\" aria-label={t.dots} className={cn('flex items-center', className)}>\n      {Array.from({ length: count }, (_, i) => {\n        const active = i === index\n        return (\n          <button\n            key={i}\n            type=\"button\"\n            aria-current={active ? 'true' : undefined}\n            aria-label={t.goTo(i + 1)}\n            disabled={!onSelect}\n            onClick={() => onSelect?.(i)}\n            className={cn('group/dot grid h-6 min-w-6 place-items-center rounded-full px-1 disabled:cursor-default ds-focus focus-visible:outline-offset-0', DOT_TONE[tone].ring)}\n          >\n            <span\n              aria-hidden\n              className={cn(\n                'block h-1.5 rounded-full transition-[width,background-color] duration-(--dur-moderate) ease-(--ease-standard)',\n                active ? cn('w-[18px]', DOT_TONE[tone].active) : cn('w-1.5', DOT_TONE[tone].idle),\n              )}\n            />\n          </button>\n        )\n      })}\n    </div>\n  )\n}\n\nfunction Carousel({\n  visibleItems = 1,\n  navigation = 'bottom',\n  tone = 'primary',\n  gap = 24,\n  showDots = true,\n  minItemWidth,\n  labels,\n  className,\n  children,\n  ...props\n}: Omit<React.ComponentProps<'div'>, 'children'> & {\n  visibleItems?: CarouselVisible\n  navigation?: 'bottom' | 'side'\n  tone?: CarouselTone\n  /** Space between items, in px (Figma 24). */\n  gap?: number\n  /** false is Figma \"Slider=False\": the buttons only, no dots. */\n  showDots?: boolean\n  /** Smallest item width in px. `visibleItems` then acts as a maximum and the count shrinks on narrow containers (a 3-up carousel is 1-up on a phone). */\n  minItemWidth?: number\n  /** Replace the English control labels. */\n  labels?: Partial<CarouselLabels>\n  children: React.ReactNode\n}) {\n  const t = { ...DEFAULT_LABELS, ...labels }\n  const slides = React.Children.toArray(children)\n  const count = slides.length\n  const trackRef = React.useRef<HTMLDivElement>(null)\n  const [index, setIndex] = React.useState(0)\n  const [edges, setEdges] = React.useState({ start: true, end: count <= 1 })\n  const [trackWidth, setTrackWidth] = React.useState(0)\n  const maxVisible = visibleItems === 'auto' ? 1 : visibleItems\n  const fit = minItemWidth && trackWidth > 0 ? Math.max(1, Math.floor((trackWidth + gap) / (minItemWidth + gap))) : maxVisible\n  const visible = Math.min(maxVisible, fit)\n  const pages = visibleItems === 'auto' ? count : Math.max(1, count - visible + 1)\n\n  const measure = React.useCallback(() => {\n    const el = trackRef.current\n    if (!el) return\n    setTrackWidth(el.clientWidth)\n    const max = el.scrollWidth - el.clientWidth\n    let best = 0\n    let bestDist = Infinity\n    Array.from(el.children).forEach((child, i) => {\n      const dist = Math.abs(slideLeft(el, child as HTMLElement) - el.scrollLeft)\n      if (dist < bestDist) {\n        best = i\n        bestDist = dist\n      }\n    })\n    const atEnd = max <= 1 || el.scrollLeft >= max - 1\n    const atStart = el.scrollLeft <= 1\n    setEdges({ start: atStart, end: atEnd })\n    setIndex(atEnd && max > 1 ? pages - 1 : Math.min(best, pages - 1))\n  }, [pages])\n\n  React.useEffect(() => {\n    measure()\n    const el = trackRef.current\n    if (!el || typeof ResizeObserver === 'undefined') return\n    const ro = new ResizeObserver(measure)\n    ro.observe(el)\n    return () => ro.disconnect()\n  }, [measure, count])\n\n  const goTo = (i: number) => {\n    const el = trackRef.current\n    const slide = el?.children[Math.max(0, Math.min(count - 1, i))] as HTMLElement | undefined\n    if (el && slide) el.scrollTo({ left: Math.min(Math.ceil(slideLeft(el, slide)), el.scrollWidth - el.clientWidth) })\n  }\n  const prev = () => goTo(index - 1)\n  const next = () => goTo(index + 1)\n\n  const onKeyDown = (e: React.KeyboardEvent) => {\n    // only when the track itself has focus: arrows inside an input or a menu in a slide belong to that control\n    if (e.target !== e.currentTarget) return\n    if (e.key === 'ArrowLeft') {\n      e.preventDefault()\n      prev()\n    } else if (e.key === 'ArrowRight') {\n      e.preventDefault()\n      next()\n    } else if (e.key === 'Home') {\n      e.preventDefault()\n      goTo(0)\n    } else if (e.key === 'End') {\n      e.preventDefault()\n      goTo(count - 1)\n    }\n  }\n\n  const basis = visibleItems === 'auto' ? undefined : `calc((100% - ${gap * (visible - 1)}px) / ${visible})`\n  const prevBtn = <CarouselButton tone={tone} direction=\"prev\" aria-label={t.previous} onClick={prev} disabled={edges.start} />\n  const nextBtn = <CarouselButton tone={tone} direction=\"next\" aria-label={t.next} onClick={next} disabled={edges.end} />\n  const dots = showDots && pages > 1 ? <CarouselDots count={pages} index={index} tone={tone} labels={t} onSelect={goTo} /> : null\n\n  const viewport = (\n    <div\n      ref={trackRef}\n      tabIndex={0}\n      onScroll={measure}\n      onKeyDown={onKeyDown}\n      data-slot=\"carousel-track\"\n      className=\"ov-carousel-track relative flex min-w-0 flex-1 overflow-x-auto rounded-sm ds-focus\"\n      style={{ gap }}\n    >\n      {slides.map((slide, i) => (\n        <div\n          key={i}\n          role=\"group\"\n          aria-roledescription=\"slide\"\n          aria-label={t.slide(i + 1, count)}\n          data-slot=\"carousel-item\"\n          className=\"min-w-0 shrink-0 snap-start\"\n          style={basis ? { flex: `0 0 ${basis}` } : undefined}\n        >\n          {slide}\n        </div>\n      ))}\n    </div>\n  )\n\n  return (\n    <div\n      role=\"region\"\n      aria-roledescription=\"carousel\"\n      data-slot=\"carousel\"\n      data-navigation={navigation}\n      data-tone={tone}\n      className={cn('flex w-full flex-col gap-6', tone === 'onPrimary' && '[--focus-ring:var(--focus-ring-inverse)]', className)}\n      {...props}\n    >\n      {navigation === 'side' ? (\n        <>\n          <div className=\"flex items-center gap-4\">\n            {prevBtn}\n            {viewport}\n            {nextBtn}\n          </div>\n          {dots && <div className=\"flex justify-center\">{dots}</div>}\n        </>\n      ) : (\n        <>\n          {viewport}\n          <div className=\"flex items-center justify-center gap-4\">\n            {prevBtn}\n            {dots}\n            {nextBtn}\n          </div>\n        </>\n      )}\n    </div>\n  )\n}\n\nexport { Carousel, CarouselButton, CarouselDots }\nexport type { CarouselLabels, CarouselTone, CarouselVisible }\n","import * as React from 'react'\nimport { Check, X } from 'lucide-react'\n\nimport { cn } from '../lib/utils'\n\n/**\n * Chip (Figma 2762:1323). A pill (corner radius 1000) in six colours (primary, neutral, positive, negative, alert, info), two types\n * (`intense` = solid fill, `outline` = hairline border) and four sizes (large 32, medium 28, small 24, xsmall 18).\n * States: default, hover, focused / pressed, disabled. The colour matrix lives in src/styles/ds-atoms.css (.ds-chip).\n *\n * Kinds are behaviours on top of the same look: assist (an action, optional leading icon), filter (toggles `selected`, shows a check and\n * turns solid), input (a removable value with a trailing X) and status (read-only, optional dot).\n * Pass data-force=\"hover|active|focus\" to show a state without interaction (used by the design-system gallery).\n */\nexport type ChipKind = 'assist' | 'filter' | 'input' | 'status'\n/** `warning` is the same colour as `alert` (the name Badge, Alert and the tokens use). */\nexport type ChipColor = 'neutral' | 'primary' | 'positive' | 'negative' | 'alert' | 'warning' | 'info'\n/** `lg` `md` `sm` `xs` are short names for large, medium, small and xsmall (the vocabulary of Button). */\nexport type ChipSize = 'large' | 'medium' | 'small' | 'xsmall' | 'lg' | 'md' | 'sm' | 'xs'\nexport type ChipAppearance = 'intense' | 'outline'\n\n// Figma: L 14/20 with 8 / 6 padding, M and S 12/16 (6 and 4 vertical), XS 11/14 with 4 / 2.\n// Compact density: large 28 (the same as a default Button), medium 24; small stays 24 (the minimum target) and xsmall is a status size.\nconst SIZE: Record<'large' | 'medium' | 'small' | 'xsmall', string> = {\n  large: 'h-8 gap-1 px-2 py-1.5 text-base compact:h-7 compact:py-1 compact:text-sm [&_svg]:size-4',\n  medium: