true })\nconst ListIndexContext = React.createContext(0)\n\nfunction List({\n  size = 'md',\n  tone = 'neutral',\n  marker = 'bullet',\n  toneText = true,\n  className,\n  children,\n  ...props\n}: React.ComponentProps<'ul'> & {\n  size?: ListSize\n  tone?: ListTone\n  marker?: ListMarker\n  /** false colours only the marker and leaves the text in the foreground colour (a coloured line of body text can be mistaken for a link). Default true. */\n  toneText?: boolean\n}) {\n  const value = React.useMemo(() => ({ size, tone, marker, toneText }), [size, tone, marker, toneText])\n  const Tag = (marker === 'number' ? 'ol' : 'ul') as 'ul'\n  return (\n    <ListContext.Provider value={value}>\n      <Tag data-slot=\"list\" data-size={size} role=\"list\" className={cn('flex flex-col', size === 'sm' ? 'gap-2 compact:gap-1.5' : size === 'md' ? 'gap-3 compact:gap-2' : 'gap-4 compact:gap-3', className)} {...props}>\n        {React.Children.toArray(children).map((child, i) => (\n          <ListIndexContext.Provider key={i} value={i}>\n            {child}\n          </ListIndexContext.Provider>\n        ))}\n      </Tag>\n    </ListContext.Provider>\n  )\n}\n\ninterface ListItemProps extends React.ComponentProps<'li'> {\n  tone?: ListTone\n  size?: ListSize\n  marker?: ListMarker\n  /** same as `toneText` on `List`, for one item */\n  toneText?: boolean\n  /** the glyph for marker=\"icon\" */\n  icon?: React.ReactNode\n  /** name (and optional picture) for marker=\"avatar\" */\n  avatarName?: string\n  avatarSrc?: string\n  /** second line under the text */\n  subtext?: React.ReactNode\n}\n\nfunction ListItem({ tone, size, marker, toneText, icon, avatarName, avatarSrc, subtext, className, children, ...props }: ListItemProps) {\n  const ctx = React.useContext(ListContext)\n  const index = React.useContext(ListIndexContext)\n  const s = size ?? ctx.size\n  const t = tone ?? ctx.tone\n  const m = marker ?? ctx.marker\n  const coloured = toneText ?? ctx.toneText\n\n  let mark: React.R