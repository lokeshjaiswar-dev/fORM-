ps: 'slides', ppsx: 'slides', odp: 'slides', key: 'slides',\n  png: 'image', jpg: 'image', jpeg: 'image', gif: 'image', webp: 'image', svg: 'image', bmp: 'image', tif: 'image', tiff: 'image', heic: 'image', avif: 'image',\n  zip: 'archive', rar: 'archive', '7z': 'archive', tar: 'archive', gz: 'archive', tgz: 'archive', bz2: 'archive',\n  txt: 'text', md: 'text', log: 'text', json: 'text', xml: 'text', yaml: 'text', yml: 'text', eml: 'text',\n  mp4: 'video', mov: 'video', avi: 'video', mkv: 'video', webm: 'video', m4v: 'video',\n}\n\nfunction kindFromMime(mime: string): FileKind {\n  if (mime === 'inode/directory' || mime.endsWith('.folder')) return 'folder'\n  if (mime === 'application/pdf') return 'pdf'\n  if (mime.startsWith('image/')) return 'image'\n  if (mime.startsWith('video/')) return 'video'\n  if (mime === 'text/csv' || mime.includes('spreadsheet') || mime.includes('ms-excel')) return 'sheet'\n  if (mime.includes('presentation') || mime.includes('ms-powerpoint')) return 'slides'\n  if (mime.includes('msword') || mime.includes('wordprocessing') || mime === 'application/rtf' || mime === 'application/vnd.oasis.opendocument.text') return 'doc'\n  if (/zip|rar|7z|tar|gzip/.test(mime)) return 'archive'\n  if (mime.startsWith('text/') || mime.endsWith('/json') || mime.endsWith('/xml')) return 'text'\n  return 'generic'\n}\n\n/** What a `type` string was made of, so the glyph can show the real extension (\"XLSX\") instead of the kind's default label. */\nfunction parseFileType(type?: string): { kind: FileKind; ext?: string } {\n  const raw = (type ?? '').trim().toLowerCase()\n  if (!raw) return { kind: 'generic' }\n  if ((KINDS as readonly string[]).includes(raw)) return { kind: raw as FileKind }\n  if (raw === 'directory' || raw === 'dir') return { kind: 'folder' }\n  if (raw.includes('/')) return { kind: kindFromMime(raw) }\n  const ext = raw.slice(raw.lastIndexOf('.') + 1)\n  const kind = EXTENSIONS[ext]\n  return kind ? { kind, ext } : { kind: 'generic' }\n}\n\n/** Map an extension (`.docx`, `xlsx`), a file name (`Invoice.pdf`), a MIME type (`application/pdf`) or a kind (`sheet`) to a `FileKind`. Unknown input is `generic`. */\nexport function resolveFileKind(type?: string): FileKind {\n  return parseFileType(type).kind\n}\n\n/* ---------------------------------------------------------------------------------------------------------------------------------\n   FileTypeIcon\n   --------------------------------------------------------------------------------------------------------------------------------- */\n\nexport type FileTypeIconSize = 'sm' | 'md' | 'lg' | 'xl' | '2xl'\n\nconst ICON_SIZE: Record<FileTypeIconSize, string> = { sm: 'w-5', md: 'w-8', lg: 'w-10', xl: 'w-14', '2xl': 'w-20' }\n\n/** Colour per kind, from the semantic tokens so both themes work. The tint behind the glyph is the same colour at low opacity. */\nconst KIND_TONE: Record<FileKind, string> = {\n  pdf: 'text-negative',\n  doc: 'text-primary-text',\n  sheet: 'text-positive',\n  slides: 'text-notice-text',\n  image: 'text-information',\n  video: 'text-information',\n  // neutral kinds recede: the least important types must not be the highest-contrast objects in a grid\n  archive: 'text-text-muted',\n  text: 'text-text-muted',\n  folder: 'text-primary-text',\n  generic: 'text-text-muted',\n}\n\n/** Default label printed on the page glyph; kinds without one carry an icon instead. */\nconst KIND_LABEL: Partial<Record<FileKind, string>> = { pdf: 'PDF', doc: 'DOC', sheet: 'XLS', slides: 'PPT' }\nconst KIND_ICON: Partial<Record<FileKind, React.ComponentType<{ className?: string; strokeWidth?: number }>>> = {\n  image: ImageIcon,\n  video: Clapperboard,\n  archive: Archive,\n  text: FileText,\n}\n\nexport interface FileTypeIconProps extends Omit<React.ComponentProps<'span'>, 'children'> {\n  /** extension (`docx`, `.xlsx`), file name, MIME type or kind name. With `kind` it only supplies the real extension to print (\"CSV\" instead of \"XLS\"), and only whe