selected.</span>\n                <button type=\"button\" className=\"rounded-xs font-medium text-primary-text hover:underline ds-focus\" onClick={() => onSelectedChange?.([])}>\n                  Clear selection\n                </button>\n              </>\n            ) : (\n              <>\n                <span className=\"tnum\">All {num(ids.length)} rows on this page are selected.</span>\n                <button type=\"button\" className=\"rounded-xs font-medium text-primary-text hover:underline ds-focus\" onClick={() => onSelectedChange?.(sorted.map((r) => rowId(r)))}>\n                  Select all {num(sorted.length)} rows\n                </button>\n              </>\n            )}\n          </div>\n        )}\n        <Table\n          containerRef={containerRef}\n          containerClassName={sticky ? 'max-h-(--dt-max) overflow-y-auto' : undefined}\n          className={cn(fixed && 'table-fixed')}\n          style={tableMin ? { minWidth: tableMin } : undefined}\n          aria-label={label}\n          aria-rowcount={showSkeleton || error ? undefined : total + 1}\n          aria-busy={stale || showSkeleton || undefined}\n        >\n          <TableHeader className={cn(sticky && '[&_th]:sticky [&_th]:top-0 [&_th]:z-10 [&_th]:shadow-[inset_0_-1px_0_var(--border-subtle)] [&_tr]:border-b-0')}>\n            <TableRow className=\"hover:bg-transparent\" aria-rowindex={1}>\n              {selectable && (\n                <TableHead className=\"w-12\" stickyStart={stickSelect ? 0 : undefined}>\n                  <Checkbox\n                    checked={allSel ? true : someSel ? 'indeterminate' : false}\n                    onCheckedChange={(v) => onSelectedChange?.(v ? [...new Set([...selected, ...ids])] : selected.filter((s) => !ids.includes(s)))}\n                    aria-label={virtualize ? 'Select all rows' : 'Select page'}\n                  />\n                </TableHead>\n              )}\n              {cols.map((c, i) => (\n                <TableHead\n                  key={c.key}\n                  align={c.align}\n                  info={c.info}\n                  pinned={c.pinned}\n                  stickyStart={pins[i]}\n                  onSort={c.sort ? () => toggleSort(c.key) : undefined}\n                  sorted={sort?.key === c.key ? sort.dir : false}\n                  className={cn(i === lastPin && PIN_EDGE, c.className)}\n                  style={c.width !== undefined ? { width: c.width } : undefined}\n                >\n                  {c.header === '' ? <span className=\"sr-only\">{c.key}</span> : c.header}\n                </TableHead>\n              ))}\n            </TableRow>\n          </TableHeader>\n          <TableBody className={cn(stale && 'opacity-60 transition-opacity')}>\n            {showSkeleton &&\n              Array.from({ length: Math.min(Math.max(size, 3), SKELETON_MAX_ROWS) }, (_, i) => (\n                <TableRow key={`sk-${i}`} className=\"hover:bg-transparent\" aria-hidden>\n                  {selectable && (\n                    <TableCell><Skeleton className=\"size-4 rounded-xs\" /></TableCell>\n                  )}\n                  {cols.map((c, ci) => (\n                    <TableCell key={c.key} className={cn(dense && 'h-9 py-1')}>\n                      <Skeleton shape=\"text\" className={cn('h-3.5', c.align === 'right' ? 'ml-auto w-2/5' : SKELETON_WIDTHS[(i + ci) % SKELETON_WIDTHS.length])} />\n                    </TableCell>\n                  ))}\n                </TableRow>\n              ))}\n            {!showSkeleton && error && (\n              <TableRow className=\"hover:bg-transparent\">\n                <TableCell colSpan={colSpan} className=\"h-auto p-0\">\n                  <TableState\n                    tone=\"negative\"\n                    title={errorTitle ?? 'Could not load records'}\n                    description={typeof error === 'string' ? error : 'Something went wrong. Retry to load this table.'}\n                    action={onRetry && <