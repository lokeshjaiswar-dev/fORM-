}\n\n/* ------------------------------------------------------------ validators */\n\n/** One check: returns the message when `value` is not acceptable, otherwise undefined. `values` is the whole form. */\nexport type Rule<T = unknown, V = Record<string, unknown>> = (value: T, values: V) => string | undefined\n\nconst isBlank = (v: unknown) => v === undefined || v === null || (typeof v === 'string' && v.trim() === '') || (Array.isArray(v) && v.length === 0) || v === false\n\nexport const rules = {\n  /** Fails for an empty string (spaces count as empty), an empty list, `undefined`, `null` and `false`. */\n  required:\n    (message = 'This field is required'): Rule =>\n    (v) =>\n      isBlank(v) ? message : undefined,\n  /** Fails when a non-empty string does not match; an empty value passes, so combine with `required` where needed. */\n  pattern:\n    (regex: RegExp, message = 'Enter a valid value'): Rule =>\n    (v) =>\n      typeof v === 'string' && v !== '' && !regex.test(v) ? message : undefined,\n  /** Fails when a non-empty string is shorter than `min` characters. */\n  minLength:\n    (min: number, message = `Enter at least ${min} characters`): Rule =>\n    (v) =>\n      typeof v === 'string' && v !== '' && v.trim().length < min ? message : undefined,\n}\n\n/**\n * Turns `{ field: rule | [rules] }` into a `validate` function for `useFormState`. The first failing rule of each field supplies its message.\n */\nexport function createValidator<V extends Record<string, unknown>>(spec: { [K in keyof V & string]?: Rule<V[K], V> | Rule<V[K], V>[] }): (values: V) => FormErrors {\n  return (values) => {\n    const out: FormErrors = {}\n    for (const [name, rule] of Object.entries(spec) as [string, Rule<unknown, V> | Rule<unknown, V>[] | undefined][]) {\n      for (const check of Array.isArray(rule) ? rule : rule ? [rule] : []) {\n        const message = check(values[name], values)\n        if (message) {\n          out[name] = message\n          break\n        }\n      }\n    }\n    return out\n  }\n}\n","import * as React from 'react'\nimport { ArrowLeft, PanelRight, X } from 'lucide-react'\n\nimport { Breadcrumb, BreadcrumbEllipsis, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage } from '../components/breadcrumb'\nimport { Button } from '../components/button'\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '../components/dropdown-menu'\nimport { useControllableState } from '../components/field'\nimport { Sheet, SheetContent, SheetDescription, SheetHeader, SheetTitle } from '../components/sheet'\nimport { Sidebar, SidebarProvider, SidebarTrigger, useSidebar } from '../components/sidebar'\nimport { cn } from '../lib/utils'\nimport { useScrollable } from '../hooks/use-scrollable'\n\n/*\n * Page layout: PageHeader (breadcrumb, title, status, meta, actions, tabs) and AppShell (sidebar + top bar + scrolling main + optional aside).\n * Neither imports a router: links are plain `href`, `onClick`, or your own link element.\n */\n\n/* ------------------------------------------------------------------------------------------------ PageHeader */\n\n/** One level of the breadcrumb trail. The last level is the current page and is never a link. */\nexport interface PageHeaderCrumb {\n  /** Text of the level. */\n  label: string\n  /** Link target for a plain anchor. */\n  href?: string\n  /** Click handler. With `href` it runs on the anchor; alone it turns the level into a button. */\n  onClick?: () => void\n  /** Your router's link element, e.g. `<Link to=\"/documents\" />`. The label becomes its children. Takes precedence over `href`. */\n  link?: React.ReactElement\n}\n\n/** A label and value shown in the meta row under the title (the same pairs as `KeyValue`, laid out in one line). */\nexport interface PageHeaderMeta {\n  /** Small caption above the value. */\n  label: string\n  /** The value: text, a person, a date, a badge. */\n  value: React.ReactNode\n}\n\nexport interface PageHeaderProps extends Omit<React.ComponentProps<'header'>, 'title'> {\n  /** Page title, rendered as the page's `h1` unless `titleLevel` says otherwise. */\n  title: React.ReactNode\n  /** Heading level of the title. Leave it at 1 for a page's own header; use 2 when several headers share one page (a gallery of previews, say). */\n  titleLevel?: 1 | 2 | 3 | 4\n  /** One or two lines under the title. */\n  description?: React.ReactNode\n  /** Badge or chip placed right after the title (a status, a version, a lock). */\n  status?: React.ReactNode\n  /** Trail above the title. The last item is the current page (`aria-current=\"page\"`). Trails of more than three levels collapse their middle into a menu when the header is narrower than 32rem (512 px). */\n  breadcrumb?: PageHeaderCrumb[]\n  /** Accessible name of the breadcrumb navigation. */\n  breadcrumbLabel?: string\n  /** Shows a back button before the title and calls this when it is pressed. */\n  onBack?: () => void\n  /** Shows a back button that is a plain link to this address. Use `onBack` for client-side routing. */\n  backHref?: string\n  /** Accessible name of the back button. */\n  backLabel?: string\n  /** Labelled values in one row under the description. */\n  meta?: PageHeaderMeta[]\n  /** Buttons and menus, right aligned. They wrap under the title when the header is narrower than 36rem (576 px). */\n  actions?: React.ReactNode\n  /** A `TabsList`, docked on the bottom edge with its hairline as the header's bottom line. Wrap the header and the panels in one `Tabs`. */\n  tabs?: React.ReactNode\n  /** Keeps the header at the top of the scrolling area. Once content has scrolled under it, it gets a solid background and a bottom border. */\n  sticky?: boolean\n  /** Distance in pixels from the top of the scrolling area at which a `sticky` header stops, for pages with another bar above. */\n  stickyOffset?: number\n}\n\nfunction nearestScroller(el: HTMLElement | null): HTMLElement | null {\n  for (let node = el?.parentElement; node; node = node.parentElement) {\n    const overflow = getComputedStyle(node).overflowY\n    if (overflow === 'auto' || overflow === 'scroll' || overflow === 'overlay') return node\n  }\n  return null\n}\n\n/** True once the sentinel, which sits where the header naturally starts, has scrolled above the line the header sticks at. */\nfunction useStuck(enabled: boolean, offset: number) {\n  const sentinel = React.useRef<HTMLDivElement>(null)\n  const [stuck, setStuck] = React.useState(false)\n  React.useEffect(() => {\n    const node = sentinel.current\n    if (!enabled || !node || typeof IntersectionObserver === 'undefined') {\n      setStuck(false)\n      return\n    }\n    const observer = new IntersectionObserver(\n      ([entry]) => setStuck(!entry.isIntersecting && !!entry.rootBounds && entry.boundingClientRect.bottom <= entry.rootBounds.top),\n      { root: nearestScroller(node), rootMargin: `-${offset}px 0px 0px 0px`, threshold: 0 },\n    )\n    observer.observe(node)\n    return () => observer.disconnect()\n  }, [enabled, offset])\n  return [sentinel, stuck] as const\n}\n\nfunction CrumbLink({ crumb }: { crumb: PageHeaderCrumb }) {\n  if (crumb.link) return <BreadcrumbLink asChild>{React.cloneElement(crumb.link, undefined, crumb.label)}</BreadcrumbLink>\n  if (crumb.href) return <BreadcrumbLink href={crumb.href} onClick={crumb.onClick}>{crumb.label}</BreadcrumbLink>\n  if (crumb.onClick) {\n    return (\n      <BreadcrumbLink asChild>\n        <button type=\"button\" onClick={crumb.onClick} className=\"cursor-pointer\">{crumb.label}</button>\n      </BreadcrumbLink>\n    )\n  }\n  return <span>{crumb.label}</span>\n}\n\nfunction CrumbMenuItem({ crumb }: { crumb: PageHeaderCrumb }) {\n  if (crumb.link) return <DropdownMenuItem asChild>{React.cloneElement(crumb.link, undefined, crumb.label)}</DropdownMenuItem>\n  if (crumb.href) {\n    return (\n      <DropdownMenuItem asChild>\n        <a href={crumb.href} onClick={crumb.onClick}>{crumb.label}</a>\n      </DropdownMenuItem>\n    )\n  }\n  return <DropdownMenuItem onSelect={crumb.onClick} disabled={!crumb.onClick}>{crumb.label}</DropdownMenuItem>\n}\n\nfunction Trail({ items, label }: { items: PageHeaderCrumb[]; label: string }) {\n  const last = items.length - 1\n  const collapse = items.length > 3\n  const isHidden = (i: number) => collapse && i >= 1 && i < last - 1\n  return (\n    <Breadcrumb size=\"sm\" aria-label={label} data-slot=\"page-header-breadcrumb\">\n      <BreadcrumbList>\n        {items.map((crumb, i) => (\n          <React.Fragment key={`${crumb.label}-${i}`}>\n            {collapse && i === 1 && (\n              <BreadcrumbItem separator className=\"@lg/page-header:hidden\">\n                <DropdownMenu>\n                  <DropdownMenuTrigger asChild>\n                    <BreadcrumbEllipsis />\n                  </DropdownMenuTrigger>\n                  <DropdownMenuContent align=\"start\">\n                    {items.slice(1, last - 1).map((hiddenCrumb, j) => (\n                      <CrumbMenuItem key={`${hiddenCrumb.label}-${j}`} crumb={hiddenCrumb} />\n                    ))}\n                  </DropdownMenuContent>\n                </DropdownMenu>\n              </BreadcrumbItem>\n            )}\n            <BreadcrumbItem separator={i > 0} className={isHidden(i) ? 'hidden @lg/page-header:inline-flex' : undefined}>\n              {i === last ? <BreadcrumbPage>{crumb.label}</BreadcrumbPage> : <CrumbLink crumb={crumb} />}\n            </BreadcrumbItem>\n          </React.Fragment>\n        ))}\n      </BreadcrumbList>\n    </Breadcrumb>\n  )\n}\n\n/**\n * The header at the top of a page: breadcrumb, back button, title with a status slot, description, a meta row, right-aligned actions and\n * a tabs slot docked on its bottom edge. Inside `AppShellMain` the sticky variant bleeds to the edges of the page padding.\n */\nexport function PageHeader({\n  title,\n  titleLevel = 1,\n  description,\n  status,\n  breadcrumb,\n  breadcrumbLabel = 'Breadcrumb',\n  onBack,\n  backHref,\n  backLabel = 'Back',\n  meta,\n  actions,\n  tabs,\n  sticky = false,\n  stickyOffset = 0,\n  className,\n  style,\n  ...props\n}: PageHeaderProps) {\n  const [sentinel, stuck] = useStuck(sticky, stickyOffset)\n  const hasBack = !!(onBack || backHref)\n  const Title = `h${titleLevel}` as 'h1'\n  return (\n    <>\n      {sticky && <div ref={sentinel} aria-hidden=\"true\" data-slot=\"page-header-sentinel\" className=\"pointer-events-none -mb-px h-px\" />}\n      <header\n        data-slot=\"page-header\"\n        data-sticky={sticky || undefined}\n        data-stuck={stuck || undefined}\n        style={sticky ? { top: stickyOffset, ...style } : style}\n        className={cn(\n          '@container/page-header flex flex-col gap-3 pb-4 compact:gap-2.5 compact:pb-3',\n          sticky &&\n            'sticky z-10 -mx-(--page-gutter) border-b border-transparent px-(--page-gutter) pt-3 pb-3 transition-[background-color,border-color] duration-(--dur-base) motion-reduce:transition-none compact:pt-2 compact:pb-2',\n          sticky && stuck && 'bg-background',\n          sticky && stuck && (tabs ? 'border-(--tab-track)' : 'border-border'),\n          tabs && 'pb-0 compact:pb-0',\n          className,\n        )}\n        {...props}\n      >\n        {breadcrumb && breadcrumb.length > 0 && <Trail items={breadcrumb} label={breadcrumbLabel} />}\n        <div className=\"flex flex-col gap-3 @xl/page-header:flex-row @xl/page-header:flex-wrap @xl/page-header:items-start @xl/page-header:justify-between @xl/page-header:gap-x-4\">\n          <div className=\"min-w-0 flex-1 @xl/page-header:basis-64\">\n            <div className=\"grid grid-cols-[auto_minmax(0,1fr)] gap-y-1\">\n              {hasBack && (\n                <div className=\"col-start-1 row-start-1 mr-2 self-start\">\n                  {backHref ? (\n                    <Button asChild variant=\"ghost\" size=\"icon-sm\">\n                      <a href={backHref} aria-label={backLabel}>\n                        <ArrowLeft />\n                      </a>\n                    </Button>\n                  ) : (\n                    <Button variant=\"ghost\" size=\"icon-sm\" onClick={onBack} aria-label={backLabel}>\n                      <ArrowLeft />\n                    </Button>\n                  )}\n                </div>\n              )}\n              <div className=\"col-start-2 row-start-1 flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1\">\n                <Title data-slot=\"page-header-title\" className=\"min-w-0 text-2xl font-bold tracking-tight break-words text-foreground compact:text-xl\">\n                  {title}\n                </Title>\n                {status && <div data-slot=\"page-header-status\" className=\"flex shrink-0 items-center gap-1.5\">{status}</div>}\n              </div>\n              {description && <p data-slot=\"page-header-description\" className=\"col-start-2 max-w-prose text-sm text-text-subtle\">{description}</p>}\n              {meta && meta.length > 0 && (\n                <dl data-slot=\"page-header-meta\" className=\"col-start-2 mt-1 flex flex-wrap gap-x-6 gap-y-2\">\n                  {meta.map((item, i) => (\n                    <div key={`${item.label}-${i}`} className=\"min-w-0\">\n                      <dt className=\"text-xs text-text-muted\">{item.label}</dt>\n                      <dd className=\"text-sm font-medium break-words text-foreground\">{item.value}</dd>\n                    </div>\n                  ))}\n                </dl>\n              )}\n            </div>\n          </div>\n          {actions && <div data-slot=\"page-header-actions\" className=\"flex flex-wrap items-center gap-2 @xl/page-header:shrink-0 @xl/page-header:justify-end\">{actions}</div>}\n        </div>\n        {tabs && (\n          <div\n            data-slot=\"page-header-tabs\"\n            className=\"-mb-px min-w-0\"\n            onFocus={(event) => event.target.scrollIntoView({ block: 'nearest', inline: 'nearest' })}\n          >\n            {tabs}\n          </div>\n        )}\n      </header>\n    </>\n  )\n}\n\n/* -------------------------------------------------------------------------------------------------- AppShell */\n\ninterface AppShellContextValue {\n  mainId: string\n  mainRef: React.RefObject<HTMLElement | null>\n  /** The viewport is wide enough (1024 px) to show the aside next to the main area instead of in a sheet. */\n  asideInline: boolean\n  asideOpen: boolean\n  setAsideOpen: (open: boolean) => void\n  asideSheetOpen: boolean\n  setAsideSheetOpen: (open: boolean) => void\n  toggleAside: () => void\n  /** The element that opened the aside sheet, so focus can go back to it when the sheet closes. */\n  openerRef: React.MutableRefObject<HTMLElement | null>\n  /** The aside trigger button, which gets focus back when the inline aside is closed from inside. */\n  asideTriggerRef: React.MutableRefObject<HTMLElement | null>\n}\n\nconst AppShellContext = React.createContext<AppShellContextValue | null>(null)\n\n/** State of the shell's aside panel: whether it is inline or in a sheet, whether it is open, and how to toggle it. Must be used inside `AppShell`. */\nexport function useAppShell() {\n  const ctx = React.useContext(AppShellContext)\n  if (!ctx) throw new Error('useAppShell must be used within an AppShell.')\n  return ctx\n}\n\nfunction useMediaQuery(query: string) {\n  return React.useSyncExternalStore(\n    (notify) => {\n      const list = window.matchMedia(query)\n      list.addEventListener('change', notify)\n      return () => list.removeEventListener('change', notify)\n    },\n    () => window.matchMedia(query).matches,\n    () => false,\n  )\n}\n\nfunction mergeRefs<T>(...refs: (React.Ref<T> | undefined)[]) {\n  return (node: T | null) => {\n    for (const ref of refs) {\n      if (typeof ref === 'function') ref(node)\n      else if (ref) (ref as React.RefObject<T | null>).current = node\n    }\n  }\n}\n\nexport interface AppShellProps extends Omit<React.ComponentProps<typeof SidebarProvider>, 'open' | 'defaultOpen' | 'onOpenChange'> {\n  /** Whether the sidebar is expanded (controlled). On a phone the sidebar is a sheet and this has no effect. */\n  sidebarOpen?: boolean\n  /** Whether the sidebar starts expanded. */\n  defaultSidebarOpen?: boolean\n  /** Called when the sidebar expands or collapses. */\n  onSidebarOpenChange?: (open: boolean) => void\n  /** Whether the inline aside is shown (controlled). The sheet used on narrow screens keeps its own state. */\n  asideOpen?: boolean\n  /** Whether the inline aside starts open. */\n  defaultAsideOpen?: boolean\n  /** Called when the inline aside opens or closes. */\n  onAsideOpenChange?: (open: boolean) => void\n  /** `id` of the main region, the target of the skip link. */\n  mainId?: string\n  /** Text of the skip link, the first focusable element in the shell. */\n  skipLabel?: string\n}\n\n/**\n * The application frame: a sidebar, a sticky top bar and a main area that is the only thing that scrolls. It fills its container\n * (`h-svh` by default; give it `h-full` inside a frame) and contains its own fixed-position sidebar, so it can be previewed in a box.\n * Below 768 px the sidebar becomes a sheet; below 1024 px the aside does.\n */\nexport function AppShell({\n  sidebarOpen,\n  defaultSidebarOpen = true,\n  onSidebarOpenChange,\n  asideOpen: asideOpenProp,\n  defaultAsideOpen = true,\n  onAsideOpenChange,\n  mainId = 'main-content',\n  skipLabel = 'Skip to main content',\n  className,\n  children,\n  ...props\n}: AppShellProps) {\n  const mainRef = React.useRef<HTMLElement | null>(null)\n  /* SidebarProvider ignores its own state once `onOpenChange` is given, so the shell always hands it a controlled value. */\n  const [sidebarExpanded, setSidebarExpanded] = useControllableState(sidebarOpen, defaultSidebarOpen, onSidebarOpenChange)\n  const asideInline = useMediaQuery('(min-width: 1024px)')\n  const [asideOpen, setAsideOpen] = useControllableState(asideOpenProp, defaultAsideOpen, onAsideOpenChange)\n  const openerRef = React.useRef<HTMLElement | null>(null)\n  const asideTriggerRef = React.useRef<HTMLElement | null>(null)\n  const [asideSheetOpen, setAsideSheetOpen] = React.useState(false)\n  React.useEffect(() => {\n    if (asideInline) setAsideSheetOpen(false)\n  }, [asideInline])\n  const toggleAside = React.useCallback(() => {\n    if (asideInline) {\n      setAsideOpen(!asideOpen)\n      return\n    }\n    const active = document.activeElement\n    if (!asideSheetOpen && active instanceof HTMLElement && active !== document.body) openerRef.current = active\n    setAsideSheetOpen(!asideSheetOpen)\n  }, [asideInline, asideOpen, asideSheetOpen, setAsideOpen])\n  const value = React.useMemo<AppShellContextValue>(\n    () => ({ mainId, mainRef, asideInline, asideOpen, setAsideOpen, asideSheetOpen, setAsideSheetOpen, toggleAside, openerRef, asideTriggerRef }),\n    [mainId, asideInline, asideOpen, setAsideOpen, asideSheetOpen, toggleAside],\n  )\n\n  return (\n    <AppShellContext.Provider value={value}>\n      <SidebarProvider\n        open={sidebarExpanded}\n        onOpenChange={setSidebarExpanded}\n        data-app-shell=\"\"\n        className={cn(\n          'relative isolate grid h-svh min-h-0 grid-cols-[auto_minmax(0,1fr)_auto] grid-rows-[auto_minmax(0,1fr)] overflow-hidden bg-background [contain:layout]',\n          '[&>[data-slot=sidebar]]:col-start-1 [&>[data-slot=sidebar]]:row-span-2 [&>[data-slot=sidebar]]:row-start-1',\n          className,\n        )}\n        {...props}\n      >\n        <a\n          href={`#${mainId}`}\n          data-slot=\"app-shell-skip-link\"\n          onClick={(event) => {\n            const main = mainRef.current\n            if (!main) return\n            event.preventDefault()\n            main.focus()\n          }}\n          className=\"absolute top-2 left-2 z-(--z-overlay) -translate-y-16 rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground shadow-md transition-transform focus-visible:translate-y-0 motion-reduce:transition-none ds-focus\"\n        >\n          {skipLabel}\n        </a>\n        {children}\n      </SidebarProvider>\n    </AppShellContext.Provider>\n  )\n}\n\nexport interface AppShellSidebarProps extends Omit<React.ComponentProps<typeof Sidebar>, 'children'> {\n  /** Accessible name of the navigation landmark that wraps the sidebar content. */\n  label?: string\n  /** `SidebarHeader`, `SidebarContent` and `SidebarFooter`. */\n  children?: React.ReactNode\n}\n\n/**\n * The shell's navigation: the Sidebar family inside a `nav` landmark. It collapses to the icon rail by default\n * (`collapsible=\"icon\"`) and becomes a sheet below 768 px.\n */\nexport function AppShellSidebar({ label = 'Primary', collapsible = 'icon', className, children, ...props }: AppShellSidebarProps) {\n  const { isMobile, state } = useSidebar()\n  /* An offcanvas sidebar that is slid out of view must not stay in the tab order. */\n  const hidden = !isMobile && collapsible === 'offcanvas' && state === 'collapsed'\n  return (\n    <Sidebar collapsible={collapsible} className={cn('h-full', className)} {...props}>\n      <nav aria-label={label} data-slot=\"app-shell-nav\" inert={hidden || undefined} className=\"flex min-h-0 flex-1 flex-col\">\n        {children}\n      </nav>\n    </Sidebar>\n  )\n}\n\nexport interface AppShellHeaderProps extends Omit<React.ComponentProps<'header'>, 'children'> {\n  /** The left slot after the sidebar button: a breadcrumb, a search box, the page name. It takes the free width and truncates. */\n  children?: React.ReactNode\n  /** The right slot: notifications, help, the user menu. */\n  actions?: React.ReactNode\n  /** Shows the sidebar toggle button at the start of the bar. Turn it off for a shell whose sidebar never collapses. */\n  showSidebarTrigger?: boolean\n}\n\nfunction ShellSidebarTrigger() {\n  const { isMobile, open, openMobile } = useSidebar()\n  return <SidebarTrigger className=\"-ml-1 shrink-0\" aria-expanded={isMobile ? openMobile : open} />\n}\n\n/** The top bar: sidebar toggle, a slot for search or a breadcrumb on the left and a slot for notifications and the user menu on the right. It stays in place while the main area scrolls. */\nexport function AppShellHeader({ children, actions, showSidebarTrigger = true, className, ...props }: AppShellHeaderProps) {\n  return (\n    <header\n      data-slot=\"app-shell-header\"\n      className={cn('sticky top-0 z-20 col-span-2 col-start-2 row-start-1 flex h-(--shell-bar-h) min-w-0 items-center gap-2 border-b border-border bg-background px-3 sm:px-4', className)}\n      {...props}\n    >\n      {showSidebarTrigger && <ShellSidebarTrigger />}\n      <div className=\"flex min-w-0 flex-1 items-center gap-2\">{children}</div>\n      {actions && <div data-slot=\"app-shell-header-actions\" className=\"flex shrink-0 items-center gap-1.5\">{actions}</div>}\n    </header>\n  )\n}\n\nconst mainMaxWidth = {\n  none: '',\n  sm: 'max-w-3xl',\n  md: 'max-w-5xl',\n  lg: 'max-w-6xl',\n  xl: 'max-w-7xl',\n} as const\n\nexport interface AppShellMainProps extends React.ComponentProps<'main'> {\n  /** Caps the content width and centres it: `sm` 768 px, `md` 1024, `lg` 1152, `xl` 1280. `none` fills the area. */\n  maxWidth?: keyof typeof mainMaxWidth\n  /** Adds the page padding (16 px on phones, 24 px from `sm`, tighter in compact density). Turn it off for full-bleed content such as a table or a viewer. */\n  padded?: boolean\n  /** Classes for the content wrapper inside the scrolling `main`; `className` goes on the `main` itself. */\n  contentClassName?: string\n}\n\n/** The `<main id=\"main-content\">` landmark and the only scroll region of the shell. It can be focused by the skip link. */\nexport function AppShellMain({ maxWidth = 'none', padded = true, id, ref, className, contentClassName, children, ...props }: AppShellMainProps) {\n  const shell = React.useContext(AppShellContext)\n  // the main region is the shell's one scroll pane: a tab stop while it scrolls (so the keyboard can scroll it), still the skip link's target (-1) while it does not\n  const [scrollRef, scrollable] = useScrollable<HTMLElement>()\n  return (\n    <main\n      ref={mergeRefs(ref, shell?.mainRef, scrollRef)}\n      id={id ?? shell?.mainId ?? 'main-content'}\n      tabIndex={scrollable ? 0 : -1}\n      data-slot=\"app-shell-main\"\n      className={cn(\n        'col-start-2 row-start-2 min-h-0 min-w-0 overflow-y-auto overscroll-contain bg-background ds-focus-inset',\n        padded &&\n          '[--page-gutter:calc(var(--spacing)*4)] sm:[--page-gutter:calc(var(--spacing)*6)] compact:[--page-gutter:calc(var(--spacing)*3)] compact:sm:[--page-gutter:calc(var(--spacing)*5)]',\n        className,\n      )}\n      {...props}\n    >\n      <div className={cn('mx-auto w-full', padded && 'px-(--page-gutter) py-4 sm:py-6 compact:py-3 compact:sm:py-4', mainMaxWidth[maxWidth], contentClassName)}>\n        {children}\n      </div>\n    </main>\n  )\n}\n\nconst asideWidth = { sm: 'w-72', md: 'w-80', lg: 'w-96' } as const\n\nexport interface AppShellAsideProps extends Omit<React.ComponentProps<'aside'>, 'title'> {\n  /** Heading of the panel; also its accessible name and the title of the sheet on narrow screens. */\n  title: string\n  /** Width of the inline panel: `sm` 288 px, `md` 320, `lg` 384. */\n  width?: keyof typeof asideWidth\n  /** Adds padding around the content. Turn it off for a list that should reach the panel's edges. */\n  padded?: boolean\n  /** Accessible name of the close button. */\n  closeLabel?: string\n}\n\n/**\n * An optional right-hand panel under the top bar, with its own scroll. From 1024 px it sits beside the main area and closes with its X;\n * below that it is a sheet. Open it from anywhere with `AppShellAsideTrigger` or `useAppShell().toggleAside`.\n */\nexport function AppShellAside({ title, width = 'md', padded = true, closeLabel, className, children, ...props }: AppShellAsideProps) {\n  const { asideInline, asideOpen, setAsideOpen, asideSheetOpen, setAsideSheetOpen, openerRef, asideTriggerRef, mainRef } = useAppShell()\n  const close = closeLabel ?? `Close ${title.toLowerCase()}`\n  const closeInline = () => {\n    setAsideOpen(false)\n    const target = asideTriggerRef.current?.isConnected ? asideTriggerRef.current : mainRef.current\n    target?.focus()\n  }\n\n  if (!asideInline) {\n    return (\n      <Sheet open={asideSheetOpen} onOpenChange={setAsideSheetOpen}>\n        <SheetContent\n          side=\"right\"\n          data-slot=\"app-shell-aside\"\n          onCloseAutoFocus={(event) => {\n            event.preventDefault()\n            const opener = openerRef.current\n            openerRef.current = null\n            if (opener?.isConnected) opener.focus()\n          }}\n          className={cn('w-[min(22rem,90vw)] gap-0 p-0 sm:max-w-none', className)}\n        >\n          <SheetHeader className=\"border-b\">\n            <SheetTitle>{title}</SheetTitle>\n            <SheetDescription className=\"sr-only\">{title} for the current page.</SheetDescription>\n          </SheetHeader>\n          <div className={cn('min-h-0 flex-1 overflow-y-auto', padded && 'p-4')}>{children}</div>\n        </SheetContent>\n      </Sheet>\n    )\n  }\n\n  if (!asideOpen) return null\n  return (\n    <aside\n      aria-label={title}\n      data-slot=\"app-shell-aside\"\n      className={cn('col-start-3 row-start-2 flex min-h-0 shrink-0 flex-col border-l border-border bg-background', asideWidth[width], className)}\n      {...props}\n    >\n      <div className=\"flex h-12 shrink-0 items-center justify-between gap-2 border-b border-border pr-2 pl-4\">\n        <h2 className=\"truncate text-sm font-semibold text-foreground\">{title}</h2>\n        <Button variant=\"ghost\" size=\"icon-sm\" onClick={closeInline} aria-label={close}>\n          <X />\n        </Button>\n      </div>\n      <div className={cn('min-h-0 flex-1 overflow-y-auto', padded && 'p-4')}>{children}</div>\n    </aside>\n  )\n}\n\nexport interface AppShellAsideTriggerProps extends Omit<React.ComponentProps<typeof Button>, 'children'> {\n  /** Accessible name of the button. */\n  label?: string\n}\n\n/** Icon button for the top bar that opens and closes the aside, inline or as a sheet depending on the screen. */\nexport function AppShellAsideTrigger({ label = 'Toggle details panel', onClick, ref, ...props }: AppShellAsideTriggerProps) {\n  const { asideInline, asideOpen, asideSheetOpen, toggleAside, openerRef, asideTriggerRef } = useAppShell()\n  return (\n    <Button\n      ref={mergeRefs(ref, asideTriggerRef)}\n      data-slot=\"app-shell-aside-trigger\"\n      variant=\"ghost\"\n      size=\"icon\"\n      className=\"size-8 shrink-0\"\n      aria-label={label}\n      aria-expanded={asideInline ? asideOpen : asideSheetOpen}\n      onClick={(event) => {\n        onClick?.(event)\n        openerRef.current = event.currentTarget\n        toggleAside()\n      }}\n      {...props}\n    >\n      <PanelRight />\n    </Button>\n  )\n}\n","import { useState, type KeyboardEvent, type ReactNode } from 'react'\nimport { Slot } from 'radix-ui'\nimport { ChevronDown, EllipsisVertical, ExternalLink, Star } from 'lucide-react'\nimport { PeopleList, PersonCard, type AvatarPerson } from '../components/avatar'\nimport { Button } from '../components/button'\nimport { Checkbox } from '../components/checkbox'\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '../components/dropdown-menu'\nimport { hitArea } from '../components/field'\nimport { LazyPopover, type LazyPopoverTrigger } from '../components/popover'\nimport { Switch } from '../components/switch'\nimport { fmtDate, initials, inr, num } from '../lib/format'\nimport { cn } from '../lib/utils'\n\n/*\n * Cell content for DataTable columns (Figma: Table Cell, the 19 content types of 3028:1565).\n * Each component is only the content; the column's `cell` returns it and DataTable supplies the 48px cell around it.\n *   Text, File Name, Person, Date, Link, Currency, Number, Empty, Select, Chips, Action Buttons, File Meta/Badge, Overflow,\n *   Progress, Toggle, Rating, Expandable, Avatar Stack.\n * Truncation is built in (one line, ellipsis); put the full text in `title` or a tooltip where it matters.\n */\n\ntype Tone = 'neutral' | 'primary' | 'positive' | 'negative' | 'notice' | 'information'\n/** `CellBadge` takes its own names and the shared ones (see `StatusTone`): success, danger, warning, info. */\ntype CellBadgeTone = Tone | 'success' | 'danger' | 'warning' | 'info'\nconst CELL_TONE: Record<CellBadgeTone, Tone> = { neutral: 'neutral', primary: 'primary', positive: 'positive', negative: 'negative', notice: 'notice', information: 'information', success: 'positive', danger: 'negative', warning: 'notice', info: 'information' }\n\n/** Weight of the main text of a cell: `medium` (500) is the Figma spec; `normal` (400) is the quieter look that lets a header or a bold column stand out. */\nexport type CellWeight = 'medium' | 'normal'\nconst weightClass = (w: CellWeight | undefined) => (w === 'normal' ? 'font-normal' : 'font-medium')\n\n/** Text. `subtext` is the second 12px line, `icon` a 16px leading glyph, `weight` the weight of the main line. */\nexport function CellText({ children, subtext, icon, weight, className }: { children: ReactNode; subtext?: ReactNode; icon?: ReactNode; weight?: CellWeight; className?: string }) {\n  return (\n    <div data-slot=\"cell-text\" className={cn('flex min-w-0 items-center gap-2', className)}>\n      {icon && <span className=\"shrink-0 text-text-muted [&_svg]:size-4\">{icon}</span>}\n      <div className=\"min-w-0\">\n        <div className={cn('truncate text-sm text-foreground', weightClass(weight))}>{children}</div>\n        {subtext && <div className=\"truncate text-xs font-normal text-text-muted\">{subtext}</div>}\n      </div>\n    </div>\n  )\n}\n\n/** File or folder name with its glyph in front. */\nexport function CellFileName({ name, icon, className }: { name: ReactNode; icon: ReactNode; className?: string }) {\n  return <CellText icon={<span className=\"text-icon-normal\">{icon}</span>} className={className}>{name}</CellText>\n}\n\n/** The initials avatar used by person cells and the stack (peach circle, black initials). */\nexport function InitialsAvatar({ name, label, size = 20, tone = 'peach', className }: { name: string; /** text to show instead of the initials, e.g. +2 */ label?: string; size?: 20 | 24 | 28; /** `neutral` is a grey disc: use it for a count such as +2, so it does not read as one more person */ tone?: 'peach' | 'neutral'; className?: string }) {\n  return (\n    <span\n      data-slot=\"initials-avatar\"\n      title={name}\n      className={cn(tone === 'neutral' ? 'bg-(--ds-av-neutral-bg) text-(--ds-av-neutral-fg)' : 'ds-initials-peach', 'inline-grid shrink-0 place-items-center rounded-full font-medium select-none', size === 20 && 'size-5 text-xxs', size === 24 && 'size-6 text-xxs', size === 28 && 'size-7 text-xs', className)}\n    >\n      {label ?? initials(name)}\n    </span>\n  )\n}\n\nexport interface CellPersonProps {\n  name: string\n  subtext?: ReactNode\n  /** makes the avatar and name a button. The click does not reach the row. */\n  onClick?: () => void\n  /** opens a PersonCard on press (`true`), or on hover with `{ trigger: 'hover' }`. The card mounts on first open. */\n  card?: boolean | (Omit<AvatarPerson, 'name' | 'subtext'> & { trigger?: LazyPopoverTrigger; actions?: ReactNode })\n  weight?: CellWeight\n  className?: string\n}\n\nexport function CellPerson({ name, subtext, onClick, card, weight, className }: CellPersonProps) {\n  const body = (\n    <>\n      <InitialsAvatar name={name} size={24} />\n      <div className=\"min-w-0\">\n        <div className={cn('truncate text-sm text-foreground', weightClass(weight), (onClick || card) && 'group-hover/person:underline')}>{name}</div>\n        {subtext && <div className=\"truncate text-xs font-normal text-text-muted\">{subtext}</div>}\n      </div>\n    </>\n  )\n  if (!onClick && !card) {\n    return (\n      <div data-slot=\"cell-person\" className={cn('flex min-w-0 items-center gap-2', className)}>\n        {body}\n      </div>\n    )\n  }\n  const button = (\n    <button\n      type=\"button\"\n      data-slot=\"cell-person\"\n      onClick={(e) => {\n        e.stopPropagation()\n        onClick?.()\n      }}\n      className={cn(\n        'group/person flex max-w-full min-w-0 items-center gap-2 rounded-xs text-left ds-focus',\n        className,\n      )}\n    >\n      {body}\n    </button>\n  )\n  if (!card) return button\n  const { trigger, actions, ...person } = card === true ? {} : card\n  return (\n    <LazyPopover trigger={trigger} aria-label={name} content={<PersonCard name={name} subtext={subtext} tone=\"orange\" actions={actions} {...person} />}>\n      {button}\n    </LazyPopover>\n  )\n}\n\n/** ISO date (2026-10-24) shown the Indian way, 24-Oct-2026. */\nexport function CellDate({ value, weight, className }: { value?: string | null; weight?: CellWeight; className?: string }) {\n  return <span data-slot=\"cell-date\" className={cn('text-sm whitespace-nowrap text-foreground tnum', weightClass(weight), className)}>{fmtDate(value)}</span>\n}\n\ntype CellLinkProps = { children: ReactNode; className?: string } & (\n  | { asChild: true; onClick?: never; href?: never }\n  | { onClick: () => void; asChild?: never; href?: never }\n  | { href: string; asChild?: never; onClick?: never }\n)\n\n/** Primary-coloured link: an external `href`, a click handler, or `asChild` to style your router's link (`<CellLink asChild><Link to=\"/x\">Open</Link></CellLink>`). */\nexport function CellLink({ children, className, asChild, href, onClick }: CellLinkProps) {\n  const cls = cn('block max-w-full truncate rounded-xs text-left text-sm font-medium text-primary-text hover:underline ds-focus', className)\n  if (asChild) return <Slot.Root className={cls}>{children}</Slot.Root>\n  if (href) {\n    return (\n      <a href={href} className={cn(cls, 'inline-flex items-center gap-1')} target=\"_blank\" rel=\"noreferrer\">\n        <span className=\"truncate\">{children}</span>\n        <ExternalLink aria-hidden className=\"size-3 shrink-0 opacity-70\" />\n        <span className=\"sr-only\">(opens in a new tab)</span>\n      </a>\n    )\n  }\n  return <button type=\"button\" onClick={(e) => { e.stopPropagation(); onClick?.() }} className={cls}>{children}</button>\n}\n\n/** Rupees in lakh/crore grouping: 12,34,567. Left aligned by default as in Figma; pass align to follow a right-aligned column. A missing value (null or undefined) shows the dash of `CellEmpty`, not ₹0. */\nexport function CellCurrency({ value, decimals, weight, className }: { value: number | null | undefined; decimals?: boolean; weight?: CellWeight; className?: string }) {\n  if (value === null || value === undefined) return <CellEmpty className={className} />\n  const v = Number(value)\n  const text = decimals ? '₹' + Math.abs(v).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : inr(v)\n  return <span data-slot=\"cell-currency\" className={cn('text-sm whitespace-nowrap text-foreground tnum', weightClass(weight), v < 0 && 'text-negative', className)}>{v < 0 && decimals ? '-' + text : text}</span>\n}\n\n/** Plain number with Indian grouping; right aligned (set the column to align=\"right\"). A missing value shows the dash of `CellEmpty`. */\nexport function CellNumber({ value, weight, className }: { value: number | null | undefined; weight?: CellWeight; className?: string }) {\n  if (value === null || value === undefined) return <CellEmpty className={className} />\n  return <span data-slot=\"cell-number\" className={cn('text-sm text-foreground tnum', weightClass(weight), className)}>{num(value)}</span>\n}\n\n/** The fixed dash for a value that does not exist (a screen reader says \"No value\"). */\nexport function CellEmpty({ className }: { className?: string }) {\n  return (\n    <span data-slot=\"cell-empty\" className={cn('text-sm font-medium text-text-muted', className)}>\n      <span aria-hidden>—</span>\n      <span className=\"sr-only\">No value</span>\n    </span>\n  )\n}\n\n/** Row selection checkbox (48px cell). DataTable draws its own selection column; use this for custom tables. */\nexport function CellSelect({ checked, onCheckedChange, label = 'Select row' }: { checked: boolean | 'indeterminate'; onCheckedChange: (v: boolean) => void; label?: string }) {\n  return <Checkbox checked={checked} onCheckedChange={(v) => onCheckedChange(v === true)} onClick={(e) => e.stopPropagation()} aria-label={label} />\n}\n\n/** Rounded 10px chips; `max` of them are shown and the rest collapse into +N (Figma: Chips, multi + overflow). */\nexport function CellChips({ chips, max = 2, className }: { chips: (string | { label: string; tone?: 'primary' | 'neutral' })[]; max?: number; className?: string }) {\n  const list = chips.map((c) => (typeof c === 'string' ? { label: c, tone: 'neutral' as const } : { tone: 'neutral' as const, ...c }))\n  const shown = list.slice(0, max)\n  const rest = list.length - shown.length\n  const chip = 'inline-flex h-[18px] items-center rounded-full border px-2 text-xxs font-medium whitespace-nowrap'\n  return (\n    <div data-slot=\"cell-chips\" className={cn('flex items-center gap-1', className)}>\n      {shown.map((c, i) => (\n        <span key={i} className={cn(chip, c.tone === 'primary' ? 'border-primary-highlighted text-primary-text' : 'border-border-default text-foreground')}>{c.label}</span>\n      ))}\n      {rest > 0 && <span className={cn(chip, 'border-border-default text-foreground')} title={list.slice(max).map((c) => c.label).join(', ')}>+{rest}</span>}\n    </div>\n  )\n}\n\n/** A status badge (Figma: File Meta/Badge): 4px radius, 11px Medium, tone fill with a tone border. */\nexport function CellBadge({ tone = 'neutral', icon, children, className }: { tone?: CellBadgeTone; icon?: ReactNode; children: ReactNode; className?: string }) {\n  return (\n    <span\n      data-slot=\"cell-badge\"\n      data-ds-tone={CELL_TONE[tone]}\n      className={cn('inline-flex h-[18px] items-center gap-1 rounded-sm border border-(--ds-tone-subtle) bg-(--ds-tone-faded) px-1.5 text-xxs font-medium whitespace-nowrap text-(--ds-tone) [&_svg]:size-3', className)}\n    >\n      {icon}\n      {children}\n    </span>\n  )\n}\n\n/** Inline row actions (Figma: Action Buttons): small buttons, the primary one filled. */\nexport function CellActions({ actions, className }: { actions: { label: string; onClick: () => void; primary?: boolean; /** a destructive action (Reject, Delete): a red outline button, or a solid red one when it is also `primary` */ destructive?: boolean; disabled?: boolean; icon?: ReactNode }[]; className?: string }) {\n  return (\n    <div data-slot=\"cell-actions\" className={cn('flex items-center gap-2', className)} onClick={(e) => e.stopPropagation()}>\n      {actions.map((a) => (\n        <Button key={a.label} size=\"xs\" variant={a.primary ? 'default' : 'outline'} color={a.destructive ? 'negative' : undefined} disabled={a.disabled} onClick={a.onClick}>\n          {a.icon}\n          {a.label}\n        </Button>\n      ))}\n    </div>\n  )\n}\n\n/** The kebab menu at the end of a row (Figma: Overflow). */\nexport function CellOverflow({ items, label = 'Row actions', className }: { items: { label: string; onSelect: () => void; icon?: ReactNode; destructive?: boolean; disabled?: boolean }[]; label?: string; className?: string }) {\n  return (\n    <div className={cn('flex justify-end', className)} onClick={(e) => e.stopPropagation()}>\n      <DropdownMenu>\n        <DropdownMenuTrigger asChild>\n          <button\n            type=\"button\"\n            aria-label={label}\n            data-slot=\"cell-overflow\"\n            className={cn('grid size-6 place-items-center rounded-sm text-icon-normal hover:bg-state-hover data-[state=open]:bg-state-pressed ds-focus-inset', hitArea)}\n          >\n            <EllipsisVertical className=\"size-4\" />\n          </button>\n        </DropdownMenuTrigger>\n        <DropdownMenuContent align=\"end\">\n          {items.map((it) => (\n            <DropdownMenuItem key={it.label} variant={it.destructive ? 'destructive' : 'default'} disabled={it.disabled} onSelect={it.onSelect}>\n              {it.icon}\n              {it.label}\n            </DropdownMenuItem>\n          ))}\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </div>\n  )\n}\n\n/** A label, a 4px bar and the percentage (Figma: Progress). */\n/** The bar is named by `label` when that is text, else by `aria-label` (default \"Progress\"). */\nexport function CellProgress({ value, label, className, 'aria-label': ariaLabel }: { value: number; label?: ReactNode; className?: string; 'aria-label'?: string }) {\n  const v = Math.max(0, Math.min(100, value))\n  return (\n    <div data-slot=\"cell-progress\" className={cn('flex min-w-0 items-center gap-3', className)}>\n      {label && <span className=\"truncate text-sm font-medium text-text-subtle\">{label}</span>}\n      <div role=\"progressbar\" aria-label={ariaLabel ?? (typeof label === 'string' ? label : 'Progress')} aria-valuenow={v} aria-valuemin={0} aria-valuemax={100} className=\"h-1 min-w-12 flex-1 overflow-hidden rounded-full bg-surface-highlighted\">\n        <div className=\"h-full rounded-full bg-primary\" style={{ width: `${v}%` }} />\n      </div>\n      <span className=\"w-9 shrink-0 text-right text-sm font-medium text-foreground tnum\">{Math.round(v)}%</span>\n    </div>\n  )\n}\n\nexport function CellToggle({ checked, onCheckedChange, label = 'Toggle', disabled }: { checked: boolean; onCheckedChange?: (v: boolean) => void; label?: string; disabled?: boolean }) {\n  return (\n    <div onClick={(e) => e.stopPropagation()} className=\"flex\">\n      <Switch checked={checked}