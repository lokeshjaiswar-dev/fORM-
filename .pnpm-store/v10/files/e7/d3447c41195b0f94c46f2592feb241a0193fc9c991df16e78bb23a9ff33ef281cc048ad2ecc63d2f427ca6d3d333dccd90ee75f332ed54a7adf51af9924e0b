=\"w-[4.5rem]\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {pageSizeOptions.map((n) => (\n                      <SelectItem key={n} value={String(n)}>{n}</SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n              </div>\n            ) : (\n              <span className=\"hidden sm:block\" />\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","import { useRef, useState, type ReactNode } from 'react'\nimport { Button } from '../components/button'\nimport { Textarea } from '../components/textarea'\nimport { Field } from '../components/field'\nimport { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle } from '../components/alert-dialog'\nimport { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '../components/dialog'\n\n/**\n * Confirm / cancel dialog. A `destructive` confirmation is an `AlertDialog` (role `alertdialog`, focus starts on Cancel, a click outside does not dismiss it);\n * a plain one is a `Dialog`. `children` sit between the text and the buttons.\n */\nexport function ConfirmDialog({\n  open, onOpenChange, title, description, confirmLabel = 'Confirm', onConfirm, destructive, children,\n}: {\n  open: boolean; onOpenChange: (o: boolean) => void; title: string; description?: ReactNode; confirmLabel?: string; onConfirm: () => void; destructive?: boolean; children?: ReactNode\n}) {\n  if (destructive) {\n    return (\n      <AlertDialog open={open} onOpenChange={onOpenChange}>\n        <AlertDialogContent {...(description ? {} : { 'aria-describedby': undefined })}>\n          <AlertDialogHeader>\n            <AlertDialogTitle>{title}</AlertDialogTitle>\n            {description && <AlertDialogDescription>{description}</AlertDialogDescription>}\n          </AlertDialogHeader>\n          {children && <div className=\"min-h-0 overflow-y-auto p-4\">{children}</div>}\n          <AlertDialogFooter>\n            <AlertDialogCancel>Cancel</AlertDialogCancel>\n            <AlertDialogAction variant=\"destructive\" onClick={onConfirm}>{confirmLabel}</AlertDialogAction>\n          </AlertDialogFooter>\n        </AlertDialogContent>\n      </AlertDialog>\n    )\n  }\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent>\n        <DialogHeader>\n          <DialogTitle>{title}</DialogTitle>\n          {description && <DialogDescription>{description}</DialogDescription>}\n        </DialogHeader>\n        {children}\n        <DialogFooter>\n          <Button variant=\"ghost\" color=\"primary\" onClick={() => onOpenChange(false)}>Cancel</Button>\n          <Button onClick={() => { onConfirm(); onOpenChange(false) }}>{confirmLabel}</Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  )\n}\n\n/**\n * Dialog that requires a written reason (overrides, rejections, write-offs, deactivation). While typing, a neutral \"n of 8 characters\" hint shows; the error\n * appears once the field has been left or Confirm was pressed too early, and Confirm then moves focus to the field.\n */\nexport function ReasonDialog({\n  open, onOpenChange, title, description, confirmLabel = 'Confirm', reasonLabel = 'Reason', minLength = 8, onConfirm, destructive, optional,\n}: {\n  open: boolean; onOpenChange: (o: boolean) => void; title: string; description?: ReactNode; confirmLabel?: string; reasonLabel?: string; minLength?: number\n  onConfirm: (reason: string) => void; destructive?: boolean; optional?: boolean\n}) {\n  const [reason, setReason] = useState('')\n  const [touched, setTouched] = useState(false)\n  const field = useRef<HTMLTextAreaElement>(null)\n  const length = reason.trim().length\n  const ok = optional || length >= minLength\n  const reset = () => { setReason(''); setTouched(false) }\n  return (\n    <Dialog open={open} onOpenChange={(o) => { if (!o) reset(); onOpenChange(o) }}>\n      <DialogContent>\n        <DialogHeader>\n          <DialogTitle>{title}</DialogTitle>\n          {description && <DialogDescription>{description}</DialogDescription>}\n        </DialogHeader>\n        <Field\n          label={reasonLabel}\n          required={!optional}\n          optional={optional}\n          hint={optional ? undefined : `${Math.min(length, minLength)} of ${minLength} characters minimum`}\n          error={touched && !ok ? `Please give at least ${minLength} characters.` : undefined}\n        >\n          <Textarea ref={field} value={reason} onChange={(e) => setReason(e.target.value)} onBlur={() => setTouched(true)} placeholder=\"Write the reason for the record\" rows={3} />\n        </Field>\n        <DialogFooter>\n          <Button variant=\"ghost\" color=\"primary\" onClick={() => onOpenChange(false)}>Cancel</Button>\n          <Button\n            variant={destructive ? 'destructive' : 'default'}\n            onClick={() => {\n              if (!ok) { setTouched(true); field.current?.focus(); return }\n              onConfirm(reason.trim()); reset(); onOpenChange(false)\n            }}\n          >\n            {confirmLabel}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  )\n}\n","import { useId, type ComponentProps, type FocusEvent, type ReactNode } from 'react'\nimport { Input } from '../components/input'\nimport { Field as UiField, controlAria, resolveStatus, type FieldControlProps, type FieldSize } from '../components/field'\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../components/select'\nimport { Textarea } from '../components/textarea'\nimport { CheckboxField } from '../components/checkbox'\nimport { RadioGroup, RadioField } from '../components/radio-group'\nimport { Combobox } from '../components/combobox'\nimport { MultiSelect } from '../components/multi