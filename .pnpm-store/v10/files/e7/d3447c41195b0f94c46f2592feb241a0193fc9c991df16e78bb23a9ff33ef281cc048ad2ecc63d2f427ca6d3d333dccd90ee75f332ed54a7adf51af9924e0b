ieldProps) {\n  const form = useFormContext()\n  const labelText = typeof rest.label === 'string' ? rest.label : undefined\n  const uid = React.useId()\n  const controlId = id ?? uid\n  const registerField = form?.registerField\n  const blurField = form?.blurField\n\n  React.useEffect(() => {\n    if (!name || !registerField) return\n    return registerField(name, controlId, labelText)\n  }, [name, controlId, labelText, registerField])\n\n  const message = error !== undefined && error !== null ? error : name ? form?.errors[name] : undefined\n  const shown = hasMessage(message) ? message : undefined\n  const { warning, success } = rest\n\n  // `contents` keeps the wrapper out of the layout: the label, control and message sit exactly as in the labelled fields\n  return (\n    <UiField {...rest} error={shown} htmlFor={controlId} announceError={!form?.summaryActive}>\n      {(control) => (\n        <div\n          className=\"contents\"\n          onBlur={\n            name && blurField\n              ? (e) => {\n                  // focus moving inside the field (into a picker's popover, say) is not leaving it\n                  const next = e.relatedTarget as Element | null\n                  if (next && (e.currentTarget.contains(next) || next.closest('[data-radix-popper-content-wrapper]'))) return\n                  blurField(name)\n                }\n              : undefined\n          }\n        >\n          {typeof children === 'function' ? children({ ...control, name, message: shown ?? warning ?? success }) : withFieldControl(children, control)}\n        </div>\n      )}\n    </UiField>\n  )\n}\n\n/* ----------------------------------------------------- FormErrorSummary */\n\nexport interface FormErrorSummaryProps extends Omit<React.ComponentProps<typeof Alert>, 'variant' | 'title' | 'children'> {\n  /** Heading. A function gets the number of errors; the default reads \"3 problems need your attention\". */\n  title?: React.ReactNode | ((count: number) => React.ReactNode)\n  /** Move focus to the summary after a submit that left errors (default true). */\n  focusOnError?: boolean\n}\n\nconst defaultTitle = (n: number) => (n === 1 ? '1 problem needs your attention' : `${n} problems need your attention`)\n\n/**\n * The list of a form's errors. It is driven by the submit: hidden until a submit has finished, so errors that only come from blur validation never open it.\n * From then on it shows the live list: a later error joins it, a fixed field leaves it, and it closes when none are left. It is an alert (announced when\n * it appears), takes focus after a failed submit but not when the list changes, and each error is a link that scrolls to its field and focuses it.\n */\nexport function FormErrorSummary({ title = defaultTitle, focusOnError = true, className, ref, ...props }: FormErrorSummaryProps) {\n  const form = useForm()\n  const own = React.useRef<HTMLDivElement>(null)\n  const handled = React.useRef(0)\n  const { registerSummary } = form\n  React.useEffect(() => registerSummary(), [registerSummary])\n\n  // errors with a field on the page come in the order the fields were mounted; the others (a failure of the whole form) lead\n  const order = Object.keys(form.fields)\n  const items = Object.entries(form.errors)\n    .filter(([, m]) => hasMessage(m))\n    .sort(([a], [b]) => order.indexOf(a) - order.indexOf(b))\n  const visible = form.submitCount > 0 && items.length > 0\n\n  React.useEffect(() => {\n    if (form.submitCount < handled.current) handled.current = form.submitCount\n    if (form.submitCount <= handled.current) return\n    handled.current = form.submitCount\n    if (focusOnError && items.length > 0) own.current?.focus()\n  }, [form.submitCount, focusOnError, items.length])\n\n  if (!visible) return null\n  return (\n    <Alert\n      {...props}\n      ref={(node) => {\n        own.current = node\n        if (typeof ref === 'function') ref(node)\n        else if (ref) ref.current = node\n      }}\n      data-slo