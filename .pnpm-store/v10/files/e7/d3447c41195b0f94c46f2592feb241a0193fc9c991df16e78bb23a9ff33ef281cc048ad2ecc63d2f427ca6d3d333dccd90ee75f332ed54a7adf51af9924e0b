n}\n\nexport interface SelectFilterProps extends FilterTriggerProps {\n  /** the choices, each with an optional icon and count */\n  options: FilterOption[]\n  /** the selected option value, or an empty string; leave out for an uncontrolled filter */\n  value?: string\n  /** starting choice of an uncontrolled filter */\n  defaultValue?: string\n  /** called with the chosen option value, or an empty string when cleared */\n  onValueChange?: (value: string) => void\n}\n\n/** Pick one option from a searchable list. Choosing it again, or Clear, removes the filter. The panel closes on a choice. */\nexport function SelectFilter({ label, options, value, defaultValue, onValueChange, ...trigger }: SelectFilterProps) {\n  const [current, set] = useControllableState<string>(value, defaultValue ?? '', onValueChange)\n  const def = useMemo<FilterDef>(() => ({ key: label, label, type: 'select', options }), [label, options])\n  return <StandaloneFilter def={def} value={current} onChange={(v) => set((v as string | undefined) ?? '')} {...trigger} />\n}\n\nexport interface DateRangeFilterProps extends FilterTriggerProps {\n  /** ISO dates (`2026-10-24`); leave out for an uncontrolled filter */\n  value?: DateRangeValue\n  /** starting range of an uncontrolled filter */\n  defaultValue?: DateRangeValue\n  /** called with the new range; an empty object when cleared */\n  onValueChange?: (value: DateRangeValue) => void\n  /** quick choices above the custom range (default `dateRangePresets`) */\n  presets?: DateRangePreset[]\n}\n\n/** Quick ranges (Today, Last 7 days, This month ...) above a custom range picked with the date range picker. */\nexport function DateRangeFilter({ label, value, defaultValue, onValueChange, presets, ...trigger }: DateRangeFilterProps) {\n  const [current, set] = useControllableState<DateRangeValue>(value, defaultValue ?? {}, onValueChange)\n  const def = useMemo<FilterDef>(() => ({ key: label, label, type: 'date-range', presets }), [label, presets])\n  return <StandaloneFilter def={def} value={current} onChange={(v) => set((v as DateRangeValue | undefined) ?? {})} {...trigger} />\n}\n\nexport interface NumberRangeFilterProps extends FilterTriggerProps {\n  /** the range; leave out for an uncontrolled filter */\n  value?: NumberRangeValue\n  /** starting range of an uncontrolled filter */\n  defaultValue?: NumberRangeValue\n  /** called with the new range; an empty object when cleared */\n  onValueChange?: (value: NumberRangeValue) => void\n  /** the numbers are rupees: ₹ prefix on the inputs, Indian grouping in the hint and the summary */\n  currency?: boolean\n}\n\n/** Min and max inputs, applied with the Apply button or Enter. Either end may stay empty. */\nexport function NumberRangeFilter({ label, value, defaultValue, onValueChange, currency, ...trigger }: NumberRangeFilterProps) {\n  const [current, set] = useControllableState<NumberRangeValue>(value, defaultValue ?? {}, onValueChange)\n  const def = useMemo<FilterDef>(() => ({ key: label, label, type: 'number-range', currency }), [label, currency])\n  return <StandaloneFilter def={def} value={current} onChange={(v) => set((v as NumberRangeValue | undefined) ?? {})} {...trigger} />\n}\n\nexport interface TextFilterProps extends FilterTriggerProps {\n  /** the phrase, or `null` for none; leave `value` out for an uncontrolled filter */\n  value?: TextFilterValue | null\n  /** starting phrase of an uncontrolled filter */\n  defaultValue?: TextFilterValue | null\n  /** called with the operator and phrase, or `null` when cleared */\n  onValueChange?: (value: TextFilterValue | null) => void\n  /** placeholder of the text box */\n  placeholder?: string\n}\n\n/** A phrase that the value contains or equals (ignoring case). Applied with the Apply button or Enter; `null` when cleared. */\nexport function TextFilter({ label, value, defaultValue, onValueChange, placeholder, ...trigger }: TextFilterProps) {\n  const [current, set] = useControllableState<TextFilterValue | null>(value, defaultValue ?? null, onValueChange)\n  const def = useMemo<FilterDef>(() => ({ key: label, label, type: 'text', placeholder }), [label, placeholder])\n  return <StandaloneFilter def={def} value={current ?? undefined} onChange={(v) => set((v as TextFilterValue | undefined) ?? null)} {...trigger} />\n}\n\n/* ------------------------------------------------------------------------------------------------------------------\n   FilterBar: Add filter menu, removable chips, Clear all\n   ------------------------------------------------------------------------------------------------------------------ */\n\nconst NO_FILTERS: FilterState = {}\n\nfunction FilterChip({ def, value, open, onOpenChange, onInteractOutside, onChange, onRemove }: {\n  def: FilterDef\n  value: FilterValue | undefined\n  open: boolean\n  onOpenChange: (open: boolean) => void\n  /** a click or focus outside the editor is about to close it */\n  onInteractOutside: () => void\n  onChange: (next: FilterValue | undefined) => void\n  onRemove: () => void\n}) {\n  const summary = describeFilter(def, value)\n  return (\n    <Popover open={open} onOpenChange={onOpenChange}>\n      <PopoverAnchor asChild>\n        <FilterGroup label={def.label} onRemove={onRemove} data-slot=\"filter-chip\" data-chip-key={def.key} data-state={open ? 'open' : 'closed'}>\n          <PopoverTrigger asChild>\n            <FilterButton label={def.label} icon={def.icon} summary={summary} active removable />\n          </PopoverTrigger>\n        </FilterGroup>\n      </PopoverAnchor>\n      <PopoverContent align=\"start\" aria-label={`${def.label} filter`} className={panelClass[def.type]} onInteractOutside={onInteractOutside}>\n        <FilterEditor def={def} value={value} onChange={onChange} onDone={() => onOpenChange(false)} />\n      </PopoverContent>\n    </Popover>\n  )\n}\n\nexport interface FilterBarProps {\n  /** the filters that can be added */\n  filters: FilterDef[]\n  /** active filters by key; leave out for an uncontrolled bar */\n  value?: FilterState\n  /** starting filters of an uncontrolled bar */\n  defaultValue?: FilterState\n  /** called with the whole new state; a filter that is cleared is removed from it */\n  onValueChange?: (value: FilterState) => void\n  /** how many rows match; announced to screen readers (politely) whenever it or the active filters change */\n  resultCount?: number\n  /** what a row is called in that announcement, singular (default `result`) */\n  resultNoun?: string\n  /** content at the start of the bar, before Add filter: a saved-views menu, say */\n  savedViews?: ReactNode\n  /** content at the right end of the bar */\n  actions?: ReactNode\n  /** text of the Add filter button */\n  addLabel?: string\n  /** extra classes for the bar */\n  className?: string\n}\n\n/**\n * Add filter menu, one chip per active filter (\"Status: Approved, Pending\") and Clear all. A chip opens its editor on click and has its own\n * remove button. Picking a filter in the menu adds its chip and opens the editor straight away; if you close it without choosing anything the\n * chip goes away again. A hidden live region announces the result count.\n */\nexport function FilterBar({ filters, value: valueProp, defaultValue, onValueChange, resultCount, resultNoun = 'result', savedViews, actions, addLabel = 'Add filter', className }: FilterBarProps) {\n  const [value, setValue] = useControllableState<FilterState>(valueProp, defaultValue ?? NO_FILTERS, onValueChange)\n  // the filter whose editor is open keeps its chip even while it has no value, so a filter just picked from the menu (or cleared in its editor) stays put until the editor closes\n  const [openKey, setOpenKey] = useState<string | null>(null)\n  const [order, setOrder] = useState<string[]>([])\n  const rootRef = useRef<HTMLDivElement>(null)\n  const refocus = useRef<string | null>(null)\n  // an editor closed on a filter without a value takes its chip along, which can leave focus on the page body; unless the user clicked elsewhere, it goes to Add filter\n  const rescueFocus = useRef(false)\n  const leftOutside = useRef(false)\n  const justAdded = useRef(false)\n\n  const chips = useMemo(() => {\n    const shown = filters.filter((d) => isFilterActive(d, value[d.key]) || d.key === openKey)\n    const rank = (k: string) => {\n      const i = order.indexOf(k)\n      return i < 0 ? -1 : i\n    }\n    const known = shown.filter((d) => rank(d.key) >= 0).sort((a, b) => rank(a.key) - rank(b.key))\n    return [...shown.filter((d) => rank(d.key) < 0), ...known]\n  }, [filters, value, openKey, order])\n  const activeCount = filters.reduce((n, d) => n + (isFilterActive(d, value[d.key]) ? 1 : 0), 0)\n  const available = filters.filter((d) => !chips.includes(d))\n\n  // after a chip is removed or cleared the focused element is gone: put focus on a neighbour instead of losing it\n  useEffect(() => {\n    if (rescueFocus.current) {\n      rescueFocus.current = false\n      const a = document.activeElement\n      if (!a || a === document.body) rootRef.current?.querySelector<HTMLElement>('[data-filter-add]')?.focus()\n    }\n    const target = refocus.current\n    if (!target) return\n    refocus.current = null\n    const root = rootRef.current\n    const el = target === 'add' ? root?.querySelector<HTMLElement>('[data-filter-add]') : root?.querySelector<HTMLElement>(`[data-chip-key=\"${CSS.escape(target)}\"] button`)\n    el?.focus()\n  })\n\n  const setFilter = (key: string, next: FilterValue | undefined) => {\n    const rest = { ...value }\n    if (next === undefined) delete rest[key]\n    else rest[key] = next\n    setValue(rest)\n  }\n  const add = (key: string) => {\n    justAdded.current = true\n    setOrder([...chips.map((c) => c.key), key])\n    setOpenKey(key)\n  }\n  const remove = (key: string) => {\n    const i = chips.findIndex((c) => c.key === key)\n    const next = chips[i + 1] ?? chips[i - 1]\n    refocus.current = next ? next.key : 'add'\n    if (openKey === key) setOpenKey