y bottom-0 z-10 -mx-1 border-t border-border bg-background px-1 py-3 shadow-[0_-8px_8px_-8px_rgb(10_21_33/0.14)]',\n        className,\n      )}\n      {...props}\n    />\n  )\n}\n\n/* ---------------------------------------------------------- useFormState */\n\ntype Validate<V> = (values: V) => FormErrors | Promise<FormErrors>\n\nexport interface UseFormStateOptions<V extends Record<string, unknown>> {\n  /** Values the form starts with, and what `reset()` and `isDirty` compare against. */\n  initialValues: V\n  /** Returns a message per invalid field (sync or async). Runs on submit, then on change and blur for fields the user has left or after a submit. */\n  validate?: Validate<V>\n}\n\nexport interface FormState<V extends Record<string, unknown>> {\n  /** The current values. */\n  values: V\n  /** The messages to show: only for fields that were touched or after a submit. */\n  errors: FormErrors\n  /** Fields the user has left (or all of them after a submit). */\n  touched: Partial<Record<keyof V & string, boolean>>\n  /** Sets one value and re-validates when that field is touched or the form was submitted. */\n  setValue: <K extends keyof V & string>(name: K, value: V[K]) => void\n  /** Replaces several values at once (a merge). */\n  setValues: (values: Partial<V>) => void\n  /** Replaces the errors, for messages that come from the server. Each stays until its field changes or the form is submitted again. */\n  setErrors: (errors: FormErrors) => void\n  /** Marks a field as touched and validates it: wire it to `Form`'s `onFieldBlur`, or pass the whole state as `form`. */\n  blur: (name: string) => void\n  /** Validates, and calls `onValid` with the values when there are no errors. Pass the result to `Form`'s `onSubmit`. */\n  handleSubmit: (onValid: (values: V) => void | Promise<unknown>) => (event?: { preventDefault?: () => void }) => Promise<void>\n  /** Back to the initial values (or to `values`, which then become the baseline), with no errors and nothing touched. */\n  reset: (values?: V) => void\n  /** The values differ from the initial ones. */\n  isDirty: boolean\n  /** `onValid` is running. */\n  isSubmitting: boolean\n  /** How many times the form was submitted. */\n  submitCount: number\n}\n\nfunction same(a: unknown, b: unknown): boolean {\n  if (Object.is(a, b)) return true\n  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime()\n  if (Array.isArray(a) && Array.isArray(b)) return a.length === b.length && a.every((x, i) => same(x, b[i]))\n  if (a && b && typeof a === 'object' && typeof b === 'object') {\n    const ka = Object.keys(a)\n    return ka.length === Object.keys(b).length && ka.every((k) => same((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))\n  }\n  return false\n}\n\nconst withoutEmpty = (errors: FormErrors | undefined): FormErrors => Object.fromEntries(Object.entries(errors ?? {}).filter(([, m]) => !!m))\n\n/**\n * Form values, errors and touched state without a library. Nothing is shown while the user is still typing in a field they have not left:\n * validation runs on submit, and from then on (or after a blur) on every change of that field. Compose `validate` from `createValidator`\n * or write it by hand; use a form library instead when you need arrays of fields or schema validation.\n */\nexport function useFormState<V extends Record<string, unknown>>({ initialValues, validate }: UseFormStateOptions<V>): FormState<V> {\n  const [baseline, setBaseline] = React.useState(initialValues)\n  const [values, setValuesState] = React.useState(initialValues)\n  const [errors, setErrorsState] = React.useState<FormErrors>({})\n  const [touched, setTouched] = React.useState<Partial<Record<keyof V & string, boolean>>>({})\n  const [submitCount, setSubmitCount] = React.useState(0)\n  const [isSubmitting, setSubmitting] = React.useState(false)\n\n  // refs hold the latest values so a handler called twice in one tick (a change, then a blur) sees both\n  const val