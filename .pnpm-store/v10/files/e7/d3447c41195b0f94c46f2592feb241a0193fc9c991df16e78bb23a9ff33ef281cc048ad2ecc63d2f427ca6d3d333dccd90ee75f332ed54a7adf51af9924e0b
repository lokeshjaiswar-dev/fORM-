lert, AlertDescription, AlertTitle } from '../components/alert'\nimport { Field as UiField, withFieldControl, type FieldControlProps } from '../components/field'\nimport { cn } from '../lib/utils'\n\n/** Field name -> message. A name with no message (or `undefined`) has no error. */\nexport type FormErrors = Record<string, string | undefined>\n\n/** Same shape, but a message can be any node: what `Form`, `FormField` and `FormErrorSummary` read. */\nexport type FormErrorMap = Record<string, React.ReactNode>\n\nconst hasMessage = (m: React.ReactNode) => m !== undefined && m !== null && m !== false && m !== ''\n\nconst isPromiseLike = (v: unknown): v is PromiseLike<unknown> => !!v && typeof (v as { then?: unknown }).then === 'function'\n\n/* ------------------------------------------------------------------ Form */\n\ninterface FormContextValue {\n  /** a submit handler is running */\n  submitting: boolean\n  /** errors by field name, as given to `Form` */\n  errors: FormErrorMap\n  /** how many submits have finished (since the bound `useFormState` was last reset); the error summary shows and takes focus after the first */\n  submitCount: number\n  /** names of the fields that have a `FormField`, in the order they were mounted, with the id of their control */\n  fields: Readonly<Record<string, string>>\n  /** the label text of those fields that have a plain-text `label`, by name: what the error summary puts before a message */\n  labels: Readonly<Record<string, string>>\n  /** a `FormErrorSummary` is listing the form's errors, so a `FormField` leaves announcing them to it */\n  summaryActive: boolean\n  /** called by `FormField`; returns the cleanup */\n  registerField: (name: string, id: string, label?: string) => () => void\n  /** called by `FormErrorSummary` while it is mounted; returns the cleanup */\n  registerSummary: () => () => void\n  /** scrolls the field's control into view and focuses it; false when the field is not on the page */\n  focusField: (name: stri