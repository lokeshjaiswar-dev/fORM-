 const tools = (\n    <div className=\"ml-auto flex flex-wrap items-center justify-end gap-2\">\n      {/* with a filter bar, a phone shows the count in that bar's row (next to Add filter) instead of on a line of its own under the search; the footer carries it when there is one */}\n      <span className={cn('text-xs text-text-muted tnum', showPagination && 'sr-only', showToolbar && showFilterBar && 'max-sm:hidden')} aria-live={showFilterBar ? undefined : 'polite'}>\n        {countText}\n      </span>\n      {columnToggle && (\n        <DropdownMenu>\n          <DropdownMenuTrigger asChild>\n            <Button variant=\"outline\" size=\"sm\">\n              <Columns3 /> Configure columns\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\" className=\"min-w-48\">\n            <DropdownMenuLabel>Columns</DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            {available.map((c) => (\n              <DropdownMenuCheckboxItem\n                key={c.key}\n                checked={!hiddenKeys.includes(c.key)}\n                onSelect={(e) => e.preventDefault()}\n                onCheckedChange={(v) => setHiddenKeys((p) => (v ? p.filter((k) => k !== c.key) : [...p, c.key]))}\n                disabled={!hiddenKeys.includes(c.key) && cols.length === 1}\n              >\n                {typeof c.header === 'string' ? c.header : c.key}\n              </DropdownMenuCheckboxItem>\n            ))}\n          </DropdownMenuContent>\n        </DropdownMenu>\n      )}\n      {canExport && (\n        <Button variant=\"outline\" size=\"sm\" onClick={exportCsv}>\n          <Download /> Export\n        </Button>\n      )}\n    </div>\n  )\n\n  return (\n    <div ref={rootRef} className={cn('space-y-3', className)}>\n      {showSelectionBar ? (\n        <div data-slot=\"table-selection-bar\" className=\"flex min-h-(--ctl-h-md) flex-wrap items-center gap-x-3 gap-y-2\">\n          <span className=\"text-sm font-medium tex