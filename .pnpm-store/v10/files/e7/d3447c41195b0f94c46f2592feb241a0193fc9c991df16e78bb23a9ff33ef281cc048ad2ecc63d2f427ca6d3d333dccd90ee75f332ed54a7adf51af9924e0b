{"version":3,"file":"patterns.js","sources":["../src/patterns/misc.tsx","../src/patterns/audit-log.tsx","../src/patterns/filters.tsx","../src/patterns/data-table.tsx","../src/patterns/dialogs.tsx","../src/patterns/fields.tsx","../src/patterns/form.tsx","../src/patterns/layout.tsx","../src/patterns/table-cells.tsx"],"sourcesContent":["import type { ReactNode } from 'react'\nimport { Inbox } from 'lucide-react'\nimport { Card, CardContent } from '../components/card'\nimport { Progress } from '../components/progress'\nimport { Badge } from '../components/badge'\nimport { cn } from '../lib/utils'\nimport { inr, inr2 } from '../lib/format'\nimport { toStatusTone, type StatusTone } from '../lib/tone'\n\n/** A rupee amount with paise (`decimals={false}` drops them). A missing value (null or undefined) shows a dash, not ₹0.00. */\nexport function Money({ value, className, decimals = true, muted }: { value: number | undefined | null; className?: string; decimals?: boolean; muted?: boolean }) {\n  if (value === null || value === undefined) {\n    return (\n      <span className={cn('tnum whitespace-nowrap text-text-muted', className)}>\n        <span aria-hidden>—</span>\n        <span className=\"sr-only\">No value</span>\n      </span>\n    )\n  }\n  return <span className={cn('tnum whitespace-nowrap', muted && 'text-text-muted', className)}>{decimals ? inr2(value) : inr(value)}</span>\n}\n\n/**\n * A panel for \"nothing here\": a glyph, a title, a line of explanation and the action that fixes it. `bordered` (default) is the dashed card; turn it off\n * where it sits inside a card or a table. `size=\"sm\"` is the tight version for panels and menus.\n */\nexport function EmptyState({\n  title, description, action, icon, size = 'md', bordered = true, className,\n}: { title: ReactNode; description?: ReactNode; action?: ReactNode; icon?: ReactNode; size?: 'sm' | 'md'; bordered?: boolean; className?: string }) {\n  return (\n    <div\n      data-slot=\"empty-state\"\n      className={cn('flex flex-col items-center gap-2 text-center', size === 'sm' ? 'px-4 py-6' : 'px-6 py-10', bordered && 'rounded-lg border border-dashed border-border bg-card', className)}\n    >\n      <span aria-hidden className={cn('mb-1 grid place-items-center rounded-full bg-surface-subtle text-icon-muted', size === 'sm' ? 'size-8 [&_svg]:size-4' : 'size-10 [&_svg]:size-5')}>\n        {icon ?? <Inbox />}\n      </span>\n      <div className={cn('font-semibold text-foreground', size === 'sm' ? 'text-sm' : 'text-base')}>{title}</div>\n      {description && <div className=\"max-w-md text-sm text-text-subtle\">{description}</div>}\n      {action && <div className=\"pt-1\">{action}</div>}\n    </div>\n  )\n}\n\n/**\n * A small figure tile: label, value and a one-line hint (the full hint shows as a tooltip). Kept compact so a row of them reads at a glance.\n * `href` makes the tile a plain link; for client-side routing wrap the tile in your router's link instead.\n */\nexport function StatCard({\n  label, value, hint, tone, href, icon,\n}: { label: string; value: ReactNode; hint?: ReactNode; tone?: 'default' | 'success' | 'warning' | 'danger' | StatusTone; href?: string; icon?: ReactNode }) {\n  // the shared names (positive, negative, ...) read as the older ones: only the three coloured tones change the tile\n  const t = toStatusTone(tone)\n  const look = t === 'positive' ? 'positive' : t === 'negative' ? 'negative' : t === 'warning' ? 'notice' : undefined\n  const body = (\n    <div\n      data-slot=\"stat-card\"\n      data-ds-tone={look}\n      className={cn(\n        'flex h-full min-w-0 flex-col gap-px rounded-lg border bg-card px-3 py-1.5 shadow-xs transition-colors duration-(--dur-base)',\n        href && 'hover:border-primary-highlighted',\n        look && 'border-(--ds-tone-subtle)',\n      )}\n    >\n      <div className=\"flex items-start justify-between gap-2 text-xs leading-4 font-medium text-text-muted\">\n        <span className=\"line-clamp-2 min-w-0 break-words\" title={label}>{label}</span>\n        {icon && <span className=\"shrink-0 [&_svg]:size-3.5 [&_svg]:mt-px\">{icon}</span>}\n      </div>\n      <div className={cn('text-lg leading-5 font-semibold tracking-tight text-foreground tnum', look && 'text-(--ds-tone)')}>{value}</div>\n      {hint && <div className=\"truncate text-xs leading-4 text-text-muted\" title={typeof hint === 'string' ? hint : undefined}>{hint}</div>}\n    </div>\n  )\n  return href ? <a href={href} className=\"block min-w-0 rounded-lg ds-focus\">{body}</a> : body\n}\n\n/** Label / value pairs in a grid: the label is a small muted line right above its value, and the pairs sit a full line apart, so each label reads with the value below it. */\nexport function KeyValue({ items, cols = 2, className }: { items: { label: string; value: ReactNode }[]; cols?: 1 | 2 | 3 | 4; className?: string }) {\n  return (\n    <dl className={cn('grid gap-x-5 gap-y-3.5 text-sm', cols === 1 && 'grid-cols-1', cols === 2 && 'sm:grid-cols-2', cols === 3 && 'sm:grid-cols-3', cols === 4 && 'sm:grid-cols-2 lg:grid-cols-4', className)}>\n      {items.map((i, idx) => (\n        <div key={`${i.label}-${idx}`} className=\"min-w-0\">\n          <dt className=\"mb-0.5 text-xs text-text-muted\">{i.label}</dt>\n          <dd className=\"font-medium break-words text-foreground\">{i.value ?? '—'}</dd>\n        </div>\n      ))}\n    </dl>\n  )\n}\n\n/** Usage bar with the warning threshold and the 100% block marked. The tick follows the bar height, and the bar turns amber at the warning threshold and red at 100%. */\nexport function UsageBar({ pct, warnPct = 90, label }: { pct: number; warnPct?: number; label?: ReactNode }) {\n  const tone = pct >= 100 ? 'negative' : pct >= warnPct ? 'notice' : 'primary'\n  return (\n    <div className=\"space-y-1\">\n      <div className=\"relative\">\n        <Progress value={Math.min(pct, 100)} size=\"lg\" tone={tone} aria-label={typeof label === 'string' ? label : 'Usage'} className=\"bg-surface-highlighted\" />\n        <div aria-hidden className=\"absolute -inset-y-[3px] w-0.5 -translate-x-1/2 rounded-full bg-foreground/70 ring-1 ring-card\" style={{ left: `${warnPct}%` }} title={`Warning at ${warnPct}%`} />\n      </div>\n      {label && <div className=\"text-xs text-text-muted\">{label}</div>}\n    </div>\n  )\n}\n\nconst PILL_VARIANT = { positive: 'success', negative: 'danger', neutral: 'secondary', primary: 'brand' } as const\n\n/** A status pill: a `Badge`. `tone` takes the older names (success, danger, brand, ...) and the shared ones (positive, negative, neutral, primary). */\nexport function Pill({ children, tone = 'outline' }: { children: ReactNode; tone?: 'outline' | 'success' | 'warning' | 'danger' | 'info' | 'brand' | 'secondary' | 'orange' | 'positive' | 'negative' | 'neutral' | 'primary' }) {\n  return <Badge variant={tone in PILL_VARIANT ? PILL_VARIANT[tone as keyof typeof PILL_VARIANT] : (tone as 'outline')}>{children}</Badge>\n}\n\nexport function NewTag() {\n  return <Badge variant=\"orange\" className=\"px-1.5 py-0 text-xxs uppercase\">New</Badge>\n}\n","import { useMemo, useState, type ReactNode } from 'react'\nimport { ArrowRight, Download, Filter, Inbox, X } from 'lucide-react'\nimport { Button } from '../components/button'\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuLabel, DropdownMenuRadioGroup, DropdownMenuRadioItem, DropdownMenuSeparator, DropdownMenuTrigger } from '../components/dropdown-menu'\nimport { Tooltip, TooltipContent, TooltipTrigger } from '../components/tooltip'\nimport { Sheet, SheetContent, SheetDescription, SheetHeader, SheetTitle } from '../components/sheet'\nimport { TIMELINE_EVENTS, type TimelineEventKind } from '../components/timeline'\nimport { cn } from '../lib/utils'\nimport { EmptyState } from './misc'\n\n/*\n * Audit log (Figma: Audit Log 2883:2). A record's history as a day-grouped list: each event is a 28px tone badge with a glyph,\n * the title (Medium M), a detail line (Regular S), \"actor · time\" (Regular XS) and, for edits, one row per changed field.\n * `AuditLog` is the list with its toolbar (count, filter, download, filter chips); `AuditLogDrawer` is the 480px side panel around it.\n * Feed it `AuditEvent`s; map your own records to events in your app.\n */\n\nexport interface AuditFieldChange {\n  field: ReactNode\n  from?: ReactNode\n  to?: ReactNode\n}\n\nexport interface AuditEvent {\n  id: string\n  kind: TimelineEventKind\n  title: ReactNode\n  detail?: ReactNode\n  /** person or system that did it, e.g. \"Priya Shah\" or \"Workflow WF-2041\" */\n  actor?: string\n  /** ISO date-time, e.g. 2026-10-24T09:47:00 (the clock part is read as written, like fmtDateTime does) */\n  at: string\n  changes?: AuditFieldChange[]\n}\n\nconst MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\n\nconst pad = (n: number) => String(n).padStart(2, '0')\nconst localDate = (offsetDays = 0) => {\n  const d = new Date()\n  d.setDate(d.getDate() + offsetDays)\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`\n}\nconst dateLabel = (day: string) => {\n  const [y, m, d] = day.split('-').map(Number)\n  const base = `${pad(d)} ${MON[m - 1]} ${y}`\n  return day === localDate(0) ? `Today · ${base}` : day === localDate(-1) ? `Yesterday · ${base}` : base\n}\n/** The clock of an event: `12h` is 09:47 AM (the Figma look), `24h` is 09:47, the way the tables print times. */\nexport type AuditTimeFormat = '12h' | '24h'\nconst timeLabel = (iso: string, format: AuditTimeFormat = '12h') => {\n  if (iso.length <= 10) return ''\n  if (format === '24h') return iso.slice(11, 16)\n  const h = Number(iso.slice(11, 13))\n  return `${pad(h % 12 === 0 ? 12 : h % 12)}:${iso.slice(14, 16)} ${h < 12 ? 'AM' : 'PM'}`\n}\n\n/** One changed field: name, old value, arrow, new value (Figma: AuditLog / FieldChangeRow). Indented to line up with the event text. */\nexport function AuditFieldChangeRow({ field, from, to, className }: AuditFieldChange & { className?: string }) {\n  return (\n    <div data-slot=\"audit-field-change\" className={cn('flex min-h-5 flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs', className)}>\n      <span className=\"font-medium text-foreground\">{field}</span>\n      {from !== undefined && <span className=\"text-text-muted line-through decoration-text-muted/60\">{from}</span>}\n      {from !== undefined && to !== undefined && (\n        <span role=\"img\" aria-label=\"changed to\" className=\"text-icon-muted\">\n          <ArrowRight aria-hidden className=\"size-3\" />\n        </span>\n      )}\n      {to !== undefined && <span className=\"font-medium text-foreground\">{to}</span>}\n    </div>\n  )\n}\n\n/** The 28px icon badge of an event (Figma: AuditLog / EventRow, iconBadge). */\nexport function AuditEventIcon({ kind, className }: { kind: TimelineEventKind; className?: string }) {\n  const { icon: Icon, tone } = TIMELINE_EVENTS[kind]\n  return (\n    <span data-slot=\"audit-event-icon\" data-ds-tone={tone} aria-hidden className={cn('ds-marker grid size-7 shrink-0 place-items-center rounded-full [&_svg]:size-4', className)}>\n      <Icon />\n    </span>\n  )\n}\n\nexport function AuditEventRow({ event, timeFormat, className }: { event: AuditEvent; /** how the clock reads; default `12h` */ timeFormat?: AuditTimeFormat; className?: string }) {\n  const time = timeLabel(event.at, timeFormat)\n  return (\n    <li data-slot=\"audit-event\" data-kind={event.kind} className={cn('flex gap-3', className)}>\n      <AuditEventIcon kind={event.kind} />\n      <div className=\"min-w-0 flex-1\">\n        <div className=\"text-base font-medium text-foreground\">{event.title}</div>\n        {event.detail && <div className=\"text-sm text-(--ds-text-detail)\">{event.detail}</div>}\n        {(event.actor || time) && (\n          <div className=\"text-xs text-text-muted\">\n            {event.actor}\n            {event.actor && time && ' · '}\n            {time}\n          </div>\n        )}\n        {event.changes && event.changes.length > 0 && (\n          <div className=\"mt-1.5 space-y-0.5\">\n            {event.changes.map((c, i) => (\n              <AuditFieldChangeRow key={i} {...c} />\n            ))}\n          </div>\n        )}\n      </div>\n    </li>\n  )\n}\n\n/** The day label with its rule (Figma: AuditLog / DateHeader). `as` makes the label a heading (`h2` to `h6`) so a screen reader can jump from day to day. */\nexport function AuditDateHeader({ children, as: Tag = 'div', className }: { children: ReactNode; as?: 'div' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'; className?: string }) {\n  return (\n    <div data-slot=\"audit-date-header\" className={cn('flex h-5 items-center gap-2', className)}>\n      <Tag className=\"m-0 text-xs font-bold tracking-wide whitespace-nowrap text-text-muted uppercase\">{children}</Tag>\n      <span aria-hidden className=\"h-px flex-1 bg-border-subtle\" />\n    </div>\n  )\n}\n\nexport interface AuditLogProps {\n  events: AuditEvent[]\n  /** hide the count / filter / download row */\n  hideToolbar?: boolean\n  /** called by the download button; the default downloads the shown events as CSV */\n  onDownload?: (events: AuditEvent[]) => void\n  exportName?: string\n  empty?: ReactNode\n  /** clock style of each event: `12h` (09:47 AM, default) or `24h` (09:47, like the tables) */\n  timeFormat?: AuditTimeFormat\n  /** heading level of the day labels (default 3: the drawer title is the h2) */\n  dayHeadingLevel?: 2 | 3 | 4 | 5 | 6\n  className?: string\n}\n\nconst asText = (n: ReactNode) => (typeof n === 'string' || typeof n === 'number' ? String(n) : '')\n\nexport function AuditLog({ events, hideToolbar, onDownload, exportName = 'audit-log', empty = 'No events recorded yet.', timeFormat, dayHeadingLevel = 3, className }: AuditLogProps) {\n  const [kind, setKind] = useState<TimelineEventKind | 'all'>('all')\n  const [actor, setActor] = useState('all')\n  const kinds = useMemo(() => [...new Set(events.map((e) => e.kind))], [events])\n  const actors = useMemo(() => [...new Set(events.map((e) => e.actor).filter((a): a is string => !!a))], [events])\n  const shown = useMemo(() => events.filter((e) => (kind === 'all' || e.kind === kind) && (actor === 'all' || e.actor === actor)), [events, kind, actor])\n  const groups = useMemo(() => {\n    const out: { day: string; items: AuditEvent[] }[] = []\n    for (const e of shown) {\n      const day = e.at.slice(0, 10)\n      const last = out[out.length - 1]\n      if (last && last.day === day) last.items.push(e)\n      else out.push({ day, items: [e] })\n    }\n    return out\n  }, [shown])\n\n  const download = () => {\n    if (onDownload) return onDownload(shown)\n    const lines = [['When', 'Actor', 'Event', 'Title', 'Detail'], ...shown.map((e) => [e.at, e.actor ?? '', TIMELINE_EVENTS[e.kind].label, asText(e.title), asText(e.detail)])]\n    const csv = lines.map((l) => l.map((v) => `\"${v.replaceAll('\"', '\"\"')}\"`).join(',')).join('\\n')\n    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }))\n    const a = document.createElement('a')\n    a.href = url\n    a.download = `${exportName}.csv`\n    a.click()\n    URL.revokeObjectURL(url)\n  }\n\n  const chips: { label: string; clear: () => void }[] = []\n  if (kind !== 'all') chips.push({ label: `Event: ${TIMELINE_EVENTS[kind].label}`, clear: () => setKind('all') })\n  if (actor !== 'all') chips.push({ label: `Actor: ${actor}`, clear: () => setActor('all') })\n\n  return (\n    <div data-slot=\"audit-log\" className={cn('space-y-3', className)}>\n      {!hideToolbar && (\n        <div className=\"space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs text-text-muted tnum\">\n              {shown.length} {shown.length === 1 ? 'event' : 'events'}\n            </span>\n            <div className=\"flex items-center gap-2\">\n              <DropdownMenu>\n                <Tooltip>\n                  <TooltipTrigger asChild>\n                    <DropdownMenuTrigger asChild>\n                      <Button type=\"button\" variant=\"outline\" size=\"icon-sm\" aria-label={chips.length ? `Filter events, ${chips.length} active` : 'Filter events'} className=\"relative\">\n                        <Filter />\n                        {chips.length > 0 && <span aria-hidden className=\"absolute -top-1 -right-1 size-2 rounded-full bg-primary ring-2 ring-card\" />}\n                      </Button>\n                    </DropdownMenuTrigger>\n                  </TooltipTrigger>\n                  <TooltipContent>Filter events</TooltipContent>\n                </Tooltip>\n                <DropdownMenuContent align=\"end\" className=\"min-w-48\">\n                  <DropdownMenuLabel>Event</DropdownMenuLabel>\n                  <DropdownMenuRadioGroup value={kind} onValueChange={(v) => setKind(v as typeof kind)}>\n                    <DropdownMenuRadioItem value=\"all\">All events</DropdownMenuRadioItem>\n                    {kinds.map((k) => (\n                      <DropdownMenuRadioItem key={k} value={k}>\n                        {TIMELINE_EVENTS[k].label}\n                      </DropdownMenuRadioItem>\n                    ))}\n                  </DropdownMenuRadioGroup>\n                  {actors.length > 0 && (\n                    <>\n                      <DropdownMenuSeparator />\n                      <DropdownMenuLabel>Actor</DropdownMenuLabel>\n                      <DropdownMenuRadioGroup value={actor} onValueChange={setActor}>\n                        <DropdownMenuRadioItem value=\"all\">Everyone</DropdownMenuRadioItem>\n                        {actors.map((a) => (\n                          <DropdownMenuRadioItem key={a} value={a}>\n                            {a}\n                          </DropdownMenuRadioItem>\n                        ))}\n                      </DropdownMenuRadioGroup>\n                    </>\n                  )}\n                </DropdownMenuContent>\n              </DropdownMenu>\n              <Tooltip>\n                <TooltipTrigger asChild>\n                  <Button type=\"button\" variant=\"outline\" size=\"icon-sm\" aria-label=\"Download events as CSV\" onClick={download}>\n                    <Download />\n                  </Button>\n                </TooltipTrigger>\n                <TooltipContent>Download CSV</TooltipContent>\n              </Tooltip>\n            </div>\n          </div>\n          {chips.length > 0 && (\n            <div className=\"flex flex-wrap gap-2\">\n              {chips.map((c) => (\n                <span key={c.label} className=\"inline-flex h-6 items-center gap-1 rounded-full bg-surface-subtle pr-1 pl-3 text-xs font-medium text-foreground\">\n                  {c.label}\n                  <button type=\"button\" aria-label={`Remove filter ${c.label}`} onClick={c.clear} className=\"grid size-4 place-items-center rounded-full hover:bg-state-hover ds-focus focus-visible:outline-offset-0\">\n                    <X className=\"size-3.5\" />\n                  </button>\n                </span>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n      {groups.length === 0 ? (\n        <div data-slot=\"audit-log-empty\">\n          {typeof empty === 'string' ? <EmptyState icon={<Inbox />} title={empty} /> : empty}\n        </div>\n      ) : (\n        groups.map((g) => (\n          <div key={g.day} className=\"space-y-3\">\n            <AuditDateHeader as={`h${dayHeadingLevel}`}>{dateLabel(g.day)}</AuditDateHeader>\n            <ol className=\"space-y-3\">\n              {g.items.map((e) => (\n                <AuditEventRow key={e.id} event={e} timeFormat={timeFormat} />\n              ))}\n            </ol>\n          </div>\n        ))\n      )}\n    </div>\n  )\n}\n\n/** The 480px side panel: title, record id chip, what the record is, then the log (Figma: Drawer / Record Audit Log). */\nexport function AuditLogDrawer({\n  open, onOpenChange, title = 'Audit Log', recordId, subtitle, ...log\n}: AuditLogProps & { open: boolean; onOpenChange: (open: boolean) => void; title?: string; recordId?: string; subtitle?: ReactNode }) {\n  return (\n    <Sheet open={open} onOpenChange={onOpenChange}>\n      <SheetContent\n        className=\"w-full gap-0 p-0 sm:max-w-[480px]\"\n        // focus the panel, not the first button (the Filter events icon): a programmatic focus there would open its tooltip over the header\n        onOpenAutoFocus={(e) => {\n          e.preventDefault()\n          e.currentTarget instanceof HTMLElement && e.currentTarget.focus()\n        }}\n      >\n        <SheetHeader className=\"gap-0.5 border-b border-border-subtle px-6 pt-5 pb-4\">\n          <div className=\"flex items-center gap-3\">\n            <SheetTitle className=\"text-lg font-extrabold\">{title}</SheetTitle>\n            {recordId && <span className=\"inline-flex h-5 items-center rounded-sm bg-primary-faded px-2 text-xs font-medium text-primary-text\">{recordId}</span>}\n          </div>\n          <SheetDescription className={cn('text-sm text-text-muted', !subtitle && 'sr-only')}>{subtitle ?? 'History of this record'}</SheetDescription>\n        </SheetHeader>\n        <div className=\"min-h-0 flex-1 overflow-y-auto px-6 py-4\">\n          <AuditLog {...log} />\n        </div>\n      </SheetContent>\n    </Sheet>\n  )\n}\n","import { useEffect, useId, useMemo, useRef, useState, type ComponentProps, type ReactNode } from 'react'\nimport { CalendarDays, CalendarRange, Check, ChevronLeft, ChevronRight, Hash, ListChecks, ListFilter, Plus, TextCursorInput, X } from 'lucide-react'\nimport { Button } from '../components/button'\nimport { Calendar } from '../components/calendar'\nimport { Command, CommandEmpty, CommandInput, CommandItem, CommandList } from '../components/command'\nimport { fromISO, toISO, type DateRangeValue } from '../components/date-picker'\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '../components/dropdown-menu'\nimport { useControllableState } from '../components/field'\nimport { Input } from '../components/input'\nimport { Popover, PopoverAnchor, PopoverContent, PopoverTrigger } from '../components/popover'\nimport { ToggleGroup, ToggleGroupItem } from '../components/toggle-group'\nimport { Tooltip, TooltipContent, TooltipTrigger } from '../components/tooltip'\nimport { fmtDate, inr, inrShort, num } from '../lib/format'\nimport { cn } from '../lib/utils'\n\n/* ------------------------------------------------------------------------------------------------------------------\n   Model: what a filter is, what its value looks like, and the pure functions that apply it\n   ------------------------------------------------------------------------------------------------------------------ */\n\n/** `select` picks one option, `multi` any number of them, `date-range` a from / to date, `number-range` a min / max, `text` a phrase. */\nexport type FilterType = 'select' | 'multi' | 'date-range' | 'number-range' | 'text'\n\nexport interface FilterOption {\n  /** the value stored in the filter and compared with the row's value */\n  value: string\n  /** what the row shows; may be any node, such as a status badge */\n  label: ReactNode\n  /** plain text for searching and for the chip when `label` is not a string */\n  text?: string\n  /** how many rows have this value; shown at the right of the row */\n  count?: number\n  /** icon before the label */\n  icon?: ReactNode\n}\n\n/** Both ends are inclusive; leave one out for an open range. */\nexport interface NumberRangeValue {\n  /** lowest number that passes; leave out for no lower limit */\n  min?: number\n  /** highest number that passes; leave out for no upper limit */\n  max?: number\n}\n\nexport type TextFilterOperator = 'contains' | 'equals'\n\nexport interface TextFilterValue {\n  /** `contains` finds the phrase anywhere in the value, `equals` needs the whole value to match (both ignore case) */\n  op: TextFilterOperator\n  /** the phrase to look for */\n  text: string\n}\n\n/** `select`: the option value. `multi`: option values. `date-range`: ISO dates (`2026-10-24`). `number-range`: numbers. `text`: operator and phrase. */\nexport type FilterValue = string | string[] | DateRangeValue | NumberRangeValue | TextFilterValue\n\n/** Active filters by `FilterDef.key`. A filter with no value has no entry, so `{}` means \"nothing filtered\" and `Object.keys(state).length` is the active count. */\nexport type FilterState = Record<string, FilterValue>\n\nexport interface FilterDef {\n  /** identifies the filter in a `FilterState` and, in `DataTable`, the column it belongs to */\n  key: string\n  /** name in the Add filter menu and at the start of the chip */\n  label: string\n  /** which editor the filter uses and how a row value is compared */\n  type: FilterType\n  /** choices of a `select` or `multi` filter */\n  options?: FilterOption[]\n  /** icon in the Add filter menu and on the chip; defaults to one per `type` */\n  icon?: ReactNode\n  /** `number-range`: the numbers are rupees, so the inputs get a ₹ prefix and the chip reads \"₹1 L to ₹5 L\" */\n  currency?: boolean\n  /** `text`: placeholder of the text box */\n  placeholder?: string\n  /** `date-range`: the quick choices above the custom range. Default `dateRangePresets`. */\n  presets?: DateRangePreset[]\n}\n\n/** A named range in the date filter. `range` runs when the filter is used, so \"Today\" is always today. */\nexport interface DateRangePreset {\n  /** stable identifier; a chip shows the preset's label while the range still equals it */\n  id: string\n  /** name of the quick choice */\n  label: string\n  /** the dates the preset stands for, read when the preset is chosen */\n  range: () => DateRangeValue\n}\n\nconst dayOffset = (days: number) => {\n  const d = new Date()\n  d.setDate(d.getDate() + days)\n  return toISO(d)\n}\n\n/** Today, Yesterday, Last 7 days, Last 30 days, This month, Last month and This financial year (1 April to 31 March). */\nexport const dateRangePresets: DateRangePreset[] = [\n  { id: 'today', label: 'Today', range: () => ({ from: dayOffset(0), to: dayOffset(0) }) },\n  { id: 'yesterday', label: 'Yesterday', range: () => ({ from: dayOffset(-1), to: dayOffset(-1) }) },\n  { id: 'last-7', label: 'Last 7 days', range: () => ({ from: dayOffset(-6), to: dayOffset(0) }) },\n  { id: 'last-30', label: 'Last 30 days', range: () => ({ from: dayOffset(-29), to: dayOffset(0) }) },\n  {\n    id: 'this-month',\n    label: 'This month',\n    range: () => {\n      const n = new Date()\n      return { from: toISO(new Date(n.getFullYear(), n.getMonth(), 1)), to: toISO(new Date(n.getFullYear(), n.getMonth() + 1, 0)) }\n    },\n  },\n  {\n    id: 'last-month',\n    label: 'Last month',\n    range: () => {\n      const n = new Date()\n      return { from: toISO(new Date(n.getFullYear(), n.getMonth() - 1, 1)), to: toISO(new Date(n.getFullYear(), n.getMonth(), 0)) }\n    },\n  },\n  {\n    id: 'this-fy',\n    label: 'This financial year',\n    range: () => {\n      const n = new Date()\n      const start = n.getMonth() >= 3 ? n.getFullYear() : n.getFullYear() - 1\n      return { from: toISO(new Date(start, 3, 1)), to: toISO(new Date(start + 1, 2, 31)) }\n    },\n  },\n]\n\nconst optionText = (o: FilterOption) => o.text ?? (typeof o.label === 'string' ? o.label : o.value)\n\n/** True when the value narrows anything: a non-empty option list, a date range with an end, a number bound, a phrase. */\nexport function isFilterActive(def: Pick<FilterDef, 'type'>, value: FilterValue | undefined): boolean {\n  if (value === undefined || value === null) return false\n  switch (def.type) {\n    case 'select':\n      return typeof value === 'string' && value !== ''\n    case 'multi':\n      return Array.isArray(value) && value.length > 0\n    case 'date-range': {\n      const v = value as DateRangeValue\n      return Boolean(v.from || v.to)\n    }\n    case 'number-range': {\n      const v = value as NumberRangeValue\n      return v.min !== undefined || v.max !== undefined\n    }\n    case 'text':\n      return Boolean((value as TextFilterValue).text?.trim())\n  }\n}\n\n/** The values a row offers to a select or multi filter: strings, numbers and booleans as text, arrays flattened, blanks dropped. */\nfunction candidateKeys(c: unknown): string[] {\n  if (c === null || c === undefined || c === '') return []\n  if (Array.isArray(c)) return c.flatMap(candidateKeys)\n  return [String(c)]\n}\n\nfunction candidateDay(c: unknown): string | undefined {\n  if (c instanceof Date) return Number.isNaN(c.getTime()) ? undefined : toISO(c)\n  return typeof c === 'string' && /^\\d{4}-\\d{2}-\\d{2}/.test(c) ? c.slice(0, 10) : undefined\n}\n\nfunction candidateNumber(c: unknown): number | undefined {\n  if (typeof c === 'number') return Number.isNaN(c) ? undefined : c\n  if (typeof c === 'string' && c.trim() !== '') {\n    const n = Number(c)\n    return Number.isNaN(n) ? undefined : n\n  }\n  return undefined\n}\n\ntype Test = (candidate: unknown) => boolean\n\n/** The test for one filter, built once so the per-row work is only the comparison. `null` when the filter is empty. */\nfunction compile(type: FilterType, value: FilterValue | undefined): Test | null {\n  if (!isFilterActive({ type }, value)) return null\n  switch (type) {\n    case 'select': {\n      const want = value as string\n      return (c) => candidateKeys(c).includes(want)\n    }\n    case 'multi': {\n      const want = new Set(value as string[])\n      return (c) => candidateKeys(c).some((k) => want.has(k))\n    }\n    case 'date-range': {\n      const { from, to } = value as DateRangeValue\n      return (c) => {\n        const d = candidateDay(c)\n        return d !== undefined && (!from || d >= from) && (!to || d <= to)\n      }\n    }\n    case 'number-range': {\n      const { min, max } = value as NumberRangeValue\n      return (c) => {\n        const n = candidateNumber(c)\n        return n !== undefined && (min === undefined || n >= min) && (max === undefined || n <= max)\n      }\n    }\n    case 'text': {\n      const { op, text } = value as TextFilterValue\n      const want = text.trim().toLowerCase()\n      return (c) => {\n        const have = (Array.isArray(c) ? c.join(' ') : String(c ?? '')).toLowerCase()\n        return op === 'equals' ? have.trim() === want : have.includes(want)\n      }\n    }\n  }\n}\n\n/**\n * Does one row value pass one filter? `candidate` is what the row holds for this filter (a string, number, ISO date or array of strings).\n * An empty filter lets everything through.\n */\nexport function matchesFilter(def: Pick<FilterDef, 'type'>, value: FilterValue | undefined, candidate: unknown): boolean {\n  const test = compile(def.type, value)\n  return test ? test(candidate) : true\n}\n\n/** Reads the value a filter tests from a row. The default reads `row[key]`. */\nexport type FilterAccessor<T> = (row: T, key: string) => unknown\n\nconst readKey = (row: unknown, key: string) => (row as Record<string, unknown>)[key]\n\n/** Rows per option value, for each select / multi filter: `counts[key][optionValue]`. */\nexport type FacetCounts = Record<string, Record<string, number>>\n\nexport interface FilterEvaluation {\n  /** positions in `rows` of the rows that pass every active filter, in the original order */\n  indices: number[]\n  /** only with `withCounts` */\n  counts: FacetCounts\n}\n\n/**\n * One pass over the rows: which ones pass every active filter and, with `withCounts`, how many rows each option of each select / multi filter\n * would show given the *other* filters (the filter's own choice is ignored, so picking \"Approved\" does not zero out \"Pending\").\n * `DataTable` uses this; call it yourself to filter long lists without copying the rows.\n */\nexport function evaluateFilters<T>(rows: readonly T[], defs: readonly FilterDef[], state: FilterState, accessor: FilterAccessor<T> = readKey, withCounts = false): FilterEvaluation {\n  const n = rows.length\n  const tests: { def: FilterDef; test: Test; failed: Uint8Array | null }[] = []\n  for (const def of defs) {\n    const test = compile(def.type, state[def.key])\n    if (test) tests.push({ def, test, failed: withCounts ? new Uint8Array(n) : null })\n  }\n\n  const misses = new Uint16Array(n)\n  for (const { def, test, failed } of tests) {\n    for (let i = 0; i < n; i++) {\n      if (test(accessor(rows[i], def.key))) continue\n      misses[i]++\n      if (failed) failed[i] = 1\n    }\n  }\n\n  const indices: number[] = []\n  for (let i = 0; i < n; i++) if (misses[i] === 0) indices.push(i)\n\n  const counts: FacetCounts = {}\n  if (withCounts) {\n    for (const def of defs) {\n      if (def.type !== 'select' && def.type !== 'multi') continue\n      const own = tests.find((t) => t.def === def)?.failed ?? null\n      const tally: Record<string, number> = Object.create(null)\n      for (let i = 0; i < n; i++) {\n        if (misses[i] - (own ? own[i] : 0) !== 0) continue\n        const keys = candidateKeys(accessor(rows[i], def.key))\n        for (let k = 0; k < keys.length; k++) {\n          if (k > 0 && keys.indexOf(keys[k]) < k) continue\n          tally[keys[k]] = (tally[keys[k]] ?? 0) + 1\n        }\n      }\n      counts[def.key] = tally\n    }\n  }\n  return { indices, counts }\n}\n\n/** The rows that pass every active filter. Returns `rows` itself when no filter is active. */\nexport function applyFilters<T>(rows: T[], defs: readonly FilterDef[], state: FilterState, accessor: FilterAccessor<T> = readKey): T[] {\n  if (!defs.some((d) => isFilterActive(d, state[d.key]))) return rows\n  return evaluateFilters(rows, defs, state, accessor).indices.map((i) => rows[i])\n}\n\n/** A short text for a chip or a summary: \"Approved, Pending\", \"Last 7 days\", \"₹1 L to ₹5 L\", `contains \"master\"`. Empty for an inactive filter. */\nexport function describeFilter(def: FilterDef, value: FilterValue | undefined): string {\n  if (!isFilterActive(def, value)) return ''\n  const labelOf = (v: string) => {\n    const o = def.options?.find((x) => x.value === v)\n    return o ? optionText(o) : v\n  }\n  switch (def.type) {\n    case 'select':\n      return labelOf(value as string)\n    case 'multi': {\n      const chosen = value as string[]\n      const order = def.options ? chosen.slice().sort((a, b) => def.options!.findIndex((o) => o.value === a) - def.options!.findIndex((o) => o.value === b)) : chosen\n      const picked = order.map(labelOf)\n      return picked.length > 2 ? `${picked.slice(0, 2).join(', ')} +${picked.length - 2}` : picked.join(', ')\n    }\n    case 'date-range': {\n      const v = value as DateRangeValue\n      const preset = matchPreset(v, def.presets ?? dateRangePresets)\n      if (preset) return preset.label\n      if (v.from && v.to) return v.from === v.to ? fmtDate(v.from) : `${fmtDate(v.from)} to ${fmtDate(v.to)}`\n      return v.from ? `From ${fmtDate(v.from)}` : `Until ${fmtDate(v.to)}`\n    }\n    case 'number-range': {\n      const v = value as NumberRangeValue\n      const show = (x: number) => (def.currency ? rupeeShort(x) : num(x))\n      if (v.min !== undefined && v.max !== undefined) return `${show(v.min)} to ${show(v.max)}`\n      return v.min !== undefined ? `At least ${show(v.min)}` : `At most ${show(v.max as number)}`\n    }\n    case 'text': {\n      const v = value as TextFilterValue\n      return `${v.op === 'equals' ? 'equals' : 'contains'} “${v.text.trim()}”`\n    }\n  }\n}\n\nfunction matchPreset(value: DateRangeValue, presets: DateRangePreset[]) {\n  if (!value.from && !value.to) return undefined\n  return presets.find((p) => {\n    const r = p.range()\n    return r.from === value.from && r.to === value.to\n  })\n}\n\n/** `inrShort` without the noise of its fixed two decimals: \"₹5 L\" and \"₹4.5 L\" rather than \"₹5.00 L\" and \"₹4.50 L\". */\nconst rupeeShort = (n: number) =>\n  inrShort(n)\n    .replace(/(\\.\\d*?)0+(?=\\s|$)/, '$1')\n    .replace(/\\.(?=\\s|$)/, '')\n\nconst defaultIcon: Record<FilterType, ReactNode> = {\n  select: <ListFilter />,\n  multi: <ListChecks />,\n  'date-range': <CalendarDays />,\n  'number-range': <Hash />,\n  text: <TextCursorInput />,\n}\n\n/* ------------------------------------------------------------------------------------------------------------------\n   Editors: the panel that opens from a chip, an Add filter item or a standalone filter button\n   ------------------------------------------------------------------------------------------------------------------ */\n\n/** Substring match on the option text, so \"pend\" finds \"Pending\" and nothing else. */\nconst matchKeywords = (_value: string, search: string, keywords?: string[]) => ((keywords ?? []).join(' ').toLowerCase().includes(search.trim().toLowerCase()) ? 1 : 0)\n\nfunction PanelFooter({ note, onClear, disabled }: { note?: ReactNode; onClear: () => void; disabled: boolean }) {\n  return (\n    <div data-slot=\"filter-panel-footer\" className=\"mt-1 flex items-center justify-between gap-2 border-t border-border px-2 pt-1.5 pb-0.5\">\n      <span className=\"text-xs text-text-muted tnum\">{note}</span>\n      <Button type=\"button\" variant=\"ghost\" size=\"sm\" disabled={disabled} onClick={onClear}>\n        Clear\n      </Button>\n    </div>\n  )\n}\n\nfunction OptionsPanel({ label, options, value, multiple, onChange, onDone }: {\n  label: string\n  options: FilterOption[]\n  value: string[]\n  multiple: boolean\n  onChange: (next: string[]) => void\n  onDone: () => void\n}) {\n  const root = useRef<HTMLDivElement>(null)\n  const pick = (v: string) => {\n    if (multiple) return onChange(value.includes(v) ? value.filter((x) => x !== v) : [...value, v])\n    onChange(value[0] === v ? [] : [v])\n    onDone()\n  }\n  // Clear disables itself once nothing is left to clear, so focus goes back to the search box instead of being lost with it\n  const clear = () => {\n    onChange([])\n    root.current?.querySelector('input')?.focus()\n  }\n  return (\n    <div ref={root} data-slot=\"filter-options\">\n      <Command label={`${label} options`} filter={matchKeywords} className=\"bg-transparent\">\n        <CommandInput variant=\"menu\" placeholder={`Search ${label.toLowerCase()}…`} aria-label={`Search ${label}`} />\n        <CommandList className=\"max-h-[280px]\">\n          <CommandEmpty>No options found</CommandEmpty>\n          {options.map((o) => {\n            const selected = value.includes(o.value)\n            return (\n              <CommandItem key={o.value} value={o.value} keywords={[optionText(o)]} data-checked={!multiple && selected ? 'true' : undefined} onSelect={() => pick(o.value)}>\n                {multiple && (\n                  <span aria-hidden data-state={selected ? 'checked' : 'unchecked'} className=\"ds-check pointer-events-none inline-flex size-4 shrink-0 items-center justify-center\">\n                    <span className=\"ds-check-box\">{selected && <Check className=\"text-current\" strokeWidth={3.5} />}</span>\n                  </span>\n                )}\n                {o.icon && <span className=\"inline-flex shrink-0 text-icon-muted [&>svg]:size-4\">{o.icon}</span>}\n                <span className=\"min-w-0 flex-1 truncate\">{o.label}</span>\n                {o.count !== undefined && <span className=\"shrink-0 text-xs font-normal text-text-muted tnum\">{num(o.count)}</span>}\n                {!multiple && <span className=\"ds-option-check\">{selected && <Check className=\"size-4\" />}</span>}\n              </CommandItem>\n            )\n          })}\n        </CommandList>\n      </Command>\n      <PanelFooter note={multiple && value.length > 0 ? `${num(value.length)} selected` : undefined} disabled={value.length === 0} onClear={clear} />\n    </div>\n  )\n}\n\nfunction DateRangePanel({ label, value, presets, onChange, onDone }: {\n  label: string\n  value: DateRangeValue\n  presets: DateRangePreset[]\n  onChange: (next: DateRangeValue) => void\n  onDone: () => void\n}) {\n  const active = matchPreset(value, presets)\n  const custom = Boolean(value.from || value.to) && !active\n  // two views in one panel: the quick ranges, and an inline calendar for a custom one. (A date field here would open a second popover on top of this one.)\n  const [view, setView] = useState<'presets' | 'custom'>('presets')\n  const [draft, setDraft] = useState<DateRangeValue>(value)\n  useEffect(() => setDraft(value), [value.from, value.to]) // eslint-disable-line react-hooks/exhaustive-deps\n  const root = useRef<HTMLDivElement>(null)\n  const switched = useRef(false)\n  // moving between the views replaces the focused element, so focus goes to the first control of the new view\n  useEffect(() => {\n    if (!switched.current) return\n    root.current?.querySelector<HTMLElement>(view === 'custom' ? 'button' : '[data-custom-range]')?.focus()\n  }, [view])\n  const go = (next: 'presets' | 'custom') => {\n    switched.current = true\n    setView(next)\n  }\n\n  if (view === 'custom') {\n    const from = fromISO(draft.from)\n    const to = fromISO(draft.to)\n    return (\n      <div ref={root} data-slot=\"filter-date-range\" data-view=\"custom\">\n        <div className=\"flex items-center gap-1 px-1 pt-1\">\n          <Button type=\"button\" variant=\"ghost\" size=\"icon-sm\" aria-label=\"Back to quick ranges\" onClick={() => go('presets')}>\n            <ChevronLeft />\n          </Button>\n          <span className=\"text-sm font-semibold text-foreground\">Custom range</span>\n        </div>\n        <Calendar\n          mode=\"range\"\n          numberOfMonths={1}\n          selected={from ? { from, to } : undefined}\n          defaultMonth={from}\n          aria-label={`${label} custom range`}\n          onSelect={(r) => {\n            const next = { from: r?.from ? toISO(r.from) : undefined, to: r?.to ? toISO(r.to) : undefined }\n            setDraft(next)\n            // the second, different day completes the range; a one-day range is confirmed with Apply, so the data behind the panel never filters on half a choice\n            if (next.from && next.to && next.to !== next.from) {\n              onChange(next)\n              onDone()\n            }\n          }}\n        />\n        <div className=\"flex items-center justify-between gap-2 border-t border-border px-2 pt-1.5 pb-0.5\">\n          <span className=\"min-w-0 truncate text-xs text-text-muted tnum\">{draft.from ? describeFilter({ key: '', label, type: 'date-range', presets: [] }, { from: draft.from, to: draft.to ?? draft.from }) : 'Pick the first day'}</span>\n          <Button\n            type=\"button\"\n            size=\"sm\"\n            disabled={!draft.from}\n            onClick={() => {\n              onChange({ from: draft.from, to: draft.to ?? draft.from })\n              onDone()\n            }}\n          >\n            Apply\n          </Button>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div ref={root} data-slot=\"filter-date-range\">\n      <div role=\"group\" aria-label={`${label} quick ranges`} className=\"flex flex-col\">\n        {presets.map((p) => (\n          <button\n            key={p.id}\n            type=\"button\"\n            className=\"ds-option\"\n            data-checked={active?.id === p.id ? 'true' : undefined}\n            aria-pressed={active?.id === p.id}\n            onClick={() => {\n              onChange(p.range())\n              onDone()\n            }}\n          >\n            <span className=\"min-w-0 flex-1 truncate text-left\">{p.label}</span>\n            <span className=\"ds-option-check\">{active?.id === p.id && <Check className=\"size-4\" />}</span>\n          </button>\n        ))}\n      </div>\n      <div className=\"mt-1 border-t border-border pt-1\">\n        <button type=\"button\" data-custom-range className=\"ds-option\" data-checked={custom ? 'true' : undefined} aria-label={`Custom range${custom ? `, ${describeFilter({ key: '', label, type: 'date-range', presets: [] }, value)}` : ''}`} onClick={() => go('custom')}>\n          <CalendarRange aria-hidden className=\"size-4 text-icon-muted\" />\n          <span className=\"min-w-0 flex-1 truncate text-left\">Custom range</span>\n          {custom && <span className=\"min-w-0 shrink truncate text-xs font-normal text-primary-text tnum\">{describeFilter({ key: '', label, type: 'date-range', presets: [] }, value)}</span>}\n          <ChevronRight aria-hidden className=\"size-4 text-icon-muted\" />\n        </button>\n      </div>\n    </div>\n  )\n}\n\nconst parseNumber = (s: string) => (s.trim() === '' ? undefined : Number(s))\n\nfunction NumberRangePanel({ label, value, currency, onChange, onDone }: {\n  label: string\n  value: NumberRangeValue\n  currency?: boolean\n  onChange: (next: NumberRangeValue) => void\n  onDone: () => void\n}) {\n  const [min, setMin] = useState(value.min === undefined ? '' : String(value.min))\n  const [max, setMax] = useState(value.max === undefined ? '' : String(value.max))\n  const lo = parseNumber(min)\n  const hi = parseNumber(max)\n  const bad = Number.isNaN(lo) || Number.isNaN(hi)\n  const reversed = !bad && lo !== undefined && hi !== undefined && lo > hi\n  const empty = lo === undefined && hi === undefined\n  const apply = () => {\n    if (bad || reversed) return\n    onChange({ ...(lo !== undefined && { min: lo }), ...(hi !== undefined && { max: hi }) })\n    onDone()\n  }\n  const form = useRef<HTMLFormElement>(null)\n  const clear = () => {\n    setMin('')\n    setMax('')\n    onChange({})\n    form.current?.querySelector('input')?.focus()\n  }\n  const prefix = currency ? <span aria-hidden className=\"text-text-muted\">₹</span> : undefined\n  const keys = (e: React.KeyboardEvent) => {\n    if (e.key === 'Enter') {\n      e.preventDefault()\n      apply()\n    }\n  }\n  const idPrefix = useId()\n  return (\n    <form ref={form} data-slot=\"filter-number-range\" className=\"space-y-2\" onSubmit={(e) => e.preventDefault()}>\n      <div className=\"grid grid-cols-2 gap-2\">\n        <div className=\"space-y-1\">\n          <label htmlFor={`${idPrefix}-min`} className=\"text-xs font-medium text-text-subtle\">Min</label>\n          <Input id={`${idPrefix}-min`} type=\"number\" inputMode=\"decimal\" size=\"sm\" startIcon={prefix} value={min} onChange={(e) => setMin(e.target.value)} onKeyDown={keys} placeholder=\"No min\" aria-invalid={reversed || undefined} aria-describedby={reversed ? `${idPrefix}-error` : undefined} autoFocus />\n        </div>\n        <div className=\"space-y-1\">\n          <label htmlFor={`${idPrefix}-max`} className=\"text-xs font-medium text-text-subtle\">Max</label>\n          <Input id={`${idPrefix}-max`} type=\"number\" inputMode=\"decimal\" size=\"sm\" startIcon={prefix} value={max} onChange={(e) => setMax(e.target.value)} onKeyDown={keys} placeholder=\"No max\" aria-invalid={reversed || undefined} aria-describedby={reversed ? `${idPrefix}-error` : undefined} />\n        </div>\n      </div>\n      {reversed ? (\n        <p id={`${idPrefix}-error`} role=\"alert\" className=\"text-xs text-negative\">Min cannot be more than max.</p>\n      ) : (\n        currency &&\n        !empty &&\n        !bad && (\n          <p className=\"text-xs text-text-muted tnum\">\n            {lo !== undefined && hi !== undefined ? `${inr(lo)} to ${inr(hi)}` : lo !== undefined ? `At least ${inr(lo)}` : `At most ${inr(hi)}`}\n          </p>\n        )\n      )}\n      <div className=\"flex items-center justify-end gap-2 border-t border-border pt-2\">\n        <Button type=\"button\" variant=\"ghost\" size=\"sm\" disabled={empty && value.min === undefined && value.max === undefined} onClick={clear}>\n          Clear\n        </Button>\n        <Button type=\"button\" size=\"sm\" disabled={bad || reversed || empty} onClick={apply}>\n          Apply\n        </Button>\n      </div>\n    </form>\n  )\n}\n\nfunction TextPanel({ label, value, placeholder, onChange, onDone }: {\n  label: string\n  value: TextFilterValue\n  placeholder?: string\n  onChange: (next: TextFilterValue | undefined) => void\n  onDone: () => void\n}) {\n  const [op, setOp] = useState<TextFilterOperator>(value.op)\n  const [text, setText] = useState(value.text)\n  const form = useRef<HTMLFormElement>(null)\n  const apply = () => {\n    if (!text.trim()) return\n    onChange({ op, text: text.trim() })\n    onDone()\n  }\n  const idPrefix = useId()\n  return (\n    <form ref={form} data-slot=\"filter-text\" className=\"space-y-2\" onSubmit={(e) => { e.preventDefault(); apply() }}>\n      <ToggleGroup type=\"single\" value={op} onValueChange={(v) => v && setOp(v as TextFilterOperator)} aria-label={`${label} match`} className=\"w-full\">\n        <ToggleGroupItem value=\"contains\" className=\"flex-1\">Contains</ToggleGroupItem>\n        <ToggleGroupItem value=\"equals\" className=\"flex-1\">Equals</ToggleGroupItem>\n      </ToggleGroup>\n      <label htmlFor={idPrefix} className=\"sr-only\">{label}</label>\n      <Input id={idPrefix} size=\"sm\" value={text} onChange={(e) => setText(e.target.value)} placeholder={placeholder ?? `${label}…`} autoFocus />\n      <div className=\"flex items-center justify-end gap-2 border-t border-border pt-2\">\n        <Button type=\"button\" variant=\"ghost\" size=\"sm\" disabled={!text && !value.text} onClick={() => { setText(''); onChange(undefined); form.current?.querySelector('input')?.focus() }}>\n          Clear\n        </Button>\n        <Button type=\"submit\" size=\"sm\" disabled={!text.trim()}>\n          Apply\n        </Button>\n      </div>\n    </form>\n  )\n}\n\nconst panelClass: Record<FilterType, string> = {\n  select: 'w-60 min-w-[220px] p-1',\n  multi: 'w-60 min-w-[220px] p-1',\n  'date-range': 'w-80 p-1',\n  'number-range': 'w-72 p-3',\n  text: 'w-72 p-3',\n}\n\n/** The editor of one filter. `onChange(undefined)` means \"no longer filtered\". */\nfunction FilterEditor({ def, value, onChange, onDone }: {\n  def: FilterDef\n  value: FilterValue | undefined\n  onChange: (next: FilterValue | undefined) => void\n  onDone: () => void\n}) {\n  switch (def.type) {\n    case 'multi':\n      return <OptionsPanel label={def.label} options={def.options ?? []} value={(value as string[] | undefined) ?? []} multiple onChange={(n) => onChange(n.length ? n : undefined)} onDone={onDone} />\n    case 'select':\n      return <OptionsPanel label={def.label} options={def.options ?? []} value={value ? [value as string] : []} multiple={false} onChange={(n) => onChange(n[0])} onDone={onDone} />\n    case 'date-range':\n      return <DateRangePanel label={def.label} value={(value as DateRangeValue | undefined) ?? {}} presets={def.presets ?? dateRangePresets} onChange={(n) => onChange(isFilterActive(def, n) ? n : undefined)} onDone={onDone} />\n    case 'number-range':\n      return <NumberRangePanel label={def.label} value={(value as NumberRangeValue | undefined) ?? {}} currency={def.currency} onChange={(n) => onChange(isFilterActive(def, n) ? n : undefined)} onDone={onDone} />\n    case 'text':\n      return <TextPanel label={def.label} value={(value as TextFilterValue | undefined) ?? { op: 'contains', text: '' }} placeholder={def.placeholder} onChange={onChange} onDone={onDone} />\n  }\n}\n\n/* ------------------------------------------------------------------------------------------------------------------\n   Standalone filters: a button that opens one editor\n   ------------------------------------------------------------------------------------------------------------------ */\n\ninterface FilterButtonProps extends Omit<ComponentProps<'button'>, 'color'> {\n  label: string\n  icon?: ReactNode\n  /** text after the divider; empty while nothing is filtered */\n  summary: string\n  /** the filter narrows something: the tinted look (default: there is a summary) */\n  active?: boolean\n  /** leaves room at the right for the remove button of a `FilterGroup` */\n  removable?: boolean\n}\n\n/**\n * The button of one filter. Idle it is the outline Button next to it (Add filter); active it takes the primary tint, edge and text, the one look that both a\n * standalone filter and a FilterBar chip have. It is always a Button, so going from idle to active changes colours, not elements, and focus stays where it was.\n */\nfunction FilterButton({ label, icon, summary, active = Boolean(summary), removable, className, ...props }: FilterButtonProps) {\n  return (\n    <Button\n      type=\"button\"\n      variant={active ? 'secondary' : 'outline'}\n      size=\"sm\"\n      data-active={active || undefined}\n      className={cn(\n        'max-w-full min-w-0',\n        active && '[--btn-bg:var(--primary-faded)] [--btn-bg-h:var(--primary-faded-highlighted)] [--btn-bg-f:var(--primary-faded-highlighted)]',\n        removable && 'pr-[calc(var(--ctl-h-sm)-2px)]',\n        className,\n      )}\n      {...props}\n    >\n      {icon}\n      <span className=\"shrink-0\">{label}</span>\n      {summary && (\n        <>\n          <span aria-hidden className=\"h-3.5 w-px shrink-0 bg-current opacity-30\" />\n          <span className=\"min-w-0 truncate font-semibold\">{summary}</span>\n        </>\n      )}\n    </Button>\n  )\n}\n\n/** Wraps a `FilterButton` with the remove button of an active filter. The remove button is a sibling of the trigger, not inside it (a button in a button is invalid). */\nfunction FilterGroup({ label, onRemove, className, children, ...props }: Omit<ComponentProps<'div'>, 'children'> & { label: string; onRemove?: () => void; children: ReactNode }) {\n  return (\n    <div\n      role={onRemove ? 'group' : undefined}\n      aria-label={onRemove ? `${label} filter` : undefined}\n      className={cn('relative inline-flex max-w-full min-w-0', className)}\n      {...props}\n    >\n      {children}\n      {onRemove && (\n        <button\n          type=\"button\"\n          aria-label={`Remove ${label} filter`}\n          onClick={onRemove}\n          className={cn(\n            'absolute top-1/2 right-0.5 inline-flex size-[calc(var(--ctl-h-sm)-4px)] -translate-y-1/2 items-center justify-center rounded-sm text-primary-text hover:bg-primary-faded-highlighted ds-focus focus-visible:outline-offset-0 after:absolute after:-inset-0.5 after:content-[\"\"]',\n          )}\n        >\n          <X aria-hidden className=\"size-3.5\" />\n        </button>\n      )}\n    </div>\n  )\n}\n\n/** Props every standalone filter shares. */\nexport interface FilterTriggerProps {\n  /** name on the button and in the editor */\n  label: string\n  /** icon before the label */\n  icon?: ReactNode\n  /** the button cannot be opened */\n  disabled?: boolean\n  /** why the filter is disabled: shown as a tooltip when the button is hovered or focused (the button itself becomes reachable by keyboard) */\n  disabledReason?: ReactNode\n  /** extra classes for the button */\n  className?: string\n  /** which edge of the button the panel lines up with (default `start`) */\n  align?: 'start' | 'center' | 'end'\n}\n\nfunction StandaloneFilter({ def, value, onChange, icon, disabled, disabledReason, className, align = 'start' }: Omit<FilterTriggerProps, 'label'> & {\n  def: FilterDef\n  value: FilterValue | undefined\n  onChange: (next: FilterValue | undefined) => void\n}) {\n  const [open, setOpen] = useState(false)\n  const group = useRef<HTMLDivElement>(null)\n  const summary = describeFilter(def, value)\n  const explained = Boolean(disabled && disabledReason)\n  const trigger = (\n    <PopoverAnchor asChild>\n      <FilterGroup\n        ref={group}\n        label={def.label}\n        onRemove={\n          summary && !disabled\n            ? () => {\n                onChange(undefined)\n                // the remove button goes with the value: focus moves to the filter's own button\n                group.current?.querySelector('button')?.focus()\n              }\n            : undefined\n        }\n        tabIndex