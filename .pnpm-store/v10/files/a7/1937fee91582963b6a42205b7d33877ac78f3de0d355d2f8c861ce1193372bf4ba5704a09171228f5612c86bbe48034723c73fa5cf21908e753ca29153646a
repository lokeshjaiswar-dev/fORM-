/* atoms: component-level CSS for the atoms group of the dMACQ design system (keyframes, state matrix, tokens). Owned by the atoms fork.
   Figma: Button & Icon 564:1367, Chip 2762:1323, Badge 2532:21380, Avatar 1438:1365, Tooltip 893:5924, Toggle 913:62, Loader 2118:14843,
   Skeleton 3570:7027, Progress 3594:10198. */

:root,
.ov-theme-light {
  /* soft halos (hover on a slider thumb, the static `ringed` Button): decorative only. Keyboard focus is --focus-ring (index.css), drawn by .ds-focus below. */
  --ds-ring-soft: #305eff2e;
  --ds-ring-strong: #305eff52;
  /* primary button states (interactive.background.primary.highlighted, text.primary.disabled) */
  --ds-primary-hover: #2243b6;
  --ds-primary-ghost-hover: #2243b6;
  --ds-primary-ghost-active: #2243b6;
  /* neutral (interactive.background.neutral.*) */
  --ds-neutral-default: #2f4256;
  --ds-neutral-hover: #243547;
  --ds-neutral-faded: #6c849d17;
  --ds-neutral-hover-fg: #2f4256;
  /* static white (whiteOnPrimary) */
  --ds-white-hover: #ffffffcc;
  --ds-white-faded: #ffffff66;
  --ds-white-text-disabled: #ffffff80;
  /* hover / pressed wash of a white button on the primary band: a black wash darkens the blue, so white text keeps >= 4.5:1 (a white wash lifts it to 3.9) */
  --ds-white-wash: #00000024;
  --ds-white-wash-a: #00000038;
  /* outline button edges for the tinted tones (>= 3:1 on white, so they sit beside the neutral --border-control edge) */
  --ds-outline-primary-bd: #6384ff;
  --ds-outline-negative-bd: #d9696a;
  --ds-outline-positive-bd: #3c9d7e;
  --ds-outline-notice-bd: #e9690c;
  --ds-outline-info-bd: #3d92cc;
  /* tooltip, switch */
  --ds-tooltip-bg: #2f4256;
  --ds-tooltip-fg: #ffffff;
  --ds-tooltip-shadow: #19283917;
  /* skeleton shimmer */
  --ds-shimmer-a: #6c849d17; /* Figma Skeleton initial state: interactive.border.gray.faded */
  --ds-shimmer-b: #6c849d2e; /* final state: interactive.border.gray.default */
  /* Progress track (the unfilled part): stronger than the skeleton fade so the bar reads as a bar */
  --ds-track: #6c849d33;
  /* primary indicator colour for Loader and Progress: the brand blue, lifted to the text blue on dark surfaces (3.5:1 -> 7:1) */
  --ds-indicator-primary: var(--primary-default);
  /* avatar initials palette (peach is the default shown in Figma) */
  --ds-av-orange-bg: #ffdcb9; --ds-av-orange-fg: #000000; /* Figma Initials/color/light_peach with static black text */
  --ds-av-blue-bg: #d8e4fd;   --ds-av-blue-fg: #1b3591;
  --ds-av-green-bg: #d3eee3;  --ds-av-green-fg: #0d4532;
  --ds-av-red-bg: #fbdcdc;    --ds-av-red-fg: #702121;
  --ds-av-info-bg: #cdeafb;   --ds-av-info-fg: #004a78;
  --ds-av-neutral-bg: #e3eaf3; --ds-av-neutral-fg: #243547;
}

/* derived tokens: declared on every theme root so a nested .dark / .ov-theme-light panel re-resolves them against its own theme */
:root,
.dark,
.ov-theme-light,
.ov-theme-dark {
  --ds-on-primary-disabled: var(--disabled-fg); /* alias kept for old consumers: disabled text is --disabled-fg in every variant */
  --ds-neutral-disabled-bg: var(--disabled-bg);
  /* solid feedback colours (interactive.background.<tone>.default), used by solid buttons and intense badges: white text >= 4.5:1, same in both themes */
  --ds-negative-solid: var(--negative-solid);
  --ds-negative-hover: var(--negative-solid-hover);
  --ds-positive-solid: var(--positive-solid);
  --ds-positive-hover: var(--positive-solid-hover);
  --ds-notice-solid: var(--notice-solid);
  --ds-notice-hover: var(--notice-solid-hover);
  --ds-info-solid: var(--information-solid);
  --ds-info-hover: var(--information-solid-hover);
  /* an unfilled switch track is a control boundary: >= 3:1 */
  --ds-switch-off: var(--border-control);
  --ds-switch-off-disabled: var(--disabled-border);
}

.dark,
.ov-theme-dark {
  --ds-ring-soft: #75a3ff40;
  --ds-ring-strong: #75a3ff66;
  --ds-outline-primary-bd: #4f76ff;
  --ds-outline-negative-bd: #d44a4a;
  --ds-outline-positive-bd: #1f936c;
  --ds-outline-notice-bd: #d9771f;
  --ds-outline-info-bd: #0087da;
  --ds-primary-hover: #2950da;
  --ds-primary-ghost-hover: #b4cdfd;
  --ds-primary-ghost-active: #75a3ff;
  --ds-neutral-default: #4b6580;
  --ds-neutral-hover: #58728d;
  --ds-neutral-faded: #6c849d1f;
  --ds-neutral-hover-fg: #f8fafc;
  --ds-tooltip-bg: #58728d;
  --ds-tooltip-shadow: #00000052;
  --ds-shimmer-a: #6c849d24;
  --ds-shimmer-b: #6c849d3d;
  --ds-track: #6c849d4d;
  --ds-indicator-primary: var(--primary-text);
  --ds-av-neutral-bg: #2f4256; --ds-av-neutral-fg: #e3eaf3;
}

/* =====================================================================================================================
   Chip (Figma 2762:1323). Type Intense = solid fill (white text, >= 4.5:1); Outline = hairline border. Per colour:
   --cc-solid / --cc-solid-hover (intense fill, the same solids as buttons and badges in both themes),
   --cc-text / --cc-border (outline), --cc-faded / --cc-faded-hl (outline hover / pressed).
   Disabled is one recipe for every colour (--disabled-bg / --disabled-fg / --disabled-border), see the rules below the matrix.
   ===================================================================================================================== */
.ds-chip[data-color='primary'] { --cc-solid: #2950da; --cc-solid-hover: #2243b6; --cc-text: #2950da; --cc-border: var(--ds-outline-primary-bd); --cc-faded: #305eff17; --cc-faded-hl: #305eff3d; }
.ds-chip[data-color='neutral'] { --cc-solid: #2f4256; --cc-solid-hover: #243547; --cc-text: #0c1927; --cc-border: var(--border-control); --cc-faded: #6c849d17; --cc-faded-hl: #6c849d52; }
.ds-chip[data-color='positive'] { --cc-solid: var(--ds-positive-solid); --cc-solid-hover: var(--ds-positive-hover); --cc-text: var(--positive); --cc-border: var(--ds-outline-positive-bd); --cc-faded: #146e4f17; --cc-faded-hl: #146e4f1f; }
.ds-chip[data-color='negative'] { --cc-solid: var(--ds-negative-solid); --cc-solid-hover: var(--ds-negative-hover); --cc-text: var(--negative); --cc-border: var(--ds-outline-negative-bd); --cc-faded: #be3a3a17; --cc-faded-hl: #be3a3a1f; }
.ds-chip[data-color='alert'] { --cc-solid: var(--ds-notice-solid); --cc-solid-hover: var(--ds-notice-hover); --cc-text: var(--notice-text); --cc-border: var(--ds-outline-notice-bd); --cc-faded: #e9690c17; --cc-faded-hl: #e9690c2e; }
.ds-chip[data-color='info'] { --cc-solid: var(--ds-info-solid); --cc-solid-hover: var(--ds-info-hover); --cc-text: var(--information); --cc-border: var(--ds-outline-info-bd); --cc-faded: #006fb417; --cc-faded-hl: #006fb41f; }

.dark .ds-chip[data-color='primary'] { --cc-solid: #305eff; --cc-solid-hover: #2950da; --cc-text: var(--primary-text); --cc-border: var(--ds-outline-primary-bd); --cc-faded: #305eff2e; --cc-faded-hl: #305eff52; }
.dark .ds-chip[data-color='neutral'] { --cc-solid: #4b6580; --cc-solid-hover: #58728d; --cc-text: #f8fafc; --cc-border: var(--border-control); --cc-faded: #6c849d17; --cc-faded-hl: #6c849d2e; }
.dark .ds-chip[data-color='positive'] { --cc-text: var(--positive); --cc-border: var(--ds-outline-positive-bd); --cc-faded: #167b593d; --cc-faded-hl: #167b5952; }
.dark .ds-chip[data-color='negative'] { --cc-text: var(--negative); --cc-border: var(--ds-outline-negative-bd); --cc-faded: #d44a4a2e; --cc-faded-hl: #d44a4a52; }
.dark .ds-chip[data-color='alert'] { --cc-text: var(--notice-text); --cc-border: var(--ds-outline-notice-bd); --cc-faded: #e9690c2e; --cc-faded-hl: #e9690c52; }
.dark .ds-chip[data-color='info'] { --cc-text: var(--information); --cc-border: var(--ds-outline-info-bd); --cc-faded: #0087da3d; --cc-faded-hl: #0087da52; }

.ds-chip { border: 1px solid transparent; }
.ds-chip[data-appearance='intense'] { background: var(--cc-solid); color: #fff; }
.ds-chip[data-appearance='intense']:is(:hover, [data-force='hover'], :active, [data-force='active'], [data-selected='true']):not(:disabled, [aria-disabled='true']) { background: var(--cc-solid-hover); }
/* a selected filter chip already wears the hover fill, so hovering or pressing it goes one step darker: the pointer still gets an answer */
.ds-chip[data-selected='true'][data-appearance='intense']:is(:hover, [data-force='hover'], :active, [data-force='active']):not(:disabled, [aria-disabled='true']) { background: color-mix(in srgb, var(--cc-solid-hover), #000 16%); }
.ds-chip[data-appearance='outline'] { background: transparent; color: var(--cc-text); border-color: var(--cc-border); }
.ds-chip[data-appearance='outline']:is(:hover, [data-force='hover']):not(:disabled, [aria-disabled='true']) { background: var(--cc-faded); }
.ds-chip[data-appearance='outline']:is(:active, [data-force='active'], [data-selected='true']):not(:disabled, [aria-disabled='true']) { background: var(--cc-faded-hl); }
.ds-chip[data-appearance='intense']:is(:disabled, [aria-disabled='true']) { background: var(--disabled-bg); color: var(--disabled-fg); border-color: transparent; }
.ds-chip[data-appearance='outline']:is(:disabled, [aria-disabled='true']) { background: transparent; color: var(--disabled-fg); border-color: var(--disabled-border); }
.ds-chip:is(:disabled, [aria-disabled='true']) { pointer-events: none; }

/* =====================================================================================================================
   Keyframes
   ===================================================================================================================== */
@keyframes ds-dot-pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.75); }
  40% { opacity: 1; transform: scale(1); }
}
@keyframes ds-shimmer {
  from { background-color: var(--ds-shimmer-a); }
  to { background-color: var(--ds-shimmer-b); }
}
@keyframes ds-indeterminate {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}

@layer components {
  /* ===================================================================================================================
     Keyboard focus: ONE recipe for the whole library. A solid 2px outline in --focus-ring (>= 3:1 on every surface, light and dark), offset 2px
     so it never touches the control's own edge. It is an outline, not a box-shadow, so it follows border-radius, never changes layout and survives
     Windows forced-colors mode (where box-shadows are dropped).
       .ds-focus        controls with room around them: buttons, links, chips, icon buttons, switches, thumbs
       .ds-focus-inset  the outline is drawn inside the box: table headers, rows, tabs, sidebar cells, anything clipped by overflow
     .ds-btn, .ds-link and .ds-chip carry the recipe without a class. Never add `outline-none` / `outline-hidden` to an element that carries it
     (in Tailwind 4 those are plain utilities and win over this layer). On a solid coloured fill set `--focus-ring: var(--focus-ring-inverse)`
     on the container (the Toast, intense Alert and Banner, white Buttons do), on the navy sidebar `var(--focus-ring-on-dark)`.
     data-force="focus" shows the state without interaction (the gallery).
     =================================================================================================================== */
  :is(.ds-focus, .ds-focus-inset, .ds-btn, .ds-link, .ds-chip):is(:focus-visible, [data-force='focus']) {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  .ds-focus-inset:is(:focus-visible, [data-force='focus']) {
    outline-offset: calc(var(--focus-ring-width) * -1);
  }
  /* an inline link has no room around it: keep the ring tight so it does not cover the neighbouring words */
  .ds-link:is(:focus-visible, [data-force='focus']) { outline-offset: 1px; }
  /* controls that sit on a solid fill */
  .ds-btn-white, .ds-link-white { --focus-ring: var(--focus-ring-inverse); }

  /* ===================================================================================================================
     Button colour matrix (color x variant x state). The element carries ds-btn, ds-btn-<kind> (solid|outline|ghost|link)
     and ds-btn-<color> (primary|neutral|negative|positive|white). Forced states for the gallery use data-force.
     Variables: --btn-bg / -fg / -bd, suffix -h hover, -a active, -f focus, -d disabled. Anything not set falls back to the
     previous state, so each colour only declares what Figma changes.
     =================================================================================================================== */
  .ds-btn {
    background-color: var(--btn-bg, transparent);
    color: var(--btn-fg, currentColor);
    border-color: var(--btn-bd, transparent);
  }
  .ds-btn:is(:hover, [data-force='hover']) {
    background-color: var(--btn-bg-h, var(--btn-bg, transparent));
    color: var(--btn-fg-h, var(--btn-fg, currentColor));
    border-color: var(--btn-bd-h, var(--btn-bd, transparent));
  }
  .ds-btn:is(:active, [data-force='active']) {
    background-color: var(--btn-bg-a, var(--btn-bg-h, var(--btn-bg, transparent)));
    color: var(--btn-fg-a, var(--btn-fg-h, var(--btn-fg, currentColor)));
    border-color: var(--btn-bd-a, var(--btn-bd-h, var(--btn-bd, transparent)));
  }
  .ds-btn:is(:focus-visible, [data-force='focus']) {
    background-color: var(--btn-bg-f, var(--btn-bg-h, var(--btn-bg, transparent)));
    color: var(--btn-fg-f, var(--btn-fg-h, var(--btn-fg, currentColor)));
    border-color: var(--btn-bd-f, var(--btn-bd-h, var(--btn-bd, transparent)));
  }
  .ds-btn:is(:disabled, [aria-disabled='true'], [data-force='disabled']) {
    background-color: var(--btn-bg-d, transparent);
    color: var(--btn-fg-d, var(--disabled-fg));
    border-color: var(--btn-bd-d, transparent);
    cursor: not-allowed;
  }
  /* loading keeps the normal colours and ignores hover */
  .ds-btn[data-loading='true'] {
    background-color: var(--btn-bg, transparent);
    color: var(--btn-fg, currentColor);
    border-color: var(--btn-bd, transparent);
  }
  /* toggled / pressed (Figma "Selected / toggled") */
  .ds-btn[aria-pressed='true']:not(:disabled) {
    background-color: var(--btn-bg-pressed, var(--btn-bg-h, var(--btn-bg, transparent)));
    color: var(--btn-fg-pressed, var(--btn-fg-h, var(--btn-fg, currentColor)));
    border-color: var(--btn-bd-pressed, var(--btn-bd-h, var(--btn-bd, transparent)));
  }
  /* ---- solid (Figma variant=Primary) */
  .ds-btn-solid { --btn-fg: #ffffff; }
  .ds-btn-solid.ds-btn-primary {
    --btn-bg: var(--primary); --btn-bg-h: var(--ds-primary-hover); --btn-bg-f: var(--primary);
    --btn-bg-d: var(--disabled-bg); --btn-fg-d: var(--disabled-fg);
  }
  .ds-btn-solid.ds-btn-neutral {
    --btn-bg: var(--ds-neutral-default); --btn-bg-h: var(--ds-neutral-hover); --btn-bg-f: var(--ds-neutral-default);
    --btn-bg-d: var(--disabled-bg); --btn-fg-d: var(--disabled-fg);
  }
  .ds-btn-solid.ds-btn-negative {
    --btn-bg: var(--ds-negative-solid); --btn-bg-h: var(--ds-negative-hover); --btn-bg-f: var(--ds-negative-solid);
    --btn-bg-d: var(--disabled-bg); --btn-fg-d: var(--disabled-fg);
  }
  .ds-btn-solid.ds-btn-positive {
    --btn-bg: var(--ds-positive-solid); --btn-bg-h: var(--ds-positive-hover); --btn-bg-f: var(--ds-positive-solid);
    --btn-bg-d: var(--disabled-bg); --btn-fg-d: var(--disabled-fg);
  }
  .ds-btn-solid.ds-btn-white {
    --btn-bg: #ffffff; --btn-fg: #2950da; --btn-bg-h: var(--ds-white-hover); --btn-bg-f: #ffffff;
    --btn-bg-d: var(--ds-white-faded); --btn-fg-d: var(--ds-white-text-disabled);
  }

  /* ---- outline (Figma variant=Secondary) */
  .ds-btn-outline.ds-btn-primary {
    --btn-fg: var(--primary-text); --btn-bd: var(--ds-outline-primary-bd);
    --btn-bg-h: var(--primary-faded); --btn-bg-f: var(--primary-faded);
    --btn-fg-d: var(--disabled-fg); --btn-bd-d: var(--disabled-border);
  }
  .ds-btn-outline.ds-btn-neutral {
    /* the outline edge is the same colour as a field edge (--border-control, >= 3:1), so a Select and a Button side by side match */
    --btn-fg: var(--text-subtle); --btn-bd: var(--border-control);
    --btn-fg-h: var(--ds-neutral-hover-fg); --btn-bg-h: var(--ds-neutral-faded); --btn-bd-h: var(--border-control-hover);
    /* Figma: the pressed neutral secondary turns primary-tinted */
    --btn-fg-a: var(--primary-text); --btn-bg-a: var(--primary-faded); --btn-bd-a: var(--primary-border-highlighted);
    --btn-fg-f: var(--ds-neutral-hover-fg); --btn-bg-f: var(--ds-neutral-faded); --btn-bd-f: var(--border-control-hover);
    --btn-fg-d: var(--disabled-fg); --btn-bd-d: var(--disabled-border);
    --btn-fg-pressed: var(--primary-text); --btn-bg-pressed: var(--primary-faded); --btn-bd-pressed: var(--primary-border-highlighted);
  }
  .ds-btn-outline.ds-btn-negative {
    --btn-fg: var(--negative); --btn-bd: var(--ds-outline-negative-bd);
    --btn-bg-h: var(--negative-faded); --btn-bg-f: var(--negative-faded);
    --btn-fg-d: var(--disabled-fg); --btn-bd-d: var(--disabled-border);
  }
  .ds-btn-outline.ds-btn-positive {
    --btn-fg: var(--positive); --btn-bd: var(--ds-outline-positive-bd);
    --btn-bg-h: var(--positive-faded); --btn-bg-f: var(--positive-faded);
    --btn-fg-d: var(--disabled-fg); --btn-bd-d: var(--disabled-border);
  }
  .ds-btn-outline.ds-btn-white {
    --btn-fg: #ffffff; --btn-bd: var(--ds-white-faded);
    --btn-bg-h: var(--ds-white-wash); --btn-bg-f: var(--ds-white-wash); --btn-bg-a: var(--ds-white-wash-a);
    --btn-fg-d: var(--ds-white-text-disabled); --btn-bd-d: #ffffff3d;
  }

  /* ---- ghost (Figma variant=Ghost): hover and pressed take a faded fill on every ghost, text or icon-only, so it never looks inert */
  .ds-btn-ghost.ds-btn-primary {
    --btn-fg: var(--primary-text); --btn-fg-h: var(--ds-primary-ghost-hover); --btn-fg-a: var(--ds-primary-ghost-active);
    --btn-bg-h: var(--primary-faded); --btn-bg-a: var(--primary-faded-highlighted); --btn-bg-f: transparent;
    --btn-fg-d: var(--disabled-fg);
    --btn-fg-pressed: var(--primary-text); --btn-bg-pressed: var(--primary-faded);
  }
  .ds-btn-ghost.ds-btn-neutral {
    --btn-fg: var(--text-subtle); --btn-fg-h: var(--ds-neutral-hover-fg); --btn-fg-a: var(--text-normal);
    --btn-bg-h: var(--ds-neutral-faded); --btn-bg-a: var(--state-pressed); --btn-bg-f: transparent;
    --btn-fg-d: var(--disabled-fg);
    --btn-fg-pressed: var(--primary-text); --btn-bg-pressed: var(--primary-faded);
  }
  .ds-btn-ghost.ds-btn-negative {
    --btn-fg: var(--negative); --btn-fg-a: var(--ds-negative-hover);
    --btn-bg-h: var(--negative-faded); --btn-bg-a: var(--negative-subtle); --btn-bg-f: transparent;
    --btn-fg-d: var(--disabled-fg);
    --btn-fg-pressed: var(--negative); --btn-bg-pressed: var(--negative-faded);
  }
  .ds-btn-ghost.ds-btn-positive {
    --btn-fg: var(--positive);
    --btn-bg-h: var(--positive-faded); --btn-bg-a: var(--positive-subtle); --btn-bg-f: transparent;
    --btn-fg-d: var(--disabled-fg);
    --btn-fg-pressed: var(--positive); --btn-bg-pressed: var(--positive-faded);
  }
  .ds-btn-ghost.ds-btn-white {
    --btn-fg: #ffffff; --btn-bg-h: var(--ds-white-wash); --btn-bg-a: var(--ds-white-wash-a);
    --btn-fg-d: var(--ds-white-text-disabled);
    --btn-fg-pressed: #ffffff; --btn-bg-pressed: var(--ds-white-wash-a);
  }
  /* icon-only ghost keeps its colour on hover and takes the faded fill instead (Figma 2654:2766) */
  .ds-btn-ghost[data-icon-only='true'].ds-btn-primary { --btn-bg-h: var(--primary-faded); --btn-fg-h: var(--primary-text); --btn-bg-a: var(--primary-faded); --btn-fg-a: var(--primary-text); --btn-bg-f: transparent; }
  .ds-btn-ghost[data-icon-only='true'].ds-btn-neutral { --btn-bg-h: var(--ds-neutral-faded); --btn-bg-a: var(--border-faded); --btn-fg-f: var(--btn-fg); --btn-bg-f: transparent; }
  .ds-btn-ghost[data-icon-only='true'].ds-btn-negative { --btn-bg-h: var(--negative-faded); --btn-fg-h: var(--negative); --btn-bg-a: var(--negative-subtle); --btn-bg-f: transparent; }
  .dark .ds-btn-ghost.ds-btn-negative { --btn-fg-a: #ff5757; }
  .ds-btn-ghost[data-icon-only='true'].ds-btn-white { --btn-bg-h: var(--ds-white-wash); --btn-bg-a: var(--ds-white-wash-a); }

  /* ---- link (button that reads as a text link) */
  .ds-btn-link { --btn-fg: var(--primary-text); --btn-fg-d: var(--disabled-fg); }
  .ds-btn-link.ds-btn-neutral { --btn-fg: var(--text-normal); --btn-fg-d: var(--disabled-fg); }
  .ds-btn-link.ds-btn-negative { --btn-fg: var(--negative); --btn-fg-d: var(--disabled-fg); }
  .ds-btn-link.ds-btn-positive { --btn-fg: var(--positive); --btn-fg-d: var(--disabled-fg); }
  .ds-btn-link.ds-btn-white { --btn-fg: #ffffff; --btn-fg-d: var(--ds-white-text-disabled); }

  /* ===================================================================================================================
     Text link (Figma 3222:3088)
     =================================================================================================================== */
  .ds-link {
    color: var(--lnk-fg, var(--primary-text));
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .ds-link:is(:hover, [data-force='hover']) { text-decoration: underline; color: var(--lnk-fg-h, var(--lnk-fg, var(--primary-text))); }
  .ds-link:is(:focus-visible, [data-force='focus']) { text-decoration: underline; }
  .ds-link[data-underline='always'] { text-decoration: underline; }
  /* a link in running text is set apart by more than hue (WCAG 1.4.1): a thin, soft underline at rest that firms up on hover / focus */
  .ds-link[data-underline='rest']:not(:is([aria-disabled='true'], [data-force='disabled'])) { text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: color-mix(in srgb, currentColor 72%, transparent); }
  .ds-link[data-underline='rest']:not(:is([aria-disabled='true'], [data-force='disabled'])):is(:hover, :focus-visible, [data-force='hover'], [data-force='focus']) { text-decoration-color: currentColor; }
  .ds-link:is([aria-disabled='true'], [data-force='disabled']) { color: var(--lnk-fg-d, var(--disabled-fg)); pointer-events: none; text-decoration: none; cursor: not-allowed; }
  .ds-link-neutral { --lnk-fg: var(--text-subtle); --lnk-fg-h: var(--text-normal); --lnk-fg-d: var(--disabled-fg); }
  .ds-link-negative { --lnk-fg: var(--negative); --lnk-fg-d: var(--disabled-fg); }
  .ds-link-white { --lnk-fg: #ffffff; --lnk-fg-d: var(--ds-white-text-disabled); }
  .ds-link-primary { --lnk-fg: var(--primary-text); --lnk-fg-h: var(--ds-primary-ghost-hover); }

  /* ===================================================================================================================
     Skeleton shimmer (Figma 3570:7027)
     =================================================================================================================== */
  .ds-shimmer {
    background-color: var(--ds-shimmer-a);
    animation: ds-shimmer 1.1s ease-in-out infinite alternate;
  }
  .ds-skeleton-static { background-color: var(--ds-shimmer-a); }

  /* ===================================================================================================================
     Loader
     =================================================================================================================== */
  .ds-loader-dot {
    border-radius: 9999px;
    background-color: currentColor;
    animation: ds-dot-pulse 1.2s ease-in-out infinite;
  }
  .ds-loader-dot:nth-child(2) { animation-delay: 0.15s; }
  .ds-loader-dot:nth-child(3) { animation-delay: 0.3s; }
  .ds-loader-dot:nth-child(4) { animation-delay: 0.45s; }
  .ds-loader-bar { animation: ds-indeterminate 1.4s ease-in-out infinite; }
  .ds-loader-spin { animation: ds-spin 1s linear infinite; }
}
@keyframes ds-spin { to { transform: rotate(360deg); } }

@keyframes ds-indeterminate-calm {
  0% { opacity: 0.35; }
  100% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .ds-shimmer, .ds-loader-dot { animation-duration: 3s; }
  .ds-loader-spin { animation-duration: 2.4s; }
  /* the indeterminate bar stops travelling: a fixed third of the track that breathes slowly (2.4s per half cycle), no sweep, no flashing */
  .ds-loader-bar { animation: ds-indeterminate-calm 2.4s ease-in-out infinite alternate; }
}
