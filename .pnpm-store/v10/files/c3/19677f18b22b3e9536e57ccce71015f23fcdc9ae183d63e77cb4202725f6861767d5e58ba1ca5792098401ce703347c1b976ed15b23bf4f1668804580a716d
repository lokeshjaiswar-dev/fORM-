/* data: component-level CSS for the data group of the dMACQ design system (Table, Pagination, Timeline, Audit log). Owned by the data fork.
   Everything here maps to tokens declared in index.css; no raw colours except the Figma "Initials" peach, which has no semantic token. */

/* ---- tones: one attribute (data-ds-tone) sets the three colours used by timeline markers and audit icon badges.
   --ds-tone is the glyph/dot colour, --ds-tone-faded the soft badge fill, --ds-tone-solid the filled dot.
   Figma: feedback.background.<tone>.subtle (badge fill) and interactive.text.<tone>.normal (glyph). */
[data-ds-tone="neutral"]     { --ds-tone: var(--neutral-intense); --ds-tone-faded: var(--bluedark-a50);   --ds-tone-subtle: var(--neutral-subtle);           --ds-tone-solid: var(--text-subtle); }
[data-ds-tone="primary"]     { --ds-tone: var(--primary-text);    --ds-tone-faded: var(--primary-faded);  --ds-tone-subtle: var(--primary-border-highlighted); --ds-tone-solid: var(--primary-default); }
[data-ds-tone="positive"]    { --ds-tone: var(--positive);        --ds-tone-faded: var(--positive-faded); --ds-tone-subtle: var(--positive-subtle);          --ds-tone-solid: var(--positive); }
[data-ds-tone="negative"]    { --ds-tone: var(--ds-negative-text);        --ds-tone-faded: var(--negative-faded); --ds-tone-subtle: var(--negative-subtle);          --ds-tone-solid: var(--negative); }
[data-ds-tone="notice"]      { --ds-tone: var(--notice-text);          --ds-tone-faded: var(--notice-faded);   --ds-tone-subtle: var(--notice-subtle);            --ds-tone-solid: var(--notice); }
[data-ds-tone="information"] { --ds-tone: var(--information);     --ds-tone-faded: var(--information-faded); --ds-tone-subtle: var(--information-subtle);    --ds-tone-solid: var(--information); }

/* A marker sits on the page colour (so a connector line never shows through it) with the tone fill on top. */
.ds-marker {
  color: var(--ds-tone);
  background: linear-gradient(var(--ds-tone-faded), var(--ds-tone-faded)), var(--surface-intense);
}
/* Figma: Initials/color/light_peach (avatar marker, static in both themes, black initials) */
.ds-initials-peach { background: #ffdcb9; color: #000000; }

/* ---- timeline connectors (1px, centred under the 24px marker) */
.ds-timeline-line { background: var(--border-control); }

/* ---- forced states for the gallery (data-force="hover|pressed|focus"): the same look as the real :hover / :active / :focus-visible */
[data-slot="table-head"][data-force="hover"] > button { background: var(--surface-highlighted); color: var(--text-normal); }
[data-slot="table-head"][data-force="pressed"] > button,
[data-slot="table-head"][data-force="focus"] > button { background: var(--surface-primary-subtle); color: var(--primary-text); }
[data-slot="table-head"][data-force="focus"] > button { outline: var(--focus-ring-width) solid var(--focus-ring); outline-offset: calc(var(--focus-ring-width) * -1); }
[data-slot^="pagination-"][data-force="hover"] { border-color: var(--border-default); background: var(--state-hover); color: var(--ds-text-strong); }
[data-slot^="pagination-"][data-force="focus"] { background: var(--state-hover); color: var(--ds-text-strong); outline: var(--focus-ring-width) solid var(--focus-ring); outline-offset: var(--focus-ring-offset); }
[data-slot^="pagination-"][data-force="pressed"] { background: var(--state-pressed); color: var(--ds-text-strong); }

/* ---- text colours that differ between "surface" text and "interactive" text in Figma */
:root, .ov-theme-light { --ds-negative-text: #a83030; /* red text that still reaches 4.5:1 on the red tint of a flagged row */ --ds-text-detail: var(--bluedark-900); --ds-text-strong: var(--bluedark-1000); }
.dark, .ov-theme-dark { --ds-negative-text: #ff8585; --ds-text-detail: var(--text-subtle); --ds-text-strong: var(--text-normal); }
