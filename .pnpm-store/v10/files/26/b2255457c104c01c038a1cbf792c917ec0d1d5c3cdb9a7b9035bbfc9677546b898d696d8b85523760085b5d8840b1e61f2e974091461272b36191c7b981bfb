/* overlays: component-level CSS for the overlays group of the dMACQ design system (keyframes, state helpers). Owned by the overlays fork.
   Figma pages: Alert / Toast 2166:3834, Banner 4003:1027, Modal 3334:1173, Bottom Sheet 3792:4426, Spotlight Popover 3649:3739, Carousel 3709:322. */

/* ---- feedback tones: the solid ("Intense") fills are the same in light and dark (white text on top, >= 4.5:1), see feedback.background.<tone>.intense.
   They point at the shared solids in index.css, so a toast, an alert, a button and a badge show the same green / red / amber. */
:root,
.ov-theme-light {
  /* modal card outline: none in light (it floats on shadow) */
  --ov-modal-border: transparent;
  /* modal / sheet backdrop: the Figma frames dim the page with ~60% of the navy */
  --ov-scrim: #0c192799;
  --ov-neutral-solid: var(--bluedark-1000); /* feedback.background.neutral.intense #2f4256 */
}
.dark,
.ov-theme-dark {
  /* the card sits one rung above the page on the dark ladder; the outline and the scrim give the rest of the separation */
  --ov-scrim: #000000a6;
  --ov-modal-border: var(--border-default);
  --ov-neutral-solid: #3a5068;
}
:root,
.dark,
.ov-theme-light,
.ov-theme-dark {
  --ov-primary-solid: var(--primary-default);
  --ov-positive-solid: var(--positive-solid);
  --ov-negative-solid: var(--negative-solid);
  --ov-notice-solid: var(--notice-solid);
  /* opaque "Subtle" fills for toasts (a toast floats over content, so the 9% tint is laid over the page surface) */
  --ov-primary-subtle: linear-gradient(var(--primary-faded), var(--primary-faded)), var(--surface-intense);
  --ov-positive-subtle: linear-gradient(var(--positive-faded), var(--positive-faded)), var(--surface-intense);
  --ov-negative-subtle: linear-gradient(var(--negative-faded), var(--negative-faded)), var(--surface-intense);
  --ov-notice-subtle: linear-gradient(var(--notice-faded), var(--notice-faded)), var(--surface-intense);
  --ov-neutral-subtle: linear-gradient(var(--bluedark-a50), var(--bluedark-a50)), var(--surface-intense);
}
/* ---- gallery theme panels (the docs overlays page). The token tables in index.css are declared on ".ov-theme-light" / ".ov-theme-dark" too, so
   a light panel and a dark panel can sit side by side whatever the page theme is. Use ".ov-theme-dark" together with the "dark" class. */
.ov-theme-light,
.ov-theme-dark {
  background: var(--background);
  color: var(--foreground);
}
.ov-theme-light { color-scheme: light; }
.ov-theme-dark { color-scheme: dark; }

@theme inline {
  --color-ov-primary: var(--ov-primary-solid);
  --color-ov-positive: var(--ov-positive-solid);
  --color-ov-negative: var(--ov-negative-solid);
  --color-ov-notice: var(--ov-notice-solid);
  --color-ov-neutral: var(--ov-neutral-solid);
  --color-scrim: var(--ov-scrim);
  --color-modal-border: var(--ov-modal-border);
  --color-neutral-faded: var(--bluedark-a50);
  --color-neutral-faded-highlighted: var(--bluedark-a200);
}

/* ---- sonner toasts (src/components/ui/sonner.tsx): Figma Toast 2169:16965, 360x36, icon + one line + close X, Intense or Subtle.
   Sonner's own rules have specificity (0,2,0) to (0,3,0); the ones below are (0,3,0) to (0,4,0) so they win without !important. */
[data-sonner-toaster].ds-toaster {
  --width: 360px;
  --border-radius: 8px; /* the same corner as Alert, Button and the menus (it was 4px) */
  z-index: var(--z-toast);
  font-family: var(--font-sans); /* sonner sets its own system stack on the toaster and on every toast */
}
[data-sonner-toaster].ds-toaster [data-sonner-toast] {
  font-family: inherit;
  /* a modal Dialog makes the body pointer-events:none, which the toaster inherits: a toast raised from inside the dialog (above its scrim, z-toast) would
     show its Undo and close buttons but hand every click to the scrim. The toast itself stays clickable. */
  pointer-events: auto;
}
/* a toast with Undo / Keep needs room to stay on one line: widen it (360px stays the width of a plain toast), never past the viewport */
[data-sonner-toaster].ds-toaster [data-sonner-toast]:has([data-button], [data-cancel]) {
  --width: min(440px, calc(100vw - 32px));
}
[data-sonner-toaster].ds-toaster[data-sonner-theme] {
  --normal-bg: var(--ov-neutral-solid);
  --normal-text: #ffffff;
  --normal-border: transparent;
  --success-bg: var(--ov-positive-solid);
  --success-text: #ffffff;
  --success-border: transparent;
  --error-bg: var(--ov-negative-solid);
  --error-text: #ffffff;
  --error-border: transparent;
  --warning-bg: var(--ov-notice-solid);
  --warning-text: #ffffff;
  --warning-border: transparent;
  --info-bg: var(--ov-primary-solid);
  --info-text: #ffffff;
  --info-border: transparent;
}
[data-sonner-toaster].ds-toaster.ds-toaster-subtle[data-sonner-theme] {
  --normal-bg: var(--ov-neutral-subtle);
  --normal-text: var(--text-normal);
  --success-bg: var(--ov-positive-subtle);
  --success-text: var(--text-normal);
  --error-bg: var(--ov-negative-subtle);
  --error-text: var(--text-normal);
  --warning-bg: var(--ov-notice-subtle);
  --warning-text: var(--text-normal);
  --info-bg: var(--ov-primary-subtle);
  --info-text: var(--text-normal);
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] {
  min-height: 36px;
  padding: 8px 12px;
  gap: 8px;
  font-size: 12px;
  line-height: 16px;
  border-width: 0;
  box-shadow: var(--elevation-mid);
}
[data-sonner-toaster].ds-toaster.ds-toaster-subtle [data-sonner-toast][data-styled='true'] {
  box-shadow: none;
  border-width: 1px;
  border-color: var(--border-faded);
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-icon] {
  margin: 0;
}
/* Sonner centres its loader wrapper with top/left 50% and a translate, which lands a few px off the 16px slot the other icons sit in (the toast jumps when
   it resolves). Pin the wrapper to the slot and let the Loader fill it. */
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-icon] > .sonner-loader {
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: none;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-icon] > .sonner-loader[data-visible='false'] { transform: scale(0.8); }
/* Subtle toasts carry the tone on the icon only (Figma: tinted fill, dark text, coloured icon) */
.ds-toaster.ds-toaster-subtle [data-sonner-toast][data-type='success'] [data-icon] { color: var(--positive); }
.ds-toaster.ds-toaster-subtle [data-sonner-toast][data-type='error'] [data-icon] { color: var(--negative); }
.ds-toaster.ds-toaster-subtle [data-sonner-toast][data-type='warning'] [data-icon] { color: var(--notice-text); }
.ds-toaster.ds-toaster-subtle [data-sonner-toast][data-type='info'] [data-icon] { color: var(--primary-text); }
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-title] {
  font-weight: 500;
  line-height: 16px;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-content]:has([data-description]) [data-title] {
  font-weight: 600;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-description] {
  font-size: 12px;
  line-height: 16px;
  color: inherit;
  opacity: 1; /* full strength: white at 90% on the solid fills drops under 4.5:1; the title weight carries the hierarchy */
}
/* the close button sits inline at the end of the row (Figma), not as a round badge on the corner */
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-close-button] {
  position: relative;
  inset: auto;
  order: 99;
  margin: -2px -4px -2px auto; /* 24px target (WCAG 2.5.8) that does not grow the 36px row */
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  transform: none;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: inherit;
  opacity: 0.85;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-close-button] svg {
  width: 16px;
  height: 16px;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true']:hover [data-close-button]:hover {
  background: color-mix(in srgb, currentColor 14%, transparent);
  border: 0;
  opacity: 1;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-button] {
  height: 24px;
  padding: 0 8px;
  border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
  border-radius: 6px;
  background: transparent;
  color: inherit;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-button]:hover {
  background: color-mix(in srgb, currentColor 14%, transparent);
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-cancel] {
  border-color: transparent;
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] [data-cancel]:hover {
  background: color-mix(in srgb, currentColor 14%, transparent);
}

/* ---- spotlight popover: dim the page behind the popover and lift the anchored element above the scrim */
@keyframes ov-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.ov-spotlight-scrim {
  animation: ov-fade-in var(--dur-moderate) var(--ease-standard);
}

/* ---- carousel: hide the scrollbar of the track, keep it scrollable by keyboard, buttons and touch */
.ov-carousel-track {
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
}
.ov-carousel-track::-webkit-scrollbar {
  display: none;
}
@media (prefers-reduced-motion: reduce) {
  .ov-carousel-track {
    scroll-behavior: auto;
  }
}

/* ---- banner loader (Figma Loader Icon, Loader Frame=1..8): a 40px ring with a quarter arc */
@keyframes ov-spin {
  to { transform: rotate(360deg); }
}
.ov-loader-arc {
  animation: ov-spin 0.9s linear infinite;
  transform-origin: 50% 50%;
}
/* reduced motion: the arc stops turning and breathes instead (a fixed quarter arc that fades in and out), no rotation at all */
@keyframes ov-loader-breathe {
  0% { opacity: 0.4; }
  100% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .ov-loader-arc {
    animation: ov-loader-breathe 1.6s ease-in-out infinite alternate;
  }
}

/* ---- toast focus: Sonner draws a faint grey box-shadow on the toast, the close button and the action. Replace it with the shared solid outline.
   The toast itself floats over the page, so its ring uses the theme colour; the buttons inside an intense toast sit on a solid coloured fill,
   so they use the inverse (white) ring. Subtle toasts are tinted and keep the theme ring everywhere. */
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true']:focus-visible {
  box-shadow: var(--elevation-mid);
  outline: var(--focus-ring-width) solid var(--focus-ring);
  outline-offset: var(--focus-ring-offset);
}
[data-sonner-toaster].ds-toaster [data-sonner-toast][data-styled='true'] :is([data-close-button], [data-button], [data-cancel]):focus-visible {
  box-shadow: none;
  outline: var(--focus-ring-width) solid var(--focus-ring-inverse);
  outline-offset: 1px;
}
[data-sonner-toaster].ds-toaster.ds-toaster-subtle [data-sonner-toast][data-styled='true'] :is([data-close-button], [data-button], [data-cancel]):focus-visible {
  outline-color: var(--focus-ring);
}
[data-sonner-toaster].ds-toaster.ds-toaster-subtle [data-sonner-toast][data-styled='true']:focus-visible {
  box-shadow: none;
}

/* ---- collapsible: height ease like Accordion. `overflow: hidden` lives only in the keyframes, so at rest nothing clips the content's focus rings. */
@keyframes ds-collapsible-down {
  from { height: 0; overflow: hidden; }
  to { height: var(--radix-collapsible-content-height); overflow: hidden; }
}
@keyframes ds-collapsible-up {
  from { height: var(--radix-collapsible-content-height); overflow: hidden; }
  to { height: 0; overflow: hidden; }
}
.ds-collapsible-content[data-state='open'] {
  animation: ds-collapsible-down var(--dur-moderate) var(--ease-standard);
}
.ds-collapsible-content[data-state='closed'] {
  animation: ds-collapsible-up var(--dur-moderate) var(--ease-standard);
}
@media (prefers-reduced-motion: reduce) {
  .ds-collapsible-content[data-state] {
    animation: none;
  }
}
