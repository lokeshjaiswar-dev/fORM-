{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck", "^build"], "outputs": ["coverage/**"], "env": ["FORM_TEST_MAILPIT_SMTP", "FORM_TEST_MAILPIT_API"] },
    "test:int": {
      "dependsOn": ["^typecheck"],
      "cache": false,
      "env": ["FORM_TEST_DATABASE_ADMIN_URL", "FORM_TEST_PG_IMAGE"],
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH", "TESTCONTAINERS_*"]
    },
    "e2e": { "dependsOn": ["build"], "passThroughEnv": ["CI"] },
    "test:determinism": { "dependsOn": ["^typecheck"], "cache": false, "passThroughEnv": ["CI"] },
    "test:perf": { "cache": false, "passThroughEnv": ["FORM_PERF_SLACK"] },
    "templates:build": { "outputs": ["dist/**"], "env": ["FORM_PACK_SIGNING_KEY", "FORM_PACK_KEY_ID"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
