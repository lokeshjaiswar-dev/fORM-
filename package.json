{
  "name": "form-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@form/builder",
    "dev:api": "pnpm --filter @form/api dev",
    "dev:worker": "pnpm --filter @form/worker dev",
    "dev:setup": "pnpm --filter @form/db db:setup --env-out ../../apps/api/.env.local && pnpm --filter @form/worker dev:setup --env-out .env.local",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "lint": "oxlint",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "i18n:extract": "pnpm --filter @form/i18n i18n:extract"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "18.5.0",
    "oxlint": "~1.86.0",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
