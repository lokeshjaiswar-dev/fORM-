        {
          "id": "b1000000-0000-4000-8000-000000000003",
          "type": "email",
          "name": "Vendor Email",
          "value": "Vendor Email",
          "label": "Vendor Email",
          "required": true,
          "placeholder": ""
        },
        {
          "id": "b1000000-0000-4000-8000-000000000004",
          "type": "phonenumber",
          "name": "Vendor Phone",
