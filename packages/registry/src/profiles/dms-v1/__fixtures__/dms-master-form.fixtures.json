          "id": "b1000000-0000-4000-8000-000000000001",
          "type": "textinput",
          "name": "Vendor Name",
          "value": "Vendor Name",
          "label": "Vendor Name",
          "required": true,
          "placeholder": "",
          "primary": true,
          "numeric": false,
          "specialChars": false
        },
        {
          "id": "b1000000-0000-4000-8000-000000000002",
          "type": "numberinput",
          "name": "Vendor Code",
          "value": "Vendor Code",
          "label": "Vendor Code",
          "required": false,
          "placeholder": "e.g. 1042"
