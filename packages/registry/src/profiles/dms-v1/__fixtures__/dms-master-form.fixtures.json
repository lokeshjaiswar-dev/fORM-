  "formPlusBlocks": {
    "$comment": "What elementsToDefinition(create.request.form_builder_fields) must produce per block (subset). key = \"f_\" + id without dashes. All blocks carry x[\"x-dms\"].type = classic type. config.optionCodes is shorthand for options.map(o => o.code); option ids are \"v\" + fnv1a64 hex of the value.",
    "blocks": [
      {
        "id": "b1000000-0000-4000-8000-000000000001",
        "key": "f_b1000000000040008000000000000001",
        "type": "short_text",
        "required": true,
        "unique": {
          "normalize": "exact"
        },
        "config": {
          "pattern": {
            "source": "^[a-zA-Z\\s]+$"
          }
        }
      },
      {
        "id": "b1000000-0000-4000-8000-000000000002",
        "key": "f_b1000000000040008000000000000002",
        "type": "number",
        "required": false,
        "config": {
          "display": "input",
          "integerOnly": true,
          "allowNegative": true,
          "min": "-2147483648",
          "max": "2147483647",
          "placeholder": "e.g. 1042"
        }
      },
      {
        "id": "b1000000-0000-4000-8000-000000000003",
        "key": "f_b1000000000040008000000000000003",
        "type": "email",
        "required": true,
        "config": {}
      },
      {
        "id": "b1000000-0000-4000-8000-000000000004",
        "key": "f_b1000000000040008000000000000004",
        "type": "short_text",
        "required": false,
        "config": {
          "maxLength": 10,
          "pattern": {
            "source": "^[0-9]+$"
          }
        }
      },
      {
        "id": "b1000000-0000-4000-8000-000000000005",
        "key": "f_b1000000000040008000000000000005",
        "type": "long_text",
        "required": false,
        "config": {
          "rows": 4
        }
      },
      {
        "id": "b1000000-0000-4000-8000-000000000006",
        "key": "f_b1000000000040008000000000000006",
        "type": "single_choice",
        "required": false,
        "config": {
          "display": "dropdown",
          "searchable": true,
          "optionCodes": [
            "Wholesale",
            "Retail"
          ]
        }
      },
      {
        "id": "b1000000-0000-4000-8000-000000000007",
        "key": "f_b1000000000040008000000000000007",
        "type": "date",
        "required": false,
        "config": {
          "pattern": "DD-MM-YYYY",
          "picker": "calendar"
        }
      }
    ],
    "textinputPatterns": {
      "numeric=false,specialChars=false": "^[a-zA-Z\\s]+$",
      "numeric=true,specialChars=false": "^[a-zA-Z0-9\\s]+$",
      "numeric=false,specialChars=true": "^[^0-9]*$",
      "numeric=true,specialChars=true": null
    }
