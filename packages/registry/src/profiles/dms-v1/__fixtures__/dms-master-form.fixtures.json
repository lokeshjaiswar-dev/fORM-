  "mustStillPass": [
    {
      "$comment": "OpenForm path unchanged: source dms with OpenForm types is accepted as before",
      "status": 201,
      "request": {
        "name": "Contact Master",
        "source": "dms",
        "doctype_ids": [],
        "folder_ids": [],
        "form_builder_fields": [
          {
            "id": "b5000000-0000-4000-8000-000000000001",
            "type": "text",
            "name": "Your name"
          },
          {
            "id": "b5000000-0000-4000-8000-000000000002",
            "type": "phone_number",
            "name": "Phone Number"
          }
        ]
      }
    }
