          "name": "Vendor Category",
          "value": "Vendor Category",
          "label": "Vendor Category",
          "required": false,
          "placeholder": "",
          "options": [
            {
              "name": "Wholesale",
              "value": "Wholesale"
            },
            {
              "name": "Retail",
              "value": "Retail"
            }
          ],
          "select": {
            "options": [
              {
                "name": "Wholesale",
                "value": "Wholesale"
              },
              {
                "name": "Retail",
                "value": "Retail"
              }
            ]
          }
        },
        {
          "id": "b1000000-0000-4000-8000-000000000007",
          "type": "date",
          "name": "Onboarded On",
          "value": "Onboarded On",
          "label": "Onboarded On",
          "required": false,
          "placeholder": "",
          "isDefaultToDate": false
        }
      ]
