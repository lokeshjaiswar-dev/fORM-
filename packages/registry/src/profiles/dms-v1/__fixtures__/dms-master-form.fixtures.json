    "expectedStatus": 201,
    "expectedPrimaryKey": "Vendor Name",
    "expectedMasterFields": [
      {
        "id": "b1000000-0000-4000-8000-000000000001",
        "name": "Vendor Name",
        "type": "textinput",
        "dynamic_field_name": "field_1",
        "column": "string",
        "is_required": true,
        "is_primary": true,
        "options": null
      },
      {
        "id": "b1000000-0000-4000-8000-000000000002",
        "name": "Vendor Code",
        "type": "numberinput",
        "dynamic_field_name": "field_2",
        "column": "bigInteger",
        "is_required": false,
        "is_primary": false,
        "options": null
      },
      {
        "id": "b1000000-0000-4000-8000-000000000003",
        "name": "Vendor Email",
