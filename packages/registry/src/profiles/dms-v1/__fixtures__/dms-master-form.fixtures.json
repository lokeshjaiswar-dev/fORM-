      {
        "id": "b1000000-0000-4000-8000-000000000004",
        "name": "Vendor Phone",
        "type": "phonenumber",
        "dynamic_field_name": "field_4",
        "column": "text",
        "is_required": false,
        "is_primary": false,
        "options": null
      },
      {
        "id": "b1000000-0000-4000-8000-000000000005",
        "name": "Vendor Address",
        "type": "multilineinput",
        "dynamic_field_name": "field_5",
        "column": "text",
        "is_required": false,
        "is_primary": false,
        "options": null
      },
      {
        "id": "b1000000-0000-4000-8000-000000000006",
        "name": "Vendor Category",
        "type": "dropdown",
        "dynamic_field_name": "field_6",
        "column": "string",
        "is_required": false,
        "is_primary": false,
        "options": [
          {
            "name": "Wholesale",
            "value": "Wholesale"
          },
          {
            "name": "Retail",
            "value": "Retail"
          }
