{
  "$comment": "Canonical master-form fixtures (DESIGN.md sections 1 and 3). T-API tests the server side, T-FORM-1 the translator. Order of form_builder_fields = canvas order. dynamic column names are field_<n> in insertion order.",
  "endpoint": {
    "create": "POST /dms/v1/master/form",
    "show": "GET /dms/v1/master/form/{id}",
    "update": "PATCH /dms/v1/master/form/{id}"
  },
  "headers": {
    "Authorization": "Bearer <DMS user token, never in fixtures>",
    "X-Tenant-Id": "<tenant>",
    "X-Workspace-Id": "<workspace uuid>",
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
