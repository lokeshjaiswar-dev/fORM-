{
  "$comment": "Contract for the one-time OpenForm -> classic (dms-v1) master conversion (DESIGN-v2 section 3). Canonical copy: docs/demo1/contract/. Byte-identical copies: dms-api tests/Fixtures/formplus/, fORM- packages/registry/src/profiles/dms-v1/__fixtures__/. Element output key order: id,type,name,value,label,required,placeholder, then type keys. `primary` appears only when true. `placeholder` is always present ('' when OpenForm had none). Columns of _dynamic_master_* and record values are never touched.",
  "contract": "openform-to-dms-v1",
  "version": 1,
  "converterVersion": "openform-dms-v1/1",
  "classicTypes": [
    "textinput",
    "numberinput",
    "email",
    "phonenumber",
    "multilineinput",
    "dropdown",
    "date"
  ],
  "layoutTypes": [
    "nf-text",
    "nf-code",
    "nf-image",
    "nf-page-break",
    "nf-divider",
    "divider",
    "heading",
    "section",
    "button"
  ],
  "layoutNote": "Layout blocks are dropped from json_data (they have no column and no values) and listed in the report; `section` children are flattened in order. `button` is layout unless it has an active master field (Validate PAN).",
  "legacyMarker": {
    "key": "legacy",
    "shape": {
      "from": "string (OpenForm type)",
      "readOnly": "true"
    },
    "rules": [
      "readOnly fields are never required and never primary (converter clears both and warns)",
      "fORM- builder: type, options and legacy marker are locked; rename/reorder allowed; delete allowed (non-destructive G6)",
      "fORM- record mode: shown read-only with the raw stored value, never sent on create or update",
      "classic renderer ignores the key"
    ]
  },
  "primaryRules": [
    "at most one primary: the first primary in canonical (flattened) order wins; others demoted with warning primary_demoted",
    "primary allowed on textinput, numberinput, email, phonenumber only; else demoted (primary_type_not_allowed)",
    "masters.primary_key = name of the remaining primary, or null"
  ],
  "blockingRules": [
    "duplicate_field_names: two kept elements whose trimmed names match case-insensitively",
    "empty_field_name: a kept element whose trimmed name and master field name are both empty"
  ],
  "warningCodes": [
    "phone_format",
    "decimal_values_possible",
    "time_dropped_in_ui",
    "required_dropped_read_only",
    "unknown_type",
    "logic_dropped",
    "hidden_dropped",
    "primary_demoted",
    "primary_type_not_allowed",
    "orphan_master_field",
    "column_type_differs"
  ],
  "typeMap": [
    {
      "from": "text",
      "when": "default",
      "to": "textinput",
      "keys": "numeric/specialChars copied when boolean, else true (OpenForm text accepts any characters)",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "text",
      "when": "multi_lines === true",
      "to": "multilineinput",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "email",
      "to": "email",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "phone_number",
      "to": "phonenumber",
      "lossless": true,
      "readOnly": false,
      "warning": "phone_format"
    },
    {
      "from": "number",
      "to": "numberinput",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "rating",
      "to": "numberinput",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "scale",
      "to": "numberinput",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "slider",
      "to": "numberinput",
      "lossless": false,
      "readOnly": false,
      "warning": "decimal_values_possible"
    },
    {
      "from": "date",
      "aliases": [
        "nf-date"
      ],
      "when": "default",
      "to": "date",
      "keys": "isDefaultToDate = (prefill_today === true)",
      "lossless": true,
      "readOnly": false,
      "warning": "with_time -> time_dropped_in_ui"
    },
    {
      "from": "date",
      "when": "date_range === true",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "select",
      "to": "dropdown",
      "keys": "options = select.options[].name -> {name,value:name}",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "radio",
      "to": "dropdown",
      "keys": "options = radio.options[].name -> {name,value:name}",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "checkbox",
      "to": "dropdown",
      "keys": "options = [{name:'Yes',value:'1'},{name:'No',value:'0'}]",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "url",
      "to": "textinput",
      "keys": "numeric:true, specialChars:true",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "barcode",
      "to": "textinput",
      "keys": "numeric:true, specialChars:true",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "time",
      "to": "textinput",
      "keys": "numeric:true, specialChars:true",
      "lossless": true,
      "readOnly": false
    },
    {
      "from": "multi_select",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "rich_text",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "files",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "signature",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "image",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "matrix",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "full_name",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "address",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "button",
      "when": "has an active master field (Validate PAN)",
      "to": "textinput",
      "keys": "numeric:true, specialChars:true",
      "lossless": false,
      "readOnly": true
    },
    {
      "from": "*",
      "when": "any other type with an active master field",
      "to": "multilineinput",
      "lossless": false,
      "readOnly": true,
      "warning": "unknown_type"
    },
    {
      "from": "textinput|numberinput|email|phonenumber|multilineinput|dropdown|date",
      "when": "already a classic name inside an OpenForm-dialect master",
      "to": "same",
      "lossless": true,
      "readOnly": false
    }
  ],
  "dialectCases": [
    {
